      "pt": "Agora você pode salvar seus dados\n         como #C000246204Clear Data#CDEF."
    },
    {
      "id": 88,
      "msgctxt": "516972",
      "tipo": "unk_op1650",
      "medida": null,
      "max_bytes": null,
      "comum": true,
      "repeticoes": 154,
      "en": "     You may use this data to carry\nover elements to the start of a new game.",
      "pt": "     Você pode usar esses dados para levar\nelementos ao início de um novo jogo."
    },
    {
      "id": 89,
      "msgctxt": "517052",
      "tipo": "unk_op1650",
      "medida": null,
      "max_bytes": null,
      "comum": true,
      "repeticoes": 154,
      "en": "Please be careful to not overwrite\n  the data while you are saving.",
      "pt": "Tome cuidado para não sobrescrever\n  os dados ao salvar."
    },
    {
      "id": 90,
      "msgctxt": "517120",
      "tipo": "unk_op1653",
      "medida": null,
      "max_bytes": null,
      "comum": true,
