      "pt": "　Você não pode carregar mais\n#C000246204#TITM0001#CDEF."
    },
    {
      "id": 87,
      "msgctxt": "516888",
      "tipo": "unk_op1650",
      "medida": null,
      "max_bytes": null,
      "comum": true,
