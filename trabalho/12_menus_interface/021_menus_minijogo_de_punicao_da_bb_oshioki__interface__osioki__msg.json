      "repeticoes": 1,
      "en": "Get a grip, you capitalist… bitch!",
      "pt": "Se recomponha, sua capitalista… vadia!"
    },
    {
      "id": 2,
      "msgctxt": "1",
      "tipo": "",
      "medida": "choice",
      "max_bytes": null,
      "comum": false,
      "repeticoes": 1,
      "en": "You should know better than anyone!",
      "pt": "Você deveria saber melhor do que ninguém!"
    },
    {
      "id": 3,
      "msgctxt": "2",
      "tipo": "",
      "medida": "choice",
      "max_bytes": null,
      "comum": false,
      "repeticoes": 1,
      "en": "…erm, maybe \"pig\" would've been better…?",
      "pt": "…hmm, talvez \"porca\" fosse melhor…?"
    },
    {
      "id": 4,
      "msgctxt": "3",
      "tipo": "",
      "medida": "choice",
      "max_bytes": null,
      "comum": false,
      "repeticoes": 1,
      "en": "You sound like a piggy squealing!",
      "pt": "Você parece um porquinho guinchando!"
    },
    {
      "id": 5,
      "msgctxt": "4",
      "tipo": "",
      "medida": "choice",
      "max_bytes": null,
      "comum": false,
      "repeticoes": 1,
      "en": "Then I'll let you handle everything!",
      "pt": "Então vou deixar tudo nas suas mãos!"
    },
    {
      "id": 6,
      "msgctxt": "5",
      "tipo": "",
      "medida": "choice",
      "max_bytes": null,
      "comum": false,
      "repeticoes": 1,
      "en": "Then take responsibility to the very end!",
      "pt": "Então assuma a responsabilidade até o fim!"
    },
    {
      "id": 7,
      "msgctxt": "6",
      "tipo": "",
      "medida": "choice",
      "max_bytes": null,
      "comum": false,
      "repeticoes": 1,
      "en": "No, it's not!",
      "pt": "Não, não é!"
