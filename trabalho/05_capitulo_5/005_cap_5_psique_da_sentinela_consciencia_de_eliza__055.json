    {
      "id": 48,
      "msgctxt": "498188",
      "tipo": "backlog,motion,text",
      "medida": "dialog",
      "max_bytes": null,
      "comum": false,
      "repeticoes": 1,
      "en": "…*woosh*!\n*rustle, rustle, rustle*…\n*slide*…! *squeal*…!",
      "pt": ""
    },
    {
      "id": 49,
      "msgctxt": "498252",
      "tipo": "backlog,motion,text",
      "medida": "dialog",
      "max_bytes": null,
      "comum": false,
      "repeticoes": 1,
      "en": "…a grating racket rings out.",
      "pt": ""
    },
    {
      "id": 50,
      "msgctxt": "498928",
      "tipo": "backlog,motion,text",
      "medida": "dialog",
      "max_bytes": null,
      "comum": false,
      "repeticoes": 1,
      "en": "Do noises with such nuance now torment\n#C236196003Elizabeth#CDEF, the keeper of this space…?",
      "pt": ""
    },
    {
      "id": 51,
      "msgctxt": "499024",
      "tipo": "backlog,motion,text",
      "medida": "dialog",
      "max_bytes": null,
      "comum": false,
      "repeticoes": 1,
      "en": "…loud… so, loud…\nShut up… shut up…!\nPlease, shut up! Be quiet!",
      "pt": ""
    },
    {
      "id": 52,
      "msgctxt": "499112",
      "tipo": "backlog,motion,text",
      "medida": "dialog",
      "max_bytes": null,
      "comum": false,
      "repeticoes": 1,
      "en": "It's painful. It's exhausting…\nI already have a headache.\nPlease don't make it any worse!",
      "pt": ""
    },
    {
      "id": 53,
      "msgctxt": "499204",
      "tipo": "backlog,motion,text",
      "medida": "dialog",
      "max_bytes": null,
      "comum": false,
      "repeticoes": 1,
      "en": "Grk…! It hurts… It HURTS!\nPlease, no more…",
      "pt": ""
    },
    {
      "id": 54,
      "msgctxt": "499296",
      "tipo": "backlog,motion,text",
      "medida": "dialog",
      "max_bytes": null,
      "comum": false,
      "repeticoes": 1,
      "en": "Pigs! Insects! Men! WOMEN!\nMy body! My castle! My BLOOD!\nCrunching! Chafing! Creaking! SCRATCHING!",
      "pt": ""
    },
    {
      "id": 55,
      "msgctxt": "499520",
      "tipo": "backlog,motion,text",
      "medida": "dialog",
      "max_bytes": null,
      "comum": false,
      "repeticoes": 1,
      "en": "I don't know――!\nI don't know where this pain is\ncoming from anymore!",
      "pt": ""
    },
    {
      "id": 56,
      "msgctxt": "499596",
      "tipo": "backlog,motion,text",
      "medida": "dialog",
      "max_bytes": null,
      "comum": false,
      "repeticoes": 1,
      "en": "…I see. She, too, was headache-prone.\nThis noise is like a rasp,\nconstantly tormenting her.",
      "pt": ""
    },
