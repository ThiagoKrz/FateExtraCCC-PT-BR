    },
    {
      "id": 49,
      "msgctxt": "499592",
      "tipo": "backlog,motion,text",
      "medida": "dialog",
      "max_bytes": null,
      "comum": false,
      "repeticoes": 5,
      "en": "―――Wait.",
      "pt": ""
    },
    {
      "id": 50,
      "msgctxt": "499676",
      "tipo": "backlog,motion,text",
      "medida": "dialog",
      "max_bytes": null,
      "comum": false,
      "repeticoes": 1,
      "en": "Oh, you―――\nHey, sleepyhead.",
      "pt": ""
    },
    {
      "id": 51,
      "msgctxt": "500344",
      "tipo": "backlog,motion,text",
      "medida": "dialog",
      "max_bytes": null,
      "comum": false,
      "repeticoes": 1,
      "en": "H-huh? Senpai…? Don't tell me―did I mess\nup your resuscitation!? Do you recognize me!?",
      "pt": ""
    },
    {
      "id": 52,
      "msgctxt": "500484",
      "tipo": "backlog,motion,text",
      "medida": "dialog",
      "max_bytes": null,
      "comum": false,
      "repeticoes": 1,
      "en": "#C236196003Sakura#CDEF is here as the #C236196003Sakura#CDEF I know.",
      "pt": ""
    },
    {
      "id": 53,
      "msgctxt": "500908",
      "tipo": "backlog,motion,text",
      "medida": "dialog",
      "max_bytes": null,
      "comum": false,
      "repeticoes": 1,
      "en": "I take a deep breath and squint.",
      "pt": ""
    },
    {
      "id": 54,
      "msgctxt": "502568",
      "tipo": "backlog,motion,text",
      "medida": "dialog",
      "max_bytes": null,
      "comum": false,
      "repeticoes": 1,
      "en": "Wherever you go, let's go together, please.\nYour dreams are my dreams.",
      "pt": ""
    },
    {
      "id": 55,
      "msgctxt": "502904",
      "tipo": "backlog,motion,text",
      "medida": "dialog",
      "max_bytes": null,
      "comum": false,
      "repeticoes": 1,
      "en": "Umm… ahem.",
      "pt": ""
    },
    {
      "id": 56,
      "msgctxt": "502976",
      "tipo": "backlog,motion,text",
      "medida": "dialog",
      "max_bytes": null,
      "comum": false,
      "repeticoes": 1,
      "en": "#C080080080I'm happy you're here with me.\n               I―――　　　　　　　　　　　\n               I've fallen in love with everything about you.#CDEF",
      "pt": ""
    },
    {
