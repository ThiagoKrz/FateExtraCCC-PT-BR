      "tipo": "backlog,motion,text",
      "medida": "dialog",
      "max_bytes": null,
      "comum": false,
      "repeticoes": 1,
      "en": "\"Because I know people who're even weirder.\"",
      "pt": "\"Porque eu conheço gente ainda mais esquisita.\""
    },
