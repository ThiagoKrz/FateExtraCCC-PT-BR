    },
    {
      "id": 79,
      "msgctxt": "510064",
      "tipo": "unk_op1659",
      "medida": null,
      "max_bytes": null,
      "comum": true,
      "repeticoes": 154,
      "en": "　You cannot carry any more\n#C000246204#TITM0001#CDEF.",
      "pt": "　Você não pode carregar mais\n#C000246204#TITM0001#CDEF."
    },
    {
      "id": 80,
      "msgctxt": "510120",
      "tipo": "unk_op1650",
      "medida": null,
      "max_bytes": null,
      "comum": true,
      "repeticoes": 154,
      "en": "You may now save your current game data\n            as #C000246204Clear Data#CDEF.",
      "pt": "Agora você pode salvar seus dados\n         como #C000246204Clear Data#CDEF."
    },
    {
      "id": 81,
      "msgctxt": "510204",
      "tipo": "unk_op1650",
      "medida": null,
      "max_bytes": null,
      "comum": true,
      "repeticoes": 154,
      "en": "     You may use this data to carry\nover elements to the start of a new game.",
      "pt": "     Você pode usar esses dados para levar\nelementos ao início de um novo jogo."
    },
    {
      "id": 82,
      "msgctxt": "510284",
      "tipo": "unk_op1650",
      "medida": null,
      "max_bytes": null,
      "comum": true,
      "repeticoes": 154,
      "en": "Please be careful to not overwrite\n  the data while you are saving.",
      "pt": "Tome cuidado para não sobrescrever\n  os dados ao salvar."
    },
    {
      "id": 83,
      "msgctxt": "510352",
      "tipo": "unk_op1653",
      "medida": null,
      "max_bytes": null,
      "comum": true,
      "repeticoes": 154,
      "en": "Would you like to save your Clear Data?",
      "pt": "Deseja salvar seus Clear Data?"
    },
    {
      "id": 84,
      "msgctxt": "510392",
      "tipo": "popupSaveBeforeQuit_line1",
      "medida": null,
      "max_bytes": null,
      "comum": true,
      "repeticoes": 145,
      "en": "Are you sure you wish to exit",
      "pt": "Tem certeza de que deseja sair"
    },
    {
      "id": 85,
      "msgctxt": "510424",
      "tipo": "popupSaveBeforeQuit_line2",
      "medida": null,
      "max_bytes": null,
      "comum": true,
      "repeticoes": 145,
      "en": "without saving the Clear Data?",
      "pt": "sem salvar os Clear Data?"
    },
    {
      "id": 86,
      "msgctxt": "510456",
      "tipo": "backlog,motion,text",
      "medida": "dialog",
      "max_bytes": null,
      "comum": false,
      "repeticoes": 1,
      "en": "It's a bright, sunny morning\nas I make my way to school.",
      "pt": "É uma manhã clara e ensolarada\nenquanto sigo para a escola."
    },
    {
      "id": 87,
      "msgctxt": "510516",
      "tipo": "backlog,motion,text",
      "medida": "dialog",
      "max_bytes": null,
      "comum": false,
      "repeticoes": 1,
      "en": "I should really be used to commuting by now,\nbut I still can't seem to remember the way here.",
      "pt": "Já deveria estar acostumad#[o][a]# com o trajeto,\nmas ainda não consigo decorar o caminho."
    },
    {
      "id": 88,
      "msgctxt": "510612",
      "tipo": "backlog,motion,text",
      "medida": "dialog",
      "max_bytes": null,
      "comum": false,
      "repeticoes": 1,
      "en": "Soon enough, I arrive in front of the school gate.",
      "pt": "Logo chego em frente ao portão da escola."
    },
    {
      "id": 89,
      "msgctxt": "510664",
      "tipo": "backlog,motion,text",
      "medida": "dialog",
      "max_bytes": null,
      "comum": false,
      "repeticoes": 1,
      "en": "There's still plenty of time left.\nOther students in the same uniform\npass through the gate in peaceful harmony.",
      "pt": "Ainda há bastante tempo.\nOutros alunos de mesmo uniforme\natravessam o portão em tranquila harmonia."
    },
    {
      "id": 90,
      "msgctxt": "510780",
      "tipo": "backlog,motion,text",
      "medida": "dialog",
      "max_bytes": null,
      "comum": false,
      "repeticoes": 1,
      "en": "Continuing my main #RUBS  thread#RUBEroutine#REND, I also head for the gate.",
      "pt": "Seguindo minha #RUBS  linha#RUBErotina#REND principal,\ntambém vou até o portão."
    },
    {
      "id": 91,
      "msgctxt": "510860",
      "tipo": "backlog,motion,text",
      "medida": "dialog",
      "max_bytes": null,
      "comum": false,
      "repeticoes": 1,
      "en": "I feel as if someone's calling for me, so I hurry up\nuntil I see my friend and student council president\n#C236196003Issei Ryuudou#CDEF standing there.",
      "pt": "Sinto que alguém me chama e apresso o passo,\naté ver meu amigo e presidente do grêmio,\n#C236196003Ryuudou Issei#CDEF, parado ali."
    },
    {
      "id": 92,
      "msgctxt": "511012",
      "tipo": "backlog,motion,text",
      "medida": "dialog",
      "max_bytes": null,
      "comum": false,
      "repeticoes": 1,
      "en": "Which reminds me……",
      "pt": "Isso me lembra……"
    },
    {
      "id": 93,
      "msgctxt": "511036",
      "tipo": "backlog,motion,text",
      "medida": "dialog",
      "max_bytes": null,
      "comum": false,
      "repeticoes": 1,
      "en": "Starting today, they would be doing inspections\nto ensure we were in compliance with school rules……\nIt was #C000246204Public Morals Awareness Month#CDEF or something.",
      "pt": "A partir de hoje fariam inspeções\npara ver se seguíamos as regras da escola……\nEra o #C000246204Mês dos Bons Costumes#CDEF, algo assim."
    },
    {
      "id": 94,
      "msgctxt": "511208",
      "tipo": "backlog,motion,text",
      "medida": "dialog",
      "max_bytes": null,
      "comum": false,
      "repeticoes": 1,
      "en": "Good morning! Lovely weather we're\nhaving, don't you think?\nIt's a perfect day for studying!",
      "pt": "Bom dia! O tempo está ótimo\nhoje, não acha?\nUm dia perfeito para estudar!"
    },
    {
      "id": 95,
      "msgctxt": "511304",
      "tipo": "backlog,motion,text",
      "medida": "dialog",
      "max_bytes": null,
      "comum": false,
      "repeticoes": 1,
      "en": "What? You want to know if I'm going to\ninspect your uniform? And if Public Morals \nAwareness Month is still going on?",
      "pt": "O quê? Quer saber se vou\ninspecionar seu uniforme? E se o Mês dos\nBons Costumes ainda está valendo?"
    },
    {
      "id": 96,
      "msgctxt": "511424",
      "tipo": "backlog,motion,text",
      "medida": "dialog",
      "max_bytes": null,
      "comum": false,
      "repeticoes": 1,
      "en": "You're #[a man that says][one to say]# some strange things.\nI haven't heard of such an event.\nPerhaps there's an error in your records?",
      "pt": "Você #[é um homem que diz][costuma dizer]# cada coisa estranha.\nNunca ouvi falar desse evento.\nTalvez haja um erro nos seus registros?"
    },
    {
      "id": 97,
      "msgctxt": "511560",
      "tipo": "backlog,motion,text",
      "medida": "dialog",
      "max_bytes": null,
      "comum": false,
      "repeticoes": 1,
      "en": "I laugh it off, telling #C236196003Issei#CDEF \"It's nothing,\"\nthen head towards the school building.",
      "pt": "Dou risada e digo a #C236196003Issei#CDEF que \"não é nada\",\ndepois sigo para o prédio da escola."
    },
    {
      "id": 98,
      "msgctxt": "511664",
      "tipo": "backlog,motion,text",
      "medida": "dialog",
      "max_bytes": null,
      "comum": false,
      "repeticoes": 1,
      "en": "Oh, wait a moment.\nThere's a favor I'd like to ask of you.",
      "pt": "Ah, espere um momento.\nTenho um favor a lhe pedir."
    },
    {
      "id": 99,
      "msgctxt": "511724",
      "tipo": "backlog,motion,text",
      "medida": "dialog",
      "max_bytes": null,
      "comum": false,
      "repeticoes": 1,
      "en": "Sorry, but before you go to class, could you\nclose up #C000246204the supply room on the first floor#CDEF?\nI forgot to lock it.",
      "pt": "Desculpe, mas antes da aula, você poderia\nfechar #C000246204o depósito do primeiro andar#CDEF?\nEsqueci de trancá-lo."
    },
    {
      "id": 100,
      "msgctxt": "511852",
      "tipo": "backlog,motion,text",
      "medida": "dialog",
      "max_bytes": null,
      "comum": false,
      "repeticoes": 1,
      "en": "Given my #ROFS0002#RUBS  role#RUBEduties#REND, I'm unable to move from here.\nCould you do that for me?",
      "pt": "Dado meu #ROFS0002#RUBS  cargo#RUBEdeveres#REND, não posso sair daqui.\nVocê faria isso por mim?"
    },
    {
      "id": 101,
      "msgctxt": "511956",
      "tipo": "backlog,motion,text",
      "medida": "dialog",
      "max_bytes": null,
      "comum": false,
      "repeticoes": 1,
      "en": "The storage room on the first floor……\nIf I recall, it's #C000246204at the end of the hallway\nto the left of the entrance#CDEF.",
      "pt": "O depósito do primeiro andar……\nSe bem me lembro, fica #C000246204no fim do corredor\nà esquerda da entrada#CDEF."
    },
    {
      "id": 102,
      "msgctxt": "512088",
      "tipo": "backlog,motion,text",
      "medida": "dialog",
      "max_bytes": null,
      "comum": false,
      "repeticoes": 1,
      "en": "I still have time until homeroom starts, \nand it's a request from #C236196003Issei#CDEF himself.\nThere's no reason to refuse.",
      "pt": "Ainda tenho tempo até a chamada, \ne é um pedido do próprio #C236196003Issei#CDEF.\nNão há motivo para recusar."
    },
    {
      "id": 103,
      "msgctxt": "512216",
      "tipo": "backlog,motion,text",
      "medida": "dialog",
      "max_bytes": null,
      "comum": false,
      "repeticoes": 1,
      "en": "…honestly.\nSome strange people joined the faculty too.\nI'm about to collapse under all the stress.",
      "pt": "…sinceramente.\nGente estranha também entrou no corpo docente.\nEstou prestes a desabar de tanto estresse."
    },
    {
      "id": 104,
      "msgctxt": "512316",
      "tipo": "backlog,motion,text",
      "medida": "dialog",
      "max_bytes": null,
      "comum": false,
      "repeticoes": 1,
      "en": "If we had someone like you, #C236196003#FAMILY#CDEF,\n#C000246204the girl in charge of the Infirmary#CDEF and I \nwould have it much easier, but…",
      "pt": "Se tivéssemos alguém como você, #C236196003#FAMILY#CDEF,\neu e #C000246204a garota responsável pela Enfermaria#CDEF \nteríamos muito menos trabalho, mas…"
    },
    {
      "id": 105,
      "msgctxt": "512464",
      "tipo": "backlog,motion,text",
      "medida": "dialog",
      "max_bytes": null,
      "comum": false,
      "repeticoes": 1,
      "en": "Hm. No, that was inconsiderate of me.\nI'd never try to coerce you into\njoining the student council.",
      "pt": "Hm. Não, isso foi indelicado da minha parte.\nJamais tentaria forçá-#[lo][la]# a\nentrar para o grêmio."
    },
    {
      "id": 106,
      "msgctxt": "512564",
      "tipo": "backlog,motion,text",
      "medida": "dialog",
      "max_bytes": null,
      "comum": false,
      "repeticoes": 1,
      "en": "Here's the key to the storage room. See ya.\nHere's to another good day, with no regrets!",
      "pt": "Aqui está a chave do depósito. Até mais.\nQue seja mais um bom dia, sem arrependimento!"
    },
    {
      "id": 107,
      "msgctxt": "512656",
      "tipo": "backlog,motion,text",
      "medida": "dialog",
      "max_bytes": null,
      "comum": false,
      "repeticoes": 1,
      "en": "He thanks me in an exaggerated manner\nand resumes his task of overseeing the main gate.",
      "pt": "Ele me agradece de forma exagerada\ne volta a vigiar o portão principal."
    },
    {
      "id": 108,
      "msgctxt": "512744",
      "tipo": "backlog,motion,text",
      "medida": "dialog",
      "max_bytes": null,
      "comum": false,
      "repeticoes": 1,
      "en": "He told me that Public Morals Awareness Month\ndoesn't start today, but here he is.",
      "pt": "Ele disse que o Mês dos Bons Costumes\nnão começa hoje, mas lá está ele."
    },
    {
      "id": 109,
      "msgctxt": "512828",
      "tipo": "backlog,motion,text",
      "medida": "dialog",
      "max_bytes": null,
      "comum": false,
      "repeticoes": 1,
      "en": "The student council president is as diligent\nas a fine-tuned machine.",
      "pt": "O presidente do grêmio é diligente\ncomo uma máquina bem ajustada."
    },
    {
      "id": 110,
      "msgctxt": "512900",
      "tipo": "backlog,motion,text",
      "medida": "dialog",
      "max_bytes": null,
      "comum": false,
      "repeticoes": 1,
      "en": "I say goodbye to #C236196003Issei#CDEF and head for the school building,\nsquinting against the sunlight that didn't really\nfeel like early summer or early spring.",
      "pt": "Me despeço de #C236196003Issei#CDEF e sigo para o prédio,\napertando os olhos contra um sol que não parecia\nnem de começo de verão nem de primavera."
    },
    {
      "id": 111,
      "msgctxt": "513064",
      "tipo": "popupStd_line2",
      "medida": null,
      "max_bytes": null,
      "comum": false,
      "repeticoes": 3,
      "en": "You may access it via the △ button.",
      "pt": "Acesse pelo botão △."
    }
  ]
}
