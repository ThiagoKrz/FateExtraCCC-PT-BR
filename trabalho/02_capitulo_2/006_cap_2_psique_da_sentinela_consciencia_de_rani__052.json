      "msgctxt": "504020",
      "tipo": "backlog,motion,text",
      "medida": "dialog",
      "max_bytes": null,
      "comum": false,
      "repeticoes": 1,
      "en": "…my glasses are fogged.\nThis world is so narrow, but the ways of\nman stretch so vast.",
      "pt": ""
    },
    {
      "id": 49,
      "msgctxt": "504772",
      "tipo": "backlog,motion,text",
      "medida": "dialog",
      "max_bytes": null,
      "comum": false,
      "repeticoes": 1,
      "en": "I half agree, but I'm also half disappointed.",
      "pt": ""
    },
    {
      "id": 50,
      "msgctxt": "505660",
      "tipo": "backlog,motion,text",
      "medida": "dialog",
      "max_bytes": null,
      "comum": false,
      "repeticoes": 1,
      "en": "I possess a duty to control you.\nI possess the ability to control you.\nI possess the zeal to control you.",
      "pt": ""
    },
    {
      "id": 51,
      "msgctxt": "506512",
      "tipo": "backlog,motion,text",
      "medida": "dialog",
      "max_bytes": null,
      "comum": false,
      "repeticoes": 1,
      "en": "She may be doing all of this just for you,\nbut what would be best for #C236196003Rani#CDEF is a\nstern rejection.",
      "pt": ""
    },
    {
      "id": 52,
      "msgctxt": "506868",
      "tipo": "backlog,motion,text",
      "medida": "dialog",
      "max_bytes": null,
      "comum": false,
      "repeticoes": 1,
      "en": "Hmm.\nThis puppet's murmurings are circuitous,\nbut that's not so unusual.",
      "pt": ""
    },
    {
      "id": 53,
      "msgctxt": "507048",
      "tipo": "backlog,motion,text",
      "medida": "dialog",
      "max_bytes": null,
      "comum": false,
      "repeticoes": 1,
      "en": "Yes…\nYes, that's right.",
      "pt": ""
    },
    {
      "id": 54,
      "msgctxt": "507672",
      "tipo": "backlog,motion,text",
      "medida": "dialog",
      "max_bytes": null,
      "comum": false,
      "repeticoes": 1,
      "en": "I hear #C236196003Rani#CDEF's strange and passionate murmurings.",
      "pt": ""
    },
    {
      "id": 55,
      "msgctxt": "507872",
      "tipo": "backlog,motion,text",
      "medida": "dialog",
      "max_bytes": null,
      "comum": false,
      "repeticoes": 1,
      "en": "Like when I was with #C236196003Rin#CDEF, I can't answer these murmurings.",
      "pt": ""
    },
