msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: pt_BR\n"

#. cv/btl/tam_2060.at3 | 100 quadros | modo 1
msgctxt "0:0"
msgid "It's too bad I couldn't get my\n      tail tucked away.      "
msgstr "Pena que não consegui esconder o rabo."

#. cv/btl/tam_2060.at3 | 52 quadros | modo 1
msgctxt "0:1"
msgid "Huh? It's fine how it is?"
msgstr "Hein? Ele fica bem assim?"

#. cv/btl/gil_1091.at3 | 28 quadros | modo 1
msgctxt "1:0"
msgid "Stand back!"
msgstr "Recua!"

#. se/eb_gil/15 | 44 quadros | modo 1
msgctxt "2:0"
msgid "Ha! How pathetic."
msgstr "Ha! Que patético."

#. cv/fld/mll_0105.at3 | 116 quadros | modo 2
msgctxt "3:0"
msgid "I obviously won't tell you where I'm most sensitive."
msgstr "É claro que não vou dizer onde sou mais sensível."

#. cv/fld/mll_0105.at3 | 56 quadros | modo 2
msgctxt "3:1"
msgid "In what way do I mean that?"
msgstr "Em que sentido, você pergunta?"

#. cv/fld/mll_0105.at3 | 78 quadros | modo 2
msgctxt "3:2"
msgid "Hehe… Imagine whatever you'd like～"
msgstr "Hehe… Imagine o que quiser～"

#. cv/fld/gil_0603.at3 | 52 quadros | modo 1
msgctxt "4:0"
msgid "Hmm. Shall we partake in some wine?"
msgstr "Hum. Tomamos um pouco de vinho?"

#. cv/btl/adl_1510.at3 | 48 quadros | modo 1
msgctxt "5:0"
msgid "Doing okay? They're getting the better of you!"
msgstr "Tudo bem aí? Estão levando a melhor!"

#. cv/fld/mll_0102.at3 | 186 quadros | modo 2
msgctxt "6:0"
msgid "Legs included, 53kg. Lip and BB have too much baggage."
msgstr "Com as pernas, 53 kg. Lip e BB têm peso demais."

#. se/eb_ner/4 | 39 quadros | modo 1
msgctxt "7:0"
msgid "I'll finish them off here!"
msgstr "Vou acabar com eles aqui!"

#. cv/btl/rob_1231_edit.at3 | 66 quadros | modo 1
msgctxt "8:0"
msgid "It's a nerve poison. Have fun!"
msgstr "É um veneno pros nervos. Divirta-se!"

#. cv/fld/kia_0200.at3 | 90 quadros | modo 2
msgctxt "9:0"
msgid "I wouldn't ask for much."
msgstr "Eu não pediria muito."

#. cv/fld/kia_0200.at3 | 174 quadros | modo 2
msgctxt "9:1"
msgid "Just that they love me with all the desire in their heart."
msgstr "Só que me ame com todo o desejo que tem no coração."

#. cv/btl/el2_1700.at3 | 60 quadros | modo 1
msgctxt "10:0"
msgid "Give up."
msgstr "Desista."

#. cv/btl/el2_1700.at3 | 88 quadros | modo 1
msgctxt "10:1"
msgid "You can't kill me, I'm immortal."
msgstr "Você não pode me matar. Sou imortal."

#. cv/btl/ner_1260_edit.at3 | 108 quadros | modo 1
msgctxt "11:0"
msgid "Sing praise! Laus St. Claudius!"
msgstr "Cantem louvores! Laus St. Claudius!"

#. cv/btl/ner_1870_mix.at3 | 128 quadros | modo 1
msgctxt "12:0"
msgid "You say my love is twisted?\n    Don't make me laugh.    "
msgstr "Meu amor é distorcido, é?\nNão me faça rir."

#. cv/btl/ner_1870_mix.at3 | 132 quadros | modo 1
msgctxt "12:1"
msgid "What is the right way to love then?\n  Do you have an answer, Saber!?  "
msgstr "E qual é o jeito certo de amar?\nVocê tem uma resposta, Saber!?"

#. cv/btl/ner_1870_mix.at3 | 216 quadros | modo 1
msgctxt "12:2"
msgid "Of course. Love is recognizable by all who\n    see it, not just the ones in love.    "
msgstr "Claro. Todos reconhecem o amor quando o veem,\nmesmo quem não está apaixonado."

#. cv/btl/ner_1870_mix.at3 | 84 quadros | modo 1
msgctxt "12:3"
msgid "That is the true form of love."
msgstr "Essa é a verdadeira forma do amor."

#. cv/btl/ner_1870_mix.at3 | 254 quadros | modo 1
msgctxt "12:4"
msgid "It's something neither of us can truly have,\n    but it's certainly there, Meltlilith.    "
msgstr "Nenhuma de nós pode tê-lo de fato,\nmas ele existe, Meltlilith."

#. cv/btl/ner_1870_mix.at3 | 128 quadros | modo 1
msgctxt "12:5"
msgid "  Enough with the flowery words. I need  \nonly the person I love to see it my way."
msgstr "Chega de floreios. Só me importa\nque quem eu amo veja as coisas como eu."

#. cv/btl/ner_1870_mix.at3 | 100 quadros | modo 1
msgctxt "12:6"
msgid "Everyone else can just disappear!!"
msgstr "Todo o resto pode desaparecer!!"

#. cv/btl/rob_1520.at3 | 48 quadros | modo 1
msgctxt "13:0"
msgid "Am I losing my touch!?"
msgstr "Será que tô perdendo a prática!?"

#. cv/btl/gil_2000.at3 | 60 quadros | modo 1
msgctxt "14:0"
msgid "Well then, how should we proceed?"
msgstr "Pois bem, como prosseguiremos?"

#. cv/fld/eli_0103.at3 | 250 quadros | modo 2
msgctxt "15:0"
msgid "B77/W56/H80. I try various things to, um, make them bigger…"
msgstr "B77/C56/Q80. Tento de tudo pra, hum, aumentar…"

#. cv/fld/eli_0103.at3 | 82 quadros | modo 2
msgctxt "15:1"
msgid "W-what are you making me say!?"
msgstr "O-o que você tá me fazendo dizer!?"

#. cv/fld/gil_0600.at3 | 58 quadros | modo 1
msgctxt "16:0"
msgid "And we're back at our scuzzy hotel room…"
msgstr "E voltamos a este quarto de hotel imundo…"

#. se/eb_tam/18 | 32 quadros | modo 1
msgctxt "17:0"
msgid "I won't allow that～"
msgstr "Não vou deixar～"

#. se/eb_emi3/12 | 24 quadros | modo 1
msgctxt "18:0"
msgid "Seriously?"
msgstr "A sério?"

#. cv/btl/gil_2060.at3 | 104 quadros | modo 1
msgctxt "19:0"
msgid "You, enemy! Jump! Dance!"
msgstr "Tu, inimigo! Salta! Dança!"

#. cv/btl/emi_1621.at3 | 132 quadros | modo 1
msgctxt "20:0"
msgid "        That was dangerous.        \nPlease pay more attention, Master."
msgstr "Foi perigoso.\nPreste mais atenção, por favor."

#. cv/btl/emi_1211_edit.at3 | 27 quadros | modo 1
msgctxt "21:0"
msgid "Trace on!"
msgstr "Trace on!"

#. cv/fld/ner_0102.at3 | 230 quadros | modo 2
msgctxt "22:0"
msgid "42kg. Errrgh… When your body becomes the pinnacle of fine arts,"
msgstr "42 kg. Argh… Quando teu corpo é o auge das belas-artes,"

#. cv/fld/ner_0102.at3 | 168 quadros | modo 2
msgctxt "22:1"
msgid "having the masses asking you your weight is… well… *mumbles*…"
msgstr "ter o povo perguntando teu peso é… bem… *resmungos*…"

#. se/eb_ner/5 | 28 quadros | modo 1
msgctxt "23:0"
msgid "With beauty!"
msgstr "Com beleza!"

#. cv/btl/rob_1090.at3 | 32 quadros | modo 1
msgctxt "24:0"
msgid "Might as well enjoy this!"
msgstr "Vamos aproveitar, já que estamos aqui!"

#. cv/btl/rob_1753.at3 | 92 quadros | modo 1
msgctxt "25:0"
msgid "What the fuck is wrong with your body!?"
msgstr "Que porra tem de errado com seu corpo!?"

#. cv/btl/rob_1753.at3 | 60 quadros | modo 1
msgctxt "25:1"
msgid "If you're a human, then die like one!!"
msgstr "Se é humano, então morra como um!!"

#. cv/btl/ner_1211_edit.at3 | 40 quadros | modo 1
msgctxt "26:0"
msgid "Fountain of snakes!"
msgstr "Fonte de serpentes!"

#. cv/btl/sal_1800.at3 | 55 quadros | modo 1
msgctxt "27:0"
msgid "Welcome to my doll house!"
msgstr "Boas-vindas à minha casa de bonecas!"

#. cv/btl/sal_1090.at3 | 30 quadros | modo 1
msgctxt "28:0"
msgid "Welcome～ 鷙"
msgstr "Boas-vindas～鷙"

#. cv/btl/gil_1110.at3 | 34 quadros | modo 1
msgctxt "29:0"
msgid "If you insist!"
msgstr "Se tanto insistes!"

#. cv/btl/twi_1711.at3 | 146 quadros | modo 1
msgctxt "30:0"
msgid "       Defeat, huh? That's fine.       \nIt's a road I've walked many times now."
msgstr "Uma derrota, é? Tudo bem.\nJá trilhei esse caminho muitas vezes."

#. se/eb_emi3/3 | 28 quadros | modo 1
msgctxt "31:0"
msgid "That all you got?"
msgstr "É só isso que tem?"

#. cv/btl/gil_1621.at3 | 78 quadros | modo 1
msgctxt "32:0"
msgid "Fool! You almost killed me back there!"
msgstr "Idiota! Quase me mataste ali!"

#. cv/btl/gil_1612.at3 | 58 quadros | modo 1
msgctxt "33:0"
msgid "Hey. No injuries, right?"
msgstr "Ei. Sem ferimentos, certo?"

#. cv/btl/leo_1540.at3 | 40 quadros | modo 1
msgctxt "34:0"
msgid "But why won't she fall!?"
msgstr "Mas por que ela não cai!?"

#. cv/btl/twi_1210_edit.at3 | 46 quadros | modo 1
msgctxt "35:1"
msgid "Stay calm, Caster."
msgstr "Mantenha a calma, Caster."

#. cv/btl/eli_1757_mix.at3 | 298 quadros | modo 1
msgctxt "36:0"
msgid "How… Not even 10,000 African elephants could\nsurvive Lancer's horrid super tone-deaf song!"
msgstr "Como… Nem dez mil elefantes africanos\naguentariam a cantoria desafinada da Lancer!"

#. cv/btl/eli_1757_mix.at3 | 134 quadros | modo 1
msgctxt "36:1"
msgid "     No! That was my sonic dragon breath!     \nIt was a sonic wave, okay!? A supersonic WAVE!"
msgstr "Não! Era meu sopro sônico de dragão!\nUma onda sonora, tá!? Supersônica!"

#. se/eb_mks/12 | 30 quadros | modo 1
msgctxt "37:0"
msgid "How rude!"
msgstr "Que grosseria!"

#. cv/btl/gil_1201_edit.at3 | 66 quadros | modo 1
msgctxt "38:0"
msgid "That takes care of my upkeep.\nNow you can wield me freely."
msgstr "Isso cuida da minha manutenção.\nAgora podes me empunhar à vontade."

#. cv/btl/kia_1757_mix.at3 | 260 quadros | modo 1
msgctxt "39:0"
msgid "…I'm perplexed. It seems you need even greater\nstimulation or a more severe curse to give in…"
msgstr "…estou perplexa. Precisa de mais estímulo\nou de uma maldição mais forte para ceder…"

#. cv/btl/kia_1757_mix.at3 | 42 quadros | modo 1
msgctxt "39:1"
msgid "What are you saying?"
msgstr "Do que você está falando?"

#. cv/btl/kia_1757_mix.at3 | 76 quadros | modo 1
msgctxt "39:2"
msgid "You're the one who can only get off when\n      tightly bound in coarse rope!      "
msgstr "Você é que só goza\ncom uma corda grossa te apertando!"

#. cv/btl/kot_1510.at3 | 31 quadros | modo 1
msgctxt "40:0"
msgid "Well done."
msgstr "Muito bem."

#. cv/btl/ner_1101.at3 | 48 quadros | modo 1
msgctxt "41:0"
msgid "I'll return your faith in me!"
msgstr "Farei jus à tua confiança!"

#. cv/btl/emi_1745.at3 | 128 quadros | modo 1
msgctxt "42:0"
msgid " She's a bit degraded in strength, \nbut that's definitely still Caster."
msgstr "Perdeu um pouco da força,\nmas é a Caster, sem dúvida."

#. cv/btl/emi_1745.at3 | 40 quadros | modo 1
msgctxt "42:1"
msgid "Don't let your guard down, Master."
msgstr "Mantenha a guarda."

#. cv/btl/mll_1301_edit.at3 | 108 quadros | modo 1
msgctxt "43:0"
msgid "Will the troublemakers please leave the stage?"
msgstr "Quem está atrapalhando pode sair do palco?"

#. cv/btl/mll_1301_edit.at3 | 74 quadros | modo 1
msgctxt "43:2"
msgid "Now, resign yourself to the frigid depths."
msgstr "Agora, resigne-se às profundezas geladas."

#. cv/btl/mll_1301_edit.at3 | 64 quadros | modo 1
msgctxt "43:4"
msgid "Saraswati Meltout."
msgstr "Saraswati Meltout."

#. cv/btl/ner_1271a_edit.at3 | 54 quadros | modo 1
msgctxt "44:1"
msgid "Let me confess my inner feelings…"
msgstr "Deixa-me confessar o que sinto…"

#. cv/btl/ner_1271a_edit.at3 | 38 quadros | modo 1
msgctxt "44:3"
msgid "To put it simply…"
msgstr "Em poucas palavras…"

#. cv/btl/ner_1271a_edit.at3 | 80 quadros | modo 1
msgctxt "44:5"
msgid "I love you, Praetor!!"
msgstr "Eu te amo, Maestro!!"

#. cv/btl/mll_1230_edit.at3 | 100 quadros | modo 1
msgctxt "45:1"
msgid "I'll melt you from the inside out,\n         nice and slowly.         "
msgstr "Vou derreter você de dentro pra fora,\nbem devagar."

#. cv/btl/mll_1230_edit.at3 | 34 quadros | modo 1
msgctxt "45:3"
msgid "Feels good, right?"
msgstr "É gostoso, não é?"

#. cv/btl/mll_1700.at3 | 48 quadros | modo 1
msgctxt "46:0"
msgid "Struggle to your heart's content."
msgstr "Debata-se o quanto quiser."

#. cv/btl/sin_1711.at3 | 52 quadros | modo 1
msgctxt "47:0"
msgid "Hey hey, no need to be so rough, okay!?"
msgstr "Ei, ei, pega leve, tá!?"

#. cv/btl/cuu_1301_edit.at3 | 118 quadros | modo 1
msgctxt "48:1"
msgid "Your heart shall be pierced, and\n     the strike is certain!     "
msgstr "Seu coração será perfurado.\nEste golpe não falha!"

#. cv/btl/cuu_1301_edit.at3 | 56 quadros | modo 1
msgctxt "48:2"
msgid "Gáe Bolg!"
msgstr "Gáe Bolg!"

#. cv/btl/emi3_1270_edit.at3 | 74 quadros | modo 1
msgctxt "49:0"
msgid "Can you withstand a fragment of\n  the true holy sword's power?  "
msgstr "Aguenta uma fração do poder\nda verdadeira espada sagrada?"

#. cv/btl/emi3_1270_edit.at3 | 38 quadros | modo 1
msgctxt "49:2"
msgid "Excalibur Image!"
msgstr "Excalibur Image!"

#. cv/btl/psl_1756.at3 | 116 quadros | modo 1
msgctxt "50:0"
msgid "Soon… soon…"
msgstr "Logo… logo…"

#. cv/btl/psl_1756.at3 | 82 quadros | modo 1
msgctxt "50:1"
msgid "Just a little longer… and it'll all be over."
msgstr "Só mais um pouquinho… e tudo vai acabar."

#. cv/btl/emi3_1200_edit.at3 | 24 quadros | modo 1
msgctxt "51:0"
msgid "Set."
msgstr "Pronto."

#. cv/fld/psl_0101.at3 | 174 quadros | modo 2
msgctxt "52:0"
msgid "156cm. I'm the same height as my mom,"
msgstr "156 cm. Tenho a mesma altura da mamãe,"

#. cv/fld/psl_0101.at3 | 96 quadros | modo 2
msgctxt "52:1"
msgid "but my heels may make me look slightly taller."
msgstr "mas meus saltos talvez me façam parecer mais alta."

#. se/eb_kia/9 | 24 quadros | modo 1
msgctxt "53:0"
msgid "Shame!"
msgstr "Que vergonha!"

#. cv/btl/elp_1250_edit.at3 | 82 quadros | modo 1
msgctxt "54:0"
msgid "I'm ready to go! Target acquired!"
msgstr "Estou pronta! Alvo na mira!"

#. cv/btl/elp_1250_edit.at3 | 66 quadros | modo 1
msgctxt "54:2"
msgid "You were SUPPOSED to squeal like a pig!"
msgstr "Era pra guinchar feito porquinho!"

#. se/eb_emi/27 | 25 quadros | modo 1
msgctxt "55:0"
msgid "How!?"
msgstr "Como!?"

#. cv/btl/tam3_1520.at3 | 36 quadros | modo 1
msgctxt "56:0"
msgid "Master, hang in there!"
msgstr "Aguente firme, meu bem!"

#. cv/btl/jin_1520.at3 | 68 quadros | modo 1
msgctxt "57:0"
msgid "Uwaaa!! Don't die, Karna!!"
msgstr "Aaaaah!! Não morre, Karna!!"

#. cv/fld/kot_00919.at3 | 26 quadros | modo 3
msgctxt "58:0"
msgid "Very well."
msgstr "Muito bem."

#. cv/btl/gil_1805.at3 | 104 quadros | modo 1
msgctxt "59:0"
msgid "    Let's begin. You should know    \nhow I like to take my battles by now."
msgstr "Vamos começar. Já devias saber\ncomo gosto de lutar."

#. cv/btl/emi3_1120.at3 | 36 quadros | modo 1
msgctxt "60:0"
msgid "Seems we didn't take this seriously enough."
msgstr "Parece que não levamos isso a sério."

#. cv/btl/tam_1093.at3 | 28 quadros | modo 1
msgctxt "61:0"
msgid "Leave it to me 鷙!"
msgstr "Deixe comigo鷙!"

#. cv/btl/gil_1713.at3 | 82 quadros | modo 1
msgctxt "62:0"
msgid "There will be a chance to heal.\n      Hold out until then!      "
msgstr "Teremos chance de nos curar.\nAguenta até lá!"

#. se/eb_tam/8 | 25 quadros | modo 1
msgctxt "63:0"
msgid "Let's do it!"
msgstr "Mãos à obra!"

#. cv/btl/gaw2_1701.at3 | 72 quadros | modo 1
msgctxt "64:0"
msgid "    Please don't resist.    \nPay what is owed, fair lady."
msgstr "Por favor, não resista.\nPague o que deve, gentil dama."

#. cv/btl/gil_1250_edit.at3 | 60 quadros | modo 1
msgctxt "65:1"
msgid "This is more than a pest like you deserves!"
msgstr "Isso é mais do que uma praga como tu merece!"

#. cv/btl/gil_1250_edit.at3 | 38 quadros | modo 1
msgctxt "65:3"
msgid "I'll rip you to pieces!!"
msgstr "Vou te despedaçar!!"

#. cv/btl/emi3_1752_mix_a.at3 | 174 quadros | modo 1
msgctxt "66:0"
msgid "Archer, do that thing! You know, the whole\n    \"I am the bone of my sword\" thing!    "
msgstr "Archer, faz aquilo! Sabe,\naquela do “sou o osso da minha espada”!"

#. cv/btl/emi3_1752_mix_a.at3 | 112 quadros | modo 1
msgctxt "66:1"
msgid "You know, I'm suddenly feeling unmotivated…"
msgstr "Sabe, de repente perdi a vontade…"

#. cv/fld/gil_0106.at3 | 140 quadros | modo 2
msgctxt "67:0"
msgid "Beginning or end of the year, pick whichever you prefer."
msgstr "Começo ou fim do ano. Escolhe o que preferires."

#. cv/btl/tam_2030.at3 | 68 quadros | modo 1
msgctxt "68:0"
msgid "This outfit really feels the most natural."
msgstr "Com esse traje, me sinto mais à vontade."

#. cv/btl/ner_2001.at3 | 36 quadros | modo 1
msgctxt "69:0"
msgid "Think carefully about your orders."
msgstr "Pensa bem nas tuas ordens."

#. cv/btl/gil_1250b_edit.at3 | 38 quadros | modo 1
msgctxt "70:1"
msgid "I'll rip you to pieces!!"
msgstr "Vou te despedaçar!!"

#. cv/btl/gil_1250b_edit.at3 | 60 quadros | modo 1
msgctxt "70:3"
msgid "This is more than a pest like you deserves!"
msgstr "Isso é mais do que uma praga como tu merece!"

#. se/eb_tam/21 | 30 quadros | modo 1
msgctxt "71:0"
msgid "Swift is Heaven's vengeance!"
msgstr "A vingança dos céus não tarda!"

#. cv/btl/ner_1620.at3 | 106 quadros | modo 1
msgctxt "72:0"
msgid "What? Don't you have something to say?"
msgstr "Que foi? Não tens nada a dizer?"

#. cv/fld/mll_0107.at3 | 64 quadros | modo 2
msgctxt "73:0"
msgid "A fetish for screams."
msgstr "Um fetiche por gritos."

#. cv/fld/mll_0107.at3 | 90 quadros | modo 2
msgctxt "73:1"
msgid "The way the shame and disgrace screeches out of the heart"
msgstr "A vergonha e a humilhação gritando do fundo do coração"

#. cv/fld/mll_0107.at3 | 80 quadros | modo 2
msgctxt "73:2"
msgid "as you squeeze and squeeze… I can't get enough～"
msgstr "enquanto você aperta e aperta… Nunca me canso～"

#. cv/fld/mll_0107.at3 | 86 quadros | modo 2
msgctxt "73:3"
msgid "Just hearing that wonderful sound makes me melt  鷙"
msgstr "Só de ouvir esse som maravilhoso, eu derreto鷙"

#. cv/btl/jin_1700.at3 | 80 quadros | modo 1
msgctxt "74:0"
msgid "Do remember I'm the Western Europe\n        game champion～!        "
msgstr "Só pra lembrar, sou a campeã gamer\nda Europa Ocidental～"

#. cv/btl/gil_1113.at3 | 52 quadros | modo 1
msgctxt "75:0"
msgid "Hmph. This one won't make it!"
msgstr "Humph. Este não vai longe!"

#. cv/btl/gil_2040.at3 | 74 quadros | modo 1
msgctxt "76:0"
msgid "Seems they don't know how to act\n        while on holiday.        "
msgstr "Parece que não sabem se portar nas férias."

#. cv/btl/gil_1705.at3 | 140 quadros | modo 1
msgctxt "77:0"
msgid "Holy Grail War, huh? This has been a\n  surprisingly entertaining battle!  "
msgstr "Guerra do Santo Graal, hein?\nAté que esta luta foi divertida!"

#. cv/fld/mks_0105.at3 | 150 quadros | modo 2
msgctxt "78:0"
msgid "The perfect and flawless BB has no weak points!"
msgstr "A BB, perfeita e impecável, não tem pontos fracos!"

#. cv/fld/mks_0105.at3 | 126 quadros | modo 2
msgctxt "78:1"
msgid "If I had to name *something*, it'd be you, Senpai."
msgstr "Se eu precisasse citar *algo*, seria você, Senpai."

#. cv/btl/gil_1241_edit.at3 | 50 quadros | modo 1
msgctxt "79:0"
msgid "I won't demand suicide of you."
msgstr "Não exigirei que tires a própria vida."

#. cv/btl/gil_1241_edit.at3 | 64 quadros | modo 1
msgctxt "79:2"
msgid "I'll finish you off myself!"
msgstr "Eu mesmo acabarei contigo!"

#. cv/fld/emi_0107.at3 | 158 quadros | modo 2
msgctxt "80:0"
msgid "I don't remember. When I became a Heroic Spirit,"
msgstr "Não lembro. Quando me tornei um Espírito Heroico,"

#. cv/fld/emi_0107.at3 | 72 quadros | modo 2
msgctxt "80:1"
msgid "I threw away my past life anyway."
msgstr "deixei para trás a minha vida anterior."

#. cv/btl/ner_1810_mix.at3 | 58 quadros | modo 1
msgctxt "81:0"
msgid "Prepare yourself, Rin."
msgstr "Prepara-te, Rin."

#. cv/btl/ner_1810_mix.at3 | 178 quadros | modo 1
msgctxt "81:2"
msgid "My Praetor and I shall trim off\n  all that flab you've put on!  "
msgstr "Meu Maestro e eu vamos tirar\nessa gordura que acumulaste!"

#. cv/btl/ner_1810_mix.at3 | 70 quadros | modo 1
msgctxt "81:4"
msgid "The only thing gone flabby is my wallet!"
msgstr "Só uma coisa ficou murcha: minha carteira!"

#. cv/btl/ner_1810_mix.at3 | 78 quadros | modo 1
msgctxt "81:5"
msgid "Lancer, no need to hold back."
msgstr "Lancer, não precisa se conter."

#. cv/btl/ner_1810_mix.at3 | 68 quadros | modo 1
msgctxt "81:6"
msgid "Go put that peppy little Saber down!"
msgstr "Vai lá botar essa Saber animadinha no chão!"

#. cv/btl/ner_1810_mix.at3 | 56 quadros | modo 1
msgctxt "81:8"
msgid "You don't need to tell me twice. "
msgstr "Não precisa dizer duas vezes."

#. cv/btl/ner_1810_mix.at3 | 186 quadros | modo 1
msgctxt "81:9"
msgid "That Servant's just my type of snack.\n  I'll be sure to savor the taste～  "
msgstr "Esse Servo é o meu tipo de lanche.\nVou saborear bem～"

#. cv/fld/ran_0104.at3 | 138 quadros | modo 2
msgctxt "82:0"
msgid "Titan's Pit in the mountains of Egypt."
msgstr "O Fosso do Titã, nas montanhas do Egito."

#. cv/fld/ran_0104.at3 | 72 quadros | modo 2
msgctxt "82:1"
msgid "I was created at the Atlas Institute there."
msgstr "Fui criada no Instituto Atlas, que fica lá."

#. cv/btl/emi_1714.at3 | 52 quadros | modo 1
msgctxt "83:0"
msgid "I see you're still lacking in experience."
msgstr "Vejo que ainda lhe falta experiência."

#. se/eb_eli/4 | 26 quadros | modo 1
msgctxt "84:0"
msgid "Take that!"
msgstr "Toma!"

#. se/eb_tam/22 | 36 quadros | modo 1
msgctxt "85:0"
msgid "You're joking, right?"
msgstr "Tá brincando, né?"

#. cv/btl/mll_1958.at3 | 190 quadros | modo 1
msgctxt "86:0"
msgid "In your eyes glows a dim hope…\n      Hehehe. I like it.      "
msgstr "Uma esperança tênue brilha nos seus olhos…\nHehehe. Gostei."

#. cv/btl/mll_1958.at3 | 108 quadros | modo 1
msgctxt "86:1"
msgid "I'll rip you along with that hope to shreds!"
msgstr "Vou despedaçar você e essa esperança!"

#. cv/btl/ner_1610.at3 | 72 quadros | modo 1
msgctxt "87:0"
msgid "Mhm. We can work a bit harder next time."
msgstr "Umu. Podemos nos esforçar mais da próxima vez."

#. cv/btl/tam_1300_edit.at3 | 174 quadros | modo 1
msgctxt "88:1"
msgid "  This is my land, the lands of the gods. The  \nwater is blessed and the harvest is bountiful."
msgstr "Esta é minha terra, a terra dos deuses.\nÁguas abençoadas, colheitas fartas."

#. cv/btl/tam_1300_edit.at3 | 62 quadros | modo 1
msgctxt "88:2"
msgid "This middle-earth pours a watery\n      sunlight into a void,      "
msgstr "Neste mundo de cá, a luz do sol se derrama\nqual água sobre o vazio,"

#. cv/btl/tam_1300_edit.at3 | 80 quadros | modo 1
msgctxt "88:3"
msgid "where it flows around the heavens,\n   flows around the underworld,   "
msgstr "contorna os céus,\npercorre o mundo dos mortos,"

#. cv/btl/tam_1300_edit.at3 | 66 quadros | modo 1
msgctxt "88:4"
msgid "flows and flows all about."
msgstr "corre e corre por toda parte."

#. cv/btl/tam_1300_edit.at3 | 116 quadros | modo 1
msgctxt "88:5"
msgid "Over these lands between I shine."
msgstr "E sobre estas terras entre os mundos, eu brilho."

#. cv/btl/tam_1300_edit.at3 | 132 quadros | modo 1
msgctxt "88:6"
msgid "       Linked are the grand loops,       \nthe illuminating nine layers of heaven…!"
msgstr "Unem-se os grandes círculos,\nas nove camadas de luz do céu…!"

#. cv/btl/tam_1300_edit.at3 | 88 quadros | modo 1
msgctxt "88:7"
msgid "Eightfold Blessing of Amaterasu!"
msgstr "Bênção Óctupla de Amaterasu!"

#. cv/fld/kot_00920.at3 | 74 quadros | modo 3
msgctxt "89:0"
msgid "I'm glad I could be of service."
msgstr "Fico feliz por ter ajudado."

#. cv/fld/psl_0102b.at3 | 28 quadros | modo 2
msgctxt "90:0"
msgid "that much??"
msgstr "tudo isso??"

#. cv/btl/rob_1710.at3 | 92 quadros | modo 1
msgctxt "91:0"
msgid "Jeez, it's much harder when you're alone…"
msgstr "Nossa, sem ninguém pra ajudar é bem pior…"

#. cv/btl/gil_1600.at3 | 80 quadros | modo 1
msgctxt "92:0"
msgid "That was my expectation for you.\n    You won't get any praise.    "
msgstr "Era o que eu esperava de ti.\nNão esperes elogios."

#. cv/btl/ksk_1400.at3 | 98 quadros | modo 1
msgctxt "93:0"
msgid "Aaa―AAAAAAAAAAAHH!!"
msgstr "Aaa―AAAAAAAAAAAHH!!"

#. se/eb_emi3/6 | 28 quadros | modo 1
msgctxt "94:0"
msgid "You move like a turtle!"
msgstr "Você é lento feito tartaruga!"

#. se/eb_ner/17 | 31 quadros | modo 1
msgctxt "95:0"
msgid "How unelegant."
msgstr "Que falta de elegância."

#. cv/btl/gil_1830_mix.at3 | 100 quadros | modo 1
msgctxt "96:0"
msgid "Move… Please move…"
msgstr "Saiam… Por favor, saiam do caminho…"

#. cv/btl/gil_1830_mix.at3 | 136 quadros | modo 1
msgctxt "96:2"
msgid "If I'm finally human like you said, then\n         stay out of my way…!         "
msgstr "Se enfim sou humana, como disseste,\nentão sai da minha frente…!"

#. cv/btl/gil_1830_mix.at3 | 70 quadros | modo 1
msgctxt "96:3"
msgid "You seem to have misunderstood me."
msgstr "Parece que me entendeste mal."

#. cv/btl/gil_1830_mix.at3 | 156 quadros | modo 1
msgctxt "96:4"
msgid "What I recognized as human was your love,\n            not you yourself.            "
msgstr "Reconheci como humano o teu amor.\nQuanto a ti, é outra questão."

#. cv/btl/gil_1830_mix.at3 | 164 quadros | modo 1
msgctxt "96:5"
msgid "If you wish to truly become one―then splendid!\n       Prove your worth by defeating me!       "
msgstr "Queres mesmo te tornar humana? Esplêndido!\nProva teu valor derrotando-me!"

#. cv/fld/eli_0202.at3 | 140 quadros | modo 2
msgctxt "97:0"
msgid "Recovering from fatigue with a relaxing bath."
msgstr "Aliviar o cansaço com um banho relaxante."

#. cv/fld/eli_0202.at3 | 124 quadros | modo 2
msgctxt "97:1"
msgid "Maintaining my beauty is a laborious task～"
msgstr "Manter minha beleza dá um trabalhão～"

#. cv/btl/emi_1705.at3 | 74 quadros | modo 1
msgctxt "98:0"
msgid "Okay. I'm counting on you to watch my back."
msgstr "Certo. Conto com você pra\ncobrir minha retaguarda."

#. cv/btl/ner_1201_edit.at3 | 44 quadros | modo 1
msgctxt "99:0"
msgid "Fountain of flames!"
msgstr "Fonte de chamas!"

#. se/eb_elp/11 | 24 quadros | modo 1
msgctxt "100:0"
msgid "How could you!?"
msgstr "Como pôde!?"

#. cv/btl/tam_2040.at3 | 190 quadros | modo 1
msgctxt "101:0"
msgid "Hehehe, feast your eyes upon me! A true beauty\n       can kill with just her curves～       "
msgstr "Hehehe, pode admirar! Uma beldade de\nverdade mata só com suas curvas～"

#. cv/btl/rob_1958.at3 | 172 quadros | modo 1
msgctxt "102:0"
msgid "Well, let's cut the chatter there. Though\n    this situation is like treasure;    "
msgstr "Bom, chega de papo.\nEssa situação é como um tesouro:"

#. cv/btl/rob_1958.at3 | 120 quadros | modo 1
msgctxt "102:1"
msgid "the more you want to talk about it,\n         the less you can.         "
msgstr "quanto mais você quer contar,\nmenos pode falar."

#. cv/btl/tam_1860_mix.at3 | 166 quadros | modo 1
msgctxt "103:0"
msgid "By the way, are there other kinds of hunk-mon\nout there? Like are there legendary hunk-mon?"
msgstr "A propósito, tem outros tipos de galã-mon?\nTipo, galãs-mon lendários?"

#. cv/btl/tam_1860_mix.at3 | 200 quadros | modo 1
msgctxt "103:1"
msgid "Of course! There's the darkness type Seimei\n      or the musclehead type Golden.      "
msgstr "Claro! Tem o Seimei, do tipo sombrio,\nou o Golden, do tipo marombeiro."

#. cv/btl/tam_1860_mix.at3 | 92 quadros | modo 1
msgctxt "103:2"
msgid "  Well, even if they aren't jerks,  \nI still don't want to capture them."
msgstr "Bom, mesmo que não sejam babacas,\nainda não quero capturá-los."

#. cv/btl/tam_1860_mix.at3 | 222 quadros | modo 1
msgctxt "103:3"
msgid "Hahaha. It might be a bit late to retort now,\n  but *wow* you just live in your own world.  "
msgstr "Hahaha. Meio tarde pra dizer isso, mas,\nnossa, você vive num mundo só seu."

#. cv/btl/kar_1700.at3 | 54 quadros | modo 1
msgctxt "104:0"
msgid "What's wrong, thinking about surrendering?"
msgstr "O que houve? Pensando em se render?"

#. cv/fld/eli_0200.at3 | 178 quadros | modo 2
msgctxt "105:0"
msgid "Social standing, lineage, work, hobbies, those sorts of things."
msgstr "Posição social, linhagem, trabalho, hobbies, essas coisas."

#. cv/fld/eli_0200.at3 | 128 quadros | modo 2
msgctxt "105:1"
msgid "But standing above all is the heartthrobbing call of fate～ 鷙"
msgstr "Acima de tudo, o chamado do destino que acelera o coração～鷙"

#. cv/btl/emi_1730.at3 | 114 quadros | modo 1
msgctxt "106:0"
msgid "My preparations are complete.\n  Can you keep up, Master?  "
msgstr "Tudo pronto da minha parte.\nConsegue acompanhar?"

#. cv/btl/emi_2021.at3 | 152 quadros | modo 1
msgctxt "107:0"
msgid "Hmph. I turn nasty when I wear this outfit.\n            I'm going in HARD!            "
msgstr "Humph. Com esta roupa, eu fico cruel.\nVou atacar com tudo!"

#. cv/btl/tam_1820_mix.at3 | 76 quadros | modo 1
msgctxt "108:0"
msgid "Your quest for eternal youth ends here!"
msgstr "Sua busca pela eterna juventude acaba aqui!"

#. cv/btl/tam_1820_mix.at3 | 106 quadros | modo 1
msgctxt "108:1"
msgid "Now get into that iron maiden\n      where you belong!      "
msgstr "Agora entre nessa dama de ferro,\nque é o seu lugar!"

#. cv/btl/tam_1820_mix.at3 | 146 quadros | modo 1
msgctxt "108:2"
msgid "Make me if you think you can. Spikes are\n          my thing, you know.          "
msgstr "Me obrigue, se puder.\nEspinhos são comigo mesmo, viu?"

#. cv/btl/tam_1820_mix.at3 | 140 quadros | modo 1
msgctxt "108:3"
msgid "After I drain your blood, I'll make a nice\n          stuffed fox out of you.          "
msgstr "Depois que drenar seu sangue,\nvou empalhar essa bela raposa."

#. cv/btl/tam_1820_mix.at3 | 74 quadros | modo 1
msgctxt "108:4"
msgid "The iron maiden does not have a\n      feature like that…      "
msgstr "A dama de ferro não faz isso…"

#. se/eb_tam/20 | 24 quadros | modo 1
msgctxt "109:0"
msgid "Exciting!"
msgstr "Que emoção!"

#. cv/btl/sin_1701.at3 | 54 quadros | modo 1
msgctxt "110:0"
msgid "You better surrender while you\n       have the chance.       "
msgstr "É melhor se render enquanto pode."

#. cv/btl/emi_1850_mix.at3 | 172 quadros | modo 1
msgctxt "111:0"
msgid "What's wrong with living how I want to!?\n         My beauty is absolute!         "
msgstr "Qual é o problema de viver como eu quero!?\nMinha beleza é absoluta!"

#. cv/btl/emi_1850_mix.at3 | 116 quadros | modo 1
msgctxt "111:1"
msgid "Maybe you guys who don't understand are\n        the real villains here!        "
msgstr "Talvez os verdadeiros vilões aqui\nsejam vocês, que não entendem nada!"

#. cv/btl/emi_1850_mix.at3 | 186 quadros | modo 1
msgctxt "111:2"
msgid "Sadly, I've always been a bit unfamiliar with\n    the arts. Your, um, what's the word…    "
msgstr "Infelizmente, nunca entendi muito de arte.\nEssa sua… como é que se diz…"

#. cv/btl/emi_1850_mix.at3 | 90 quadros | modo 1
msgctxt "111:3"
msgid "Cubism aesthetics? I don't really get them."
msgstr "Estética cubista? Não entendo muito."

#. cv/btl/emi_1850_mix.at3 | 178 quadros | modo 1
msgctxt "111:4"
msgid "I-I don't know anything about that either!\n    My cuteness has normal aesthetics!    "
msgstr "T-também não sei nada disso!\nMinha fofura segue uma estética normal!"

#. cv/btl/kar_1081.at3 | 24 quadros | modo 1
msgctxt "112:0"
msgid "Gah…!"
msgstr "Argh…!"

#. se/eb_rob/9 | 30 quadros | modo 1
msgctxt "113:0"
msgid "Pick up the pace!"
msgstr "Acelere o passo!"

#. cv/btl/el2_1510.at3 | 52 quadros | modo 1
msgctxt "114:0"
msgid "My head feels like it's splitting open…!"
msgstr "Minha cabeça parece que vai rachar…!"

#. cv/fld/eli_0201.at3 | 132 quadros | modo 2
msgctxt "115:0"
msgid "Hehe～ Only the top style of the entertainment world would do."
msgstr "Hehe～ Só aceito o melhor estilo do mundo do espetáculo."

#. cv/fld/eli_0201.at3 | 98 quadros | modo 2
msgctxt "115:1"
msgid "So naturally for a top idol, stripes is where it's at!"
msgstr "Uma idol de primeira, claro, tem que usar listras!"

#. cv/btl/gaw_1300_edit.at3 | 80 quadros | modo 1
msgctxt "116:1"
msgid "Night shrinks before this radiance!"
msgstr "A noite recua diante deste fulgor!"

#. cv/btl/gaw_1300_edit.at3 | 90 quadros | modo 1
msgctxt "116:2"
msgid "Purger of vanity; holy sword of the stars―"
msgstr "Espada sagrada das estrelas,\nque expurga a vaidade―"

#. cv/btl/gaw_1300_edit.at3 | 84 quadros | modo 1
msgctxt "116:3"
msgid "Excalibur Galatine!"
msgstr "Excalibur Galatine!"

#. cv/btl/ner_1241_edit.at3 | 54 quadros | modo 1
msgctxt "117:0"
msgid "I'll help you understand the\n    error of your ways!    "
msgstr "Vou te fazer entender o teu erro!"

#. cv/btl/tam_2003.at3 | 50 quadros | modo 1
msgctxt "118:0"
msgid "How should I torment you～"
msgstr "Como será que eu vou te atormentar～"

#. se/eb_gil/20 | 36 quadros | modo 1
msgctxt "119:0"
msgid "How brave of you!"
msgstr "Que coragem a tua!"

#. cv/btl/rin2_1530.at3 | 33 quadros | modo 1
msgctxt "120:0"
msgid "As expected."
msgstr "Como esperado."

#. cv/fld/tam_0200.at3 | 78 quadros | modo 2
msgctxt "121:0"
msgid "You don't have to worry, dear."
msgstr "Pode ficar sem preocupação, amor."

#. cv/fld/tam_0200.at3 | 140 quadros | modo 2
msgctxt "121:1"
msgid "My role of being a good wife is to support my Darling 鷙"
msgstr "Como boa esposa, meu papel é\ndar apoio ao meu bem 鷙"

#. cv/fld/kot_00918.at3 | 38 quadros | modo 3
msgctxt "122:0"
msgid "Shall I warm that up for you?"
msgstr "Quer que eu esquente?"

#. cv/btl/jin_1210_edit.at3 | 110 quadros | modo 1
msgctxt "123:0"
msgid "Okay… *tap* *tap* *tap*.. No shilling!"
msgstr "Beleza… *tec* *tec* *tec*… Sem jabá!"

#. cv/fld/mks_0103.at3 | 276 quadros | modo 2
msgctxt "124:0"
msgid "B85/W56/H87. Oh dear, I can feel Senpai's burning gaze from here～"
msgstr "B85/C56/Q87. Ai, já sinto seu olhar ardente daqui, Senpai～"

#. cv/btl/mks_1220_edit.at3 | 95 quadros | modo 1
msgctxt "125:0"
msgid "Okay! Sakura Beaaaam!! 鷙"
msgstr "Certo! Raio da Sakuraaaa!!鷙"

#. se/eb_gil/18 | 35 quadros | modo 1
msgctxt "126:0"
msgid "Don't make me laugh!"
msgstr "Não me faça rir!"

#. cv/btl/kar_1757_mix.at3 | 102 quadros | modo 1
msgctxt "127:0"
msgid "Diverting my blade is no easy feat.\n            Impressive.            "
msgstr "Desviar minha lâmina não é nada fácil.\nImpressionante."

#. cv/btl/kar_1757_mix.at3 | 136 quadros | modo 1
msgctxt "127:1"
msgid "You're just covering up the fact that you\nmissed, Karna! Don't try and look cool!!"
msgstr "Você só tá disfarçando que errou, Karna!\nPara de pagar de foda!!"

#. cv/btl/el2_1751.at3 | 64 quadros | modo 1
msgctxt "128:0"
msgid "You're just a damn piggy…!"
msgstr "Você é só um porquinho maldito…!"

#. cv/btl/el2_1751.at3 | 70 quadros | modo 1
msgctxt "128:1"
msgid "Worthless livestock…!"
msgstr "Rebanho inútil…!"

#. cv/btl/el2_1751.at3 | 80 quadros | modo 1
msgctxt "128:2"
msgid "YOU'RE ONLY FIT TO BE MY FOOD!!"
msgstr "Você SÓ SERVE DE COMIDA!!"

#. cv/btl/emi_1501.at3 | 29 quadros | modo 1
msgctxt "129:0"
msgid "Not bad."
msgstr "Nada mal."

#. cv/fld/tam_0105.at3 | 188 quadros | modo 2
msgctxt "130:0"
msgid "Tamamo's, kind of shy, about, her tail? 鷙"
msgstr "Tamamo tem um pouquinho de, bem,\nvergonha do rabo. 鷙"

#. cv/fld/tam_0105.at3 | 126 quadros | modo 2
msgctxt "130:1"
msgid "Before you fluff it, please declare \"I'm gonna eat you!\""
msgstr "Antes de afofar, diga:\n“Vou te devorar!”"

#. cv/btl/twi_1200_edit.at3 | 46 quadros | modo 1
msgctxt "131:0"
msgid "Try this on for size."
msgstr "Que tal experimentar isso?"

#. cv/btl/jin_1521.at3 | 52 quadros | modo 1
msgctxt "132:0"
msgid "This isn't just another game!!"
msgstr "Isso aqui não é só mais um jogo!!"

#. cv/btl/tam_1111.at3 | 25 quadros | modo 1
msgctxt "133:0"
msgid "No running away!"
msgstr "Nada de fugir!"

#. cv/btl/eli_1400.at3 | 46 quadros | modo 1
msgctxt "134:0"
msgid "No… way…"
msgstr "Não… pode ser…"

#. cv/btl/kia_1521.at3 | 56 quadros | modo 1
msgctxt "135:0"
msgid "Ahh… I can't get enough of this!"
msgstr "Ahh… Nunca me canso disso!"

#. cv/btl/emi_1803.at3 | 48 quadros | modo 1
msgctxt "136:0"
msgid "Time to live up to your expectations."
msgstr "Hora de corresponder às expectativas."

#. cv/fld/kia_0105.at3 | 172 quadros | modo 2
msgctxt "137:0"
msgid "Anywhere on my soft, fair skin. I tremble at the slightest touch."
msgstr "Em qualquer ponto da pele clara e macia. Estremeço ao menor toque."

#. cv/fld/kia_0105.at3 | 118 quadros | modo 2
msgctxt "137:1"
msgid "Don't be shy; help yourself to any part of me鷙"
msgstr "Sem timidez. Sirva-se de qualquer parte de mim鷙"

#. se/eb_ner/20 | 48 quadros | modo 1
msgctxt "138:0"
msgid "I-I won't cry over this!"
msgstr "N-não vou chorar por isso!"

#. cv/btl/tam_1510.at3 | 42 quadros | modo 1
msgctxt "139:0"
msgid "I-I'm gonna die!!"
msgstr "E-eu vou morrer!!"

#. cv/btl/mks_1090.at3 | 36 quadros | modo 1
msgctxt "140:0"
msgid "Looks like it's my turn!"
msgstr "Parece que é a minha vez!"

#. cv/fld/emi_0631.at3 | 79 quadros | modo 1
msgctxt "141:0"
msgid "Behold! Gaze upon my well-sculped body!"
msgstr "Contemple! Veja este corpo esculpido!"

#. se/eb_tam/19 | 24 quadros | modo 1
msgctxt "142:0"
msgid "Returning the favor!"
msgstr "Devolvendo o favor!"

#. cv/btl/gil_1610.at3 | 54 quadros | modo 1
msgctxt "143:0"
msgid "That didn't even wake me up."
msgstr "Isso nem chegou a me despertar."

#. cv/btl/cuu_1751_mix.at3 | 154 quadros | modo 1
msgctxt "144:0"
msgid "They're stronger than I expected.\nWant some advice from me, Lancer?"
msgstr "São mais fortes do que eu esperava.\nQuer um conselho, Lancer?"

#. cv/btl/cuu_1751_mix.at3 | 106 quadros | modo 1
msgctxt "144:1"
msgid "Stow it. I'll turn this around, so just\n          shut up and watch.          "
msgstr "Poupa a conversa. Eu viro esse jogo.\nCala a boca e olha."

#. se/eb_gil/13 | 32 quadros | modo 1
msgctxt "145:0"
msgid "I'll run you through!"
msgstr "Vou te atravessar!"

#. cv/btl/kar_1090.at3 | 24 quadros | modo 1
msgctxt "146:0"
msgid "Well met…!"
msgstr "Belo encontro…!"

#. cv/btl/kot_1520.at3 | 35 quadros | modo 1
msgctxt "147:0"
msgid "Are you okay, Lancer?"
msgstr "Está bem, Lancer?"

#. cv/fld/kot_00924.at3 | 58 quadros | modo 3
msgctxt "148:0"
msgid "Make sure to have your wallet ready at all times."
msgstr "Tenha sempre a carteira à mão."

#. cv/btl/adl_1751.at3 | 88 quadros | modo 1
msgctxt "149:0"
msgid "Shameful. Don't be a laughingstock, Kiara."
msgstr "Que vergonha. Não passe ridículo, Kiara."

#. cv/btl/emi_1910_mix.at3 | 90 quadros | modo 1
msgctxt "150:0"
msgid "To think Kotomine the priest was a Master."
msgstr "Quem diria que o padre Kotomine era Mestre."

#. cv/btl/emi_1910_mix.at3 | 110 quadros | modo 1
msgctxt "150:1"
msgid "Not going to play assassin this time?"
msgstr "Desta vez não vai brincar de assassino?"

#. cv/btl/emi_1910_mix.at3 | 62 quadros | modo 1
msgctxt "150:2"
msgid "Stow it, you disloyal bastard."
msgstr "Cala a boca, desgraçado desleal."

#. cv/btl/emi_1910_mix.at3 | 106 quadros | modo 1
msgctxt "150:3"
msgid "How about I show your new Master how\n      you look on your knees?      "
msgstr "Que tal eu mostrar como você fica de joelhos\npra quem te dá ordens agora?"

#. cv/btl/emi_1910_mix.at3 | 182 quadros | modo 1
msgctxt "150:4"
msgid "        What a splendid plan, Lancer.        \nDon't mind me; fight to your heart's content."
msgstr "Que plano esplêndido, Lancer.\nNão se preocupe comigo. Lute à vontade."

#. cv/btl/tam_1622.at3 | 102 quadros | modo 1
msgctxt "151:0"
msgid "Ahh, my fur nearly fell off there!"
msgstr "Ah, quase perdi todo o meu pelo!"

#. cv/btl/jin_1200a_edit.at3 | 82 quadros | modo 1
msgctxt "152:1"
msgid "Hehe… bet you've never seen this～"
msgstr "Hehe… aposto que nunca viu essa～"

#. cv/btl/mll_1221_edit.at3 | 32 quadros | modo 1
msgctxt "153:1"
msgid "Think you can stop me?"
msgstr "Acha que pode me deter?"

#. cv/btl/psl_1110.at3 | 62 quadros | modo 1
msgctxt "154:0"
msgid "A-ahh!! W-wait up!"
msgstr "A-ahh!! E-espera!"

#. cv/fld/tam_0620.at3 | 72 quadros | modo 1
msgctxt "155:0"
msgid "No peeping, okay Darling～?"
msgstr "Nada de espiar, viu, meu bem～?"

#. cv/btl/tam_2004.at3 | 36 quadros | modo 1
msgctxt "156:0"
msgid "Prepare yourself～"
msgstr "Prepare-se～"

#. cv/btl/tam_1270a_edit.at3 | 22 quadros | modo 1
msgctxt "157:1"
msgid "Here I go!"
msgstr "Aqui vou eu!"

#. cv/btl/tam_1270a_edit.at3 | 20 quadros | modo 1
msgctxt "157:3"
msgid "One!"
msgstr "Um!"

#. cv/btl/tam_1270a_edit.at3 | 20 quadros | modo 1
msgctxt "157:5"
msgid "Two!"
msgstr "Dois!"

#. cv/btl/tam_1270a_edit.at3 | 30 quadros | modo 1
msgctxt "157:7"
msgid "You won't escape!"
msgstr "Você não vai escapar!"

#. cv/btl/tam_1270a_edit.at3 | 42 quadros | modo 1
msgctxt "157:9"
msgid "DI―VINE PUNISHMENT!"
msgstr "Pu―ni―ção divina!"

#. cv/btl/tam_1270a_edit.at3 | 60 quadros | modo 1
msgctxt "157:11"
msgid "This is my secret move～"
msgstr "Essa é minha técnica secreta～"

#. cv/btl/emi3_1751_mix.at3 | 120 quadros | modo 1
msgctxt "158:0"
msgid "…shit. Sorry Archer, I may have slipped up."
msgstr "…merda. Desculpa, Archer. Acho que vacilei."

#. cv/btl/emi3_1751_mix.at3 | 122 quadros | modo 1
msgctxt "158:1"
msgid "That just makes it my time to show them\n            what I can do.            "
msgstr "Então chegou a hora de mostrar\ndo que sou capaz."

#. cv/btl/emi3_1751_mix.at3 | 56 quadros | modo 1
msgctxt "158:2"
msgid "Let's show them how veterans\n      finesse our wins!      "
msgstr "Vamos mostrar como veteranos vencem."

#. cv/btl/gaw2_1220_edit.at3 | 46 quadros | modo 1
msgctxt "159:0"
msgid "Your wallet will be mine!"
msgstr "Sua carteira será minha!"

#. cv/btl/kar_1220_edit.at3 | 60 quadros | modo 1
msgctxt "160:1"
msgid "I don't mean to copy Arjuna, but…"
msgstr "Não quero imitar Arjuna, mas…"

#. cv/btl/eli_1202_edit.at3 | 40 quadros | modo 1
msgctxt "161:0"
msgid "I feel alive again～"
msgstr "Estou viva de novo～"

#. cv/btl/emi_1230_edit.at3 | 78 quadros | modo 1
msgctxt "162:1"
msgid "Scent memorized… Go!"
msgstr "Cheiro memorizado… Vai!"

#. cv/btl/tam_1713.at3 | 82 quadros | modo 1
msgctxt "163:0"
msgid "Don't worry, I'm with with you! Fight!"
msgstr "Calma, estou com você! Lute!"

#. cv/btl/elp_2001.at3 | 32 quadros | modo 1
msgctxt "164:0"
msgid "I'll throw them outta here!"
msgstr "Vou mandar todos pra fora daqui!"

#. cv/fld/emi_0201.at3 | 138 quadros | modo 2
msgctxt "165:0"
msgid "A reserved woman who can stand on their own."
msgstr "Uma mulher reservada, que sabe se virar sozinha."

#. cv/fld/emi_0201.at3 | 98 quadros | modo 2
msgctxt "165:1"
msgid "I know, there aren't many like that."
msgstr "Eu sei, não existem muitas assim."

#. cv/fld/emi_0201.at3 | 100 quadros | modo 2
msgctxt "165:2"
msgid "Ah, I see. The Moon Cell knows me better than I know myself."
msgstr "Entendo. O Moon Cell me conhece melhor do que eu mesmo."

#. se/eb_tam/28 | 24 quadros | modo 1
msgctxt "166:0"
msgid "Ow ow!"
msgstr "Ai, ai!"

#. cv/btl/tam_1520.at3 | 70 quadros | modo 1
msgctxt "167:0"
msgid "Oh no! They've figured us out, Darling!"
msgstr "Ai, não! Descobriram a gente, meu bem!"

#. cv/fld/tam_0603.at3 | 136 quadros | modo 1
msgctxt "168:0"
msgid "Would you like dinner? Perhaps a bath?\n        Or would you like to…        "
msgstr "Quer jantar? Talvez um banho?\nOu quer…"

#. cv/fld/tam_0603.at3 | 36 quadros | modo 1
msgctxt "168:1"
msgid "Play with my tail? 鷙"
msgstr "Brincar com o meu rabo? 鷙"

#. cv/btl/rob_1220_edit.at3 | 52 quadros | modo 1
msgctxt "169:0"
msgid "The Faceless King, advancing."
msgstr "O Rei Sem Rosto avança."

#. se/eb_emi3/5 | 24 quadros | modo 1
msgctxt "170:0"
msgid "You idiots!"
msgstr "Seus idiotas!"

#. cv/btl/mks_1800.at3 | 200 quadros | modo 1
msgctxt "171:0"
msgid "Hehehe… Using the ace up your sleeve that you\n      were saving until the final battle?      "
msgstr "Hehehe… Vai usar o trunfo que guardou\npara a batalha final?"

#. cv/btl/mks_1800.at3 | 64 quadros | modo 1
msgctxt "171:1"
msgid "I can't fault your logic."
msgstr "Seu raciocínio faz sentido."

#. cv/btl/mks_1800.at3 | 220 quadros | modo 1
msgctxt "171:2"
msgid "But did you stop to think that maybe your\n      logic won't work against me?      "
msgstr "Mas já pensou que talvez\nessa lógica não funcione contra mim?"

#. cv/btl/mks_1800.at3 | 32 quadros | modo 1
msgctxt "171:3"
msgid "What did you say!?"
msgstr "O que você disse!?"

#. cv/btl/elp_1730.at3 | 126 quadros | modo 1
msgctxt "172:0"
msgid "Please take your seats everyone, it's the\n     moment you've been waiting for!     "
msgstr "Tomem seus lugares, pessoal!\nChegou a hora que vocês esperavam!"

#. cv/btl/rob_1751.at3 | 98 quadros | modo 1
msgctxt "173:0"
msgid "Sorry, but I'm not throwing in the\n          towel just yet.          "
msgstr "Foi mal, mas ainda não vou jogar a toalha."

#. cv/btl/rob_1751.at3 | 98 quadros | modo 1
msgctxt "173:1"
msgid "I can't tarnish Dan Blackmore's\n    reputation, now can I?    "
msgstr "Não posso manchar a reputação\nde Dan Blackmore, posso?"

#. cv/btl/sin_1510.at3 | 50 quadros | modo 1
msgctxt "174:0"
msgid "My poor Shinji Tank!!"
msgstr "Meu pobre Tanque do Shinji!!"

#. cv/btl/mll_1240_edit.at3 | 34 quadros | modo 1
msgctxt "175:1"
msgid "Take that…"
msgstr "Tome isso…"

#. cv/btl/mll_1240_edit.at3 | 58 quadros | modo 1
msgctxt "175:2"
msgid "…and that, and that, AND THAT!"
msgstr "…e isso, e isso, E ISSO!"

#. cv/btl/tam_1221_edit.at3 | 46 quadros | modo 1
msgctxt "176:1"
msgid "Frigid heaven, smash!"
msgstr "Céu gelado, despedace tudo!"

#. cv/fld/tam_0621.at3 | 74 quadros | modo 1
msgctxt "177:0"
msgid "I hope you're excited for lovely Tamamo～!"
msgstr "Prepare-se para ver a bela Tamamo～!"

#. cv/btl/gaw2_1800.at3 | 58 quadros | modo 1
msgctxt "178:0"
msgid "Is this just another fetch quest?"
msgstr "É só mais uma missão de entrega?"

#. cv/fld/rin_0103.at3 | 236 quadros | modo 2
msgctxt "179:0"
msgid "B82/W57/H80. I work myself hard, so that's not bad, right?"
msgstr "B82/C57/Q80. Eu me esforço bastante, até que tá bom, né?"

#. cv/btl/ner_1612.at3 | 35 quadros | modo 1
msgctxt "180:0"
msgid "Get out of my sight."
msgstr "Some da minha vista."

#. cv/btl/ran_1711.at3 | 56 quadros | modo 1
msgctxt "181:0"
msgid "Why was I born into this era…?"
msgstr "Por que nasci nesta época…?"

#. cv/btl/ksk_1110.at3 | 24 quadros | modo 1
msgctxt "182:0"
msgid "Continuing."
msgstr "Continuando."

#. cv/btl/kar_1753_mix.at3 | 128 quadros | modo 1
msgctxt "183:0"
msgid "What the hell, they can't be human if\n        they survived that!!        "
msgstr "Que diabos, ninguém humano\nsobreviveria a isso!!"

#. cv/btl/kar_1753_mix.at3 | 120 quadros | modo 1
msgctxt "183:1"
msgid " That or they're just really durable. This will \nbe tough, but let's find out which one they are."
msgstr "Ou só aguentam muita pancada. Vai ser difícil,\nmas vamos descobrir de que tipo são."

#. cv/fld/kot_00933.at3 | 32 quadros | modo 3
msgctxt "184:0"
msgid "See you next time."
msgstr "Até a próxima."

#. cv/btl/emi_1804.at3 | 66 quadros | modo 1
msgctxt "185:0"
msgid "Alright. How should we clean up this mess?"
msgstr "Certo. Como vamos resolver essa bagunça?"

#. cv/btl/gil_2010.at3 | 134 quadros | modo 1
msgctxt "186:0"
msgid "Consider falling back for now. That thing's\n         more than you can handle.         "
msgstr "Considera recuar por enquanto.\nEssa coisa está além da tua capacidade."

#. cv/btl/gil_1920_mix.at3 | 178 quadros | modo 1
msgctxt "187:0"
msgid "I'm not sure how to handle this, Caster.\n He's an awfully intense Heroic Spirit. "
msgstr "Não sei lidar com isso, Caster.\nEsse Espírito Heroico é intenso demais."

#. cv/btl/gil_1920_mix.at3 | 84 quadros | modo 1
msgctxt "187:1"
msgid "Don't you think he's too godlike to kill?"
msgstr "Você não acha que ele é divino demais pra matar?"

#. cv/btl/gil_1920_mix.at3 | 198 quadros | modo 1
msgctxt "187:2"
msgid "Not at all. He's a fool who denied the gods\n          and sided with mankind.          "
msgstr "De modo algum. É um tolo que renegou\nos deuses e ficou do lado dos humanos."

#. cv/btl/gil_1920_mix.at3 | 116 quadros | modo 1
msgctxt "187:3"
msgid "There's no need to fear punishment for killing\n              someone like that.              "
msgstr "Não há por que temer um castigo\npor matar alguém assim."

#. cv/btl/gil_1920_mix.at3 | 96 quadros | modo 1
msgctxt "187:4"
msgid "Really? Well then, let's knock him down then."
msgstr "É mesmo? Então vamos derrubá-lo."

#. cv/btl/gil_1920_mix.at3 | 92 quadros | modo 1
msgctxt "187:5"
msgid "One irregularity is more than enough\n          with me around.          "
msgstr "Uma irregularidade já é o bastante\ncomigo por aqui."

#. cv/btl/elp_1210_edit.at3 | 66 quadros | modo 1
msgctxt "188:0"
msgid "Anyone mean to me gets the stick."
msgstr "Quem mexer comigo vai levar uma surra."

#. cv/btl/tam3_1230_edit.at3 | 68 quadros | modo 1
msgctxt "189:1"
msgid "Concealed gale of the heavens, crash together."
msgstr "Vendaval oculto dos céus, venha rugir."

#. cv/btl/ner_1210_edit.at3 | 48 quadros | modo 1
msgctxt "190:0"
msgid "Tears of the saint!"
msgstr "Lágrimas do santo!"

#. cv/btl/tam_1890_mix.at3 | 110 quadros | modo 1
msgctxt "191:0"
msgid "A god is transcendent, but gives\n    as much as they receive.    "
msgstr "Um deus transcende o mundo e dá\ntanto quanto recebe."

#. cv/btl/tam_1890_mix.at3 | 150 quadros | modo 1
msgctxt "191:1"
msgid "  A woman like you who only seeks to  \nreceive is not fit to sit amongst gods!"
msgstr "Quem só sabe receber, como você,\nnão merece se sentar entre os deuses!"

#. cv/btl/tam_1890_mix.at3 | 84 quadros | modo 1
msgctxt "191:2"
msgid "Disappear from my sight at once!"
msgstr "Suma da minha vista, agora!"

#. cv/btl/tam_1890_mix.at3 | 180 quadros | modo 1
msgctxt "191:3"
msgid "I feel deep shame from your rebuke."
msgstr "Sua repreensão me enche de vergonha."

#. cv/btl/tam_1890_mix.at3 | 186 quadros | modo 1
msgctxt "191:4"
msgid "The words of a fallen demon\ndo carry weight after all."
msgstr "As palavras de um demônio caído\ntêm seu peso, afinal."

#. cv/btl/tam_1890_mix.at3 | 150 quadros | modo 1
msgctxt "191:5"
msgid "Well, the weight of a whining dog that is."
msgstr "O mesmo peso do ganido de um cachorro."

#. cv/btl/tam_1890_mix.at3 | 78 quadros | modo 1
msgctxt "191:6"
msgid "T-T-THIS BITCH…!"
msgstr "S-S-SUA VACA…!"

#. cv/btl/tam_1890_mix.at3 | 134 quadros | modo 1
msgctxt "191:7"
msgid "    Is she really looking to start something    \nright to my face!? AND treating me like a DOG!?"
msgstr "Ela quer arrumar briga na minha cara!?\nE ainda me trata como CACHORRO!?"

#. cv/btl/tam_1890_mix.at3 | 90 quadros | modo 1
msgctxt "191:8"
msgid "I'll curse this bitch dead to the ends\n          of the universe!!          "
msgstr "Vou amaldiçoar essa desgraçada até a morte,\naté os confins do universo!!"

#. cv/btl/tam_1890_mix.at3 | 60 quadros | modo 1
msgctxt "191:9"
msgid "Your unwelcome stay on the Moon ends now!!"
msgstr "A sua estadia indesejada na Lua acaba agora!!"

#. cv/btl/gil_1611.at3 | 84 quadros | modo 1
msgctxt "192:0"
msgid "That's about as much effort as\n  I need to expend for you.  "
msgstr "É todo o esforço que preciso fazer por ti."

#. se/eb_eli/7 | 24 quadros | modo 1
msgctxt "193:0"
msgid "What was *that*?"
msgstr "O que foi *isso*?"

#. cv/btl/rob_1091.at3 | 46 quadros | modo 1
msgctxt "194:0"
msgid "Come on, let's go!"
msgstr "Anda, vamos nessa!"

#. cv/btl/emi_2010.at3 | 68 quadros | modo 1
msgctxt "195:0"
msgid "That enemy's powerful. We should retreat\n        and think this through.        "
msgstr "Esse inimigo é forte. Melhor recuar\ne analisar a situação."

#. cv/btl/tam_1744.at3 | 120 quadros | modo 1
msgctxt "196:0"
msgid "Ladies and gentlemen, it's time to\n      unveil my true power!      "
msgstr "Senhoras e senhores, chegou a hora\nde revelar meu verdadeiro poder!"

#. cv/btl/tam_1744.at3 | 64 quadros | modo 1
msgctxt "196:1"
msgid "Master, unleash my Noble Phantasm 鷙"
msgstr "Mestre, libere meu Fantasma Nobre 鷙"

#. cv/btl/kar_1231_edit.at3 | 74 quadros | modo 1
msgctxt "197:0"
msgid "Heads up! You can hate me for this one."
msgstr "Cuidado! Pode me odiar por isso."

#. cv/btl/psl_1710.at3 | 148 quadros | modo 1
msgctxt "198:0"
msgid "I-I'm a complete mess! Melt is going to\n        laugh at me for sure!!        "
msgstr "E-eu estou um desastre!\nA Melt com certeza vai rir de mim!!"

#. cv/btl/ner_1091.at3 | 44 quadros | modo 1
msgctxt "199:0"
msgid "It's my turn."
msgstr "É a minha vez."

#. cv/btl/tam_1810_mix.at3 | 108 quadros | modo 1
msgctxt "200:0"
msgid "Hehe. Nice tail, mammal."
msgstr "Hehe. Belo rabo, mamífera."

#. cv/btl/tam_1810_mix.at3 | 170 quadros | modo 1
msgctxt "200:1"
msgid "I'll be sure to make a nice coat out of you\n       when I'm done here, old lady.       "
msgstr "Vou fazer um belo casaco com você\nquando acabar aqui, velha."

#. cv/btl/tam_1810_mix.at3 | 120 quadros | modo 1
msgctxt "200:2"
msgid "Why thank you, reptile. After I'm done cooking\n        your flesh into a nice steak,        "
msgstr "Ora, obrigada, réptil. Quando terminar\nde fazer um belo bife com a sua carne,"

#. cv/btl/tam_1810_mix.at3 | 114 quadros | modo 1
msgctxt "200:3"
msgid "maybe I'll make some nice lizard pumps\n          from the leftovers.          "
msgstr "talvez eu faça uns sapatos de couro\nde lagarto com as sobras."

#. cv/btl/tam_1810_mix.at3 | 100 quadros | modo 1
msgctxt "200:4"
msgid "Oh my… Those are both high-class items… "
msgstr "Nossa… Dois artigos de luxo…"

#. cv/btl/tam_1810_mix.at3 | 60 quadros | modo 1
msgctxt "200:5"
msgid "Maybe they'll destroy each other\n      and I can have both!      "
msgstr "Se uma acabar com a outra,\neu fico com os dois!"

#. cv/btl/ner_1701.at3 | 74 quadros | modo 1
msgctxt "201:0"
msgid "Not bad. Pretty good, actually."
msgstr "Nada mal. Aliás, muito bem."

#. cv/fld/ner_0103.at3 | 216 quadros | modo 2
msgctxt "202:0"
msgid "B83/W56/H82. I'm a small woman with a sexy body!"
msgstr "B83/C56/Q82. Sou uma mulher baixinha de corpo sensual!"

#. cv/fld/ner_0103.at3 | 130 quadros | modo 2
msgctxt "202:1"
msgid "If I didn't show off these fine lines,"
msgstr "Se eu não exibisse essas belas curvas,"

#. cv/fld/ner_0103.at3 | 62 quadros | modo 2
msgctxt "202:2"
msgid "it'd be a loss for all humanity."
msgstr "seria uma perda para a humanidade."

#. cv/btl/tam_1741_mix.at3 | 90 quadros | modo 1
msgctxt "203:0"
msgid "I can't resist playing with my food a little～"
msgstr "Não resisto a brincar um pouco com a comida～"

#. cv/btl/tam_1741_mix.at3 | 96 quadros | modo 1
msgctxt "203:1"
msgid "Make sure to give me a nice scream, okay?"
msgstr "Quero ouvir um grito bem bonito, tá?"

#. cv/btl/tam_1741_mix.at3 | 136 quadros | modo 1
msgctxt "203:2"
msgid "Geh. It's not just her appearance, even her\n            weapon is spikey!!            "
msgstr "Aff. Já não bastava a aparência,\naté a arma dela tem espinhos!!"

#. cv/btl/tam_1741_mix.at3 | 90 quadros | modo 1
msgctxt "203:3"
msgid "She really is going to be a genuine pain\n    in the ass Servant, isn't she…    "
msgstr "Essa Serva vai ser um pé no saco mesmo…"

#. cv/btl/tam_1741_mix.at3 | 124 quadros | modo 1
msgctxt "203:4"
msgid "Hehe, pretty cocky for a Servant who\n       lost all their levels.       "
msgstr "Hehe, que audácia pra quem perdeu\ntodos os níveis de Servo."

#. cv/btl/tam_1741_mix.at3 | 144 quadros | modo 1
msgctxt "203:5"
msgid "You'll just have to show me what an\nexperienced Servant like you can do."
msgstr "Vai ter que mostrar do que alguém\ncom sua experiência é capaz."

#. cv/btl/adl_1531.at3 | 44 quadros | modo 1
msgctxt "204:0"
msgid "Feeling frustrated?"
msgstr "Bateu a frustração?"

#. cv/btl/tam_1632.at3 | 140 quadros | modo 1
msgctxt "205:0"
msgid "Hmhmhm. Looks like my good wife points\n      have increased once again!      "
msgstr "Hmhmhm. Parece que ganhei mais\nuns pontinhos de boa esposa!"

#. se/eb_eli/1 | 24 quadros | modo 1
msgctxt "206:0"
msgid "How's this?"
msgstr "Que tal essa?"

#. cv/btl/ner_1261_edit.at3 | 128 quadros | modo 1
msgctxt "207:0"
msgid "Praetor, this sword is to serve you!"
msgstr "Maestro, esta espada está a teu serviço!"

#. cv/fld/mks_0201.at3 | 196 quadros | modo 2
msgctxt "208:0"
msgid "You wanna see? You wanna know? Of course I'm not telling you!"
msgstr "Quer ver? Quer saber? É claro que não vou dizer!"

#. cv/fld/mks_0201.at3 | 50 quadros | modo 2
msgctxt "208:1"
msgid "Huh? You can see them!?"
msgstr "Hã? Você consegue ver!?"

#. cv/btl/emi_2040.at3 | 78 quadros | modo 1
msgctxt "209:0"
msgid "Hmm, they're not scared off by these muscles."
msgstr "Hum, eles não se intimidam com esses músculos."

#. cv/btl/emi_2040.at3 | 70 quadros | modo 1
msgctxt "209:1"
msgid "Wait! Do you think my muscles are\n       *attracting* them!?       "
msgstr "Espere! Será que meus músculos\nestão *atraindo* eles!?"

#. cv/btl/elp_1300_edit.at3 | 100 quadros | modo 1
msgctxt "210:1"
msgid "It's time for the last number! Let yourself be\n          enchanted by my voice～薗          "
msgstr "Hora do último número!\nDeixe minha voz te encantar～薗"

#. cv/fld/mll_0106.at3 | 122 quadros | modo 2
msgctxt "211:0"
msgid "April 9th. The date itself really doesn't matter,"
msgstr "9 de abril. A data em si pouco importa,"

#. cv/fld/mll_0106.at3 | 52 quadros | modo 2
msgctxt "211:1"
msgid "as long as I'm not Lip's younger sister…"
msgstr "desde que eu não seja a irmã mais nova da Lip…"

#. se/eb_tam/17 | 28 quadros | modo 1
msgctxt "212:0"
msgid "Punch of opportunity!"
msgstr "Soco de oportunidade!"

#. cv/btl/eli_1755_mix.at3 | 160 quadros | modo 1
msgctxt "213:0"
msgid "Rani, what's going on? Are they\n    actually holding us off?    "
msgstr "Rani, o que está acontecendo?\nEles estão mesmo nos segurando?"

#. cv/btl/eli_1755_mix.at3 | 150 quadros | modo 1
msgctxt "213:1"
msgid "Please stay calm. We still have a\n      chance for a comeback.      "
msgstr "Mantenha a calma, por favor.\nAinda podemos virar o jogo."

#. cv/btl/eli_1755_mix.at3 | 170 quadros | modo 1
msgctxt "213:2"
msgid "Comeback!? You said comeback, right!?\n      THAT MEANS WE'RE LOSING!!      "
msgstr "Virar!? Você falou em virar, certo!?\nISSO QUER DIZER QUE ESTAMOS PERDENDO!!"

#. cv/btl/adl_1754.at3 | 72 quadros | modo 1
msgctxt "214:0"
msgid "Is brute force all you have left?\n         You damn idiot.         "
msgstr "Só lhe resta a força bruta?\nQue idiota."

#. cv/fld/gil_0631.at3 | 108 quadros | modo 1
msgctxt "215:0"
msgid "Hmm. The \"street style\" of this isn't quite\n        as striking as I would like.        "
msgstr "Hum. Este visual “de rua”\nnão chama tanta atenção quanto eu queria."

#. cv/fld/ner_0105.at3 | 168 quadros | modo 2
msgctxt "216:0"
msgid "Headaches, maybe no one to accept me."
msgstr "Dores de cabeça. Talvez não ter quem me aceite."

#. cv/fld/ner_0105.at3 | 188 quadros | modo 2
msgctxt "216:1"
msgid "Well, that last one's not an issue since you're here with me."
msgstr "Com você ao meu lado, isso já não é um problema."

#. cv/fld/ner_0105.at3 | 164 quadros | modo 2
msgctxt "216:2"
msgid "Extol me with 100―no, 1,000 people's worth of praise!"
msgstr "Louva-me por cem― não, por mil pessoas!"

#. cv/btl/ner_1720.at3 | 70 quadros | modo 1
msgctxt "217:0"
msgid "Our musical program has been decided."
msgstr "O repertório já está decidido."

#. cv/btl/ner_1720.at3 | 60 quadros | modo 1
msgctxt "217:1"
msgid "Ring the bells, Master!"
msgstr "Toca os sinos, Maestro!"

#. cv/fld/tam_0103.at3 | 180 quadros | modo 2
msgctxt "218:0"
msgid "B86/W57/H84. The nicest body around～"
msgstr "86 de busto, 57 de cintura, 84 de quadril.\nO corpo mais lindo que tem～"

#. cv/fld/tam_0103.at3 | 138 quadros | modo 2
msgctxt "218:1"
msgid "…is what I'd like to say, but dang, we have some monsters here."
msgstr "…é o que eu queria dizer, mas poxa,\ntem uns mulherões aqui."

#. cv/fld/tam_0103.at3 | 72 quadros | modo 2
msgctxt "218:2"
msgid "What happened to modesty and being average???"
msgstr "Cadê a modéstia e as medidas normais???"

#. se/eb_el2/1 | 23 quadros | modo 1
msgctxt "219:0"
msgid "Disappear!"
msgstr "Desapareça!"

#. cv/btl/sin_1530.at3 | 68 quadros | modo 1
msgctxt "220:0"
msgid "Hell yeah! We're so badass!!"
msgstr "Isso aí! A gente é foda!!"

#. cv/btl/gil_1231_edit.at3 | 50 quadros | modo 1
msgctxt "221:0"
msgid "I won't demand suicide of you."
msgstr "Não exigirei que tires a própria vida."

#. cv/fld/jin_0100.at3 | 56 quadros | modo 2
msgctxt "222:0"
msgid "Sup, Jinako here!"
msgstr "E aí, Jinako na área!"

#. cv/fld/ner_0201.at3 | 174 quadros | modo 2
msgctxt "223:0"
msgid "When I show myself to the people, I wear mainly red."
msgstr "Quando apareço em público, visto principalmente vermelho."

#. cv/fld/ner_0201.at3 | 100 quadros | modo 2
msgctxt "223:1"
msgid "What other color would reflect my beautiful image?"
msgstr "Que outra cor refletiria tão bem minha beleza?"

#. cv/btl/emi_1221_edit.at3 | 76 quadros | modo 1
msgctxt "224:1"
msgid "Go to the red plains, scarlet hound!"
msgstr "Às planícies rubras, cão escarlate!"

#. cv/btl/eli_1200_edit.at3 | 60 quadros | modo 1
msgctxt "225:0"
msgid "The blood of the masses is my nourishment."
msgstr "O sangue das massas me alimenta."

#. cv/btl/ksk_1200_edit.at3 | 74 quadros | modo 1
msgctxt "226:1"
msgid "Crown, grant me resources and power."
msgstr "Coroa, conceda-me recursos e poder."

#. cv/btl/kia_1751.at3 | 100 quadros | modo 1
msgctxt "227:0"
msgid "…it seems the time for pleasure has ended."
msgstr "…parece que o tempo do prazer acabou."

#. cv/btl/elp_1110.at3 | 32 quadros | modo 1
msgctxt "228:0"
msgid "Oh, this is my part!"
msgstr "Ah, essa é a minha parte!"

#. cv/btl/gil_1613.at3 | 120 quadros | modo 1
msgctxt "229:0"
msgid "Come on. Don't be so clumsy, mongrel."
msgstr "Ora. Quanta falta de jeito, criatura mestiça."

#. cv/btl/elp_1511.at3 | 56 quadros | modo 1
msgctxt "230:0"
msgid "Awawa, time out time out!"
msgstr "A-aah! Pausa, pausa!"

#. cv/fld/psl_0100.at3 | 116 quadros | modo 2
msgctxt "231:0"
msgid "Passionlip. I really like my name!"
msgstr "Passionlip. Gosto muito do meu nome!"

#. cv/fld/psl_0102a.at3 | 40 quadros | modo 2
msgctxt "232:0"
msgid "W-wait, "
msgstr "E-espera,"

#. cv/btl/emi_1800.at3 | 58 quadros | modo 1
msgctxt "233:0"
msgid "Just think of it as a warming-up exercise."
msgstr "Encare como um aquecimento."

#. se/eb_gil/23 | 40 quadros | modo 1
msgctxt "234:0"
msgid "You never learn!"
msgstr "Nunca aprendes!"

#. se/eb_ksk/17 | 26 quadros | modo 1
msgctxt "235:0"
msgid "Really now…"
msgstr "Francamente…"

#. cv/btl/ksk_1700.at3 | 76 quadros | modo 1
msgctxt "236:0"
msgid "This battle is proceeding as expected."
msgstr "A batalha prossegue como previsto."

#. cv/btl/ksk_1700.at3 | 82 quadros | modo 1
msgctxt "236:1"
msgid "Your deletion is imminent."
msgstr "Sua exclusão é iminente."

#. cv/btl/emi_1094.at3 | 29 quadros | modo 1
msgctxt "237:0"
msgid "Please leave it to me!"
msgstr "Por favor, deixe comigo!"

#. cv/fld/gil_0630.at3 | 144 quadros | modo 1
msgctxt "238:0"
msgid "Do not hold back, extol my glory! Extol it!"
msgstr "Não te contenhas! Exalta minha glória!"

#. cv/btl/tam_1251_edit.at3 | 44 quadros | modo 1
msgctxt "239:0"
msgid "Okay! You're getting cursed for real."
msgstr "Pronto! Agora a maldição é pra valer."

#. cv/btl/twi_1800.at3 | 128 quadros | modo 1
msgctxt "240:0"
msgid "            You wish to fight us?            \nThere really are eccentric Masters out there."
msgstr "Quer nos enfrentar?\nTem cada Mestre excêntrico por aí."

#. cv/fld/mll_0200.at3 | 120 quadros | modo 2
msgctxt "241:0"
msgid "Nothing really. I'll just be melting and absorbing them anyway."
msgstr "Nada, na verdade. Vou derreter e absorver de qualquer jeito."

#. cv/btl/twi_1531.at3 | 34 quadros | modo 1
msgctxt "242:0"
msgid "Keep it up, Caster!"
msgstr "Continue assim, Caster!"

#. cv/btl/ner_1250_edit.at3 | 102 quadros | modo 1
msgctxt "243:0"
msgid "Muses, protect the supreme arts!"
msgstr "Musas, protegei as artes supremas!"

#. cv/btl/mll_1201_edit.at3 | 48 quadros | modo 1
msgctxt "244:1"
msgid "Brisé, Étoile!"
msgstr "Brisé, Étoile!"

#. cv/btl/ran_1201_edit.at3 | 64 quadros | modo 1
msgctxt "245:0"
msgid "I found you a new gig, Lancer."
msgstr "Encontrei outro trabalho para você, Lancer."

#. cv/fld/rin_0104.at3 | 154 quadros | modo 2
msgctxt "246:0"
msgid "The Tohsakas were from Japan, but I'm not really connected."
msgstr "Os Tohsaka eram do Japão, mas não tenho muito vínculo com o país."

#. cv/btl/tam_1240_edit.at3 | 53 quadros | modo 1
msgctxt "247:1"
msgid "Could you please not touch me?"
msgstr "Pode tirar as mãos de mim, por favor?"

#. cv/fld/kot_0090.at3 | 55 quadros | modo 3
msgctxt "248:0"
msgid "Welcome to the school store."
msgstr "Boas-vindas à Cantina."

#. cv/btl/elp_1613.at3 | 48 quadros | modo 1
msgctxt "249:0"
msgid "That took way longer than it should have…"
msgstr "Demorou muito mais do que devia…"

#. cv/btl/gil_2001.at3 | 48 quadros | modo 1
msgctxt "250:0"
msgid "Don't leave anything standing."
msgstr "Não deixes nada de pé."

#. cv/btl/emi_1703.at3 | 72 quadros | modo 1
msgctxt "251:0"
msgid "Just like that! Leave the rest to me, Master."
msgstr "Isso! Deixe o resto comigo."

#. cv/btl/jin_1511.at3 | 54 quadros | modo 1
msgctxt "252:0"
msgid "Is this all you're capable of?"
msgstr "É só isso que consegue?"

#. cv/btl/gaw2_1510.at3 | 52 quadros | modo 1
msgctxt "253:0"
msgid "You're really set on being uncooperative,\n               aren't you?               "
msgstr "Decidiu mesmo que não vai cooperar, não foi?"

#. cv/fld/mks_0906.at3 | 128 quadros | modo 1
msgctxt "254:0"
msgid "Ahh, you look so miserable.\n So pathetic and wretched. "
msgstr "Ahh, que cara de sofrimento.\nTão lamentável, tão miserável."

#. cv/btl/mll_1756.at3 | 36 quadros | modo 1
msgctxt "255:0"
msgid "I'll make you drown."
msgstr "Vou fazer você se afogar."

#. cv/btl/elp_1501.at3 | 42 quadros | modo 1
msgctxt "256:0"
msgid "Kneel before me～!"
msgstr "De joelhos diante de mim～!"

#. cv/btl/tam_2020.at3 | 98 quadros | modo 1
msgctxt "257:0"
msgid "Ugh, come on. They're so weak! Why are\n            we bothering!?            "
msgstr "Ah, qual é. São tão fracos!\nPra que perder tempo!?"

#. cv/btl/ksk_1091.at3 | 28 quadros | modo 1
msgctxt "258:0"
msgid "I will delete you."
msgstr "Vou apagar você."

#. cv/fld/eli_0101.at3 | 192 quadros | modo 2
msgctxt "259:0"
msgid "154cm… wait no, 172cm! Impressed, aren't you?"
msgstr "154 cm… Não, 172 cm! Impressionante, né?"

#. cv/fld/eli_0101.at3 | 122 quadros | modo 2
msgctxt "259:1"
msgid "I've got to include these super chic horns fit for a model～"
msgstr "Tenho que contar estes chifres chiques de modelo～"

#. se/eb_gaw/7 | 24 quadros | modo 1
msgctxt "260:0"
msgid "How about this!?"
msgstr "E agora, que tal!?"

#. cv/fld/gil_0104.at3 | 194 quadros | modo 2
msgctxt "261:0"
msgid "Let's see. A human answer would be my capital city, Uruk."
msgstr "Vejamos. Uma resposta humana seria Uruk, minha capital."

#. cv/btl/emi_1900_mix.at3 | 108 quadros | modo 1
msgctxt "262:0"
msgid "Seems like our fundamental skills\n          are the same.          "
msgstr "Parece que temos as mesmas técnicas básicas."

#. cv/btl/emi_1900_mix.at3 | 144 quadros | modo 1
msgctxt "262:1"
msgid "I never imagined I'd have to fight myself again.\n    I really haven't grown at all, have I…?    "
msgstr "Nunca imaginei lutar comigo mesmo de novo.\nNo fim, não amadureci nada, né…?"

#. cv/btl/emi_1900_mix.at3 | 42 quadros | modo 1
msgctxt "262:2"
msgid "I think it's fine!"
msgstr "Eu acho que tudo bem!"

#. cv/btl/emi_1900_mix.at3 | 90 quadros | modo 1
msgctxt "262:3"
msgid "You're not getting into shouting matches\n     with your past self this time.     "
msgstr "Pelo menos desta vez você não está\ngritando com seu eu do passado."

#. cv/btl/emi_1900_mix.at3 | 88 quadros | modo 1
msgctxt "262:4"
msgid "I have no idea what they're talking about…"
msgstr "Não faço ideia do que estão falando…"

#. cv/btl/emi_1900_mix.at3 | 120 quadros | modo 1
msgctxt "262:5"
msgid "But Rin Tohsaka and that \"me\" get along\n          surprisingly well.          "
msgstr "Mas Tohsaka Rin e aquele “eu”\nse dão bem, por incrível que pareça."

#. cv/btl/psl_1752.at3 | 128 quadros | modo 1
msgctxt "263:0"
msgid "Ahaha, HAHAHA!!"
msgstr "Ahaha, HAHAHA!!"

#. cv/btl/tam_1703.at3 | 73 quadros | modo 1
msgctxt "264:0"
msgid "We should just be declared\n    the victor already!    "
msgstr "Já podem anunciar nossa vitória!"

#. cv/btl/rin_1520.at3 | 28 quadros | modo 1
msgctxt "265:0"
msgid "Not bad."
msgstr "Nada mal."

#. cv/btl/ksk_1201_edit.at3 | 60 quadros | modo 1
msgctxt "266:1"
msgid "Don't you know this is all pointless?"
msgstr "Ainda não percebeu que tudo isso é inútil?"

#. cv/fld/kot_0094.at3 | 86 quadros | modo 3
msgctxt "267:0"
msgid "Fundamentally, there's nothing money can't buy."
msgstr "No fundo, dinheiro compra tudo."

#. cv/fld/kot_00910.at3 | 65 quadros | modo 3
msgctxt "268:0"
msgid "That's the King of Heroes for you,"
msgstr "Típico do Rei dos Heróis."

#. cv/fld/kot_00910.at3 | 54 quadros | modo 3
msgctxt "268:1"
msgid "even your wallet is golden!"
msgstr "Até sua carteira é de ouro!"

#. cv/btl/gaw_1220_edit.at3 | 44 quadros | modo 1
msgctxt "269:0"
msgid "I will knock the wind out of you!"
msgstr "Vou arrancar seu fôlego!"

#. cv/btl/mks_1100.at3 | 28 quadros | modo 1
msgctxt "270:0"
msgid "Refresh!"
msgstr "Atualizar!"

#. cv/btl/ran_1701.at3 | 88 quadros | modo 1
msgctxt "271:0"
msgid "A world without underwear is within my grasp!"
msgstr "Um mundo sem roupa íntima está ao meu alcance!"

#. cv/fld/ner_0106.at3 | 138 quadros | modo 2
msgctxt "272:0"
msgid "Do you mean when I first cried out as an infant?"
msgstr "Queres dizer quando chorei pela primeira vez, ao nascer?"

#. cv/fld/ner_0106.at3 | 148 quadros | modo 2
msgctxt "272:1"
msgid "Or the day the crown was placed upon my head?"
msgstr "Ou o dia em que puseram a coroa na minha cabeça?"

#. cv/fld/ner_0106.at3 | 220 quadros | modo 2
msgctxt "272:2"
msgid "Sorry, I know I'm not answering straight. Don't look so down!"
msgstr "Perdão pela resposta torta. Não faças essa cara triste!"

#. cv/fld/kot_0098.at3 | 120 quadros | modo 3
msgctxt "273:0"
msgid "It seems a valued customer has arrived."
msgstr "Parece que chegou alguém de grande valor."

#. cv/fld/kot_0098.at3 | 30 quadros | modo 3
msgctxt "273:1"
msgid "Do not hold back,"
msgstr "Não se contenha."

#. cv/fld/kot_0098.at3 | 56 quadros | modo 3
msgctxt "273:2"
msgid "spend your fortunes without restraint."
msgstr "Gaste sua fortuna sem reservas."

#. cv/fld/rin_0101.at3 | 150 quadros | modo 2
msgctxt "274:0"
msgid "159cm. In the real world, I'd be a bit on the tall side,"
msgstr "159 cm. No mundo real, eu seria mais alta que a média,"

#. cv/fld/rin_0101.at3 | 70 quadros | modo 2
msgctxt "274:1"
msgid "but in here, I'm perfectly average."
msgstr "mas aqui estou bem na média."

#. cv/btl/leo_1950_mix.at3 | 80 quadros | modo 1
msgctxt "275:0"
msgid "Gawain, settle this with a single strike."
msgstr "Gawain, resolva com um único golpe."

#. cv/btl/leo_1950_mix.at3 | 54 quadros | modo 1
msgctxt "275:2"
msgid "Unseal your Noble Phantasm…!"
msgstr "Libere seu Fantasma Nobre…!"

#. cv/btl/leo_1950_mix.at3 | 200 quadros | modo 1
msgctxt "275:3"
msgid "Hehehe… So you saved your trump card\n        for the final battle?        "
msgstr "Hehehe… Então guardou seu trunfo\npara a batalha final?"

#. cv/btl/leo_1950_mix.at3 | 64 quadros | modo 1
msgctxt "275:4"
msgid "I can't fault your logic."
msgstr "Seu raciocínio faz sentido."

#. cv/btl/leo_1950_mix.at3 | 220 quadros | modo 1
msgctxt "275:5"
msgid "But did you stop to think that maybe your\n       plan won't be usable on me?       "
msgstr "Mas parou para pensar que talvez\nseu plano não funcione comigo?"

#. cv/btl/leo_1950_mix.at3 | 32 quadros | modo 1
msgctxt "275:6"
msgid "What did you say!?"
msgstr "O que você disse!?"

#. cv/fld/emi_0105.at3 | 184 quadros | modo 2
msgctxt "276:0"
msgid "I was born in Asia. But since I wandered the world,"
msgstr "Nasci na Ásia. Mas, como vaguei pelo mundo,"

#. cv/fld/emi_0105.at3 | 50 quadros | modo 2
msgctxt "276:1"
msgid "I never considered anywhere home."
msgstr "nunca chamei lugar algum de lar."

#. cv/fld/psl_0102.at3 | 148 quadros | modo 2
msgctxt "277:0"
msgid "One ton. W-wait, that much??"
msgstr "Uma tonelada. E-espera, tudo isso??"

#. cv/btl/ran_1520.at3 | 58 quadros | modo 1
msgctxt "278:0"
msgid "Are you really a top idol?"
msgstr "É mesmo uma idol de primeira?"

#. cv/btl/emi_1251_edit.at3 | 68 quadros | modo 1
msgctxt "279:0"
msgid "My being shall twist into madness…"
msgstr "Meu ser há de se retorcer em loucura…"

#. cv/btl/emi_1251_edit.at3 | 32 quadros | modo 1
msgctxt "279:2"
msgid "Caladbolg!"
msgstr "Caladbolg!"

#. se/eb_el2/6 | 25 quadros | modo 1
msgctxt "280:0"
msgid "I SAID SHUT UP!"
msgstr "MANDEI CALAR A BOCA!"

#. cv/btl/ner_1730.at3 | 110 quadros | modo 1
msgctxt "281:0"
msgid "Olympia plaudere! Open the gates!"
msgstr "Olympia plaudere! Abram os portões!"

#. cv/btl/ner_1730.at3 | 60 quadros | modo 1
msgctxt "281:1"
msgid "Raise the curtains for the star!"
msgstr "Ergam a cortina para a estrela!"

#. cv/btl/jin_1220_edit.at3 | 56 quadros | modo 1
msgctxt "282:1"
msgid "Boooting cheaaats!"
msgstr "Iniciando os cheeeats!"

#. cv/btl/jin_1220_edit.at3 | 60 quadros | modo 1
msgctxt "282:2"
msgid "M O D!"
msgstr "M O D!"

#. cv/btl/ner_1713.at3 | 94 quadros | modo 1
msgctxt "283:0"
msgid "D-don't worry, I'll fix this somehow."
msgstr "N-não te preocupes. Vou consertar isso."

#. cv/btl/gil_1623.at3 | 96 quadros | modo 1
msgctxt "284:0"
msgid "Myself aside, how can we function\n        if you slack off!?        "
msgstr "Esquece de mim. Como vamos lutar\nse fizeres corpo mole!?"

#. cv/btl/ner_2003.at3 | 72 quadros | modo 1
msgctxt "285:0"
msgid "This looks like a great chance to\n  show off my alluring body～  "
msgstr "Bela chance de exibir\nmeu corpo encantador～"

#. cv/btl/ner_1920_mix.at3 | 154 quadros | modo 1
msgctxt "286:0"
msgid "While she presents herself as brassy,\n she's suffused with impartial love. "
msgstr "Mostra-se atrevida,\nmas tem um amor que acolhe a todos."

#. cv/btl/ner_1920_mix.at3 | 160 quadros | modo 1
msgctxt "286:1"
msgid "Truly a lady knight reminiscent of a flower.\n        Her fall here will pain me.        "
msgstr "Uma dama guerreira, tal qual uma flor.\nSua queda vai me doer."

#. cv/btl/ner_1920_mix.at3 | 110 quadros | modo 1
msgctxt "286:2"
msgid "Master, please grant her no sympathy."
msgstr "Não sinta pena dela, por favor."

#. cv/btl/ner_1920_mix.at3 | 120 quadros | modo 1
msgctxt "286:3"
msgid "She's an enemy we need to defeat.\n          Nothing more.          "
msgstr "É uma inimiga que devemos derrotar.\nNada mais."

#. cv/btl/ner_1920_mix.at3 | 136 quadros | modo 1
msgctxt "286:4"
msgid "Yes, you're right. Let's wrap this up\n        nice and quick then.        "
msgstr "Sim, tens razão.\nEntão vamos acabar com isto depressa."

#. cv/btl/emi_2003a.at3 | 34 quadros | modo 1
msgctxt "287:0"
msgid "Act with confidence and claim victory!"
msgstr "Aja com confiança e conquiste a vitória!"

#. se/eb_emi3/8 | 24 quadros | modo 1
msgctxt "288:0"
msgid "I'll overtake you!"
msgstr "Vou ultrapassar você!"

#. cv/btl/gil_1703.at3 | 82 quadros | modo 1
msgctxt "289:0"
msgid "Not bad, you're getting me excited as well!"
msgstr "Nada mal, estou até me animando!"

#. cv/fld/jin_0201.at3 | 124 quadros | modo 2
msgctxt "290:0"
msgid "I don't have a partner to show, but a daringly sexy black!"
msgstr "Não tenho pra quem mostrar, mas preto ousado fica sexy!"

#. cv/fld/jin_0201.at3 | 70 quadros | modo 2
msgctxt "290:1"
msgid "I'm just wearing white though. Deal with it."
msgstr "Só que eu tô de branco. Lida com isso."

#. cv/btl/psl_1221_edit.at3 | 66 quadros | modo 1
msgctxt "291:1"
msgid "P-please be in more pain…!"
msgstr "P-por favor, sofra um pouco mais…!"

#. cv/btl/elp_1612.at3 | 60 quadros | modo 1
msgctxt "292:0"
msgid "Didn't even break a sweat."
msgstr "Nem suei."

#. cv/btl/gil_1704.at3 | 114 quadros | modo 1
msgctxt "293:0"
msgid "This is too easy. Shall we have\n  some fun with this, mongrel?  "
msgstr "Fácil demais. Vamos nos divertir um pouco,\ncriatura mestiça?"

#. se/eb_emi/7 | 24 quadros | modo 1
msgctxt "294:0"
msgid "I'll strike you down!"
msgstr "Vou abater você!"

#. cv/btl/kar_1091.at3 | 30 quadros | modo 1
msgctxt "295:0"
msgid "My sights are set…!"
msgstr "Alvo na mira…!"

#. cv/btl/elp_1720.at3 | 72 quadros | modo 1
msgctxt "296:0"
msgid "Here it comes…! Be careful, Master!"
msgstr "Lá vem…! Cuidado!"

#. cv/btl/tam_1500.at3 | 52 quadros | modo 1
msgctxt "297:0"
msgid "Ah ha, am I sparkling?"
msgstr "Ahá! Estou brilhando?"

#. cv/btl/elp_1620.at3 | 58 quadros | modo 1
msgctxt "298:0"
msgid "The curry was too spicy!"
msgstr "O curry estava picante demais!"

#. se/eb_ner/10 | 36 quadros | modo 1
msgctxt "299:0"
msgid "You may cheer for me."
msgstr "Podes torcer por mim."

#. se/eb_emi/15 | 24 quadros | modo 1
msgctxt "300:0"
msgid "Too obvious!"
msgstr "Óbvio demais!"

#. cv/btl/ner_1221_edit.at3 | 96 quadros | modo 1
msgctxt "301:1"
msgid "Let the curtains fall!\n    Rosa Ichthys!    "
msgstr "Que caiam as cortinas!\nRosa Ichthys!"

#. se/eb_el2/2 | 46 quadros | modo 1
msgctxt "302:0"
msgid "Break and shatter!"
msgstr "Rache e se despedace!"

#. cv/btl/gil_1803.at3 | 96 quadros | modo 1
msgctxt "303:0"
msgid "Be quick with your orders. I won't wait long."
msgstr "Dá logo as ordens. Não vou esperar muito."

#. cv/btl/kot_1210_edit.at3 | 130 quadros | modo 1
msgctxt "304:0"
msgid "Now… Move in―and strike!"
msgstr "Agora… Avance― e ataque!"

#. cv/btl/ner_1270_edit.at3 | 42 quadros | modo 1
msgctxt "305:1"
msgid "Fax Caelestis."
msgstr "Fax Caelestis."

#. cv/btl/ner_1270_edit.at3 | 140 quadros | modo 1
msgctxt "305:3"
msgid "Race, O stars! This very flame is my passion!"
msgstr "Correi, ó estrelas! Esta chama é minha paixão!"

#. cv/btl/elp_1100.at3 | 38 quadros | modo 1
msgctxt "306:0"
msgid "T-thanks."
msgstr "O-obrigada."

#. cv/btl/emi_2050.at3 | 44 quadros | modo 1
msgctxt "307:0"
msgid "I'll finish this before you can take a breath."
msgstr "Acabo com isso antes do seu próximo suspiro."

#. cv/btl/kar_1200_edit.at3 | 58 quadros | modo 1
msgctxt "308:0"
msgid "Sun, become my armor!"
msgstr "Sol, torna-te minha armadura!"

#. se/eb_elp/7 | 24 quadros | modo 1
msgctxt "309:0"
msgid "Bingo!"
msgstr "Bingo!"

#. cv/btl/ran_1800.at3 | 52 quadros | modo 1
msgctxt "310:0"
msgid "High-speed performance, start."
msgstr "Iniciar apresentação em alta velocidade."

#. se/eb_emi/6 | 24 quadros | modo 1
msgctxt "311:0"
msgid "You're mine!"
msgstr "Peguei você!"

#. cv/btl/tam3_1240_edit.at3 | 66 quadros | modo 1
msgctxt "312:1"
msgid "A void of ignorance weighs\n    upon the universe.    "
msgstr "Um vazio de ignorância pesa sobre o universo."

#. se/eb_gil/21 | 20 quadros | modo 1
msgctxt "313:0"
msgid "Huh."
msgstr "Hum."

#. cv/btl/tam_1830_mix.at3 | 166 quadros | modo 1
msgctxt "314:0"
msgid "Wooow. The yandere stalker has class changed\n      into the Livid Murderer class…      "
msgstr "Nooossa. A perseguidora yandere mudou\npra classe Assassina Furiosa…"

#. cv/btl/tam_1830_mix.at3 | 84 quadros | modo 1
msgctxt "314:1"
msgid "I suppose this is a glimpse into BB's\n            real nature.            "
msgstr "Pelo visto, é a verdadeira natureza\nda BB dando as caras."

#. cv/btl/tam_1830_mix.at3 | 116 quadros | modo 1
msgctxt "314:2"
msgid "Don't belittle me! I'm being serious here…"
msgstr "Não me subestime! Estou falando sério…"

#. cv/btl/tam_1830_mix.at3 | 188 quadros | modo 1
msgctxt "314:3"
msgid "This is my love, MY affection!\n    I'm nothing like BB!!    "
msgstr "Esse é o meu amor, o MEU afeto!\nEu não sou nada parecida com a BB!!"

#. cv/fld/jin_0107.at3 | 78 quadros | modo 2
msgctxt "315:0"
msgid "Hot voices are the BEST!"
msgstr "Vozes sexy são TUDO!"

#. cv/fld/jin_0107.at3 | 96 quadros | modo 2
msgctxt "315:1"
msgid "That's the only area where Karna scores high points…"
msgstr "É a única área em que o Karna pontua bem…"

#. cv/btl/ner_1400.at3 | 124 quadros | modo 1
msgctxt "316:0"
msgid "I guess my power wasn't enough…"
msgstr "Parece que minha força não bastou…"

#. cv/btl/emi_1091.at3 | 36 quadros | modo 1
msgctxt "317:0"
msgid "Not a bad call!"
msgstr "Nada mal essa decisão!"

#. cv/fld/tam_0631.at3 | 86 quadros | modo 1
msgctxt "318:0"
msgid "How is it? Do I look… cute?"
msgstr "E aí, eu fiquei… fofa?"

#. cv/btl/gil_1715.at3 | 88 quadros | modo 1
msgctxt "319:0"
msgid "Damn it! This is your fault for\n    being stingy with items!    "
msgstr "Maldição! A culpa é tua\npor economizares tantos itens!"

#. cv/fld/kot_0096.at3 | 68 quadros | modo 3
msgctxt "320:1"
msgid "Looking for a present, girl?"
msgstr "Procurando um presente, moça?"

#. cv/fld/tam_0630.at3 | 66 quadros | modo 1
msgctxt "321:0"
msgid "I've gotten so much more cute,\n  it's like a new beginning!  "
msgstr "Fiquei tão mais fofinha!\nÉ como um novo começo!"

#. cv/btl/elp_1211_edit.at3 | 82 quadros | modo 1
msgctxt "322:0"
msgid "The beat of love is a dragon scale～薗"
msgstr "O amor bate no ritmo das escamas de dragão～薗"

#. cv/btl/kia_1511.at3 | 34 quadros | modo 1
msgctxt "323:0"
msgid "How cruel of you～"
msgstr "Que crueldade a sua～"

#. cv/btl/ksk_1520.at3 | 50 quadros | modo 1
msgctxt "324:0"
msgid "To think you could surpass me…"
msgstr "Quem diria que você me superaria…"

#. cv/btl/emi_2030.at3 | 26 quadros | modo 1
msgctxt "325:0"
msgid "Can you keep up?"
msgstr "Consegue acompanhar?"

#. se/eb_tam3/4 | 24 quadros | modo 1
msgctxt "326:0"
msgid "Take that!"
msgstr "Toma!"

#. cv/fld/rin_09021.at3 | 44 quadros | modo 1
msgctxt "327:0"
msgid "Thank you, thank you!"
msgstr "Valeu, valeu!"

#. cv/btl/tam_1600.at3 | 112 quadros | modo 1
msgctxt "328:0"
msgid "Fantastic! Even my ears are ecstatic!"
msgstr "Fantástico! Até minhas orelhas vibraram!"

#. cv/btl/emi3_1710.at3 | 48 quadros | modo 1
msgctxt "329:0"
msgid "I didn't expect this much resistance…"
msgstr "Não esperava tanta resistência…"

#. cv/btl/emi3_1710.at3 | 55 quadros | modo 1
msgctxt "329:2"
msgid "This Holy Grail War is no cheap imitation."
msgstr "Esta Guerra do Santo Graal é pra valer."

#. cv/fld/gil_0200.at3 | 98 quadros | modo 2
msgctxt "330:0"
msgid "If you want that answer, you'll have to search on your own."
msgstr "Se queres essa resposta, terás de procurar por conta própria."

#. se/eb_cuu/6 | 24 quadros | modo 1
msgctxt "331:0"
msgid "Too weak!"
msgstr "Fraco demais!"

#. cv/btl/eli_1251_edit.at3 | 80 quadros | modo 1
msgctxt "332:0"
msgid "This'll be fun! Rock and roll!"
msgstr "Isso vai ser divertido! Rock and roll!"

#. cv/btl/eli_1251_edit.at3 | 68 quadros | modo 1
msgctxt "332:2"
msgid "Huh, you're firm, aren't you? Gyah!"
msgstr "Hã? Que firmeza, hein? Aaah!"

#. se/eb_tam3/12 | 30 quadros | modo 1
msgctxt "333:0"
msgid "Karma's retribution."
msgstr "A retribuição do carma."

#. cv/fld/gil_0601.at3 | 50 quadros | modo 1
msgctxt "334:0"
msgid "Sleep in that corner where you belong."
msgstr "Dorme naquele canto. É onde deves ficar."

#. cv/btl/emi_1720.at3 | 40 quadros | modo 1
msgctxt "335:0"
msgid "They're getting serious…"
msgstr "Estão começando a levar a sério…"

#. cv/btl/emi_1720.at3 | 33 quadros | modo 1
msgctxt "335:2"
msgid "Something's coming, Master!"
msgstr "Lá vem alguma coisa!"

#. se/eb_mll/107 | 23 quadros | modo 1
msgctxt "336:0"
msgid "And pose!"
msgstr "E pose!"

#. cv/btl/gil_1270_edit.at3 | 38 quadros | modo 1
msgctxt "337:0"
msgid "Chains of Heaven!"
msgstr "Correntes do Céu!"

#. cv/btl/el2_1500.at3 | 58 quadros | modo 1
msgctxt "338:0"
msgid "Fall, fall, FALL!"
msgstr "Caia, caia, CAIA!"

#. cv/btl/psl_1751.at3 | 60 quadros | modo 1
msgctxt "339:0"
msgid "Why is this happening…?"
msgstr "Por que isso está acontecendo…?"

#. cv/btl/psl_1751.at3 | 74 quadros | modo 1
msgctxt "339:1"
msgid "I don't understand, I don't understand!"
msgstr "Não entendo, não entendo!"

#. cv/btl/psl_1751.at3 | 38 quadros | modo 1
msgctxt "339:2"
msgid "I DON'T UNDERSTAND!!"
msgstr "Eu não ENTENDO!!"

#. cv/btl/el2_1240_edit.at3 | 42 quadros | modo 1
msgctxt "340:1"
msgid "Haaaa!"
msgstr "Haaaa!"

#. cv/btl/el2_1240_edit.at3 | 60 quadros | modo 1
msgctxt "340:2"
msgid "Yes… This sensation…!"
msgstr "Sim… Essa sensação…!"

#. cv/btl/eli_1751_mix.at3 | 109 quadros | modo 1
msgctxt "341:0"
msgid "This is bad. Are they strong\n    or just persistent?    "
msgstr "Que droga. São fortes ou só persistentes?"

#. cv/btl/eli_1751_mix.at3 | 142 quadros | modo 1
msgctxt "341:2"
msgid "      Lancer, get a grip!      \nUse your tail! Swing it around!"
msgstr "Lancer, se controla!\nUsa a cauda! Balança ela!"

#. cv/btl/eli_1751_mix.at3 | 150 quadros | modo 1
msgctxt "341:3"
msgid "I don't just show it whenever! What\nabout you? Give me more mana, Rin!"
msgstr "Eu não mostro quando bem entendem!\nE você? Me dá mais mana, Rin!"

#. cv/btl/adl_1710.at3 | 79 quadros | modo 1
msgctxt "342:0"
msgid "Shameful. Don't be a laughingstock, Kiara."
msgstr "Que vergonha. Não passe ridículo, Kiara."

#. cv/fld/kot_00932.at3 | 86 quadros | modo 3
msgctxt "343:0"
msgid "What a wise, young Master you are."
msgstr "Quanta sabedoria para alguém tão jovem."

#. se/eb_ner/29 | 39 quadros | modo 1
msgctxt "344:0"
msgid "Don't move!"
msgstr "Não te mexas!"

#. se/eb_mll/108 | 20 quadros | modo 1
msgctxt "345:0"
msgid "Back at you."
msgstr "Devolvo a gentileza."

#. cv/btl/mll_1092.at3 | 24 quadros | modo 1
msgctxt "346:0"
msgid "That's far enough!"
msgstr "Não vai passar daqui!"

#. cv/btl/twi_1700.at3 | 86 quadros | modo 1
msgctxt "347:0"
msgid "Everything's going smoothly.\n   Let's not slip up now.   "
msgstr "Tudo vai bem.\nNão vamos baixar a guarda agora."

#. cv/btl/el2_1220_edit.at3 | 48 quadros | modo 1
msgctxt "348:1"
msgid "None of this matters anymore!"
msgstr "Nada disso importa mais!"

#. cv/btl/emi_1920_mix.at3 | 150 quadros | modo 1
msgctxt "349:0"
msgid "As a public guardian who judged the evil\nof individuals, may I ask you a question?"
msgstr "Como guardião que julgava os males humanos,\nme permita uma pergunta."

#. cv/btl/emi_1920_mix.at3 | 100 quadros | modo 1
msgctxt "349:1"
msgid "    How long did you last under the    \nweight of all that self-righteousness?"
msgstr "Quanto tempo aguentou\nsob o peso da própria virtude?"

#. cv/btl/emi_1920_mix.at3 | 106 quadros | modo 1
msgctxt "349:2"
msgid "Until the day I died, of course."
msgstr "Até o dia em que morri, é claro."

#. cv/btl/emi_1920_mix.at3 | 112 quadros | modo 1
msgctxt "349:3"
msgid "I'd have quietly gone to Heaven if I ever\nstopped to think about what I was doing."
msgstr "Teria ido em paz pro Céu\nse tivesse parado pra pensar no que fazia."

#. cv/btl/emi_1920_mix.at3 | 130 quadros | modo 1
msgctxt "349:4"
msgid "                   I see.                   \nForgive me, that question was disrespectful."
msgstr "Entendo. Perdoe-me.\nA pergunta foi desrespeitosa."

#. cv/btl/emi_1920_mix.at3 | 82 quadros | modo 1
msgctxt "349:5"
msgid "Let me apologize with it with a victory\n       born from a worthy fight.       "
msgstr "Peço desculpas com uma vitória\nconquistada numa luta digna."

#. cv/btl/elp_1090.at3 | 36 quadros | modo 1
msgctxt "350:0"
msgid "OWWWW～!"
msgstr "AIIII～!"

#. cv/btl/rin2_1200_edit.at3 | 38 quadros | modo 1
msgctxt "351:0"
msgid "It's up to you now, Archer!"
msgstr "Agora é com você, Archer!"

#. se/eb_kar/17 | 24 quadros | modo 1
msgctxt "352:0"
msgid "Too slow!"
msgstr "Devagar demais!"

#. cv/btl/eli_1520.at3 | 52 quadros | modo 1
msgctxt "353:0"
msgid "This isn't how we rehearsed it!"
msgstr "Não foi assim que a gente ensaiou!"

#. cv/btl/kar_1511.at3 | 30 quadros | modo 1
msgctxt "354:0"
msgid "You've got good form."
msgstr "Boa postura."

#. cv/btl/emi3_1091.at3 | 24 quadros | modo 1
msgctxt "355:0"
msgid "I'll drive them out…!"
msgstr "Vou expulsá-los…!"

#. cv/btl/gil_1900_mix.at3 | 76 quadros | modo 1
msgctxt "356:0"
msgid "Archer, that's…!"
msgstr "Archer, é o…!"

#. cv/btl/gil_1900_mix.at3 | 200 quadros | modo 1
msgctxt "356:1"
msgid "Oh, I know who that is, all right.\n    King of Heroes, Gilgamesh!    "
msgstr "Ah, eu sei muito bem quem é.\nO Rei dos Heróis, Gilgamesh!"

#. cv/btl/gil_1900_mix.at3 | 74 quadros | modo 1
msgctxt "356:2"
msgid "I never thought I'd have to fight you again…"
msgstr "Nunca imaginei que teria de lutar\ncontra você de novo…"

#. cv/btl/gil_1900_mix.at3 | 180 quadros | modo 1
msgctxt "356:3"
msgid "Oh? Sounds like I gave this cur a good\n    thrashing in another timeline.    "
msgstr "Ora? Parece que dei uma boa surra\nneste cão em outra linha do tempo."

#. cv/btl/gil_1900_mix.at3 | 130 quadros | modo 1
msgctxt "356:4"
msgid "     Very well. In my other self's place,     \nI'll give you the chance to redeem your honor."
msgstr "Pois bem. Em nome do meu outro eu,\nte dou a chance de resgatar tua honra."

#. cv/btl/gil_1900_mix.at3 | 74 quadros | modo 1
msgctxt "356:5"
msgid "If a fake like you can, that is."
msgstr "Se uma falsificação como tu puder, claro."

#. cv/btl/emi_1710.at3 | 47 quadros | modo 1
msgctxt "357:0"
msgid "What're you doing? Get it together!"
msgstr "O que está fazendo? Se recomponha!"

#. se/eb_mll/112 | 23 quadros | modo 1
msgctxt "358:0"
msgid "Damn you!"
msgstr "Maldito!"

#. cv/btl/emi_1880_mix.at3 | 130 quadros | modo 1
msgctxt "359:0"
msgid "Your desire to overwrite your results\n        is incomprehensible.        "
msgstr "Não entendo essa vontade\nde sobrescrever o resultado."

#. cv/btl/emi_1880_mix.at3 | 196 quadros | modo 1
msgctxt "359:1"
msgid "BB, no, Moon Cell! Return to being a proper\n            measurement machine!            "
msgstr "BB, digo, Moon Cell! Volte a ser\num dispositivo de medição!"

#. cv/btl/emi_1880_mix.at3 | 234 quadros | modo 1
msgctxt "359:2"
msgid "Proper? You, who only perpetrate mistakes,\n      speak to me of what's proper?      "
msgstr "Voltar ao normal? Você, que só comete erros,\nquer me dizer o que é normal?"

#. cv/btl/emi_1880_mix.at3 | 132 quadros | modo 1
msgctxt "359:3"
msgid "I'll crush that hubris of yours like the\n           bugs that you are!           "
msgstr "Vou esmagar essa arrogância\njunto com os insetos que vocês são!"

#. cv/btl/twi_1521.at3 | 42 quadros | modo 1
msgctxt "360:0"
msgid "Sorry, Caster…"
msgstr "Desculpe, Caster…"

#. cv/fld/gil_0202.at3 | 110 quadros | modo 2
msgctxt "361:0"
msgid "Pleasure trips. No matter the era,"
msgstr "Passeios por prazer. Seja qual for a época,"

#. cv/fld/gil_0202.at3 | 90 quadros | modo 2
msgctxt "361:1"
msgid "I can't resist simple walks through the city."
msgstr "não resisto a uma simples volta pela cidade."

#. cv/fld/gil_0202.at3 | 110 quadros | modo 2
msgctxt "361:2"
msgid "Then again, I managed to rest long enough to fall to level 1."
msgstr "Por outro lado, descansei tanto que voltei ao nível 1."

#. cv/btl/tam_1401.at3 | 58 quadros | modo 1
msgctxt "362:1"
msgid "Please forgive me, Master…"
msgstr "Me perdoe, Mestre…"

#. cv/fld/ner_0100.at3 | 140 quadros | modo 2
msgctxt "363:0"
msgid "For now, you may call me Saber."
msgstr "Por enquanto, podes me chamar de Saber."

#. cv/fld/ner_0100.at3 | 158 quadros | modo 2
msgctxt "363:1"
msgid "When the time comes, I'm sure you'll remember my true name."
msgstr "Quando chegar a hora, vais lembrar meu Nome Verdadeiro."

#. cv/btl/ksk_1300_edit.at3 | 76 quadros | modo 1
msgctxt "364:1"
msgid "Now―this should bring you joy."
msgstr "Agora― isto deve te trazer alegria."

#. cv/btl/ksk_1300_edit.at3 | 66 quadros | modo 1
msgctxt "364:3"
msgid "I'm removing you from this universe."
msgstr "Vou tirar você deste universo."

#. cv/btl/ksk_1300_edit.at3 | 120 quadros | modo 1
msgctxt "364:5"
msgid "Operation: Cursed Cutting Crater."
msgstr "Operação: Cursed Cutting Crater."

#. cv/btl/ksk_1300_edit.at3 | 170 quadros | modo 1
msgctxt "364:7"
msgid "  Voices shall fall silent…  \nAs my shadow engulfs the world."
msgstr "As vozes se calarão…\nenquanto minha sombra engole o mundo."

#. cv/fld/eli_0100.at3 | 126 quadros | modo 2
msgctxt "365:0"
msgid "Dragon girl torture idol, Elizabeth Báthory!"
msgstr "A garota-dragão, idol da tortura,\nElizabeth Báthory!"

#. cv/fld/eli_0100.at3 | 64 quadros | modo 2
msgctxt "365:1"
msgid "I'll crack your heart right in two 鷙"
msgstr "Vou partir seu coração no meio鷙"

#. cv/btl/emi_1090.at3 | 38 quadros | modo 1
msgctxt "366:0"
msgid "Eh, we'll get by somehow."
msgstr "Bom, vamos dar um jeito."

#. cv/btl/kar_1754_mix.at3 | 164 quadros | modo 1
msgctxt "367:0"
msgid "         \"Do I sense defeat\"…?         \nNo, I consigned that sense to the reaper."
msgstr "“Pressinto a derrota”…?\nNão. Deixei esse sentimento com a morte."

#. cv/btl/kar_1754_mix.at3 | 84 quadros | modo 1
msgctxt "367:1"
msgid "Pfff, don't cut yourself on that edge!"
msgstr "Pfff, cuidado pra não se cortar de tão trevoso!"

#. se/eb_tam/23 | 24 quadros | modo 1
msgctxt "368:0"
msgid "Is that so?"
msgstr "Ah, é?"

#. cv/btl/adl_1541.at3 | 44 quadros | modo 1
msgctxt "369:0"
msgid "This is just sad!"
msgstr "Isso é de dar pena!"

#. se/eb_mll/109 | 22 quadros | modo 1
msgctxt "370:0"
msgid "Is that all?"
msgstr "Só isso?"

#. se/eb_kar/6 | 24 quadros | modo 1
msgctxt "371:0"
msgid "Try again!"
msgstr "Tente de novo!"

#. cv/btl/ner_1741.at3 | 140 quadros | modo 1
msgctxt "372:0"
msgid "You've got quite the discerning ears if you're\n      asking to hear my beautiful voice.      "
msgstr "Tens mesmo ouvidos exigentes\npara pedires minha bela voz."

#. cv/btl/ner_1741.at3 | 114 quadros | modo 1
msgctxt "372:1"
msgid "Unfortunately for you, you'll be the\n        one singing tonight.        "
msgstr "Para teu azar, serás tu quem canta hoje."

#. cv/fld/ran_0103.at3 | 196 quadros | modo 2
msgctxt "373:0"
msgid "B80/W58/H81. My creator settled on this size."
msgstr "B80/C58/Q81. Minha criadora escolheu essas medidas."

#. cv/fld/ran_0103.at3 | 68 quadros | modo 2
msgctxt "373:1"
msgid "I believe it was to optimize my movements."
msgstr "Creio que fosse para otimizar meus movimentos."

#. cv/btl/cuu_1800.at3 | 75 quadros | modo 1
msgctxt "374:0"
msgid "This'll be fun. I haven't had a one-on-one\n            fight in forever!            "
msgstr "Vai ser divertido. Faz séculos\nque não luto mano a mano!"

#. cv/btl/emi_1400.at3 | 42 quadros | modo 1
msgctxt "375:0"
msgid "Was I too reckless…?"
msgstr "Fui imprudente demais…?"

#. cv/fld/rin_0100a.at3 | 130 quadros | modo 2
msgctxt "376:0"
msgid "Rin Tohsaka. I'm fairly well known as a Spiritron Hacker."
msgstr "Tohsaka Rin. Tenho certa fama como hacker de Spiritrons."

#. se/eb_kar/13 | 24 quadros | modo 1
msgctxt "377:0"
msgid "Come."
msgstr "Venha."

#. cv/fld/kot_0097.at3 | 94 quadros | modo 3
msgctxt "378:0"
msgid "You must have a strong capitalist spirit"
msgstr "Você deve ter um forte espírito capitalista"

#. cv/fld/kot_0097.at3 | 62 quadros | modo 3
msgctxt "378:1"
msgid "to stick with me for this long!"
msgstr "para continuar comigo por tanto tempo!"

#. cv/btl/ner_1604.at3 | 60 quadros | modo 1
msgctxt "379:0"
msgid "I deem you worthy to become my empress!"
msgstr "És digna de ser minha imperatriz!"

#. cv/btl/ner_1121.at3 | 60 quadros | modo 1
msgctxt "380:0"
msgid "My loyalty is undying."
msgstr "Minha lealdade é eterna."

#. cv/btl/mll_1211_edit.at3 | 28 quadros | modo 1
msgctxt "381:1"
msgid "Time to raise the tempo."
msgstr "Hora de acelerar o ritmo."

#. cv/btl/psl_1210_edit.at3 | 76 quadros | modo 1
msgctxt "382:1"
msgid "Please… let me have them!"
msgstr "Por favor… me deixe ficar com eles!"

#. cv/btl/ner_1880_mix.at3 | 98 quadros | modo 1
msgctxt "383:0"
msgid "So those are your wings?"
msgstr "São essas as tuas asas?"

#. cv/btl/ner_1880_mix.at3 | 130 quadros | modo 1
msgctxt "383:1"
msgid "You have some gall to stand before\n     my Praetor in such form.     "
msgstr "Quanta ousadia em aparecer\ndiante do meu Maestro nessa forma."

#. cv/btl/ner_1880_mix.at3 | 114 quadros | modo 1
msgctxt "383:2"
msgid "Your mind and body have certainly\n    changed for the worst, BB.    "
msgstr "Mente e corpo mudaram para pior, BB."

#. cv/btl/ner_1880_mix.at3 | 250 quadros | modo 1
msgctxt "383:3"
msgid "    I do not understand how my form has    \nanything to do with how your Master feels."
msgstr "Não entendo o que minha forma tem\na ver com o que sente seu Mestre."

#. cv/btl/ner_1880_mix.at3 | 156 quadros | modo 1
msgctxt "383:4"
msgid "You two will always be mere,\n  unneeded variables to me.  "
msgstr "Vocês serão sempre variáveis\ndispensáveis para mim."

#. cv/btl/ner_1880_mix.at3 | 246 quadros | modo 1
msgctxt "383:5"
msgid "I see, sarcasm doesn't work well with you.\nThere's nothing left but to cut you down."
msgstr "Entendo, sarcasmo não funciona contigo.\nSó me resta te cortar."

#. cv/btl/ner_1880_mix.at3 | 130 quadros | modo 1
msgctxt "383:6"
msgid "Hitting a broken machine has always been\n   the best way to fix it, after all!   "
msgstr "Bater numa máquina quebrada\nsempre foi o melhor jeito de consertar!"

#. cv/btl/tam_1113.at3 | 46 quadros | modo 1
msgctxt "384:0"
msgid "Our love… priceless!"
msgstr "Nosso amor… não tem preço!"

#. cv/fld/mks_0102.at3 | 124 quadros | modo 2
msgctxt "385:0"
msgid "46kg. Heh, heheh."
msgstr "46 kg. Heh, hehe."

#. cv/fld/mks_0102.at3 | 136 quadros | modo 2
msgctxt "385:1"
msgid "Unlike my silly Senpai, my body's nice and tight."
msgstr "Meu corpo é firme e bem cuidado, ao contrário do seu, Senpai."

#. cv/btl/ner_1271_edit.at3 | 54 quadros | modo 1
msgctxt "386:1"
msgid "Let me confess my inner feelings…"
msgstr "Deixa-me confessar o que sinto…"

#. cv/btl/ner_1271_edit.at3 | 38 quadros | modo 1
msgctxt "386:3"
msgid "To put it simply…"
msgstr "Em poucas palavras…"

#. cv/btl/ner_1271_edit.at3 | 74 quadros | modo 1
msgctxt "386:5"
msgid "I love you, Praetor!!"
msgstr "Eu te amo, Maestro!!"

#. se/eb_ner/18 | 32 quadros | modo 1
msgctxt "387:0"
msgid "Was that it?"
msgstr "Era só isso?"

#. se/eb_mll/101 | 20 quadros | modo 1
msgctxt "388:0"
msgid "Deux."
msgstr "Deux."

#. cv/btl/ner_1100.at3 | 64 quadros | modo 1
msgctxt "389:0"
msgid "Mhm, do as you see fit."
msgstr "Umu, faz como achares melhor."

#. se/eb_gil/10 | 46 quadros | modo 1
msgctxt "390:0"
msgid "Time for repentance!"
msgstr "Hora de te arrependeres!"

#. cv/btl/ksk_1750.at3 | 154 quadros | modo 1
msgctxt "391:0"
msgid "   Like a candle before a storm.   \nI'll wipe you out in a single blow."
msgstr "Como uma vela diante da tempestade.\nVou apagar você de um só golpe."

#. cv/fld/emi_0900.at3 | 74 quadros | modo 2
msgctxt "392:0"
msgid "Cleaning up My Room."
msgstr "Arrumando o Meu Quarto."

#. cv/fld/emi_0900.at3 | 108 quadros | modo 2
msgctxt "392:1"
msgid "Some unnamed person here doesn't have the skills to do it."
msgstr "Tem gente aqui, sem citar nomes,\nque não leva jeito pra isso."

#. cv/btl/gil_2003.at3 | 52 quadros | modo 1
msgctxt "393:0"
msgid "Go forth with diligence."
msgstr "Avança com diligência."

#. cv/fld/jin_0200.at3 | 104 quadros | modo 2
msgctxt "394:0"
msgid "An angelic shota Servant would be mmm～"
msgstr "Um Servo shota todo angelical seria, hummm～"

#. cv/fld/jin_0200.at3 | 54 quadros | modo 2
msgctxt "394:1"
msgid "But no Servant like that would want me…"
msgstr "Mas um Servo assim nunca ia me querer…"

#. cv/btl/tam3_1090.at3 | 24 quadros | modo 1
msgctxt "395:0"
msgid "At once!"
msgstr "Imediatamente!"

#. cv/fld/kia_0101.at3 | 197 quadros | modo 2
msgctxt "396:0"
msgid "166cm. Sadly I look like a giant standing next to Andersen."
msgstr "166 cm. Infelizmente, pareço uma gigante ao lado de Andersen."

#. cv/btl/ner_1603.at3 | 60 quadros | modo 1
msgctxt "397:0"
msgid "I deem you worthy to become my husband!"
msgstr "És digno de ser meu marido!"

#. cv/fld/emi_0603.at3 | 50 quadros | modo 1
msgctxt "398:0"
msgid "It's always a relief when we get back home."
msgstr "É sempre um alívio voltar pra casa."

#. cv/fld/mks_0200.at3 | 118 quadros | modo 2
msgctxt "399:0"
msgid "Frankly, I don't ask a thing. Just that you please"
msgstr "Francamente, não peço nada. Só que"

#. cv/fld/mks_0200.at3 | 85 quadros | modo 2
msgctxt "399:1"
msgid "remain sitting obediently in the corner."
msgstr "fique aí no canto, sem dar trabalho."

#. cv/btl/gil_1400.at3 | 54 quadros | modo 1
msgctxt "400:0"
msgid "You're… kidding…"
msgstr "Só podes… estar brincando…"

#. cv/btl/ksk_1301_edit.at3 | 76 quadros | modo 1
msgctxt "401:1"
msgid "Now, it's time to rejoice!"
msgstr "Agora, é hora de comemorar!"

#. cv/btl/ksk_1301_edit.at3 | 66 quadros | modo 1
msgctxt "401:3"
msgid "Did you think you'd be able to escape?"
msgstr "Achou que conseguiria escapar?"

#. cv/btl/ksk_1301_edit.at3 | 100 quadros | modo 1
msgctxt "401:5"
msgid "I'll crush you like an apple."
msgstr "Vou esmagar você como uma maçã."

#. cv/btl/ksk_1301_edit.at3 | 100 quadros | modo 1
msgctxt "401:7"
msgid "Return to your mother, eternal infant."
msgstr "Volte para sua mãe, bebê eterno."

#. cv/btl/tam3_1710.at3 | 124 quadros | modo 1
msgctxt "402:0"
msgid "Argh… This enemy would be nothing if only\n            I had all my tails.            "
msgstr "Argh… Esse inimigo não seria nada\nse eu tivesse todas as minhas caudas."

#. cv/fld/tam_0106.at3 | 108 quadros | modo 2
msgctxt "403:0"
msgid "I hate to disappoint, but I wasn't born by two loving humans…"
msgstr "Foi mal decepcionar, mas eu não nasci\nde dois humanos apaixonados…"

#. cv/fld/tam_0106.at3 | 128 quadros | modo 2
msgctxt "403:1"
msgid "Ah, wait! Let's take the opportunity to just make it today then!"
msgstr "Ah, espera! Podemos aproveitar\ne fazer de hoje meu aniversário!"

#. cv/fld/tam_0106.at3 | 110 quadros | modo 2
msgctxt "403:2"
msgid "And YOU can be my presen―AGHYAA!"
msgstr "E você pode ser meu presen―AIIIAAA!"

#. cv/btl/ner_1110.at3 | 28 quadros | modo 1
msgctxt "404:0"
msgid "There's no hope for you!"
msgstr "Não há esperança para ti!"

#. cv/btl/tam_1094.at3 | 34 quadros | modo 1
msgctxt "405:0"
msgid "Let's go with the usual."
msgstr "Vamos com o de sempre."

#. cv/btl/tam_1110.at3 | 24 quadros | modo 1
msgctxt "406:0"
msgid "Thanks!"
msgstr "Valeu!"

#. cv/btl/rin2_1220_edit.at3 | 112 quadros | modo 1
msgctxt "407:0"
msgid "Take this! Seven Colors Cracker!!"
msgstr "Toma essa! Estouro das Sete Cores!!"

#. cv/btl/gil_1220_edit.at3 | 44 quadros | modo 1
msgctxt "408:0"
msgid "I suppose I should be careful."
msgstr "Suponho que devo ter cuidado."

#. cv/btl/ksk_1221_edit.at3 | 60 quadros | modo 1
msgctxt "409:0"
msgid "Everybody loves beams, rights?"
msgstr "Todo mundo adora um raio, né?"

#. se/eb_cuu/8 | 24 quadros | modo 1
msgctxt "410:0"
msgid "Back at ya!"
msgstr "Devolvo a gentileza!"

#. cv/btl/emi3_1400.at3 | 72 quadros | modo 1
msgctxt "411:0"
msgid "Damn… Not bad…"
msgstr "Droga… Nada mal…"

#. cv/fld/psl_0105.at3 | 87 quadros | modo 2
msgctxt "412:0"
msgid "I don't like being touched…"
msgstr "Não gosto que me toquem…"

#. cv/fld/psl_0105.at3 | 86 quadros | modo 2
msgctxt "412:1"
msgid "My breasts are especially ticklish…"
msgstr "Sinto cócegas, principalmente nos seios…"

#. cv/fld/ner_0202.at3 | 188 quadros | modo 2
msgctxt "413:0"
msgid "Bathing, especially enjoyable with flower petals."
msgstr "Tomar banho, sobretudo com pétalas de flores."

#. cv/fld/ner_0202.at3 | 158 quadros | modo 2
msgctxt "413:1"
msgid "I'd be more than happy to accept your thanks with a back scrub 鷙"
msgstr "Aceito teus agradecimentos se esfregares minhas costas鷙"

#. cv/btl/gil_1510.at3 | 30 quadros | modo 1
msgctxt "414:1"
msgid "What the hell are you doing!?"
msgstr "Que diabos estás fazendo!?"

#. cv/btl/emi3_1210_edit.at3 | 28 quadros | modo 1
msgctxt "415:0"
msgid "Trace on!"
msgstr "Trace on!"

#. cv/btl/cuu_1121.at3 | 46 quadros | modo 1
msgctxt "416:0"
msgid "You just won't let me die, will you?"
msgstr "Você não vai me deixar morrer, né?"

#. cv/btl/jin_1541.at3 | 60 quadros | modo 1
msgctxt "417:0"
msgid "Everything's comin' up Jinako!"
msgstr "Tá tudo dando certo pra Jinako!"

#. cv/btl/ksk_1800.at3 | 80 quadros | modo 1
msgctxt "418:0"
msgid "Starting synchronization with the Moon Cell."
msgstr "Iniciando sincronização com o Moon Cell."

#. cv/btl/ksk_1800.at3 | 50 quadros | modo 1
msgctxt "418:1"
msgid "Let us commence your demise."
msgstr "Vamos dar início à sua extinção."

#. se/eb_mll/100 | 20 quadros | modo 1
msgctxt "419:0"
msgid "Un."
msgstr "Un."

#. cv/btl/emi3_1700.at3 | 40 quadros | modo 1
msgctxt "420:0"
msgid "We'll shoot them down in no time, Rin."
msgstr "Vamos derrubá-los num instante, Rin."

#. cv/btl/kar_1510.at3 | 43 quadros | modo 1
msgctxt "421:0"
msgid "Hmph, you're pretty good."
msgstr "Humph, você é bem capaz."

#. cv/btl/tam_2000.at3 | 60 quadros | modo 1
msgctxt "422:0"
msgid "Ehh, as long as we win."
msgstr "É, contanto que a gente ganhe."

#. cv/btl/kia_1110.at3 | 39 quadros | modo 1
msgctxt "423:0"
msgid "Star performer coming through!"
msgstr "Com licença, chegou a estrela do show!"

#. cv/btl/tam_1731.at3 | 112 quadros | modo 1
msgctxt "424:0"
msgid "Okay! I can't contain myself! Can I go\n  full-throttle now please, Master?  "
msgstr "Pronto! Não consigo me segurar!\nPosso dar tudo de mim, Mestre?"

#. cv/btl/psl_1800.at3 | 148 quadros | modo 1
msgctxt "425:0"
msgid "…I'm sorry. Please, don't break too\n            easily, okay?            "
msgstr "…desculpe. Por favor, não\nse quebre tão fácil, tá?"

#. cv/btl/rob_1700.at3 | 136 quadros | modo 1
msgctxt "426:0"
msgid "Haste makes waste, you know. I'll corner you\n        carefully and methodically.        "
msgstr "A pressa é inimiga da perfeição.\nVou cercar você com toda a calma."

#. cv/btl/tam3_1100.at3 | 46 quadros | modo 1
msgctxt "427:0"
msgid "You have my thanks, Master."
msgstr "Meus agradecimentos."

#. cv/btl/gil_1714.at3 | 108 quadros | modo 1
msgctxt "428:0"
msgid "Force yourself to stand!\nIt's too early to fall!"
msgstr "Força-te a levantar! É cedo demais para cair!"

#. se/eb_psl/16 | 26 quadros | modo 1
msgctxt "429:0"
msgid "N-no!"
msgstr "N-não!"

#. cv/btl/gil_1890_mix.at3 | 170 quadros | modo 1
msgctxt "430:0"
msgid "Preferences aside, what a magnificent\n      metamorphosis, Sessyoin.      "
msgstr "Gostos à parte, que metamorfose magnífica,\nSessyoin."

#. cv/btl/gil_1890_mix.at3 | 134 quadros | modo 1
msgctxt "430:1"
msgid "You've certainly showed me the result of\n      taking desire to its extreme.      "
msgstr "Mostraste bem o resultado\nde levar o desejo ao extremo."

#. cv/btl/gil_1890_mix.at3 | 278 quadros | modo 1
msgctxt "430:2"
msgid "Ahhh, I'm honored, King of Heroes. So you\n   understand and approve of me, then?   "
msgstr "Ah, que honra, Rei dos Heróis.\nEntão você me compreende e me aprova?"

#. cv/btl/gil_1890_mix.at3 | 270 quadros | modo 1
msgctxt "430:3"
msgid "Now―will you accept my love and melt into me\n      like all the Earthly kings have?      "
msgstr "Então aceite meu amor e se dissolva em mim,\ncomo todos os reis da Terra."

#. cv/btl/gil_1890_mix.at3 | 144 quadros | modo 1
msgctxt "430:4"
msgid "I refuse. Only a dog would eat slop like that."
msgstr "Recuso. Só um cão comeria essa lavagem."

#. cv/btl/gil_1890_mix.at3 | 184 quadros | modo 1
msgctxt "430:5"
msgid "Avatar of womanhood: I have no interest in\n          desire without future.          "
msgstr "Avatar da feminilidade,\nnão me interessa um desejo sem futuro."

#. cv/btl/gil_1890_mix.at3 | 86 quadros | modo 1
msgctxt "430:6"
msgid "Fall back into the trash heaps of Earth\n           where you belong.           "
msgstr "Volta ao lixo da Terra, de onde vieste."

#. cv/btl/adl_1210_edit.at3 | 86 quadros | modo 1
msgctxt "431:1"
msgid "Gerda's Tears, melt her heart!"
msgstr "Lágrimas de Gerda, derretam seu coração!"

#. se/eb_eli/0 | 24 quadros | modo 1
msgctxt "432:0"
msgid "Nuisance!"
msgstr "Que incômodo!"

#. cv/btl/kar_1300_edit.at3 | 60 quadros | modo 1
msgctxt "433:1"
msgid "Know the mercy of the King of Gods."
msgstr "Conheça a misericórdia do Rei dos Deuses."

#. cv/btl/kar_1300_edit.at3 | 64 quadros | modo 1
msgctxt "433:3"
msgid "Watch closely, Indra."
msgstr "Observe bem, Indra."

#. cv/btl/kar_1300_edit.at3 | 80 quadros | modo 1
msgctxt "433:5"
msgid "One hit will lead to extinction."
msgstr "Um só golpe levará à extinção."

#. cv/btl/kar_1300_edit.at3 | 88 quadros | modo 1
msgctxt "433:7"
msgid "Burn, Vasavi Shakti!"
msgstr "Arda, Vasavi Shakti!"

#. cv/btl/kar_1300_edit.at3 | 88 quadros | modo 1
msgctxt "433:9"
msgid "Hmph. Farewell."
msgstr "Humph. Adeus."

#. cv/btl/mll_1231_edit.at3 | 28 quadros | modo 1
msgctxt "434:1"
msgid "Glissade～"
msgstr "Glissade～"

#. cv/btl/mll_1231_edit.at3 | 38 quadros | modo 1
msgctxt "434:3"
msgid "You should feel honored."
msgstr "Considere isso uma honra."

#. cv/btl/tam_1095.at3 | 42 quadros | modo 1
msgctxt "435:0"
msgid "I won't leave any scraps behind!"
msgstr "Não vou deixar sobrar nada!"

#. cv/fld/kot_00922.at3 | 86 quadros | modo 3
msgctxt "436:0"
msgid "I'll gladly buy your item for cheap."
msgstr "Terei prazer em comprar seu item baratinho."

#. cv/btl/tam3_1200_edit.at3 | 54 quadros | modo 1
msgctxt "437:0"
msgid "Your hatred sustains me."
msgstr "Seu ódio me sustenta."

#. cv/fld/kot_0093.at3 | 72 quadros | modo 3
msgctxt "438:0"
msgid "I await your extravagant, unrestrained purchasing."
msgstr "Aguardo suas compras\nextravagantes e sem limites."

#. cv/btl/gil_1731.at3 | 140 quadros | modo 1
msgctxt "439:0"
msgid "A reward for you. I'll show you\n  mankind's most ancient hell!  "
msgstr "Uma recompensa. Vou te mostrar\no inferno mais antigo da humanidade!"

#. se/eb_gil/28 | 36 quadros | modo 1
msgctxt "440:0"
msgid "You bastard!"
msgstr "Desgraçado!"

#. cv/btl/ner_1220_edit.at3 | 96 quadros | modo 1
msgctxt "441:1"
msgid "My blade dances like petals fall!\n          Rosa Ichthys!          "
msgstr "Minha lâmina dança como pétalas ao cair!\nRosa Ichthys!"

#. cv/btl/mks_1230_edit.at3 | 64 quadros | modo 1
msgctxt "442:1"
msgid "Now, come out!"
msgstr "Agora, apareça!"

#. cv/btl/mks_1230_edit.at3 | 42 quadros | modo 1
msgctxt "442:3"
msgid "Become a little piggy for me 鷙"
msgstr "Vire um porquinho pra mim鷙"

#. se/eb_tam3/11 | 30 quadros | modo 1
msgctxt "443:0"
msgid "And back to you."
msgstr "Devolvo o favor."

#. cv/btl/tam_2061.at3 | 170 quadros | modo 1
msgctxt "444:0"
msgid "My steps are short and so are my clothes.\n      I'm always a girl of spring～      "
msgstr "Passinhos curtos e roupinhas também.\nSou uma eterna garota da primavera～"

#. cv/btl/ner_1600.at3 | 64 quadros | modo 1
msgctxt "445:0"
msgid "That wasn't even a warmup."
msgstr "Isso nem serviu de aquecimento."

#. se/eb_eli/8 | 24 quadros | modo 1
msgctxt "446:0"
msgid "Third-rate!"
msgstr "De terceira categoria!"

#. cv/btl/el2_1752.at3 | 100 quadros | modo 1
msgctxt "447:0"
msgid "I'll allow you the honor of hearing\n    Earth's number one hit song!    "
msgstr "Vou lhe dar a honra de ouvir\no maior sucesso da Terra!"

#. se/eb_kar/7 | 24 quadros | modo 1
msgctxt "448:0"
msgid "Katsu!"
msgstr "Katsu!"

#. cv/fld/kia_0103.at3 | 224 quadros | modo 2
msgctxt "449:0"
msgid "B96/W58/H86… I believe? But, those are just numbers, after all."
msgstr "B96/C58/Q86… creio. Afinal, são só números."

#. cv/fld/kia_0103.at3 | 194 quadros | modo 2
msgctxt "449:1"
msgid "It'd be easier if you verified with your own eyes…"
msgstr "Seria mais fácil conferir com os próprios olhos…"

#. cv/btl/eli_1300_edit.at3 | 46 quadros | modo 1
msgctxt "450:1"
msgid "Time to lower the curtains."
msgstr "Hora de baixar a cortina."

#. cv/btl/eli_1300_edit.at3 | 72 quadros | modo 1
msgctxt "450:2"
msgid "Listen to my special number!"
msgstr "Escute meu número especial!"

#. cv/btl/gil_1910_mix.at3 | 186 quadros | modo 1
msgctxt "451:0"
msgid "   I know what makes this guy tick. Quick,   \ntake him out while he's still toying with us!"
msgstr "Conheço bem esse cara. Rápido,\nacabe com ele enquanto brinca conosco!"

#. cv/btl/gil_1910_mix.at3 | 160 quadros | modo 1
msgctxt "451:1"
msgid "With pleasure. I'll take every last gold coin\n     and leave him naked in the streets!     "
msgstr "Com prazer. Vou tomar até a última moeda\ne largá-lo nu na rua!"

#. cv/btl/gil_1910_mix.at3 | 88 quadros | modo 1
msgctxt "451:2"
msgid "What a vulgar lot…"
msgstr "Que gente vulgar…"

#. cv/btl/gil_1910_mix.at3 | 212 quadros | modo 1
msgctxt "451:3"
msgid "Don't get the wrong idea, mongrel.\nI have no connection to these guys!"
msgstr "Não te enganes, criatura mestiça.\nNão tenho ligação com essa gente!"

#. cv/btl/tam_1712.at3 | 80 quadros | modo 1
msgctxt "452:0"
msgid "Heal! Heal me please, Master!!"
msgstr "Cura! Me cure, por favor, Mestre!!"

#. cv/btl/gil_1094.at3 | 34 quadros | modo 1
msgctxt "453:0"
msgid "Fall before me!"
msgstr "Cai diante de mim!"

#. se/eb_rob/7 | 24 quadros | modo 1
msgctxt "454:0"
msgid "Don't fall asleep!"
msgstr "Não vai dormir!"

#. se/eb_mks/6 | 38 quadros | modo 1
msgctxt "455:0"
msgid "It's a punishment game, you know!"
msgstr "É um jogo de punição, viu!"

#. cv/btl/ksk_1751.at3 | 90 quadros | modo 1
msgctxt "456:0"
msgid "The difference in power between us should\n            be clear by now…            "
msgstr "A diferença de poder entre nós\njá devia estar clara…"

#. cv/btl/ksk_1751.at3 | 48 quadros | modo 1
msgctxt "456:1"
msgid "…but how are you still standing!?"
msgstr "…então como você ainda está de pé!?"

#. cv/fld/kot_00915.at3 | 36 quadros | modo 3
msgctxt "457:0"
msgid "Welcome."
msgstr "Boas-vindas."

#. cv/btl/kia_1230_edit.at3 | 168 quadros | modo 1
msgctxt "458:0"
msgid "\"All things are without a self \"? Hogwash.\n\"Virtue in understanding\"? Snuff the idea."
msgstr "“Nada tem um eu”? Bobagem.\n“Virtude na compreensão”? Esqueça."

#. cv/btl/kia_1230_edit.at3 | 84 quadros | modo 1
msgctxt "458:1"
msgid "C'mon, just let lust overload your six senses."
msgstr "Vamos, deixe o desejo\ninundar seus seis sentidos."

#. cv/btl/leo_1210_edit.at3 | 80 quadros | modo 1
msgctxt "459:1"
msgid "Simultaneous damage and stun!"
msgstr "Dano e atordoamento simultâneos!"

#. cv/btl/mll_1753.at3 | 74 quadros | modo 1
msgctxt "460:0"
msgid "You just don't give up…!\nYou WANT me to hate you!?"
msgstr "Você não desiste…!\nQuer que eu odeie você!?"

#. cv/btl/ner_1301_edit.at3 | 40 quadros | modo 1
msgctxt "461:1"
msgid "Behold my genius!"
msgstr "Contemplem minha genialidade!"

#. cv/btl/ner_1301_edit.at3 | 60 quadros | modo 1
msgctxt "461:3"
msgid "Listen to the thunderous applause!"
msgstr "Ouçam o aplauso estrondoso!"

#. cv/btl/ner_1301_edit.at3 | 60 quadros | modo 1
msgctxt "461:5"
msgid "The glory of the Empire is here!"
msgstr "A glória do Império está aqui!"

#. cv/btl/ner_1301_edit.at3 | 62 quadros | modo 1
msgctxt "461:7"
msgid "Throw open the doors like a flower in bloom"
msgstr "Que as portas se abram como uma flor"

#. cv/btl/ner_1301_edit.at3 | 90 quadros | modo 1
msgctxt "461:9"
msgid "to my Golden Theater!"
msgstr "para o meu Teatro Dourado!"

#. cv/btl/tam_1805.at3 | 66 quadros | modo 1
msgctxt "462:0"
msgid "I wonder what I should cook after this…"
msgstr "O que será que eu cozinho depois disso…?"

#. cv/fld/kot_00911.at3 | 112 quadros | modo 3
msgctxt "463:0"
msgid "\"Ingot.\" What a lovely ring it has."
msgstr "“Lingote.” Que palavra agradável."

#. cv/fld/kot_00911.at3 | 26 quadros | modo 3
msgctxt "463:1"
msgid "I can't get enough."
msgstr "Não me canso disso."

#. cv/fld/eli_0106.at3 | 144 quadros | modo 2
msgctxt "464:0"
msgid "May 17th. Please leave all presents with my manager."
msgstr "17 de maio. Deixem os presentes com meu agente."

#. cv/btl/gaw_1400.at3 | 120 quadros | modo 1
msgctxt "465:0"
msgid "          Curse you…          \nThis regret… will haunt me…!"
msgstr "Maldição… Este remorso… vai me assombrar…!"

#. cv/btl/gaw2_1750.at3 | 102 quadros | modo 1
msgctxt "466:0"
msgid "Contracts are absolute.\nAccept your obligation!"
msgstr "Contratos são absolutos.\nCumpra sua obrigação!"

#. cv/btl/kar_1102.at3 | 28 quadros | modo 1
msgctxt "467:0"
msgid "We're losing."
msgstr "Estamos perdendo."

#. cv/btl/ner_1401.at3 | 200 quadros | modo 1
msgctxt "468:0"
msgid "I'm ashamed… You weren't able to count on me…"
msgstr "Que vergonha… Não pudeste contar comigo…"

#. cv/fld/kia_0102.at3 | 214 quadros | modo 2
msgctxt "469:0"
msgid "Last time I measured I was… 49kg, I think?"
msgstr "Da última vez que me pesei, eram… 49 kg, creio."

#. cv/fld/kia_0102.at3 | 134 quadros | modo 2
msgctxt "469:1"
msgid "Hehe, if you really want to know, you're welcome to pick me up鷙"
msgstr "Hehe, se tanto deseja saber, fique à vontade para me erguer鷙"

#. se/eb_gaw2/6 | 27 quadros | modo 1
msgctxt "470:0"
msgid "Your money is mine!"
msgstr "Seu dinheiro é meu!"

#. se/eb_tam3/14 | 26 quadros | modo 1
msgctxt "471:0"
msgid "That won't work."
msgstr "Não vai funcionar."

#. cv/btl/kot_1700.at3 | 88 quadros | modo 1
msgctxt "472:0"
msgid "       How disappointing.       \nGo level up and try again later."
msgstr "Que decepção.\nSuba de nível e tente de novo."

#. cv/btl/tam_1501.at3 | 50 quadros | modo 1
msgctxt "473:0"
msgid "That feels sooo good～!"
msgstr "Ai, que delíciaaa～!"

#. cv/btl/tam_1870_mix.at3 | 84 quadros | modo 1
msgctxt "474:0"
msgid "You'd make just the perfect power source."
msgstr "Você daria uma fonte de energia perfeita."

#. cv/btl/tam_1870_mix.at3 | 148 quadros | modo 1
msgctxt "474:1"
msgid "I'll drain you to the bone and restore all\n           the strength I lost.           "
msgstr "Vou sugar você até os ossos e recuperar\ntoda a força que perdi."

#. cv/btl/tam_1870_mix.at3 | 138 quadros | modo 1
msgctxt "474:2"
msgid "Hmph. Nothing you've ever possessed\n      came from you yourself.      "
msgstr "Hmph. Tudo o que você tem veio dos outros."

#. cv/btl/tam_1870_mix.at3 | 92 quadros | modo 1
msgctxt "474:3"
msgid "Your body is borrowed. Your levels, borrowed."
msgstr "Seu corpo é emprestado. Seus níveis também."

#. cv/btl/tam_1870_mix.at3 | 108 quadros | modo 1
msgctxt "474:4"
msgid "I won't yield my darling to such a woman!"
msgstr "Não vou entregar meu bem pra uma mulher dessas!"

#. se/eb_eli/11 | 24 quadros | modo 1
msgctxt "475:0"
msgid "How could you!?"
msgstr "Como pôde!?"

#. cv/btl/cuu_1400.at3 | 144 quadros | modo 1
msgctxt "476:0"
msgid "Alright… I'm pretty satisfied…\n    You really gave me hell…    "
msgstr "Certo… Até que valeu a pena…\nVocê me deu um trabalho danado…"

#. se/eb_el2/5 | 23 quadros | modo 1
msgctxt "477:0"
msgid "Eyesore!"
msgstr "Que feiura!"

#. cv/btl/el2_1251_edit.at3 | 55 quadros | modo 1
msgctxt "478:0"
msgid "I'm coming to defile you 鷙"
msgstr "Vou aí te profanar鷙"

#. cv/btl/el2_1251_edit.at3 | 33 quadros | modo 1
msgctxt "478:1"
msgid "Just let it happen!"
msgstr "Deixa acontecer!"

#. cv/btl/el2_1251_edit.at3 | 74 quadros | modo 1
msgctxt "478:3"
msgid "W-well then, had enough?"
msgstr "E-então, já chega pra você?"

#. cv/btl/tam_1920_mix.at3 | 98 quadros | modo 1
msgctxt "479:0"
msgid "This one's got a rather bubbly personality."
msgstr "Essa daí é bem animadinha."

#. cv/btl/tam_1920_mix.at3 | 94 quadros | modo 1
msgctxt "479:1"
msgid "…is that how you really are, Caster?"
msgstr "…você é assim mesmo, Caster?"

#. cv/btl/tam_1920_mix.at3 | 204 quadros | modo 1
msgctxt "479:2"
msgid "Um… I, well… L-let's focus on winning,\n              okay, Master?              "
msgstr "Hum… Eu, bem… V-vamos focar em ganhar,\npode ser, Mestre?"

#. cv/btl/tam_1920_mix.at3 | 176 quadros | modo 1
msgctxt "479:3"
msgid "Bleh～ Was I always that dishonest with myself?\n        Ugh, not what I was hoping for…        "
msgstr "Bleh～ Sempre menti assim pra mim mesma?\nAff, esperava mais…"

#. cv/btl/tam_1920_mix.at3 | 88 quadros | modo 1
msgctxt "479:4"
msgid "Okay, let's rip the disguise off this monster鷙"
msgstr "Vamos arrancar o disfarce desse monstro鷙"

#. cv/btl/tam3_1800.at3 | 58 quadros | modo 1
msgctxt "480:0"
msgid "Please let me handle this, Master."
msgstr "Deixe comigo, meu bem."

#. cv/btl/ran_1710.at3 | 118 quadros | modo 1
msgctxt "481:0"
msgid "Have we reached the limit of Lancer's singing?"
msgstr "Chegamos ao limite vocal de Lancer?"

#. cv/btl/emi_1940.at3 | 66 quadros | modo 1
msgctxt "482:0"
msgid "Now, let's get this party started, Master!"
msgstr "Então, vamos começar a festa!"

#. cv/btl/rob_1750.at3 | 90 quadros | modo 1
msgctxt "483:0"
msgid "What's going on with you over there?"
msgstr "O que tá acontecendo aí com você?"

#. cv/btl/rob_1750.at3 | 96 quadros | modo 1
msgctxt "483:1"
msgid "Feeling bad for a Servant at death's\n         door or something?         "
msgstr "Com pena de um Servo à beira da morte?"

#. cv/btl/emi3_1101.at3 | 44 quadros | modo 1
msgctxt "484:0"
msgid "As expected from my Master."
msgstr "Como eu esperava de você."

#. cv/btl/ner_1092.at3 | 46 quadros | modo 1
msgctxt "485:0"
msgid "Mhm. Leave it to me."
msgstr "Umu. Deixa comigo."

#. cv/btl/leo_1200_edit.at3 | 52 quadros | modo 1
msgctxt "486:0"
msgid "I will not tolerate your cheating."
msgstr "Não vou tolerar trapaça."

#. cv/btl/kar_1201_edit.at3 | 56 quadros | modo 1
msgctxt "487:0"
msgid "Protect me, Kundala!"
msgstr "Proteja-me, Kundala!"

#. cv/btl/jin_1221_edit.at3 | 32 quadros | modo 1
msgctxt "488:1"
msgid "IF YOU WORK, YOU…"
msgstr "SE você TRABALHAR…"

#. cv/btl/ner_1094.at3 | 40 quadros | modo 1
msgctxt "489:0"
msgid "Gaze upon me!"
msgstr "Contempla-me!"

#. cv/btl/cuu_1750_mix.at3 | 80 quadros | modo 1
msgctxt "490:0"
msgid "See, you can do it if you try, Lancer."
msgstr "Viu? Quando se esforça, você consegue, Lancer."

#. cv/btl/cuu_1750_mix.at3 | 116 quadros | modo 1
msgctxt "490:1"
msgid "No shit! It's just that your calls keep\n            tripping me up!            "
msgstr "É claro, porra!\nSuas ordens é que me atrapalham!"

#. cv/btl/gil_1880_mix.at3 | 234 quadros | modo 1
msgctxt "491:0"
msgid "Gilgamesh… I do not understand your desire to\n destroy me when you are an arbiter yourself. "
msgstr "Gilgamesh… Também és um árbitro.\nPor que desejas me destruir?"

#. cv/btl/gil_1880_mix.at3 | 126 quadros | modo 1
msgctxt "491:1"
msgid "You and I should share the same view point."
msgstr "Deveríamos ter o mesmo ponto de vista."

#. cv/btl/gil_1880_mix.at3 | 198 quadros | modo 1
msgctxt "491:2"
msgid "Don't make me laugh. We both want to observe\n    until the end, that much is correct.    "
msgstr "Não me faças rir. Ambos queremos observar\naté o fim, nisso tens razão."

#. cv/btl/gil_1880_mix.at3 | 166 quadros | modo 1
msgctxt "491:3"
msgid "However, you look upon mankind with disgust,\n   whereas I enjoy the history they make.   "
msgstr "Mas olhas a humanidade com repulsa.\nEu aprecio a história que ela constrói."

#. cv/btl/gil_1880_mix.at3 | 134 quadros | modo 1
msgctxt "491:4"
msgid "That seems plenty reason for us to fight."
msgstr "Isso já é razão de sobra para lutarmos."

#. cv/btl/gil_1880_mix.at3 | 110 quadros | modo 1
msgctxt "491:5"
msgid "  We were destined to be  \nbitter rivals, Moon Cell!"
msgstr "Estava escrito que seríamos rivais, Moon Cell!"

#. se/eb_elp/0 | 24 quadros | modo 1
msgctxt "492:0"
msgid "Nuisance!"
msgstr "Que incômodo!"

#. cv/btl/cuu_1230_edit.at3 | 26 quadros | modo 1
msgctxt "493:1"
msgid "Time to start getting serious."
msgstr "Hora de levar isso a sério."

#. cv/btl/kia_1091.at3 | 30 quadros | modo 1
msgctxt "494:0"
msgid "Please be gentle."
msgstr "Peço que seja gentil."

#. cv/btl/kia_1756_mix.at3 | 190 quadros | modo 1
msgctxt "495:0"
msgid "Stand back, Andersen. Unless you want to be\n      swept up inside of me as well?      "
msgstr "Recue, Andersen. Ou também quer\nque eu o arraste para dentro de mim?"

#. cv/btl/kia_1756_mix.at3 | 70 quadros | modo 1
msgctxt "495:1"
msgid "From the bottom of my heart;\n      no way in hell!      "
msgstr "Do fundo do coração,\nnem fodendo!"

#. cv/btl/kia_1756_mix.at3 | 56 quadros | modo 1
msgctxt "495:2"
msgid "I'll be hiding in my book till you're done!"
msgstr "Vou me esconder no livro até você terminar!"

#. cv/btl/tam_1910_mix.at3 | 156 quadros | modo 1
msgctxt "496:0"
msgid "Do not hold back. This is do-or-die, Lancer!"
msgstr "Vá com tudo. É matar ou morrer, Lancer!"

#. cv/btl/tam_1910_mix.at3 | 92 quadros | modo 1
msgctxt "496:1"
msgid "It's not often you tell me to\n   take 'em straight down.   "
msgstr "Você quase nunca pede pra ir direto à luta."

#. cv/btl/tam_1910_mix.at3 | 80 quadros | modo 1
msgctxt "496:2"
msgid "She must be tougher than she looks."
msgstr "Ela deve ser mais forte do que parece."

#. cv/btl/tam_1910_mix.at3 | 126 quadros | modo 1
msgctxt "496:3"
msgid "Ehh? Am I being treated as the bad guy here?"
msgstr "Hein? Aqui eu é que sou a vilã?"

#. cv/btl/gil_1730.at3 | 146 quadros | modo 1
msgctxt "497:0"
msgid "Use the Key of the King's Law, Bab-ilu,\n  and open the gates to my treasury!  "
msgstr "Usa Bab-ilu, a Chave da Lei do Rei,\ne abre os portões do meu tesouro!"

#. cv/btl/gil_1802.at3 | 92 quadros | modo 1
msgctxt "498:0"
msgid "Now then, will this even count as a battle?"
msgstr "Pois bem, isso sequer conta como batalha?"

#. se/eb_tam/11 | 28 quadros | modo 1
msgctxt "499:0"
msgid "Observe!"
msgstr "Veja só!"

#. cv/btl/emi3_1220_edit.at3 | 34 quadros | modo 1
msgctxt "500:1"
msgid "I'll have you rethink your strategy."
msgstr "Vou fazer você repensar sua estratégia."

#. cv/btl/mks_1520.at3 | 56 quadros | modo 1
msgctxt "501:0"
msgid "I-I'll remember this!!"
msgstr "E-eu vou me lembrar disso!!"

#. cv/btl/kia_1100.at3 | 74 quadros | modo 1
msgctxt "502:0"
msgid "Ahhh, I can feel it penetrating me to my core…"
msgstr "Ahhh, sinto isso penetrar até o fundo…"

#. se/eb_kar/9 | 24 quadros | modo 1
msgctxt "503:0"
msgid "Not good enough!"
msgstr "Não é o bastante!"

#. cv/btl/psl_1954.at3 | 148 quadros | modo 1
msgctxt "504:0"
msgid "That Servant… is in my way. In OUR way."
msgstr "Aquele Servo… está no meu caminho. No NOSSO."

#. cv/btl/psl_1954.at3 | 112 quadros | modo 1
msgctxt "504:2"
msgid "I can just get rid of them… right?"
msgstr "Posso só me livrar dele… não posso?"

#. cv/btl/gil_1860_mix.at3 | 86 quadros | modo 1
msgctxt "505:0"
msgid "You know, this might actually be fate."
msgstr "Sabe, talvez isso seja mesmo o destino."

#. cv/btl/gil_1860_mix.at3 | 244 quadros | modo 1
msgctxt "505:1"
msgid "My final opponent is the King of Kings! Maybe\n  I can call myself a real Robin Hood now.  "
msgstr "Meu último adversário é o Rei dos Reis!\nAgora posso me chamar de Robin Hood."

#. cv/btl/gil_1860_mix.at3 | 200 quadros | modo 1
msgctxt "505:2"
msgid "  Hmm. I'm sure you're aware, but it's not  \npossible for a fake to become the real thing."
msgstr "Hum. Já deves saber que uma falsificação\njamais se torna verdadeira."

#. cv/btl/gil_1860_mix.at3 | 240 quadros | modo 1
msgctxt "505:3"
msgid "But. If you manage to kill me, then it might\nas well be true. Do you wish to try, mongrel?"
msgstr "Mas, se me matares, talvez se torne verdade.\nQueres tentar, criatura mestiça?"

#. cv/btl/gil_1860_mix.at3 | 220 quadros | modo 1
msgctxt "505:4"
msgid "  But of course! Killing kings is my life's  \nwork. And you sure look like a tyrant to me!"
msgstr "É claro! Matar reis é meu ofício.\nE você tem toda a cara de um tirano!"

#. se/eb_ksk/15 | 24 quadros | modo 1
msgctxt "506:0"
msgid "Worthless"
msgstr "Sem valor."

#. cv/fld/ner_0101.at3 | 250 quadros | modo 2
msgctxt "507:0"
msgid "150cm. Whatever you just thought should never leave your mouth!"
msgstr "150 cm. Nem penses em dizer o que acabaste de pensar!"

#. cv/fld/ner_0101.at3 | 95 quadros | modo 2
msgctxt "507:1"
msgid "I mean, I might be *small*, but I'll get mad if you say it!!"
msgstr "Quer dizer, posso até ser *baixa*, mas vou me irritar se disseres!!"

#. sound/bgm/blossom_ok.at3 | 137 quadros | modo 0
msgctxt "508:1"
msgid "Down deep in my heart"
msgstr "No fundo do meu coração"

#. sound/bgm/blossom_ok.at3 | 136 quadros | modo 0
msgctxt "508:2"
msgid "where no-one knew, a dream was born, it seems"
msgstr "nasceu um sonho que ninguém conhecia"

#. sound/bgm/blossom_ok.at3 | 66 quadros | modo 0
msgctxt "508:3"
msgid "and I felt it then―"
msgstr "e foi ali que eu senti―"

#. sound/bgm/blossom_ok.at3 | 158 quadros | modo 0
msgctxt "508:4"
msgid "yes, it was that moment when \"You looked at me.\""
msgstr "sim, quando você olhou pra mim."

#. sound/bgm/blossom_ok.at3 | 268 quadros | modo 0
msgctxt "508:6"
msgid "Your hands were so warm―your touch so soft, so magic to me"
msgstr "Mãos tão quentes, um toque suave,\nquase mágico para mim"

#. sound/bgm/blossom_ok.at3 | 69 quadros | modo 0
msgctxt "508:7"
msgid "and that was when―"
msgstr "e foi ali que―"

#. sound/bgm/blossom_ok.at3 | 177 quadros | modo 0
msgctxt "508:8"
msgid "I felt all of ～those rules, on my heart were swept aside"
msgstr "as regras do meu coração se desfizeram"

#. sound/bgm/blossom_ok.at3 | 134 quadros | modo 0
msgctxt "508:10"
msgid "For the one who'd even speak so tenderly"
msgstr "Para quem falava com tanta ternura"

#. sound/bgm/blossom_ok.at3 | 137 quadros | modo 0
msgctxt "508:11"
msgid "to the one, the flower no one else would name"
msgstr "à flor que ninguém mais nomearia"

#. sound/bgm/blossom_ok.at3 | 111 quadros | modo 0
msgctxt "508:12"
msgid "You're the one that I would really want to see"
msgstr "É você quem eu mais quero ver"

#. sound/bgm/blossom_ok.at3 | 107 quadros | modo 0
msgctxt "508:13"
msgid "the moment when the buds'll loose―opening,"
msgstr "no instante em que os botões desabrocham"

#. sound/bgm/blossom_ok.at3 | 103 quadros | modo 0
msgctxt "508:14"
msgid "up to the breaking dawn"
msgstr "sob a primeira luz da manhã"

#. sound/bgm/blossom_ok.at3 | 158 quadros | modo 0
msgctxt "508:16"
msgid "So, I'll have to wait and see 'til this little piece of me"
msgstr "Vou esperar até esse pedaço de mim"

#. sound/bgm/blossom_ok.at3 | 127 quadros | modo 0
msgctxt "508:17"
msgid "comes along with, melts along with, and gets filled in too"
msgstr "se entregar, derreter e enfim se preencher"

#. sound/bgm/blossom_ok.at3 | 135 quadros | modo 0
msgctxt "508:18"
msgid "As it turns to a shade of―a cherry-colored love"
msgstr "e tomar a cor―de um amor cor de cerejeira"

#. sound/bgm/blossom_ok.at3 | 144 quadros | modo 0
msgctxt "508:19"
msgid "I know someday this love will bloom"
msgstr "Eu sei que um dia esse amor vai florescer"

#. sound/bgm/blossom_ok.at3 | 129 quadros | modo 0
msgctxt "508:21"
msgid "If all that awaits"
msgstr "Se o que nos espera"

#. sound/bgm/blossom_ok.at3 | 136 quadros | modo 0
msgctxt "508:22"
msgid "ahead of us is a mournful fate"
msgstr "é apenas um destino de tristeza"

#. sound/bgm/blossom_ok.at3 | 69 quadros | modo 0
msgctxt "508:23"
msgid "then I won't just wait―"
msgstr "eu não vou ficar parada―"

#. sound/bgm/blossom_ok.at3 | 157 quadros | modo 0
msgctxt "508:24"
msgid "I'll even change the course \"Of the whole world.\""
msgstr "mudo até o rumo do mundo inteiro."

#. sound/bgm/blossom_ok.at3 | 266 quadros | modo 0
msgctxt "508:26"
msgid "Instead of the words―the verse that a poet weaves, to me"
msgstr "Em vez das palavras que um poeta tece"

#. sound/bgm/blossom_ok.at3 | 170 quadros | modo 0
msgctxt "508:27"
msgid "What I'd rather see is a carefree smile, that's―"
msgstr "prefiro ver um sorriso despreocupado―"

#. sound/bgm/blossom_ok.at3 | 76 quadros | modo 0
msgctxt "508:28"
msgid "what I choose to keep closely"
msgstr "é isso que guardo junto ao peito"

#. sound/bgm/blossom_ok.at3 | 139 quadros | modo 0
msgctxt "508:30"
msgid "To the one who bears their pain so silently"
msgstr "Para quem suporta a dor em silêncio"

#. sound/bgm/blossom_ok.at3 | 132 quadros | modo 0
msgctxt "508:31"
msgid "all alone, and so that no one else would see"
msgstr "sem companhia, longe de todos os olhares"

#. sound/bgm/blossom_ok.at3 | 108 quadros | modo 0
msgctxt "508:32"
msgid "You're the one, and it's for you I live my life"
msgstr "É por você, só por você que eu vivo"

#. sound/bgm/blossom_ok.at3 | 111 quadros | modo 0
msgctxt "508:33"
msgid "I'll put on a pure white dress to walk along"
msgstr "Vou vestir um traje branco e puro"

#. sound/bgm/blossom_ok.at3 | 104 quadros | modo 0
msgctxt "508:34"
msgid "and take my eternal vows"
msgstr "e fazer meus votos eternos"

#. sound/bgm/blossom_ok.at3 | 157 quadros | modo 0
msgctxt "508:36"
msgid "I'm so different from back then―from how I was and how I am"
msgstr "Como sou diferente do que eu era antes"

#. sound/bgm/blossom_ok.at3 | 126 quadros | modo 0
msgctxt "508:37"
msgid "In all my thoughts, and all my wants―I burn for you"
msgstr "Todo pensamento, todo desejo arde por você"

#. sound/bgm/blossom_ok.at3 | 133 quadros | modo 0
msgctxt "508:38"
msgid "You are all I'm thinking of―I can't help myself, it's love"
msgstr "Só penso em você. O amor tomou conta de mim"

#. sound/bgm/blossom_ok.at3 | 149 quadros | modo 0
msgctxt "508:39"
msgid "I know one day that love gets through"
msgstr "Sei que um dia esse amor vai chegar a você"

#. sound/bgm/blossom_ok.at3 | 135 quadros | modo 0
msgctxt "508:41"
msgid "For the one who is my pride beyond belief"
msgstr "Quem me enche de um orgulho sem tamanho"

#. sound/bgm/blossom_ok.at3 | 137 quadros | modo 0
msgctxt "508:42"
msgid "is the one, the flower no one else would name"
msgstr "é a flor que ninguém mais nomearia"

#. sound/bgm/blossom_ok.at3 | 108 quadros | modo 0
msgctxt "508:43"
msgid "You're the one, and what I want is you to live"
msgstr "É de você que eu quero salvar a vida"

#. sound/bgm/blossom_ok.at3 | 107 quadros | modo 0
msgctxt "508:44"
msgid "Even if it has to be this flower was"
msgstr "mesmo que esta flor tenha de se desfazer"

#. sound/bgm/blossom_ok.at3 | 97 quadros | modo 0
msgctxt "508:45"
msgid "scattered into the winds～"
msgstr "ao vento～"

#. sound/bgm/blossom_ok.at3 | 160 quadros | modo 0
msgctxt "508:47"
msgid "Though I know it's faded out, there is hope that can be found"
msgstr "Ainda que tenha murchado, há uma esperança"

#. sound/bgm/blossom_ok.at3 | 126 quadros | modo 0
msgctxt "508:48"
msgid "and I've made sure to pass it on―from me to you"
msgstr "e fiz questão de passá-la de mim pra você"

#. sound/bgm/blossom_ok.at3 | 131 quadros | modo 0
msgctxt "508:49"
msgid "Whether it's an awkward crush―or a flower's twisted love"
msgstr "Seja paixão tímida ou o amor torto de uma flor"

#. sound/bgm/blossom_ok.at3 | 171 quadros | modo 0
msgctxt "508:50"
msgid "It's fine, even if to the sands they go"
msgstr "Tudo bem, mesmo que acabem na areia"

#. sound/bgm/blossom_ok.at3 | 255 quadros | modo 0
msgctxt "508:51"
msgid "In the end, I can see――an endless future――"
msgstr "No fim, vejo――um futuro sem fim――"

#. cv/btl/jin_1800.at3 | 104 quadros | modo 1
msgctxt "509:0"
msgid "Can you withstand all the calories I've saved\n         by never leaving my house!?         "
msgstr "Você aguenta todas as calorias\nque acumulei sem sair de casa!?"

#. cv/btl/psl_1300_edit.at3 | 106 quadros | modo 1
msgctxt "510:0"
msgid "Ahh, so this is what love looks like…"
msgstr "Ahh, então é assim que o amor é…"

#. cv/btl/psl_1300_edit.at3 | 108 quadros | modo 1
msgctxt "510:2"
msgid "I… finally understand now."
msgstr "Eu… finalmente entendo."

#. cv/btl/psl_1300_edit.at3 | 126 quadros | modo 1
msgctxt "510:3"
msgid "If I'm cursed to be hated and never loved…"
msgstr "Se estou condenada a receber\nódio e nunca amor…"

#. cv/btl/psl_1300_edit.at3 | 104 quadros | modo 1
msgctxt "510:4"
msgid "Then please, I'd rather you be\n      in bits and pieces.      "
msgstr "Então, por favor… prefiro\nque fique em pedacinhos."

#. cv/btl/psl_1300_edit.at3 | 64 quadros | modo 1
msgctxt "510:6"
msgid "Now, your mind and body…"
msgstr "Agora, seu corpo e sua mente…"

#. cv/btl/psl_1300_edit.at3 | 56 quadros | modo 1
msgctxt "510:8"
msgid "…will belong to me."
msgstr "…serão meus."

#. cv/btl/ner_2040.at3 | 146 quadros | modo 1
msgctxt "511:0"
msgid "Urrghh… Must even the plebeians\n      see me clothed so!?      "
msgstr "Aaargh… Até os plebeus vão\nme ver vestida assim!?"

#. cv/btl/ner_2040.at3 | 54 quadros | modo 1
msgctxt "511:1"
msgid "You should be embarrassing yourself too,\n                you know!                "
msgstr "Tu também devias passar vergonha, sabes!"

#. cv/fld/ran_0100.at3 | 106 quadros | modo 2
msgctxt "512:0"
msgid "Rani VIII. My name was granted to me by Sialim."
msgstr "Rani VIII. Meu nome me foi dado por Sialim."

#. cv/fld/kot_0099.at3 | 80 quadros | modo 3
msgctxt "513:0"
msgid "Don't get overconfident. Stock up."
msgstr "Não confie demais na sorte. Abasteça-se."

#. cv/fld/kot_0099.at3 | 96 quadros | modo 3
msgctxt "513:1"
msgid "Your Servant there practically prints money."
msgstr "Esse seu Servo praticamente imprime dinheiro."

#. cv/btl/cuu_1091.at3 | 28 quadros | modo 1
msgctxt "514:0"
msgid "I'll send you flying!"
msgstr "Vou mandar você pelos ares!"

#. cv/btl/kar_1104.at3 | 30 quadros | modo 1
msgctxt "515:0"
msgid "This is just the beginning."
msgstr "Isto é só o começo."

#. cv/fld/emi_0602.at3 | 60 quadros | modo 1
msgctxt "516:0"
msgid "I can let you use the bed if you're exhausted."
msgstr "Posso ceder a cama se precisar descansar."

#. se/eb_eli/6 | 33 quadros | modo 1
msgctxt "517:0"
msgid "You're banned from the venue!"
msgstr "Sua entrada no show está banida!"

#. cv/btl/emi_1701.at3 | 46 quadros | modo 1
msgctxt "518:0"
msgid "Seems like we're in control of the tempo."
msgstr "Parece que controlamos o ritmo."

#. cv/btl/emi_1820_mix.at3 | 128 quadros | modo 1
msgctxt "519:0"
msgid "Another innocent monster born from\n      society's perception.      "
msgstr "Mais um monstro inocente,\ncriado pelo olhar dos outros."

#. cv/btl/emi_1820_mix.at3 | 142 quadros | modo 1
msgctxt "519:1"
msgid "       Most are victims,       \nbut you're purely a victimizer."
msgstr "A maioria é vítima,\nmas você só faz vítimas."

#. cv/btl/emi_1820_mix.at3 | 124 quadros | modo 1
msgctxt "519:2"
msgid "Hmm, it doesn't look like I'll be getting any\n              sympathy from you.              "
msgstr "Hum, não parece que vou\nreceber nenhuma compaixão sua."

#. cv/btl/emi_1820_mix.at3 | 130 quadros | modo 1
msgctxt "519:3"
msgid "I think we're both pretty alike, though."
msgstr "Mas acho que somos bem parecidos."

#. cv/btl/emi_1820_mix.at3 | 106 quadros | modo 1
msgctxt "519:4"
msgid "We were changed by the bad rep we got."
msgstr "A má fama mudou nós dois."

#. cv/btl/emi_1820_mix.at3 | 160 quadros | modo 1
msgctxt "519:5"
msgid "Don't lump us together. I changed after death;\n        you were disgraced during life!        "
msgstr "Não nos compare. Mudei depois de morrer.\nVocê caiu em desgraça em vida!"

#. cv/btl/ner_1113.at3 | 49 quadros | modo 1
msgctxt "520:0"
msgid "This chance is mine!"
msgstr "Esta chance é minha!"

#. se/eb_emi3/11 | 24 quadros | modo 1
msgctxt "521:0"
msgid "Don't mind me."
msgstr "Não se preocupe comigo."

#. cv/btl/gaw_1200_edit.at3 | 44 quadros | modo 1
msgctxt "522:1"
msgid "Purge the wicked!"
msgstr "Expurgue os perversos!"

#. cv/fld/rin_0201.at3 | 140 quadros | modo 2
msgctxt "523:0"
msgid "I'm more interested in nice designs and lace myself than color."
msgstr "Me importo mais com um bom desenho\ne uma renda bonita do que com a cor."

#. cv/fld/rin_0201.at3 | 72 quadros | modo 2
msgctxt "523:1"
msgid "'Cause I like it, not to show off!!"
msgstr "Porque eu gosto, não é pra me exibir!!"

#. cv/btl/eli_1754_mix.at3 | 178 quadros | modo 1
msgctxt "524:0"
msgid "This'll be a piece of cake. Unlike last time,\n          I'll actually be trying.          "
msgstr "Vai ser moleza. Desta vez eu vou\nme esforçar de verdade."

#. cv/btl/eli_1754_mix.at3 | 170 quadros | modo 1
msgctxt "524:1"
msgid "No, your power isn't that much different.\n       Don't be conceited, Lancer.       "
msgstr "Seu poder quase não mudou.\nNão se ache, Lancer."

#. cv/btl/emi_1706.at3 | 76 quadros | modo 1
msgctxt "525:0"
msgid "Okay. Watch my back, alright?"
msgstr "Certo. Cobre minha retaguarda, tá?"

#. cv/btl/rob_1300.at3 | 96 quadros | modo 1
msgctxt "526:0"
msgid "Suffer this sacrament of the\n druids, the stealth sages. "
msgstr "Sofra o sacramento dos druidas,\nos sábios furtivos."

#. cv/btl/leo_1940.at3 | 28 quadros | modo 1
msgctxt "527:0"
msgid "What did you say!?"
msgstr "O que você disse!?"

#. cv/btl/tam_2005.at3 | 44 quadros | modo 1
msgctxt "528:0"
msgid "Ooh, this is getting exciting!"
msgstr "Ooh, isso está ficando interessante!"

#. cv/btl/emi_1601.at3 | 50 quadros | modo 1
msgctxt "529:0"
msgid "You're really shining today, Master."
msgstr "Hoje você está brilhando."

#. cv/btl/adl_1540.at3 | 65 quadros | modo 1
msgctxt "530:0"
msgid "Ha! You've really been pent-up, haven't you?"
msgstr "Ha! Estava mesmo se contendo, hein?"

#. cv/btl/tam3_1400.at3 | 44 quadros | modo 1
msgctxt "531:0"
msgid "This seems to be where we part…"
msgstr "Aqui parece ser a nossa despedida…"

#. cv/fld/rin_0106.at3 | 60 quadros | modo 2
msgctxt "532:0"
msgid "February 4th."
msgstr "4 de fevereiro."

#. cv/fld/rin_0106.at3 | 96 quadros | modo 2
msgctxt "532:1"
msgid "When was the last time I even celebrated my birthday anyway…?"
msgstr "Quando foi mesmo a última vez que comemorei meu aniversário…?"

#. cv/btl/sin_1200_edit.at3 | 46 quadros | modo 1
msgctxt "533:0"
msgid "I suppose I should help you out…"
msgstr "Acho que vou ter que ajudar você…"

#. cv/btl/elp_1230_edit.at3 | 46 quadros | modo 1
msgctxt "534:1"
msgid "My performance will move you!"
msgstr "Meu show vai emocionar você!"

#. cv/btl/kia_1510.at3 | 38 quadros | modo 1
msgctxt "535:0"
msgid "You're quite flustered～"
msgstr "Que perturbação～"

#. cv/btl/sal_1100.at3 | 50 quadros | modo 1
msgctxt "536:0"
msgid "Taking care of your toys is very important!"
msgstr "É muito importante cuidar dos brinquedos!"

#. cv/btl/adl_1511.at3 | 40 quadros | modo 1
msgctxt "537:0"
msgid "Oh wow, how *clever* of you!"
msgstr "Nossa, que *esperteza* a sua!"

#. cv/btl/mll_1751.at3 | 62 quadros | modo 1
msgctxt "538:0"
msgid "This… isn't how it's supposed to go…!"
msgstr "Isto… não devia acontecer assim…!"

#. cv/btl/emi_1220_edit.at3 | 60 quadros | modo 1
msgctxt "539:1"
msgid "This guy's just a little persistent."
msgstr "Esse aí é um pouco persistente."

#. cv/btl/ner_1712.at3 | 89 quadros | modo 1
msgctxt "540:0"
msgid "Praetor, you're not― no, nevermind."
msgstr "Maestro, tu não― deixa pra lá."

#. cv/btl/ran_1540.at3 | 56 quadros | modo 1
msgctxt "541:0"
msgid "We sold out the show, haven't we?"
msgstr "O show esgotou, não esgotou?"

#. cv/btl/sal_1801.at3 | 55 quadros | modo 1
msgctxt "542:0"
msgid "Let me know you some hospitality 鷙"
msgstr "Vou mostrar como recebo minhas visitas鷙"

#. cv/btl/eli_1501.at3 | 45 quadros | modo 1
msgctxt "543:0"
msgid "Everyone, thank you!!"
msgstr "Obrigada, pessoal!!"

#. cv/btl/ner_1620_a.at3 | 102 quadros | modo 1
msgctxt "544:0"
msgid "What? Don't you have something to say?"
msgstr "Que foi? Não tens nada a dizer?"

#. cv/btl/el2_1091.at3 | 40 quadros | modo 1
msgctxt "545:0"
msgid "You won't get out alive!!"
msgstr "Ninguém vai sair vivo daqui!!"

#. cv/btl/tam_1260_edit.at3 | 118 quadros | modo 1
msgctxt "546:0"
msgid "Now scatter, flower of heaven's grudge,\n    eternally blooming and tearing.    "
msgstr "Espalhe-se, flor do rancor celeste,\na florescer e dilacerar pela eternidade."

#. cv/btl/tam_1260_edit.at3 | 56 quadros | modo 1
msgctxt "546:1"
msgid "Land of Eternal Bane!"
msgstr "Terra da Maldição Eterna!"

#. cv/btl/psl_1231_edit.at3 | 70 quadros | modo 1
msgctxt "547:1"
msgid "I won't let you escape～"
msgstr "Não vou deixar você escapar～"

#. cv/btl/psl_1231_edit.at3 | 118 quadros | modo 1
msgctxt "547:2"
msgid "Hehehe… You'll fit perfectly in my hands～"
msgstr "Hehehe… Vai caber direitinho nas minhas mãos～"

#. se/eb_gil/14 | 46 quadros | modo 1
msgctxt "548:0"
msgid "You're easy to read."
msgstr "És fácil de ler."

#. se/eb_sal/14 | 23 quadros | modo 1
msgctxt "549:0"
msgid "Owie!"
msgstr "Ai!"

#. cv/btl/tam_2041.at3 | 88 quadros | modo 1
msgctxt "550:0"
msgid "Master～ Could you rub some lotion on me 鷙"
msgstr "Mestre～ Passa um pouquinho de loção em mim? 鷙"

#. cv/btl/emi_1120.at3 | 66 quadros | modo 1
msgctxt "551:0"
msgid "Can't let it end that easily, can we?"
msgstr "Não dá pra acabar tão fácil assim, dá?"

#. cv/btl/adl_1711.at3 | 110 quadros | modo 1
msgctxt "552:0"
msgid "    What's wrong? If you fall now,    \nthen consider this story's finale writ!"
msgstr "O que houve? Se cair agora,\no desfecho desta história já está escrito!"

#. cv/btl/ksk_1100.at3 | 58 quadros | modo 1
msgctxt "553:0"
msgid "Spiritron composition, reconstruct."
msgstr "Reconstruir a composição de Spiritrons."

#. cv/btl/gil_1741.at3 | 124 quadros | modo 1
msgctxt "554:0"
msgid "The only thing you'll get from me is\na smile as I watch the jesters dance."
msgstr "De mim só terás um sorriso\nenquanto observo a dança dos bufões."

#. cv/btl/gil_1741.at3 | 84 quadros | modo 1
msgctxt "554:1"
msgid "You'll be the one screaming\n    by the end of this.    "
msgstr "No fim, será você quem vai gritar."

#. cv/btl/ner_1744.at3 | 136 quadros | modo 1
msgctxt "555:0"
msgid "The time has come! The orchestra is tuned\n      and the actors are in place!      "
msgstr "Chegou a hora! A orquestra está afinada,\ne os atores, a postos!"

#. cv/btl/ner_1744.at3 | 66 quadros | modo 1
msgctxt "555:1"
msgid "Raise the curtains, Master!"
msgstr "Ergue a cortina, Maestro!"

#. cv/btl/tam3_1210_edit.at3 | 58 quadros | modo 1
msgctxt "556:1"
msgid "Fiery heavens, scorch the Earth."
msgstr "Céus em chamas, abrasem a Terra."

#. cv/btl/gil_1740.at3 | 122 quadros | modo 1
msgctxt "557:0"
msgid "Instruct me, mongrel. I do not wish to think."
msgstr "Dá tuas ordens, criatura mestiça.\nNão quero pensar."

#. cv/btl/gil_1740.at3 | 86 quadros | modo 1
msgctxt "557:2"
msgid "Leading us to victory is your job."
msgstr "Conduzir-nos à vitória é teu trabalho."

#. cv/btl/ner_1803.at3 | 82 quadros | modo 1
msgctxt "558:0"
msgid "Behold the power of my dear Praetor!"
msgstr "Contemplem o poder de Maestro, a quem tanto amo!"

#. cv/btl/el2_1250_edit.at3 | 100 quadros | modo 1
msgctxt "559:0"
msgid "It's fork time～ Heartbreak!"
msgstr "Hora do garfo～ Coração partido!"

#. cv/btl/el2_1250_edit.at3 | 76 quadros | modo 1
msgctxt "559:2"
msgid "I guess I don't know my own strength."
msgstr "Acho que não conheço a minha força."

#. cv/btl/cuu_1200_edit.at3 | 74 quadros | modo 1
msgctxt "560:0"
msgid "Red thorns, like those of a wild rose."
msgstr "Espinhos vermelhos, como os da rosa silvestre."

#. se/eb_emi3/17 | 25 quadros | modo 1
msgctxt "561:0"
msgid "Not bad."
msgstr "Nada mal."

#. se/eb_mll/103 | 20 quadros | modo 1
msgctxt "562:0"
msgid "Quatre."
msgstr "Quatre."

#. cv/btl/gil_1250a_edit.at3 | 60 quadros | modo 1
msgctxt "563:0"
msgid "This is more than a pest like you deserves!"
msgstr "Isso é mais do que uma praga como tu merece!"

#. cv/btl/gil_1250a_edit.at3 | 40 quadros | modo 1
msgctxt "563:2"
msgid "I'll rip you to pieces!!"
msgstr "Vou te despedaçar!!"

#. cv/btl/el2_1260_edit.at3 | 60 quadros | modo 1
msgctxt "564:1"
msgid "I'll crush you like the rat that you are!"
msgstr "Vou te esmagar como o rato que você é!"

#. cv/btl/ner_1621.at3 | 72 quadros | modo 1
msgctxt "565:0"
msgid "It seems my full strength has yet to return…"
msgstr "Parece que ainda não recuperei toda a força…"

#. cv/btl/ner_1602.at3 | 110 quadros | modo 1
msgctxt "566:0"
msgid "Mhm! My Master is the best in\n    all the S.E.R.A.P.H.!    "
msgstr "Umu! Meu Maestro é sem igual em todo o SE.RA.PH!"

#. cv/btl/mll_1520.at3 | 28 quadros | modo 1
msgctxt "567:0"
msgid "Now you've done it…"
msgstr "Agora você passou dos limites…"

#. se/eb_elp/1 | 24 quadros | modo 1
msgctxt "568:0"
msgid "How's this?"
msgstr "Que tal essa?"

#. cv/btl/gil_1810_mix.at3 | 110 quadros | modo 1
msgctxt "569:0"
msgid "You're hardly qualified to call\nyourself the Queen of the Moon."
msgstr "Mal tens direito de te chamar Rainha da Lua."

#. cv/btl/gil_1810_mix.at3 | 108 quadros | modo 1
msgctxt "569:1"
msgid "Reach the top of the financial\n    world, then we'll talk.    "
msgstr "Chega ao topo do mundo das finanças,\nentão conversaremos."

#. cv/btl/gil_1810_mix.at3 | 110 quadros | modo 1
msgctxt "569:3"
msgid "Ugh, what's with that persuasive Servant!?"
msgstr "Argh, como esse Servo é convincente!?"

#. cv/btl/gil_1810_mix.at3 | 180 quadros | modo 1
msgctxt "569:4"
msgid "  His personality is horrid, but  \nI feel we'd be *super* compatible!"
msgstr "A personalidade dele é horrível,\nmas sinto que a gente ia combinar DEMAIS!"

#. cv/btl/gil_1810_mix.at3 | 88 quadros | modo 1
msgctxt "569:6"
msgid "…can I go home?"
msgstr "…posso ir pra casa?"

#. cv/btl/tam3_1752_mix.at3 | 124 quadros | modo 1
msgctxt "570:0"
msgid "Alright. Let's settle this here, Caster."
msgstr "Certo. Vamos resolver isso aqui, Caster."

#. cv/btl/tam3_1752_mix.at3 | 110 quadros | modo 1
msgctxt "570:1"
msgid "        Please leave this to me.        \nLet the grand loops of heaven be linked."
msgstr "Deixe comigo, por favor.\nQue se unam os grandes anéis do céu."

#. cv/fld/ner_0200.at3 | 188 quadros | modo 2
msgctxt "571:0"
msgid "That I'm allowed to protect you, Praetor. I ask not much."
msgstr "Poder proteger-te, Maestro. Não peço muito."

#. cv/fld/ner_0200.at3 | 86 quadros | modo 2
msgctxt "571:1"
msgid "Knowing you're happy and safe is enough for me."
msgstr "Basta saber que estás bem e a salvo."

#. cv/btl/emi_1113.at3 | 31 quadros | modo 1
msgctxt "572:0"
msgid "Leave it to me!"
msgstr "Deixa comigo!"

#. cv/btl/twi_1511.at3 | 52 quadros | modo 1
msgctxt "573:0"
msgid "Heh, I'm just getting started."
msgstr "Heh, estou só começando."

#. cv/btl/psl_1511.at3 | 26 quadros | modo 1
msgctxt "574:0"
msgid "I hate you…"
msgstr "Eu odeio você…"

#. cv/btl/ksk_1752.at3 | 60 quadros | modo 1
msgctxt "575:0"
msgid "Conception of all animals―"
msgstr "Concepção de todos os animais―"

#. cv/btl/ksk_1752.at3 | 66 quadros | modo 1
msgctxt "575:1"
msgid "Code, Çatalhöyük."
msgstr "Código, Çatalhöyük."

#. cv/btl/tam_1612.at3 | 46 quadros | modo 1
msgctxt "576:0"
msgid "Not bad, though not great."
msgstr "Até que foi bom. Nada de mais."

#. cv/btl/eli_1102.at3 | 42 quadros | modo 1
msgctxt "577:0"
msgid "Thank you, Rani."
msgstr "Obrigada, Rani."

#. cv/btl/twi_1540.at3 | 34 quadros | modo 1
msgctxt "578:0"
msgid "Are we finishing up already?"
msgstr "Já estamos acabando?"

#. cv/btl/emi_1801.at3 | 40 quadros | modo 1
msgctxt "579:0"
msgid "What a stubborn bunch."
msgstr "Que bando teimoso."

#. cv/fld/gil_0201.at3 | 176 quadros | modo 2
msgctxt "580:0"
msgid "You're really the Fool of Fools. What else other than gold!?"
msgstr "És mesmo o maior dos tolos. Que mais seria, além de ouro!?"

#. cv/btl/elp_1111.at3 | 31 quadros | modo 1
msgctxt "581:0"
msgid "Rock 'n roll!"
msgstr "Rock 'n roll!"

#. cv/btl/psl_1521.at3 | 58 quadros | modo 1
msgctxt "582:0"
msgid "Why do you hate me so much…!?"
msgstr "Por que você me odeia tanto…!?"

#. cv/btl/mks_1200_edit.at3 | 48 quadros | modo 1
msgctxt "583:0"
msgid "Let's pretend this never happened, okay? 鷙"
msgstr "Vamos fingir que nunca aconteceu, tá?鷙"

#. cv/btl/rob_1400.at3 | 106 quadros | modo 1
msgctxt "584:0"
msgid "That's that. I thought I'd be able to\n      last a little bit longer.      "
msgstr "Foi isso. Achei que ia durar mais um pouco."

#. cv/btl/ner_2030.at3 | 86 quadros | modo 1
msgctxt "585:0"
msgid "Well then, let us write poetry with our blows."
msgstr "Pois bem, escrevamos poesia a golpes de espada."

#. cv/btl/ksk_1090.at3 | 40 quadros | modo 1
msgctxt "586:0"
msgid "Commencing operation."
msgstr "Iniciando operação."

#. se/eb_gaw2/7 | 26 quadros | modo 1
msgctxt "587:0"
msgid "Your money is mine!!"
msgstr "Seu dinheiro é meu!!"

#. cv/fld/emi_0601.at3 | 52 quadros | modo 1
msgctxt "588:0"
msgid "Somehow we made it back in one piece."
msgstr "De algum jeito, voltamos inteiros."

#. cv/btl/elp_1931.at3 | 139 quadros | modo 1
msgctxt "589:0"
msgid "Welcome～ Let's get this special private\n        live performance started!        "
msgstr "Boas-vindas～ Vamos começar\neste show particular!"

#. cv/btl/emi_1250_edit.at3 | 74 quadros | modo 1
msgctxt "590:0"
msgid "My wrought iron shall twist and break…"
msgstr "Meu ferro forjado há de se torcer e partir…"

#. cv/btl/emi_1250_edit.at3 | 52 quadros | modo 1
msgctxt "590:2"
msgid "Burst open, helix sword!"
msgstr "Arrebente, espada helicoidal!"

#. cv/btl/leo_1800.at3 | 80 quadros | modo 1
msgctxt "591:0"
msgid "Gawain, settle this with a single strike."
msgstr "Gawain, resolva com um único golpe."

#. cv/btl/leo_1800.at3 | 40 quadros | modo 1
msgctxt "591:2"
msgid "Unseal your Noble Phantasm…!"
msgstr "Libere seu Fantasma Nobre…!"

#. cv/btl/emi_1401.at3 | 58 quadros | modo 1
msgctxt "592:0"
msgid "Master, I'm sorry…"
msgstr "Me desculpe…"

#. cv/fld/kot_00930.at3 | 66 quadros | modo 3
msgctxt "593:0"
msgid "Eh, I don't care where you get your"
msgstr "Ah, pouco importa de onde vem o dinheiro,"

#. cv/fld/kot_00930.at3 | 54 quadros | modo 3
msgctxt "593:1"
msgid "money as long as I end up with it."
msgstr "desde que acabe comigo."

#. se/eb_sal/12 | 23 quadros | modo 1
msgctxt "594:0"
msgid "Good day!"
msgstr "Bom dia!"

#. se/eb_emi/11 | 29 quadros | modo 1
msgctxt "595:0"
msgid "Power through!"
msgstr "Avance com tudo!"

#. se/eb_ksk/11 | 24 quadros | modo 1
msgctxt "596:0"
msgid "Erase."
msgstr "Apagar."

#. cv/fld/emi_0101.at3 | 148 quadros | modo 2
msgctxt "597:0"
msgid "Just call me Archer. There's not really anything better."
msgstr "Chame-me de Archer. Não tem nome melhor."

#. cv/btl/eli_1091.at3 | 32 quadros | modo 1
msgctxt "598:0"
msgid "I'll settle this with style!"
msgstr "Vou resolver isso em grande estilo!"

#. cv/btl/tam_1702.at3 | 66 quadros | modo 1
msgctxt "599:0"
msgid "Pest. Could you please hurry and die?"
msgstr "Que praga. Pode morrer logo, por favor?"

#. cv/btl/ner_1800.at3 | 50 quadros | modo 1
msgctxt "600:0"
msgid "Praetor, your orders?"
msgstr "Maestro, quais são as tuas ordens?"

#. cv/btl/jin_1531.at3 | 28 quadros | modo 1
msgctxt "601:0"
msgid "Nice combo!"
msgstr "Belo combo!"

#. cv/btl/tam3_1751_mix.at3 | 84 quadros | modo 1
msgctxt "602:0"
msgid "The tides have started to turn in their favor."
msgstr "A maré começou a virar a favor deles."

#. cv/btl/tam3_1751_mix.at3 | 158 quadros | modo 1
msgctxt "602:1"
msgid "       They're certainly strong.       \nThough maybe it's just us who are weak."
msgstr "São fortes, sem dúvida.\nOu talvez a gente que seja fraco."

#. cv/btl/tam3_1751_mix.at3 | 130 quadros | modo 1
msgctxt "602:2"
msgid "I'm sorry, please forgive me.\n  If only I was stronger…  "
msgstr "Desculpe, por favor, me perdoe.\nSe ao menos eu fosse mais forte…"

#. cv/btl/gil_1101.at3 | 36 quadros | modo 1
msgctxt "603:0"
msgid "That's how it's done."
msgstr "É assim que se faz."

#. cv/btl/sal_1220_edit.at3 | 80 quadros | modo 1
msgctxt "604:1"
msgid "So fun, so fun, so fun!!"
msgstr "Que divertido, divertido, divertido!!"

#. cv/btl/kar_1110.at3 | 24 quadros | modo 1
msgctxt "605:0"
msgid "Like this?"
msgstr "Assim?"

#. cv/btl/gaw_1120.at3 | 62 quadros | modo 1
msgctxt "606:0"
msgid "How could this… have happened…"
msgstr "Como isso… pôde acontecer…"

#. se/eb_emi/17 | 30 quadros | modo 1
msgctxt "607:0"
msgid "Was that it?"
msgstr "Era só isso?"

#. cv/btl/gaw2_1300_edit.at3 | 80 quadros | modo 1
msgctxt "608:1"
msgid "This blade is replica of the sun."
msgstr "Esta lâmina é uma réplica do Sol."

#. cv/btl/gaw2_1300_edit.at3 | 90 quadros | modo 1
msgctxt "608:2"
msgid "It also serves to collect debts!"
msgstr "Também serve para cobrar dívidas!"

#. cv/btl/gaw2_1300_edit.at3 | 78 quadros | modo 1
msgctxt "608:3"
msgid "Excalibur Galatine!"
msgstr "Excalibur Galatine!"

#. cv/fld/eli_0102.at3 | 150 quadros | modo 2
msgctxt "609:0"
msgid "An idol's age and weight are usually firm secrets, but…"
msgstr "Idade e peso de idol são segredo absoluto, mas…"

#. cv/fld/eli_0102.at3 | 120 quadros | modo 2
msgctxt "609:1"
msgid "Well, do you want to know…? No matter what? Haha～"
msgstr "Então… quer saber? Custe o que custar? Haha～"

#. cv/fld/eli_0102.at3 | 70 quadros | modo 2
msgctxt "609:2"
msgid "I guess I'll just have to tell you then～!"
msgstr "Acho que vou ter que contar～"

#. cv/fld/eli_0102.at3 | 98 quadros | modo 2
msgctxt "609:3"
msgid "It's a captivating 44 kilograms～鷙"
msgstr "Uns encantadores 44 quilos～鷙"

#. cv/btl/elp_1510.at3 | 48 quadros | modo 1
msgctxt "610:0"
msgid "Hey, keep it together!"
msgstr "Ei, se controla!"

#. cv/btl/el2_1210_edit.at3 | 62 quadros | modo 1
msgctxt "611:1"
msgid "Get over here so I can grant you death."
msgstr "Vem cá, que eu te concedo a morte."

#. se/eb_tam/9 | 30 quadros | modo 1
msgctxt "612:0"
msgid "Here we go!"
msgstr "Lá vamos nós!"

#. cv/fld/kia_0100.at3 | 164 quadros | modo 2
msgctxt "613:0"
msgid "Successor of the Shingon Tachikawa school, Kiara Sessyoin."
msgstr "Sessyoin Kiara, sucessora da escola Shingon Tachikawa."

#. cv/btl/tam_1715.at3 | 46 quadros | modo 1
msgctxt "614:0"
msgid "Master, don't give up."
msgstr "Mestre, não desista."

#. cv/btl/kot_1710.at3 | 46 quadros | modo 1
msgctxt "615:0"
msgid "How interesting."
msgstr "Que interessante."

#. cv/btl/kot_1710.at3 | 63 quadros | modo 1
msgctxt "615:1"
msgid "We'll have to fight with intent to kill too\n        if we want to survive this.        "
msgstr "Também teremos de lutar para matar\nse quisermos sobreviver."

#. cv/btl/cuu_1521.at3 | 38 quadros | modo 1
msgctxt "616:0"
msgid "Damn, they're kicking our asses!"
msgstr "Droga, tão acabando com a gente!"

#. cv/btl/eli_1120.at3 | 60 quadros | modo 1
msgctxt "617:0"
msgid "What the hell are you doing,\n      I died just then!      "
msgstr "Que diabos você tá fazendo?\nEu morri agora há pouco!"

#. cv/fld/ner_0603.at3 | 78 quadros | modo 1
msgctxt "618:0"
msgid "S-should I turn down the lights?"
msgstr "D-devo baixar as luzes?"

#. cv/btl/ner_2020.at3 | 76 quadros | modo 1
msgctxt "619:0"
msgid "I'll make you scream nice and loud～"
msgstr "Vou te fazer gritar bem alto～"

#. cv/btl/el2_1090.at3 | 30 quadros | modo 1
msgctxt "620:0"
msgid "I'll kill you all!!"
msgstr "Vou matar todos vocês!!"

#. cv/btl/kia_1752_mix.at3 | 108 quadros | modo 1
msgctxt "621:1"
msgid "Can't even keep it in your pants, harpy?"
msgstr "Nem consegue se conter, sua harpia?"

#. cv/btl/kia_1752_mix.at3 | 84 quadros | modo 1
msgctxt "621:2"
msgid "  Watch out you two. The most vile, most  \nperverse Noble Phantasm is coming your way."
msgstr "Cuidado, vocês dois.\nAí vem o Fantasma Nobre mais vil e perverso."

#. cv/btl/el2_1750.at3 | 110 quadros | modo 1
msgctxt "622:0"
msgid "AHAHAHAHA! Her body will be mine!"
msgstr "AHAHAHAHA! O corpo dela será meu!"

#. cv/btl/gil_1701.at3 | 86 quadros | modo 1
msgctxt "623:0"
msgid "Don't slack off now, crush them!"
msgstr "Nada de corpo mole agora. Esmaga-os!"

#. cv/fld/gil_0101.at3 | 242 quadros | modo 2
msgctxt "624:0"
msgid "If you must know, 182cm. What? Too normal for you?"
msgstr "Se precisas saber, 182 cm. Que foi? Normal demais?"

#. cv/fld/gil_0101.at3 | 98 quadros | modo 2
msgctxt "624:1"
msgid "Fool! Do you desire me to be some abnormal flesh monster!?"
msgstr "Tolo! Querias que eu fosse uma aberração de carne!?"

#. cv/btl/tam_1745.at3 | 162 quadros | modo 1
msgctxt "625:0"
msgid "One is annoying enough, but now mass\n  production!? I'm getting dizzy…  "
msgstr "Uma já enche o saco, agora em série!?\nAi, que tontura…"

#. cv/btl/tam_1745.at3 | 62 quadros | modo 1
msgctxt "625:1"
msgid "I'm going to beat the crap out of them,\n          no mercy, okay? 鷙          "
msgstr "Vou encher todos de porrada.\nSem dó, viu? 鷙"

#. cv/btl/mll_1100.at3 | 25 quadros | modo 1
msgctxt "626:0"
msgid "How thoughtful."
msgstr "Quanta consideração."

#. cv/btl/gil_1711.at3 | 172 quadros | modo 1
msgctxt "627:0"
msgid "This is pitiful to watch, but\n it's your battle, not mine. "
msgstr "É lamentável de se ver,\nmas a batalha é tua."

#. cv/fld/rin_0107.at3 | 204 quadros | modo 2
msgctxt "628:0"
msgid "Money… wait, no! I don't have some weird money obsession, okay!?"
msgstr "Dinheiro… quer dizer, não! Não tenho obsessão por dinheiro, tá!?"

#. cv/fld/rin_0107.at3 | 44 quadros | modo 2
msgctxt "628:1"
msgid "H-hey, are you listening to me!?"
msgstr "E-ei, você tá me ouvindo!?"

#. cv/btl/el2_1757.at3 | 140 quadros | modo 1
msgctxt "629:0"
msgid "You want an encore…!? Ugh, you're such a pain!"
msgstr "Quer bis…!? Aff, que insistência!"

#. cv/btl/gil_2061.at3 | 154 quadros | modo 1
msgctxt "630:0"
msgid "They won't leave me alone even on my off time.\n       My charisma can sure be a curse!       "
msgstr "Não me deixam em paz nem na folga.\nMeu carisma bem que é uma maldição!"

#. cv/btl/tam_1610.at3 | 44 quadros | modo 1
msgctxt "631:0"
msgid "Mhmm, you're very welcome."
msgstr "Uhum, de nada, viu."

#. cv/btl/gil_1702.at3 | 57 quadros | modo 1
msgctxt "632:0"
msgid "How much of my time do you plan on wasting?"
msgstr "Quanto do meu tempo pretendes desperdiçar?"

#. cv/btl/emi_1092.at3 | 27 quadros | modo 1
msgctxt "633:0"
msgid "Shall we rush in?"
msgstr "Vamos avançar?"

#. cv/btl/eli_1090.at3 | 29 quadros | modo 1
msgctxt "634:0"
msgid "I'll stab them over and over!"
msgstr "Vou espetar todos, sem parar!"

#. se/eb_emi3/7 | 24 quadros | modo 1
msgctxt "635:0"
msgid "Don't make me laugh!"
msgstr "Não me faça rir!"

#. cv/btl/ner_1940.at3 | 84 quadros | modo 1
msgctxt "636:0"
msgid "Let's light up the stage, Master!"
msgstr "Vamos iluminar o palco, Maestro!"

#. cv/btl/kar_1103.at3 | 29 quadros | modo 1
msgctxt "637:0"
msgid "You have my thanks."
msgstr "Meus agradecimentos."

#. cv/btl/emi_1711.at3 | 62 quadros | modo 1
msgctxt "638:0"
msgid "This isn't over! Calm down\nand rethink your strategy."
msgstr "Ainda não acabou! Acalme-se\ne repense a estratégia."

#. cv/btl/rob_1230_edit.at3 | 38 quadros | modo 1
msgctxt "639:0"
msgid "What a shocking development!"
msgstr "Que reviravolta chocante!"

#. cv/btl/gil_1720.at3 | 122 quadros | modo 1
msgctxt "640:0"
msgid "  Oh? Brace yourself, mongrel.  \nThey're using their trump card."
msgstr "Ora? Prepara-te, criatura mestiça.\nVão usar o trunfo."

#. cv/btl/mks_1510.at3 | 38 quadros | modo 1
msgctxt "641:0"
msgid "Is this for real?"
msgstr "É sério isso?"

#. cv/btl/kot_1200_edit.at3 | 76 quadros | modo 1
msgctxt "642:0"
msgid "Here we go. Strike true!"
msgstr "Vamos lá. Acerte em cheio!"

#. se/eb_elp/5 | 24 quadros | modo 1
msgctxt "643:0"
msgid "Back at you!"
msgstr "É pra você!"

#. cv/btl/adl_1750.at3 | 99 quadros | modo 1
msgctxt "644:0"
msgid "God, this is unbearable! You're a\n        DISGRACE, Kiara!        "
msgstr "Que coisa insuportável! Você é\numa DESGRAÇA, Kiara!"

#. se/eb_mll/102 | 20 quadros | modo 1
msgctxt "645:0"
msgid "Trois."
msgstr "Trois."

#. se/eb_emi3/10 | 24 quadros | modo 1
msgctxt "646:0"
msgid "Foolish."
msgstr "Que tolice."

#. cv/btl/tam_1200_edit.at3 | 64 quadros | modo 1
msgctxt "647:0"
msgid "I'll help myself to a little bit of your soul."
msgstr "Vou me servir de um pouquinho da sua alma."

#. cv/btl/kia_1700.at3 | 154 quadros | modo 1
msgctxt "648:0"
msgid " Our game has only just begun… \nPlease don't let it end too soon."
msgstr "Nosso jogo mal começou…\nPor favor, que não acabe tão cedo."

#. cv/btl/emi_1240_edit.at3 | 64 quadros | modo 1
msgctxt "649:1"
msgid "\"Spirit and technique, flawless and firm.\""
msgstr "“Espírito e técnica, impecáveis e firmes.”"

#. cv/btl/adl_1520.at3 | 46 quadros | modo 1
msgctxt "650:0"
msgid "I can't even put this into words!"
msgstr "Isso me deixa sem palavras!"

#. cv/fld/kot_00926.at3 | 44 quadros | modo 3
msgctxt "651:0"
msgid "Give up your money again soon!"
msgstr "Volte logo para entregar mais dinheiro!"

#. cv/btl/gil_1260_edit.at3 | 80 quadros | modo 1
msgctxt "652:1"
msgid "Gate of Babylon!"
msgstr "Gate of Babylon!"

#. cv/btl/ner_1611.at3 | 80 quadros | modo 1
msgctxt "653:0"
msgid "Well, it could have been worse."
msgstr "Bem, podia ter sido pior."

#. se/eb_kia/13 | 24 quadros | modo 1
msgctxt "654:0"
msgid "Easily penetrated!"
msgstr "Tão fácil de penetrar!"

#. se/eb_ksk/7 | 26 quadros | modo 1
msgctxt "655:0"
msgid "Unsightly."
msgstr "Que feiura."

#. cv/fld/rin_0100.at3 | 130 quadros | modo 2
msgctxt "656:0"
msgid "Rin Tohsaka. I'm fairly well known as a Spiritron Hacker."
msgstr "Tohsaka Rin. Tenho certa fama como hacker de Spiritrons."

#. se/eb_gaw/8 | 24 quadros | modo 1
msgctxt "657:0"
msgid "I'll crush you!"
msgstr "Vou esmagar você!"

#. cv/btl/ner_1703.at3 | 86 quadros | modo 1
msgctxt "658:0"
msgid "That's my Praetor for you, so reliable!"
msgstr "É típico do meu Maestro.\nPosso sempre contar contigo!"

#. cv/btl/elp_1301_edit.at3 | 90 quadros | modo 1
msgctxt "659:1"
msgid "This is my performance as the\n    Fresh Blood Demoness!    "
msgstr "Este é o show da Demonesa de Sangue Fresco!"

#. cv/btl/emi_1231_edit.at3 | 76 quadros | modo 1
msgctxt "660:1"
msgid "Consume everything. Hrunting!"
msgstr "Devore tudo. Hrunting!"

#. cv/btl/cuu_1710.at3 | 84 quadros | modo 1
msgctxt "661:0"
msgid "This isn't good. Seems like they've got the\n            flow on their side.            "
msgstr "Isso não é bom.\nParece que a maré virou a favor deles."

#. cv/btl/tam_1620.at3 | 80 quadros | modo 1
msgctxt "662:0"
msgid "Darling, that really huuurt～"
msgstr "Meu bem, isso doeu demaaaais～"

#. cv/btl/gil_1501.at3 | 74 quadros | modo 1
msgctxt "663:0"
msgid "This is what it means to trample our foes!"
msgstr "É assim que se esmaga um inimigo!"

#. cv/btl/emi_1713.at3 | 82 quadros | modo 1
msgctxt "664:0"
msgid "Ugh, I must be in pretty bad shape."
msgstr "Argh, devo estar bem mal."

#. cv/btl/ner_1111.at3 | 24 quadros | modo 1
msgctxt "665:0"
msgid "Keep going!"
msgstr "Continua!"

#. cv/btl/tam_1710.at3 | 38 quadros | modo 1
msgctxt "666:0"
msgid "Master, take a deep breath."
msgstr "Mestre, respire fundo."

#. cv/btl/tam_2010.at3 | 156 quadros | modo 1
msgctxt "667:0"
msgid "                  Oh, shi…                  \nDarling, listen, I didn't get much sleep, so…"
msgstr "Puta mer… Sabe, meu bem,\neu dormi tão pouco, então…"

#. cv/btl/tam3_1110.at3 | 25 quadros | modo 1
msgctxt "668:0"
msgid "Please let me handle this."
msgstr "Por favor, deixe comigo."

#. cv/btl/rin_1710.at3 | 100 quadros | modo 1
msgctxt "669:0"
msgid "Oh no! My dream of building\nmy own nation is in peril!"
msgstr "Ah, não! Meu sonho de fundar\num país está em perigo!"

#. cv/btl/gil_1801.at3 | 70 quadros | modo 1
msgctxt "670:0"
msgid "All I see is trash…"
msgstr "Só vejo lixo…"

#. cv/btl/gaw2_1700.at3 | 100 quadros | modo 1
msgctxt "671:0"
msgid "Please pay back your debt, as a gentleman\n                 should.                 "
msgstr "Por favor, pague sua dívida,\ncomo convém a um cavalheiro."

#. cv/btl/jin_1201_edit.at3 | 50 quadros | modo 1
msgctxt "672:1"
msgid "Just a little trolling!"
msgstr "Só uma trolladinha!"

#. cv/btl/tam_1101.at3 | 44 quadros | modo 1
msgctxt "673:0"
msgid "I can keep going!"
msgstr "Ainda posso continuar!"

#. cv/btl/twi_1710.at3 | 130 quadros | modo 1
msgctxt "674:0"
msgid "This has taken a turn for the worst.\n  Caster, give it all you've got.  "
msgstr "A situação ficou feia.\nCaster, dê tudo de si."

#. cv/btl/ner_2050.at3 | 76 quadros | modo 1
msgctxt "675:0"
msgid "Were you drawn by my imperium?"
msgstr "Meu imperium te atraiu?"

#. cv/btl/ner_2050.at3 | 60 quadros | modo 1
msgctxt "675:1"
msgid "I'll rout you just as you wish then!"
msgstr "Então vou te derrotar, como desejas!"

#. cv/btl/emi3_1510.at3 | 36 quadros | modo 1
msgctxt "676:0"
msgid "Awfully bold for a small fry…!"
msgstr "Que ousadia pra alguém tão insignificante…!"

#. cv/btl/emi_1830_mix.at3 | 214 quadros | modo 1
msgctxt "677:0"
msgid "I'll crush you… I'll crush anyone who\n            gets in my way.            "
msgstr "Vou esmagar você…\nE qualquer um que se ponha no caminho."

#. cv/btl/emi_1830_mix.at3 | 100 quadros | modo 1
msgctxt "677:2"
msgid "I'll turn you into a nice paste, Archer!"
msgstr "Vou transformar você em pasta, Archer!"

#. cv/btl/emi_1830_mix.at3 | 84 quadros | modo 1
msgctxt "677:3"
msgid "It seems you've lost yourself to hatred."
msgstr "Parece que o ódio tomou conta de você."

#. cv/btl/emi_1830_mix.at3 | 190 quadros | modo 1
msgctxt "677:4"
msgid "I feel pity for you, but it's also a man's job\n      to set warped affections straight!      "
msgstr "Tenho pena, mas cabe a um homem\nendireitar um afeto tão desvirtuado!"

#. cv/btl/tam_2007.at3 | 56 quadros | modo 1
msgctxt "678:0"
msgid "Hopefully this'll be satisfying."
msgstr "Tomara que valha a pena."

#. cv/btl/cuu_1100.at3 | 56 quadros | modo 1
msgctxt "679:0"
msgid "How oddly Master-like of ya."
msgstr "Até parece um Mestre de verdade."

#. cv/btl/rin_1510.at3 | 39 quadros | modo 1
msgctxt "680:0"
msgid "Huh? Did we slip up?"
msgstr "Ué? A gente vacilou?"

#. se/eb_emi/9 | 27 quadros | modo 1
msgctxt "681:0"
msgid "Can you handle this!?"
msgstr "Você aguenta isso!?"

#. cv/btl/gil_1520.at3 | 62 quadros | modo 1
msgctxt "682:0"
msgid "Your new title is \"Buffoonius Caesar\"!"
msgstr "Teu novo título é “Bufonius César”!"

#. cv/fld/kia_0106.at3 | 138 quadros | modo 2
msgctxt "683:0"
msgid "June 4th. I'd rather not count my age though, of course."
msgstr "4 de junho. Prefiro não contar a idade, naturalmente."

#. cv/btl/tam_1602.at3 | 76 quadros | modo 1
msgctxt "684:0"
msgid "Ohh darling, you're so dreamy～鷙"
msgstr "Ai, meu bem, você é um sonho～鷙"

#. cv/btl/gaw_1210_edit.at3 | 42 quadros | modo 1
msgctxt "685:0"
msgid "No mercy. Only death awaits you."
msgstr "Sem clemência. Só a morte os espera."

#. cv/btl/gaw2_1120.at3 | 78 quadros | modo 1
msgctxt "686:0"
msgid "Using such cruel methods… How dare you!"
msgstr "Usar métodos tão cruéis… Como ousa!"

#. cv/btl/tam_1940.at3 | 118 quadros | modo 1
msgctxt "687:0"
msgid "  This little flower blooms within the  \nImaginary Number Space―and is vengeful."
msgstr "Esta florzinha nasceu no Espaço dos\nNúmeros Imaginários e quer vingança."

#. cv/btl/tam_1940.at3 | 82 quadros | modo 1
msgctxt "687:1"
msgid "I'll crush you into the ground\n  until there's nothing left.  "
msgstr "Vou te esmagar até não sobrar nada."

#. cv/btl/emi_2003.at3 | 40 quadros | modo 1
msgctxt "688:0"
msgid "Let's be smart about finishing this."
msgstr "Vamos ser inteligentes e acabar com isso."

#. cv/btl/psl_1090.at3 | 23 quadros | modo 1
msgctxt "689:0"
msgid "Here I come…"
msgstr "Aqui vou eu…"

#. cv/btl/tam_1201_edit.at3 | 72 quadros | modo 1
msgctxt "690:0"
msgid "A good wife must be thrifty～"
msgstr "Uma boa esposa tem de economizar～"

#. cv/fld/gil_0103.at3 | 306 quadros | modo 2
msgctxt "691:0"
msgid "B94/W73/H93. A Golden body fit for a Golden King."
msgstr "P94/C73/Q93. Um corpo de ouro para um rei de ouro."

#. cv/fld/gil_0103.at3 | 170 quadros | modo 2
msgctxt "691:1"
msgid "It'd be wasted on your eyes, but if you still desire a cast off,"
msgstr "Seria desperdício aos teus olhos, mas, se queres que me dispa,"

#. cv/fld/gil_0103.at3 | 62 quadros | modo 2
msgctxt "691:2"
msgid "then be ready with a Command Seal!"
msgstr "prepara um Selo de Comando!"

#. cv/fld/emi_0103.at3 | 222 quadros | modo 2
msgctxt "692:0"
msgid "78kg. My body fat percentage is low, so that's nearly all muscle."
msgstr "78 kg. Tenho pouca gordura, é quase só músculo."

#. cv/fld/emi_0103.at3 | 58 quadros | modo 2
msgctxt "692:1"
msgid "Regular training is essential to me."
msgstr "Treinar com regularidade é essencial para mim."

#. cv/btl/tam_1102.at3 | 55 quadros | modo 1
msgctxt "693:0"
msgid "How husband-like of you 鷙"
msgstr "Até parece coisa de marido鷙"

#. cv/fld/emi_0106.at3 | 184 quadros | modo 2
msgctxt "694:0"
msgid "Not really a weak spot, but well… I've got a soft spot for women."
msgstr "Não chega a ser uma fraqueza, mas…\ntenho um ponto fraco por mulheres."

#. cv/fld/emi_0106.at3 | 114 quadros | modo 2
msgctxt "694:1"
msgid "I often find myself getting worked to the bone by"
msgstr "Muitas vezes acabo trabalhando feito louco por"

#. cv/fld/emi_0106.at3 | 56 quadros | modo 2
msgctxt "694:2"
msgid "tomboys like you who steal the stage."
msgstr "garotas mandonas como você, que roubam a cena."

#. se/eb_el2/8 | 24 quadros | modo 1
msgctxt "695:0"
msgid "I'll kill you!!"
msgstr "Vou te matar!!"

#. cv/btl/gil_1251_edit.at3 | 60 quadros | modo 1
msgctxt "696:1"
msgid "This is more than a pest like you deserves!"
msgstr "Isso é mais do que uma praga como tu merece!"

#. cv/btl/gil_1251_edit.at3 | 38 quadros | modo 1
msgctxt "696:3"
msgid "I'll rip you to pieces!!"
msgstr "Vou te despedaçar!!"

#. cv/btl/ner_1801.at3 | 70 quadros | modo 1
msgctxt "697:0"
msgid "  I don't see this performance  \nending on any interesting note."
msgstr "Duvido que este espetáculo\nchegue a um desfecho interessante."

#. cv/fld/mll_0201.at3 | 200 quadros | modo 2
msgctxt "698:0"
msgid "Silver and blue I suppose. Wait, you could tell just by looking."
msgstr "Prata e azul, acho. Espera, dava pra ver só de olhar."

#. cv/fld/mll_0201.at3 | 80 quadros | modo 2
msgctxt "698:1"
msgid "You just wanted to make me say it out loud, didn't you? Pervert."
msgstr "Você só queria me fazer dizer em voz alta, né? Que perversão."

#. cv/btl/eli_1800.at3 | 114 quadros | modo 1
msgctxt "699:0"
msgid "Why not? You look delectable."
msgstr "Por que não? Você parece uma delícia."

#. cv/btl/eli_1800.at3 | 66 quadros | modo 1
msgctxt "699:1"
msgid "Maybe I'll eviscerate you to paint my plate."
msgstr "Talvez eu abra sua barriga pra pintar meu prato."

#. cv/btl/emi_1111.at3 | 35 quadros | modo 1
msgctxt "700:0"
msgid "We're the favorite to win here!"
msgstr "A vantagem é nossa!"

#. se/eb_kia/20 | 26 quadros | modo 1
msgctxt "701:0"
msgid "Harder鷙"
msgstr "Com mais força鷙"

#. cv/fld/ran_0105.at3 | 160 quadros | modo 2
msgctxt "702:0"
msgid "Please avoid touching my armpits, back, abdomen, and the like."
msgstr "Evite tocar minhas axilas, costas, abdômen e afins."

#. cv/fld/ran_0105.at3 | 88 quadros | modo 2
msgctxt "702:1"
msgid "Those are my physical body's weak points."
msgstr "São os pontos fracos do meu corpo físico."

#. cv/fld/ran_0105.at3 | 54 quadros | modo 2
msgctxt "702:2"
msgid "…I get really squirmy when touched there."
msgstr "…eu me contorço bastante quando me tocam ali."

#. cv/btl/tam_1271_edit.at3 | 70 quadros | modo 1
msgctxt "703:0"
msgid "Hehehehe…"
msgstr "Hehehehe…"

#. cv/btl/tam_1271_edit.at3 | 20 quadros | modo 1
msgctxt "703:2"
msgid "NO"
msgstr "SEM"

#. cv/btl/tam_1271_edit.at3 | 30 quadros | modo 1
msgctxt "703:4"
msgid "EXCUSES!"
msgstr "DESCULPAS!"

#. cv/btl/tam_1271_edit.at3 | 44 quadros | modo 1
msgctxt "703:6"
msgid "Exterminating unfaithful lovers!"
msgstr "Exterminando amantes infiéis!"

#. cv/btl/tam_1271_edit.at3 | 38 quadros | modo 1
msgctxt "703:8"
msgid "Also known as the"
msgstr "Também conhecido como"

#. cv/btl/tam_1271_edit.at3 | 56 quadros | modo 1
msgctxt "703:9"
msgid "Polygamist Castration Fist!"
msgstr "Punho Castrador de Polígamos!"

#. se/eb_mks/5 | 24 quadros | modo 1
msgctxt "704:0"
msgid "Smack, smack!"
msgstr "Tapinha, tapinha!"

#. cv/btl/gil_1112.at3 | 36 quadros | modo 1
msgctxt "705:0"
msgid "What worthless trifle."
msgstr "Que ninharia desprezível."

#. cv/btl/jin_1512.at3 | 52 quadros | modo 1
msgctxt "706:0"
msgid "This isn't just another game!!"
msgstr "Isso aqui não é só mais um jogo!!"

#. se/eb_mks/8 | 24 quadros | modo 1
msgctxt "707:0"
msgid "Regret!"
msgstr "Arrependa-se!"

#. cv/btl/rob_1800.at3 | 87 quadros | modo 1
msgctxt "708:0"
msgid "Let's dance. You better not disappoint me."
msgstr "Vamos dançar. É bom que não me decepcione."

#. cv/btl/tam_1611.at3 | 40 quadros | modo 1
msgctxt "709:0"
msgid "No surprises there!"
msgstr "Como era de se esperar!"

#. cv/btl/sal_1700.at3 | 54 quadros | modo 1
msgctxt "710:0"
msgid "Are you going to keep playing with me?"
msgstr "Vai continuar brincando comigo?"

#. cv/btl/sal_1700.at3 | 42 quadros | modo 1
msgctxt "710:1"
msgid "Keep playing with me!!"
msgstr "Continue brincando comigo!!"

#. cv/btl/psl_1510.at3 | 40 quadros | modo 1
msgctxt "711:0"
msgid "R-really…?"
msgstr "D-de verdade…?"

#. cv/btl/tam_1801.at3 | 68 quadros | modo 1
msgctxt "712:0"
msgid "Let's wrap all this up before breakfast."
msgstr "Vamos acabar com isso antes do café."

#. cv/btl/gil_1721.at3 | 80 quadros | modo 1
msgctxt "713:0"
msgid "            Get ready.            \nTheir Noble Phantasm looms, Master!"
msgstr "Prepara-te. Vem aí o Fantasma Nobre!"

#. se/eb_rob/13 | 40 quadros | modo 1
msgctxt "714:0"
msgid "Dammit, I'm getting sloppy."
msgstr "Droga, tô ficando descuidado."

#. se/eb_rob/8 | 28 quadros | modo 1
msgctxt "715:0"
msgid "Wide open!"
msgstr "Baixou a guarda!"

#. se/eb_emi/12 | 32 quadros | modo 1
msgctxt "716:0"
msgid "How unfortunate."
msgstr "Que infelicidade."

#. cv/btl/emi_1740.at3 | 106 quadros | modo 1
msgctxt "717:0"
msgid "Let's get started. I've gotta warm\n    back up somehow, Master―    "
msgstr "Vamos começar. Preciso me aquecer de novo―"

#. cv/btl/emi_1740.at3 | 100 quadros | modo 1
msgctxt "717:2"
msgid "Wait a sec… I feel, weirdly sluggish."
msgstr "Espere… Estou estranhamente lento."

#. cv/btl/emi_1620.at3 | 55 quadros | modo 1
msgctxt "718:0"
msgid "You had me sweating there, Master."
msgstr "Você me fez suar frio."

#. cv/btl/rob_1210_edit.at3 | 66 quadros | modo 1
msgctxt "719:0"
msgid "A scratch is more than enough."
msgstr "Um arranhão é mais que suficiente."

#. cv/btl/emi_1500.at3 | 34 quadros | modo 1
msgctxt "720:0"
msgid "Let's keep pushing through!"
msgstr "Vamos continuar avançando!"

#. cv/btl/eli_1753_mix.at3 | 194 quadros | modo 1
msgctxt "721:0"
msgid "Oh, not bad. Guess you're not\n  just a third-rate Servant.  "
msgstr "Ah, nada mal. Você não é só\numa Serva de terceira categoria."

#. cv/btl/eli_1753_mix.at3 | 184 quadros | modo 1
msgctxt "721:1"
msgid "H-hey! You took that much of my blood, and\n   you still couldn't finish them off!?   "
msgstr "E-ei! Bebeu tanto do meu sangue\ne ainda não deu conta deles!?"

#. cv/btl/tam_1720.at3 | 64 quadros | modo 1
msgctxt "722:0"
msgid "They're coming at us straight on, huh?"
msgstr "Vão vir pra cima da gente mesmo, hein?"

#. cv/btl/tam_1720.at3 | 94 quadros | modo 1
msgctxt "722:1"
msgid "Brace yourself, Master.\nIt's about to get rough."
msgstr "Prepare-se, Mestre.\nA coisa vai ficar feia."

#. cv/btl/ner_1820_mix.at3 | 154 quadros | modo 1
msgctxt "723:0"
msgid "No matter how proficient a singer you are,\n     there's one thing that you lack.     "
msgstr "Por melhor que cantes,\nhá uma coisa que te falta."

#. cv/btl/ner_1820_mix.at3 | 116 quadros | modo 1
msgctxt "723:1"
msgid "My sword here will show you what it is!"
msgstr "Minha espada vai te mostrar o que é!"

#. cv/btl/ner_1820_mix.at3 | 110 quadros | modo 1
msgctxt "723:2"
msgid "Fine then, it's time to rate our performances!"
msgstr "Pois bem, é hora de julgar os espetáculos!"

#. cv/btl/ner_1820_mix.at3 | 170 quadros | modo 1
msgctxt "723:3"
msgid "You and I, whoever is left standing is the\n                true diva!                "
msgstr "Quem ficar de pé entre nós\né a verdadeira diva!"

#. cv/btl/ner_1820_mix.at3 | 64 quadros | modo 1
msgctxt "723:4"
msgid "This isn't a singing competition…"
msgstr "Isto não é um concurso de canto…"

#. cv/btl/cuu_1510.at3 | 42 quadros | modo 1
msgctxt "724:0"
msgid "Get it together, Kotomine!"
msgstr "Se recomponha, Kotomine!"

#. cv/fld/tam_0602.at3 | 70 quadros | modo 1
msgctxt "725:0"
msgid "Hehe, back at our love nest 鷙"
msgstr "Hehe, de volta ao nosso ninho de amor 鷙"

#. cv/btl/emi3_1750_mix.at3 | 128 quadros | modo 1
msgctxt "726:0"
msgid "Hmm, seems like this is the best they've got.\n              I'm disappointed.              "
msgstr "Hum, parece que é só isso que conseguem.\nQue decepção."

#. cv/btl/emi3_1750_mix.at3 | 118 quadros | modo 1
msgctxt "726:1"
msgid "What a waste of time. Their preparation\n and determination are sorely lacking. "
msgstr "Que perda de tempo. Faltam preparo\ne determinação, e muito."

#. cv/btl/cuu_1300_edit.at3 | 58 quadros | modo 1
msgctxt "727:1"
msgid "And finally, the third…"
msgstr "E, por fim, a terceira…"

#. cv/btl/cuu_1300_edit.at3 | 60 quadros | modo 1
msgctxt "727:2"
msgid "Take this!"
msgstr "Toma essa!"

#. cv/btl/cuu_1300_edit.at3 | 56 quadros | modo 1
msgctxt "727:3"
msgid "Gáe Bolg!"
msgstr "Gáe Bolg!"

#. cv/btl/emi_1112.at3 | 24 quadros | modo 1
msgctxt "728:0"
msgid "Connect!"
msgstr "Acerte!"

#. cv/btl/gil_1211_edit.at3 | 70 quadros | modo 1
msgctxt "729:0"
msgid "The water goddess blesses\nme with unlimited magic."
msgstr "A deusa das águas me abençoa\ncom magia sem limites."

#. cv/btl/ner_1731.at3 | 80 quadros | modo 1
msgctxt "730:0"
msgid "Alright, let's raise the tempo!"
msgstr "Muito bem, vamos acelerar o ritmo!"

#. cv/btl/mll_1757.at3 | 52 quadros | modo 1
msgctxt "731:0"
msgid "Did I not stretch enough before\n      the performance…?      "
msgstr "Será que não alonguei o bastante\nantes do espetáculo…?"

#. se/eb_sal/11 | 23 quadros | modo 1
msgctxt "732:0"
msgid "Thank you!"
msgstr "Valeu!"

#. cv/btl/gil_2051.at3 | 48 quadros | modo 1
msgctxt "733:0"
msgid "This form has another name:"
msgstr "Esta forma tem outro nome:"

#. cv/btl/gil_2051.at3 | 68 quadros | modo 1
msgctxt "733:1"
msgid "Gilgamesh\n  Naked!  "
msgstr "Gilgamesh\nNu!"

#. cv/btl/gil_1601.at3 | 94 quadros | modo 1
msgctxt "734:0"
msgid "      That was excellent!      \nI'll give you some candy later."
msgstr "Foi excelente! Vou te dar uns doces depois."

#. cv/btl/ner_1710.at3 | 74 quadros | modo 1
msgctxt "735:0"
msgid "Pull it together, we're not finished yet!"
msgstr "Recompõe-te. Ainda não acabamos!"

#. cv/fld/ran_0101.at3 | 194 quadros | modo 2
msgctxt "736:0"
msgid "157cm. For a girl, I feel that's perfectly average."
msgstr "157 cm. Creio ser uma altura mediana para uma moça."

#. cv/btl/tam3_1510.at3 | 24 quadros | modo 1
msgctxt "737:0"
msgid "This isn't looking good…"
msgstr "Isto não parece nada bom…"

#. cv/btl/elp_1200_edit.at3 | 50 quadros | modo 1
msgctxt "738:0"
msgid "J-just a little bit, okay!?"
msgstr "S-só um pouquinho, tá!?"

#. cv/btl/kar_1210_edit.at3 | 58 quadros | modo 1
msgctxt "739:1"
msgid "Brahma, cover the Earth!"
msgstr "Brahma, cubra a Terra!"

#. cv/btl/kia_1200_edit.at3 | 108 quadros | modo 1
msgctxt "740:0"
msgid "Pain and pleasure are but one and the same.\n  They paint our lives with their colors.  "
msgstr "Dor e prazer são uma só coisa.\nSão as cores que dão vida à nossa existência."

#. cv/btl/emi_1890_mix.at3 | 88 quadros | modo 1
msgctxt "741:0"
msgid "…I never imagined you were this monstrous."
msgstr "…nunca imaginei que fosse tão monstruosa."

#. cv/btl/emi_1890_mix.at3 | 142 quadros | modo 1
msgctxt "741:1"
msgid "You could have been an exceptional saint\nif you didn't fall down the wrong path."
msgstr "Poderia ter sido uma santa exemplar\nse não tivesse se desviado."

#. cv/btl/emi_1890_mix.at3 | 274 quadros | modo 1
msgctxt "741:2"
msgid "Do you feel pity for me, Archer?\n    Then offer me correction.    "
msgstr "Tem pena de mim, Archer?\nEntão me corrija."

#. cv/btl/emi_1890_mix.at3 | 146 quadros | modo 1
msgctxt "741:3"
msgid "I'll happily present my body\n     before your sword.     "
msgstr "De bom grado ofereço meu corpo à sua espada."

#. cv/btl/emi_1890_mix.at3 | 106 quadros | modo 1
msgctxt "741:4"
msgid "I won't fall for your temptations,\n  you damn devilish bodhisattva.  "
msgstr "Não vou cair na sua tentação,\nmaldita Bodhisattva Demoníaca."

#. cv/btl/emi_1890_mix.at3 | 182 quadros | modo 1
msgctxt "741:5"
msgid "Spawn of mankind's darkest desires:\n   your love shall crumble here.   "
msgstr "Fruto dos desejos mais sombrios da humanidade,\nseu amor se desfaz aqui."

#. cv/btl/sal_1510.at3 | 48 quadros | modo 1
msgctxt "742:0"
msgid "Time to smash your limbs～!"
msgstr "Hora de quebrar seus braços e pernas～!"

#. cv/btl/eli_1201_edit.at3 | 40 quadros | modo 1
msgctxt "743:0"
msgid "You're envious, aren't you?"
msgstr "Deu inveja, não deu?"

#. cv/fld/tam_0102.at3 | 132 quadros | modo 2
msgctxt "744:0"
msgid "49kg. Undefeated by enemies nor candy,"
msgstr "49 kg. Nem inimigos nem doces me vencem,"

#. cv/fld/tam_0102.at3 | 86 quadros | modo 2
msgctxt "744:1"
msgid "my body has been perfectly trained!"
msgstr "meu corpo foi treinado à perfeição!"

#. cv/fld/tam_0102.at3 | 82 quadros | modo 2
msgctxt "744:2"
msgid "There's nothing about it I'm ashamed of!!!"
msgstr "Tenho orgulho de cada pedacinho!!!"

#. cv/fld/kot_00916.at3 | 26 quadros | modo 3
msgctxt "745:0"
msgid "Here you go."
msgstr "Aqui está."

#. cv/fld/mks_0107.at3 | 116 quadros | modo 2
msgctxt "746:0"
msgid "Eyes. Pupils. Irises."
msgstr "Olhos. Pupilas. Íris."

#. cv/fld/mks_0107.at3 | 138 quadros | modo 2
msgctxt "746:1"
msgid "Glaring. Despairing. Staring."
msgstr "Olhares de ódio. De desespero. Fixos."

#. cv/fld/mks_0107.at3 | 108 quadros | modo 2
msgctxt "746:2"
msgid "Ahh, humans are so interesting to watch～"
msgstr "Ahh, é tão interessante observar os humanos～"

#. cv/btl/tam_1840_mix.at3 | 108 quadros | modo 1
msgctxt "747:0"
msgid "We all know humans can't be saved."
msgstr "Todo mundo sabe que humanos não têm salvação."

#. cv/btl/tam_1840_mix.at3 | 136 quadros | modo 1
msgctxt "747:1"
msgid "How about we sit you in a nice part-time\n job to save US from your blathering… "
msgstr "Que tal arrumar um bico pra você?\nAssim a gente se salva da sua tagarelice…"

#. cv/btl/tam_1840_mix.at3 | 186 quadros | modo 1
msgctxt "747:2"
msgid "S-shut up you foul sham of a miko!!\n  Karna, throw everything at her!  "
msgstr "C-cala a boca, sua falsa sacerdotisa!!\nKarna, vai com tudo!"

#. cv/btl/tam_1840_mix.at3 | 226 quadros | modo 1
msgctxt "747:3"
msgid "  Understood. I cannot defeat her otherwise.  \nHer divinity is on par… no, higher than mine."
msgstr "Entendido. É o único jeito de vencê-la.\nSua divindade iguala… supera a minha."

#. cv/btl/adl_1200_edit.at3 | 80 quadros | modo 1
msgctxt "748:0"
msgid "Kai's Splinter, lodge within her!"
msgstr "Lasca de Kai, crave-se nela!"

#. cv/btl/ner_1702.at3 | 62 quadros | modo 1
msgctxt "749:0"
msgid "Haha, I'm feeling good about this."
msgstr "Haha, tenho um bom pressentimento."

#. cv/fld/psl_0104.at3 | 94 quadros | modo 2
msgctxt "750:0"
msgid "I was born recently, in the Far Side of the Moon."
msgstr "Nasci faz pouco tempo, no Lado Distante da Lua."

#. cv/btl/emi_1871_mix.at3 | 186 quadros | modo 1
msgctxt "751:0"
msgid "  Love is something that fades over time.  \nYour wish for eternity can never be granted."
msgstr "O amor se apaga com o tempo.\nSeu desejo de eternidade nunca se realizará."

#. cv/btl/emi_1871_mix.at3 | 100 quadros | modo 1
msgctxt "751:1"
msgid "I'll end that dream of yours with\n          my own hands.          "
msgstr "Vou acabar com esse sonho\ncom minhas próprias mãos."

#. cv/btl/emi_1871_mix.at3 | 76 quadros | modo 1
msgctxt "751:2"
msgid "Stop, I don't want to hear it…!"
msgstr "Pare. Eu não quero ouvir isso…!"

#. cv/btl/emi_1871_mix.at3 | 166 quadros | modo 1
msgctxt "751:3"
msgid "     My love is eternal!     \nNo, ONLY my love is eternal!!"
msgstr "Meu amor é eterno!\nSó o MEU amor é eterno!!"

#. cv/btl/emi_1871_mix.at3 | 88 quadros | modo 1
msgctxt "751:4"
msgid "I'll engrave my feelings into your body\n         with my legs, Archer!         "
msgstr "Vou gravar o que sinto no seu corpo\ncom minhas pernas, Archer!"

#. cv/btl/ksk_1220_edit.at3 | 60 quadros | modo 1
msgctxt "752:1"
msgid "Crown, bring forth light!"
msgstr "Coroa, traga a luz!"

#. cv/btl/tam_1124.at3 | 36 quadros | modo 1
msgctxt "753:0"
msgid "I'm back～!"
msgstr "Voltei～!"

#. cv/btl/ner_1630.at3 | 118 quadros | modo 1
msgctxt "754:0"
msgid "  You may celebrate, for I've  \nreclaimed another of my powers!"
msgstr "Podes comemorar! Recuperei\noutro dos meus poderes!"

#. cv/btl/elp_1800.at3 | 64 quadros | modo 1
msgctxt "755:0"
msgid "I'll open this show with a bang!"
msgstr "Vou abrir o show com tudo!"

#. cv/btl/leo_1520.at3 | 36 quadros | modo 1
msgctxt "756:0"
msgid "What is going on!?"
msgstr "O que está acontecendo!?"

#. cv/btl/tam_1230_edit.at3 | 50 quadros | modo 1
msgctxt "757:1"
msgid "Show me a whirling dance, okay?"
msgstr "Quero ver você rodopiar, viu?"

#. cv/btl/elp_1611.at3 | 52 quadros | modo 1
msgctxt "758:0"
msgid "Looks like you had fun with that～"
msgstr "Parece que você se divertiu～"

#. se/eb_tam3/8 | 28 quadros | modo 1
msgctxt "759:0"
msgid "Rest in peace."
msgstr "Descanse em paz."

#. cv/btl/elp_1710.at3 | 152 quadros | modo 1
msgctxt "760:0"
msgid "Oh dear… You have a special secret comeback\nplan ready, right Master? I'm counting on you!"
msgstr "Ai, ai… Você tem um plano secreto pra virar\nisso, né? Estou contando com você!"

#. se/eb_ner/9 | 37 quadros | modo 1
msgctxt "761:0"
msgid "It's my time to shine!"
msgstr "É minha hora de brilhar!"

#. cv/btl/el2_1511.at3 | 33 quadros | modo 1
msgctxt "762:0"
msgid "Argh, how dare you…!"
msgstr "Argh, como ousa…!"

#. cv/btl/rob_1510.at3 | 70 quadros | modo 1
msgctxt "763:0"
msgid "Ha! Don't get cocky!"
msgstr "Ha! Não se ache!"

#. cv/btl/emi_1741_mix.at3 | 90 quadros | modo 1
msgctxt "764:0"
msgid "I can't resist playing with my food a little～"
msgstr "Não resisto a brincar um pouco com a comida～"

#. cv/btl/emi_1741_mix.at3 | 96 quadros | modo 1
msgctxt "764:1"
msgid "Make sure to give me a nice scream, okay?"
msgstr "Quero ouvir um grito bem bonito, tá?"

#. cv/btl/emi_1741_mix.at3 | 70 quadros | modo 1
msgctxt "764:2"
msgid "You actually on a \"diet\"?"
msgstr "É sério que você tá de “dieta”?"

#. cv/btl/emi_1741_mix.at3 | 90 quadros | modo 1
msgctxt "764:3"
msgid "You realize that \"gourmet\" doesn't mean\n            \"gorge,\" right?            "
msgstr "Você sabe que “gourmet”\nnão quer dizer “glutona”, né?"

#. cv/btl/emi_1741_mix.at3 | 124 quadros | modo 1
msgctxt "764:4"
msgid "Hehe, pretty cocky for a Servant who\n       lost all their levels.       "
msgstr "Hehe, que audácia pra quem perdeu\ntodos os níveis de Servo."

#. cv/btl/emi_1741_mix.at3 | 144 quadros | modo 1
msgctxt "764:5"
msgid "You'll just have to show me what an\nexperienced Servant like you can do."
msgstr "Vai ter que mostrar do que alguém\ncom sua experiência é capaz."

#. cv/btl/tam_1714.at3 | 85 quadros | modo 1
msgctxt "765:0"
msgid "  Tamamo loves when the  \nunderdog comes out on top!"
msgstr "Tamamo adora quando a zebra vence!"

#. cv/btl/tam_1850_mix.at3 | 190 quadros | modo 1
msgctxt "766:0"
msgid "You said I'll never be able to shine?\n      Well then, what about you?      "
msgstr "Você disse que eu nunca ia brilhar?\nPois bem, e quanto a você?"

#. cv/btl/tam_1850_mix.at3 | 104 quadros | modo 1
msgctxt "766:1"
msgid "You've sullied yourself way more than I have!"
msgstr "Você se corrompeu bem mais que eu!"

#. cv/btl/tam_1850_mix.at3 | 154 quadros | modo 1
msgctxt "766:2"
msgid "Meh. I don't need to shine. My darling's the\n  one who should be blessed with happiness.  "
msgstr "Ah, eu não preciso brilhar. Quem merece\ntoda a felicidade é o meu bem."

#. cv/btl/tam_1850_mix.at3 | 210 quadros | modo 1
msgctxt "766:3"
msgid "I'm perfectly content supporting them\n        from the shadows 鷙        "
msgstr "Fico mais que satisfeita\nem dar apoio nos bastidores 鷙"

#. cv/btl/tam_1850_mix.at3 | 224 quadros | modo 1
msgctxt "766:4"
msgid "Urgh… Shut up, shut up, shut up! How dare an\n      antihero like you find happiness!      "
msgstr "Urgh… Cala a boca, cala a boca! Como se\natreve a ser feliz, sua anti-heroína!?"

#. cv/btl/gil_1744.at3 | 100 quadros | modo 1
msgctxt "767:0"
msgid "Watch close and tremble in awe!"
msgstr "Observa bem e treme de assombro!"

#. cv/btl/gil_1744.at3 | 132 quadros | modo 1
msgctxt "767:1"
msgid "For you shall now witness the awesome power\n  of the man you formed a contract with!  "
msgstr "Agora testemunharás o poder\ndaquele com quem firmaste contrato!"

#. cv/fld/tam_0202.at3 | 102 quadros | modo 2
msgctxt "768:0"
msgid "Attending Uzume-chan's cooking class."
msgstr "Faço aulas de culinária com a Uzume-chan."

#. cv/fld/tam_0202.at3 | 92 quadros | modo 2
msgctxt "768:1"
msgid "Speaking of, Darling, do you have any favorite side dishes?"
msgstr "A propósito, meu bem, tem algum\nacompanhamento que você adora?"

#. cv/btl/gaw2_1210_edit.at3 | 56 quadros | modo 1
msgctxt "769:0"
msgid "It is time to pay the piper!"
msgstr "Chegou a hora de acertar as contas!"

#. cv/fld/ner_0604.at3 | 52 quadros | modo 1
msgctxt "770:0"
msgid "Time for a short rest."
msgstr "Hora de uma breve pausa."

#. se/eb_gil/7 | 45 quadros | modo 1
msgctxt "771:0"
msgid "You're getting cocky."
msgstr "Estás te achando."

#. cv/btl/emi3_1753_mix.at3 | 124 quadros | modo 1
msgctxt "772:0"
msgid "No way, they survived the Reality Marble…!?"
msgstr "Como!? Sobreviveram à Projeção de Realidade…!"

#. cv/btl/emi3_1753_mix.at3 | 80 quadros | modo 1
msgctxt "772:1"
msgid "To survive a brutal onslaught like that…"
msgstr "Sobreviver a um ataque tão brutal…"

#. cv/btl/emi3_1753_mix.at3 | 30 quadros | modo 1
msgctxt "772:2"
msgid "Impressive teamwork."
msgstr "Sintonia impressionante."

#. cv/btl/emi_1702.at3 | 58 quadros | modo 1
msgctxt "773:0"
msgid "Just a bit more. Don't slip up now."
msgstr "Só mais um pouco. Não vacile agora."

#. cv/btl/eli_1100.at3 | 34 quadros | modo 1
msgctxt "774:0"
msgid "How thoughtful of you～"
msgstr "Que consideração a sua～"

#. cv/fld/ran_0106.at3 | 160 quadros | modo 2
msgctxt "775:0"
msgid "January 1st. Perfect. A very beautiful beginning."
msgstr "Primeiro de janeiro. Perfeito. Um belo começo."

#. cv/fld/emi_0604.at3 | 64 quadros | modo 1
msgctxt "776:0"
msgid "You closed the door properly, right?"
msgstr "Fechou bem a porta, certo?"

#. cv/fld/emi_0604.at3 | 28 quadros | modo 1
msgctxt "776:1"
msgid "Just checking."
msgstr "Só conferindo."

#. cv/btl/kot_1531.at3 | 30 quadros | modo 1
msgctxt "777:0"
msgid "Lament!"
msgstr "Lamente-se!"

#. cv/c00_160_215.at3 | 256 quadros | modo 2
msgctxt "778:0"
msgid "I am the absolute; the first king; the King of Heroes: Gilgamesh."
msgstr "Sou o absoluto, o primeiro rei.\nGilgamesh, o Rei dos Heróis."

#. cv/c00_160_215.at3 | 70 quadros | modo 2
msgctxt "778:1"
msgid "You shall address me as such."
msgstr "É assim que me chamarás."

#. se/eb_tam3/10 | 24 quadros | modo 1
msgctxt "779:0"
msgid "Useless."
msgstr "Inútil."

#. se/eb_ner/26 | 35 quadros | modo 1
msgctxt "780:0"
msgid "Not yet!"
msgstr "Ainda não!"

#. cv/btl/gil_1820_mix.at3 | 74 quadros | modo 1
msgctxt "781:0"
msgid "You're misguided, Lancer!"
msgstr "Estás enganada, Lancer!"

#. cv/btl/gil_1820_mix.at3 | 174 quadros | modo 1
msgctxt "781:1"
msgid "The King of Luxury himself shall personally\n    show you what a true performance is!    "
msgstr "O próprio Rei do Luxo vai te mostrar\ncomo se faz um espetáculo de verdade!"

#. cv/btl/gil_1820_mix.at3 | 164 quadros | modo 1
msgctxt "781:2"
msgid "    Ah! How is he so charismatic～!    \nI have a sudden urge to become his pupil!"
msgstr "Ah! Quanto carisma～!\nDe repente, quero ser sua discípula!"

#. cv/btl/gil_1820_mix.at3 | 130 quadros | modo 1
msgctxt "781:3"
msgid "   Now that I look closely,   \nhe's really handsome to boot…"
msgstr "E, olhando bem, ele também é bem bonito…"

#. cv/btl/gil_1820_mix.at3 | 136 quadros | modo 1
msgctxt "781:4"
msgid "    Snap out of it, Lancer.    \nThat Servant is super dangerous."
msgstr "Volta a si, Lancer.\nEsse Servo é perigoso demais."

#. cv/btl/gil_1820_mix.at3 | 54 quadros | modo 1
msgctxt "781:5"
msgid "We mustn't surrender now."
msgstr "Não podemos nos render agora."

#. cv/btl/gil_1520a.at3 | 62 quadros | modo 1
msgctxt "782:0"
msgid "Your new title is \"Buffoonius Caesar\"!"
msgstr "Teu novo título é “Bufonius César”!"

#. cv/btl/emi_1095.at3 | 24 quadros | modo 1
msgctxt "783:0"
msgid "Shall we begin?"
msgstr "Vamos começar?"

#. cv/btl/elp_1800a.at3 | 114 quadros | modo 1
msgctxt "784:0"
msgid "Why not? You look delectable."
msgstr "Por que não? Você parece uma delícia."

#. cv/btl/elp_1800a.at3 | 66 quadros | modo 1
msgctxt "784:1"
msgid "Maybe I'll eviscerate you to paint my plate."
msgstr "Talvez eu abra sua barriga pra pintar meu prato."

#. cv/btl/psl_1520.at3 | 42 quadros | modo 1
msgctxt "785:0"
msgid "Argh, I'm mad now!!"
msgstr "Argh, agora estou com raiva!!"

#. cv/btl/cuu_1120.at3 | 48 quadros | modo 1
msgctxt "786:0"
msgid "You won't get rid of me that easily."
msgstr "Não vai se livrar de mim tão fácil."

#. cv/btl/emi3_1111.at3 | 25 quadros | modo 1
msgctxt "787:0"
msgid "Leave it to me!"
msgstr "Deixa comigo!"

#. sound/bgm/bgm_bb_voice_03.at3 | 100 quadros | modo 1
msgctxt "788:0"
msgid "Hehehe…"
msgstr "Hehehe…"

#. sound/bgm/bgm_bb_voice_03.at3 | 86 quadros | modo 1
msgctxt "788:1"
msgid "You're so embarrassing to watch right now,\n                  Senpai!                  "
msgstr "Que vergonha alheia, Senpai!"

#. sound/bgm/bgm_bb_voice_03.at3 | 74 quadros | modo 1
msgctxt "788:2"
msgid "Hahaha!"
msgstr "Hahaha!"

#. cv/fld/gil_0620.at3 | 38 quadros | modo 1
msgctxt "789:0"
msgid "Keep your eyes over there."
msgstr "Mantém os olhos para lá."

#. cv/btl/gil_1401.at3 | 122 quadros | modo 1
msgctxt "790:0"
msgid "Was I of all people… too slothful?"
msgstr "Logo eu… teria me acomodado demais?"

#. se/eb_ner/27 | 40 quadros | modo 1
msgctxt "791:0"
msgid "That hurts, you know!!"
msgstr "Isso dói, sabias!!"

#. cv/btl/kia_1210_edit.at3 | 108 quadros | modo 1
msgctxt "792:0"
msgid "Pain and pleasure are but one and the same.\n  They paint our lives with their colors.  "
msgstr "Dor e prazer são uma só coisa.\nSão as cores que dão vida à nossa existência."

#. cv/fld/emi_0600.at3 | 66 quadros | modo 1
msgctxt "793:0"
msgid "This room is good enough for me, personally."
msgstr "Pra mim, este quarto já está bom."

#. cv/btl/kar_1750_mix.at3 | 142 quadros | modo 1
msgctxt "794:0"
msgid "Huh, this is way too easy. Could it be!?\n              Am I A-rank!?              "
msgstr "Hã, tá fácil demais. Será que…!?\nEu sou classe A!?"

#. cv/btl/kar_1750_mix.at3 | 120 quadros | modo 1
msgctxt "794:1"
msgid "In slouching, sure.\n  It depresses me.  "
msgstr "Em ficar jogada, sim.\nIsso me deprime."

#. cv/btl/kar_1750_mix.at3 | 76 quadros | modo 1
msgctxt "794:2"
msgid "IMpresses! It IMpresses you!\n   That's what you meant!   "
msgstr "IMPRESSIONA! Isso te impressiona!\nFoi o que você quis dizer!"

#. cv/btl/elp_1521.at3 | 45 quadros | modo 1
msgctxt "795:0"
msgid "Ahh, we're gonna lose～!"
msgstr "Ahh, a gente vai perder～!"

#. cv/fld/emi_0605.at3 | 36 quadros | modo 1
msgctxt "796:0"
msgid "Finally a rest…"
msgstr "Finalmente, um descanso…"

#. cv/btl/kia_1300_edit.at3 | 216 quadros | modo 1
msgctxt "797:1"
msgid "    Salvation draws nigh. I beckon    \nall living beings and all suffering―"
msgstr "A salvação se aproxima. Convoco\ntodos os seres vivos e todo o sofrimento―"

#. cv/btl/kia_1300_edit.at3 | 114 quadros | modo 1
msgctxt "797:3"
msgid "The unrescued I shall rescue."
msgstr "Salvarei quem ainda não foi salvo."

#. cv/btl/kia_1300_edit.at3 | 164 quadros | modo 1
msgctxt "797:4"
msgid "To be joyous, pure, erudite, wise, master\nover adversity, open minded, benevolent,"
msgstr "Ser feliz, puro, erudito, sábio,\nsenhor das adversidades, aberto, benevolente,"

#. cv/btl/kia_1300_edit.at3 | 78 quadros | modo 1
msgctxt "797:5"
msgid "serene, altruistic, and omniscient."
msgstr "sereno, altruísta e onisciente."

#. cv/btl/kia_1300_edit.at3 | 156 quadros | modo 1
msgctxt "797:7"
msgid "Let us enter the Pure Land together,\n    the paradise we long for―    "
msgstr "Entremos juntos na Terra Pura,\no paraíso que tanto desejamos―"

#. cv/btl/tam_1211_edit.at3 | 45 quadros | modo 1
msgctxt "798:1"
msgid "Fiery heavens, erupt!"
msgstr "Céus em chamas, explodam!"

#. cv/btl/kia_1753_mix.at3 | 120 quadros | modo 1
msgctxt "799:0"
msgid "What absurd endurance you have…"
msgstr "Que resistência absurda…"

#. cv/btl/kia_1753_mix.at3 | 116 quadros | modo 1
msgctxt "799:1"
msgid "You could have the ultimate pleasure if you\n              just accept me.              "
msgstr "Bastaria me aceitar\npara alcançar o prazer supremo."

#. cv/btl/kia_1753_mix.at3 | 92 quadros | modo 1
msgctxt "799:2"
msgid "It just means there's humans who want more\n            than just pleasure.            "
msgstr "Só quer dizer que há humanos\nque desejam mais do que prazer."

#. cv/btl/kia_1753_mix.at3 | 58 quadros | modo 1
msgctxt "799:3"
msgid "Looks like they're the perfect enemy\n          for you, Kiara!          "
msgstr "Parece que achou o adversário perfeito, Kiara!"

#. cv/btl/gaw2_1753.at3 | 84 quadros | modo 1
msgctxt "800:0"
msgid "Why are you two so adamant on doing this!?"
msgstr "Por que vocês dois insistem tanto nisso!?"

#. cv/btl/gil_1521.at3 | 74 quadros | modo 1
msgctxt "801:0"
msgid "You blew it on every move!\n  I'm impressed, mongrel!  "
msgstr "Erraste todos os movimentos!\nEstou impressionado, criatura mestiça!"

#. cv/btl/tam_1880_mix.at3 | 212 quadros | modo 1
msgctxt "802:0"
msgid "Seems like your old personality is gone\nforever. Still, you reap what you sow."
msgstr "Parece que sua antiga personalidade sumiu\nde vez. Bem, cada um colhe o que planta."

#. cv/btl/tam_1880_mix.at3 | 90 quadros | modo 1
msgctxt "802:1"
msgid "Your backstage meddling ends here, BB!"
msgstr "Sua intromissão nos bastidores acaba aqui, BB!"

#. cv/btl/tam_1880_mix.at3 | 144 quadros | modo 1
msgctxt "802:2"
msgid "Fool… The backstage is where the truth is."
msgstr "Tola… É nos bastidores que reside a verdade."

#. cv/btl/tam_1880_mix.at3 | 162 quadros | modo 1
msgctxt "802:3"
msgid "The center stage is an impromptu fabrication,\n          showing only the \"good.\"          "
msgstr "O palco é uma farsa improvisada\nque só mostra o que há de “bom”."

#. cv/btl/tam_1880_mix.at3 | 160 quadros | modo 1
msgctxt "802:4"
msgid "I'll grant you a world where we can be\n      who we are; no posturing…      "
msgstr "Vou dar a vocês um mundo onde possam\nser quem são, sem fingimento…"

#. cv/btl/tam_1880_mix.at3 | 98 quadros | modo 1
msgctxt "802:5"
msgid "Yeah, how about no?"
msgstr "É, que tal não?"

#. cv/btl/tam_1880_mix.at3 | 148 quadros | modo 1
msgctxt "802:6"
msgid "  A world without shame or reputation?  \nHonestly, won't we just be animals, then?"
msgstr "Um mundo sem vergonha nem reputação?\nFrancamente, seríamos bichos, né?"

#. cv/btl/tam_1880_mix.at3 | 128 quadros | modo 1
msgctxt "802:7"
msgid "Let's show her what amazing things vain\n        people can do, Master!        "
msgstr "Mestre, vamos mostrar do que pessoas\nvaidosas são capazes!"

#. cv/btl/elp_1500.at3 | 63 quadros | modo 1
msgctxt "803:0"
msgid "Looks like I'm number 1 after all!"
msgstr "No fim, eu sou a número um mesmo!"

#. cv/btl/eli_1700.at3 | 70 quadros | modo 1
msgctxt "804:0"
msgid "Heh, this'll be a total cakewalk."
msgstr "Heh, vai ser moleza."

#. cv/fld/mll_0202.at3 | 94 quadros | modo 2
msgctxt "805:0"
msgid "It's collecting dolls and figurines. "
msgstr "Colecionar bonecas e figuras."

#. cv/fld/mll_0202.at3 | 90 quadros | modo 2
msgctxt "805:1"
msgid "I'll NEVER forget the shame of that time"
msgstr "Jamais vou esquecer a vergonha daquela vez"

#. cv/fld/mll_0202.at3 | 50 quadros | modo 2
msgctxt "805:2"
msgid "I was peddled a wicked statue! "
msgstr "em que me venderam uma estátua horrenda!"

#. cv/fld/rin_0200.at3 | 92 quadros | modo 2
msgctxt "806:0"
msgid "It might be nice to let someone else take the lead on a vacation."
msgstr "Talvez fosse bom deixar outra pessoa tomar a frente nas férias."

#. cv/fld/rin_0200.at3 | 86 quadros | modo 2
msgctxt "806:1"
msgid "We don't even need a plan, could just go with the flow."
msgstr "Nem precisa de plano. Podemos decidir na hora."

#. cv/btl/eli_1500.at3 | 60 quadros | modo 1
msgctxt "807:0"
msgid "Looks like I'm #1 after all!"
msgstr "No fim, eu sou mesmo a número um!"

#. cv/btl/tam_1603.at3 | 100 quadros | modo 1
msgctxt "808:0"
msgid "Oh, darling～! I can hardly contain myself\n          around you～! 鷙鷙鷙          "
msgstr "Ai, meu bem～! Mal consigo me conter\nquando você está por perto～! 鷙鷙鷙"

#. cv/btl/gil_2021.at3 | 123 quadros | modo 1
msgctxt "809:0"
msgid "Don't bother us if you're not\n     even worth killing!     "
msgstr "Não nos incomodes se nem vales a morte!"

#. se/eb_eli/5 | 24 quadros | modo 1
msgctxt "810:0"
msgid "Back at you!"
msgstr "É pra você!"

#. cv/fld/ner_0630.at3 | 118 quadros | modo 1
msgctxt "811:0"
msgid "How do I look? Like a glistening gem, right??"
msgstr "Como estou? Pareço uma joia reluzente, não??"

#. cv/btl/gaw_1100.at3 | 26 quadros | modo 1
msgctxt "812:0"
msgid "…my humble thanks."
msgstr "…meus humildes agradecimentos."

#. cv/btl/eli_1231_edit.at3 | 52 quadros | modo 1
msgctxt "813:1"
msgid "Here comes a big one!"
msgstr "Lá vem um dos grandes!"

#. cv/btl/eli_1752_mix.at3 | 120 quadros | modo 1
msgctxt "814:0"
msgid "We'll settle this here. Lancer, full power!"
msgstr "Vamos resolver isso aqui. Lancer, força total!"

#. cv/btl/eli_1752_mix.at3 | 174 quadros | modo 1
msgctxt "814:1"
msgid "It's my duty, so I can't really decline.\n    Will a slow tempo ballad suffice?    "
msgstr "É meu dever, então não posso recusar.\nUma balada lenta serve?"

#. cv/btl/emi_1520.at3 | 35 quadros | modo 1
msgctxt "815:0"
msgid "The hell are you doing, Master?"
msgstr "Que diabos você está fazendo?"

#. cv/btl/tam_1804.at3 | 82 quadros | modo 1
msgctxt "816:0"
msgid "Okay, Master. Let's crush them swiftly."
msgstr "Pois bem, Mestre. Vamos esmagá-los logo."

#. cv/btl/tam_1302_edit.at3 | 60 quadros | modo 1
msgctxt "817:0"
msgid "I'll show you my secret technique!"
msgstr "Vou mostrar minha técnica secreta!"

#. cv/btl/tam_1302_edit.at3 | 120 quadros | modo 1
msgctxt "817:1"
msgid "A deadly curse spreads throughout the\n    world from the Killing Stone.    "
msgstr "Da Pedra Assassina nasce a maldição\nmortal que se espalha pelo mundo."

#. cv/btl/tam_1302_edit.at3 | 72 quadros | modo 1
msgctxt "817:2"
msgid "The Tamamo Weight Stone will purify it."
msgstr "A Pedra de Lastro de Tamamo vai purificá-la."

#. cv/btl/tam_1302_edit.at3 | 24 quadros | modo 1
msgctxt "817:3"
msgid "Now!"
msgstr "Agora!"

#. cv/btl/tam_1302_edit.at3 | 24 quadros | modo 1
msgctxt "817:5"
msgid "Haa!"
msgstr "Haa!"

#. cv/btl/tam_1302_edit.at3 | 90 quadros | modo 1
msgctxt "817:7"
msgid "Tamamo, on stage! ☆"
msgstr "Tamamo entra em cena! ☆"

#. cv/btl/tam_1302_edit.at3 | 64 quadros | modo 1
msgctxt "817:8"
msgid "All nuisances will be cursed!"
msgstr "Vou amaldiçoar quem me atrapalhar!"

#. cv/btl/jin_1711.at3 | 82 quadros | modo 1
msgctxt "818:0"
msgid "I still have two forms after this!"
msgstr "Ainda tenho mais duas formas depois dessa!"

#. cv/btl/jin_1711.at3 | 20 quadros | modo 1
msgctxt "818:1"
msgid "…I hope."
msgstr "…espero."

#. cv/btl/tam_1630.at3 | 108 quadros | modo 1
msgctxt "819:0"
msgid "Let's celebrate! Another one of my\n  Spiritual Cores has returned!  "
msgstr "Vamos comemorar! Recuperei mais um\ndos meus Núcleos Espirituais!"

#. cv/btl/ner_1804.at3 | 84 quadros | modo 1
msgctxt "820:0"
msgid "Leave it to me! I'll easily make them submit."
msgstr "Deixa comigo! Vou fazê-los\nse render sem esforço."

#. cv/btl/mll_1957.at3 | 132 quadros | modo 1
msgctxt "821:0"
msgid "Fine, let's have a brief dance,\n         my wonderful.         "
msgstr "Pois bem, vamos dançar um pouquinho,\nmeu encanto."

#. cv/btl/mll_1957.at3 | 74 quadros | modo 1
msgctxt "821:1"
msgid "Think you'll be able to lay a finger on me?"
msgstr "Acha que vai conseguir encostar em mim?"

#. cv/btl/jin_1200_edit.at3 | 82 quadros | modo 1
msgctxt "822:1"
msgid "Hehe… bet you've never seen this～"
msgstr "Hehe… aposto que nunca viu essa～"

#. cv/fld/kia_0202.at3 | 152 quadros | modo 2
msgctxt "823:0"
msgid "I like to help people who are troubled, but now and then,"
msgstr "Gosto de ajudar quem sofre, mas, de vez em quando,"

#. cv/fld/kia_0202.at3 | 108 quadros | modo 2
msgctxt "823:1"
msgid "reading a book is rather nice. I'd say I like them even more now."
msgstr "é bom ler um livro. Acho que hoje gosto deles ainda mais."

#. cv/btl/psl_1230_edit.at3 | 70 quadros | modo 1
msgctxt "824:1"
msgid "I won't let you escape～"
msgstr "Não vou deixar você escapar～"

#. cv/btl/psl_1230_edit.at3 | 118 quadros | modo 1
msgctxt "824:2"
msgid "Hehehe… You'll fit perfectly in my hands～"
msgstr "Hehehe… Vai caber direitinho nas minhas mãos～"

#. cv/btl/kia_1240_edit.at3 | 102 quadros | modo 1
msgctxt "825:1"
msgid "\"Impurity,\" \"suffering,\" \"impermanence,\"\n              \"no self\"―              "
msgstr "“Impureza”, “sofrimento”,\n“impermanência”, “ausência de eu”―"

#. cv/btl/kia_1240_edit.at3 | 48 quadros | modo 1
msgctxt "825:3"
msgid "To the transcendent, are Four Inversions! "
msgstr "Para quem transcendeu, são as Quatro Inversões!"

#. cv/btl/mks_1210_edit.at3 | 40 quadros | modo 1
msgctxt "826:0"
msgid "It's punishment time."
msgstr "Hora da punição."

#. cv/btl/emi_2020.at3 | 56 quadros | modo 1
msgctxt "827:0"
msgid "I could beat this thing with my eyes closed."
msgstr "Posso vencer isso de olhos fechados."

#. se/eb_kar/16 | 22 quadros | modo 1
msgctxt "828:0"
msgid "Not bad."
msgstr "Nada mal."

#. cv/btl/kar_1400.at3 | 94 quadros | modo 1
msgctxt "829:0"
msgid "I can't fall here…"
msgstr "Não posso cair aqui…"

#. cv/btl/ner_1910_mix.at3 | 96 quadros | modo 1
msgctxt "830:0"
msgid "There's no need to ask why we're fighting."
msgstr "Não há por que perguntar a razão da luta."

#. cv/btl/ner_1910_mix.at3 | 150 quadros | modo 1
msgctxt "830:1"
msgid "What matters is the dance of sparks\n      between blade and spear!      "
msgstr "Importa a dança das faíscas\nentre lâmina e lança!"

#. cv/btl/ner_1910_mix.at3 | 248 quadros | modo 1
msgctxt "830:2"
msgid "    I see we're on the same page, my lady.    \nIt's about *how* we fight, not *why* we fight!"
msgstr "Vejo que pensamos igual, minha dama.\nO que importa é *como* lutamos!"

#. cv/btl/ner_1910_mix.at3 | 76 quadros | modo 1
msgctxt "830:3"
msgid "That's just what it means to be a hero!"
msgstr "É isso que significa ser herói!"

#. cv/btl/ner_1910_mix.at3 | 262 quadros | modo 1
msgctxt "830:4"
msgid "    Well said. Simple-minded warriors get    \nalong quite well. We can't lose now, Lancer!"
msgstr "Bem dito. Guerreiros de ideias simples\nse dão bem. Não podemos perder, Lancer!"

#. cv/btl/ner_1910_mix.at3 | 94 quadros | modo 1
msgctxt "830:5"
msgid "The battle of the idiots begins now!"
msgstr "Começa agora a batalha dos idiotas!"

#. cv/btl/ner_1910_mix.at3 | 32 quadros | modo 1
msgctxt "830:6"
msgid "DON'T CALL US IDIOTS!\nDON'T CALL US IDIOTS!"
msgstr "NADA DE NOS CHAMAR DE IDIOTAS!\nNADA DE NOS CHAMAR DE IDIOTAS!"

#. se/eb_cuu/12 | 24 quadros | modo 1
msgctxt "831:0"
msgid "Not bad…"
msgstr "Nada mal…"

#. cv/btl/tam_1803.at3 | 98 quadros | modo 1
msgctxt "832:0"
msgid "Ugh, come on! We had a whole mood\n    going and you ruined it!    "
msgstr "Ah, qual é! A gente estava num clima\ntão bom e você estragou tudo!"

#. cv/btl/gil_1511.at3 | 58 quadros | modo 1
msgctxt "833:0"
msgid "You're underestimating them, don't slack off!"
msgstr "Estás subestimando o inimigo. Nada de folga!"

#. cv/btl/ner_2002.at3 | 52 quadros | modo 1
msgctxt "834:0"
msgid "Shall we have some fun with this?"
msgstr "Vamos nos divertir um pouco?"

#. cv/btl/rin2_1800.at3 | 86 quadros | modo 1
msgctxt "835:0"
msgid "Shall I give you a good raking over the coals\n          as a good Senpai should?          "
msgstr "Que tal eu te dar uma boa bronca,\ncomo uma Senpai deve fazer?"

#. cv/btl/emi_1096.at3 | 36 quadros | modo 1
msgctxt "836:0"
msgid "Stand back and stay alert."
msgstr "Recue e fique de olho."

#. cv/btl/gil_1633.at3 | 126 quadros | modo 1
msgctxt "837:0"
msgid "I'm expanding what you can access from my\ntreasury. Just a special service from me."
msgstr "Vou ampliar teu acesso ao meu tesouro.\nUm favor especial meu."

#. cv/btl/tam_2050.at3 | 76 quadros | modo 1
msgctxt "838:0"
msgid "Someone like you just doesn't\n      make it look good.      "
msgstr "Em você é que não fica bem."

#. cv/btl/gil_1301_edit.at3 | 80 quadros | modo 1
msgctxt "839:0"
msgid "So, it's time to cast aside my pride, huh?"
msgstr "Chegou a hora de pôr meu orgulho de lado, hein?"

#. cv/btl/gil_1301_edit.at3 | 90 quadros | modo 1
msgctxt "839:1"
msgid "What an impudent Master you are!"
msgstr "Quanta insolência de quem me comanda!"

#. cv/btl/gil_1301_edit.at3 | 174 quadros | modo 1
msgctxt "839:3"
msgid "Your dependence on the Earth's logic is weak!\n   I'll show you the power of the Heavens!   "
msgstr "É frágil essa lógica terrena a que te agarras!\nVou te mostrar o poder dos Céus!"

#. cv/btl/gil_1301_edit.at3 | 100 quadros | modo 1
msgctxt "839:5"
msgid "Now, struggle to survive till the very end!"
msgstr "Agora luta para sobreviver até o fim!"

#. cv/btl/gil_1301_edit.at3 | 60 quadros | modo 1
msgctxt "839:6"
msgid "Blasphemy!"
msgstr "Blasfêmia!"

#. cv/btl/gil_1301_edit.at3 | 80 quadros | modo 1
msgctxt "839:8"
msgid "Pay tribute with your life!"
msgstr "Paga o tributo com a tua vida!"

#. cv/btl/gil_1301_edit.at3 | 100 quadros | modo 1
msgctxt "839:9"
msgid "Enuma Elish!"
msgstr "Enuma Elish!"

#. se/eb_ner/7 | 70 quadros | modo 1
msgctxt "840:0"
msgid "Hmhm. You may admire me."
msgstr "Umu. Podes me admirar."

#. cv/btl/el2_1800.at3 | 86 quadros | modo 1
msgctxt "841:0"
msgid "It's time for the long-awaited encore～!"
msgstr "Chegou a hora do tão esperado bis～!"

#. cv/btl/tam_1252_edit.at3 | 52 quadros | modo 1
msgctxt "842:0"
msgid "Please regret this, okay?"
msgstr "Trate de se arrepender, viu?"

#. cv/btl/gil_2050.at3 | 74 quadros | modo 1
msgctxt "843:0"
msgid "  Looks to me like you want  \nto return to primordial dust."
msgstr "Parece que desejas voltar ao pó primordial."

#. cv/btl/emi_1271_edit.at3 | 60 quadros | modo 1
msgctxt "844:0"
msgid "The most forbidden of forbidden techniques!"
msgstr "A mais proibida das técnicas proibidas!"

#. cv/btl/emi_1271_edit.at3 | 74 quadros | modo 1
msgctxt "844:2"
msgid "Can you withstand this projection!?"
msgstr "Você aguenta esta projeção!?"

#. se/eb_emi3/4 | 24 quadros | modo 1
msgctxt "845:0"
msgid "Not good enough!"
msgstr "Não é o bastante!"

#. cv/btl/eli_1521.at3 | 46 quadros | modo 1
msgctxt "846:0"
msgid "What the hell is going on!?"
msgstr "Que diabos está acontecendo!?"

#. cv/btl/emi_1802.at3 | 56 quadros | modo 1
msgctxt "847:0"
msgid "Looks like we're in for a dull fight."
msgstr "Parece que a luta vai ser um tédio."

#. cv/btl/cuu_1210_edit.at3 | 38 quadros | modo 1
msgctxt "848:0"
msgid "Here's the first…!"
msgstr "Aí vai a primeira…!"

#. se/eb_ner/12 | 28 quadros | modo 1
msgctxt "849:0"
msgid "I'll cut you to shreds!"
msgstr "Vou te cortar em pedaços!"

#. cv/fld/tam_0201.at3 | 120 quadros | modo 2
msgctxt "850:0"
msgid "Kyaa～! Darling, when did you get so *assertive*??"
msgstr "Kyaa～! Meu bem, de onde veio\ntoda essa ousadia??"

#. cv/fld/tam_0201.at3 | 136 quadros | modo 2
msgctxt "850:1"
msgid "You can find out when we bathe! LET'S SHOWER TIME!!!"
msgstr "No banho, você vai descobrir!\nHORA DA DUCHA!!!"

#. cv/fld/tam_0201.at3 | 109 quadros | modo 2
msgctxt "850:2"
msgid "Huh? Why do you never join me?"
msgstr "Hein? Por que nunca vem tomar banho comigo?"

#. cv/btl/emi_1110.at3 | 24 quadros | modo 1
msgctxt "851:0"
msgid "Let's keep going!"
msgstr "Vamos em frente!"

#. cv/btl/mks_1951.at3 | 108 quadros | modo 1
msgctxt "852:0"
msgid "When you go to the beach, you just gotta\n         play beach volleyball!         "
msgstr "Se vai à praia, tem que jogar vôlei de praia!"

#. cv/btl/mks_1951.at3 | 80 quadros | modo 1
msgctxt "852:1"
msgid "The death game starts now, Senpai 鷙"
msgstr "O jogo mortal começa agora, Senpai鷙"

#. cv/btl/gaw_1520.at3 | 48 quadros | modo 1
msgctxt "853:0"
msgid "Urgh, well done…"
msgstr "Urgh, bem feito…"

#. cv/btl/rin_1210_edit.at3 | 62 quadros | modo 1
msgctxt "854:1"
msgid "Don't dodge, these are expensive!"
msgstr "Não desvie! Custaram caro!"

#. cv/btl/emi_1200_edit.at3 | 62 quadros | modo 1
msgctxt "855:0"
msgid "Set. Duality shift!"
msgstr "Pronto. Mudança de dualidade!"

#. cv/fld/emi_0202.at3 | 140 quadros | modo 2
msgctxt "856:0"
msgid "Wait, slow down! What do you plan on doing with that information?"
msgstr "Espera aí! O que você pretende fazer com essa informação?"

#. cv/fld/emi_0202.at3 | 128 quadros | modo 2
msgctxt "856:1"
msgid "You're very lacking in modesty for a young lady!"
msgstr "Falta um pouco de modéstia para uma moça!"

#. cv/fld/emi_0202.at3 | 112 quadros | modo 2
msgctxt "856:2"
msgid "I don't remember raising you that― hey, get back here!!"
msgstr "Não lembro de ter criado você pra isso― ei, volta aqui!!"

#. cv/btl/emi_1840_mix.at3 | 206 quadros | modo 1
msgctxt "857:0"
msgid "Did that priest's lecture fall on deaf ears?\nYou have no ground to say you're a Kshatriya."
msgstr "Ignorou o sermão do padre?\nNão tem direito de se dizer xátria."

#. cv/btl/emi_1840_mix.at3 | 128 quadros | modo 1
msgctxt "857:1"
msgid "Silence. I took his lecture TOO much to heart\n          and now I'm in this mess.          "
msgstr "Silêncio. Levei o sermão a sério DEMAIS\ne foi assim que vim parar nessa."

#. cv/btl/emi_1840_mix.at3 | 82 quadros | modo 1
msgctxt "857:2"
msgid "You're a wicked boy, aren't you Archer?"
msgstr "Você é um menino malvado, né, Archer?"

#. cv/btl/emi_1840_mix.at3 | 126 quadros | modo 1
msgctxt "857:3"
msgid "Why are you two chatting like you're in\n        some BL baseball club!?        "
msgstr "Por que estão de papo feito\ndois garotos num BL de beisebol!?"

#. cv/btl/emi3_1250_edit.at3 | 28 quadros | modo 1
msgctxt "858:1"
msgid "Crush them into dust!"
msgstr "Reduza todos a pó!"

#. cv/btl/emi3_1250_edit.at3 | 36 quadros | modo 1
msgctxt "858:3"
msgid "Broken Phantasm!"
msgstr "Fantasma Quebrado!"

#. se/eb_emi/22 | 24 quadros | modo 1
msgctxt "859:0"
msgid "Oh?"
msgstr "Ora?"

#. cv/btl/rin2_1540.at3 | 42 quadros | modo 1
msgctxt "860:0"
msgid "And with that, victory is ours…!"
msgstr "E, com isso, a vitória é nossa…!"

#. cv/btl/tam3_1092.at3 | 34 quadros | modo 1
msgctxt "861:0"
msgid "They'll be cursed in a flash."
msgstr "Vou amaldiçoá-los num piscar de olhos."

#. cv/btl/tam3_1300_edit.at3 | 136 quadros | modo 1
msgctxt "862:0"
msgid "Gods residing in Izumo, whose beauty breathes\n            life into our souls.            "
msgstr "Deuses que habitam Izumo,\ncuja beleza dá vida às nossas almas."

#. cv/btl/tam3_1300_edit.at3 | 58 quadros | modo 1
msgctxt "862:2"
msgid "Amaterasu, who illuminates earth, water,\n                and sky.                "
msgstr "Amaterasu, que ilumina a terra,\nas águas e o céu."

#. cv/btl/tam3_1300_edit.at3 | 70 quadros | modo 1
msgctxt "862:4"
msgid "Let it be proof of your purity."
msgstr "Que isto seja prova da sua pureza."

#. cv/btl/tam3_1300_edit.at3 | 106 quadros | modo 1
msgctxt "862:6"
msgid "    Weighted Stone of Tamamo,    \nbecome the Sacred Mirror of Uka!"
msgstr "Pedra Pesada de Tamamo,\ntorne-se o Espelho Sagrado de Uka!"

#. cv/btl/rob_1300_edit.at3 | 98 quadros | modo 1
msgctxt "863:1"
msgid "Suffer this sacrament of the\n druids, the stealth sages! "
msgstr "Sofra o sacramento dos druidas,\nos sábios furtivos!"

#. cv/btl/tam_1633.at3 | 118 quadros | modo 1
msgctxt "864:0"
msgid "Hmm… I think I'm close to relearning\n             everything.             "
msgstr "Hmm… Acho que já estou quase\nreaprendendo tudo."

#. cv/btl/elp_1101.at3 | 37 quadros | modo 1
msgctxt "865:0"
msgid "Thank you, Master!"
msgstr "Obrigada por isso, Mestre!"

#. cv/fld/tam_0100.at3 | 138 quadros | modo 2
msgctxt "866:0"
msgid "Caster, Tama-chan, or even Honey are all great options～!"
msgstr "Caster, Tama-chan ou até “meu amor”.\nAdoro todos esses nomes～!"

#. cv/fld/tam_0100.at3 | 72 quadros | modo 2
msgctxt "866:1"
msgid "This only applies to my Darling, of course."
msgstr "Claro que só o meu bem pode me chamar assim."

#. cv/btl/gil_1221_edit.at3 | 62 quadros | modo 1
msgctxt "867:0"
msgid "Think you can destroy the\nvery avatar of the Earth?"
msgstr "Pensas poder destruir\no próprio avatar da Terra?"

#. cv/btl/rin_1200_edit.at3 | 35 quadros | modo 1
msgctxt "868:0"
msgid "Queen Gandor!"
msgstr "Queen Gandor!"

#. cv/btl/elp_1220_edit.at3 | 56 quadros | modo 1
msgctxt "869:1"
msgid "Invincibility mode―on!"
msgstr "Modo invencível―ativado!"

#. cv/btl/emi_1270_edit.at3 | 96 quadros | modo 1
msgctxt "870:0"
msgid "This light is from the King's\nsword that I can never hold."
msgstr "Esta luz vem da espada do rei\nque jamais poderei empunhar."

#. cv/btl/emi_1270_edit.at3 | 54 quadros | modo 1
msgctxt "870:2"
msgid "Excalibur Image!"
msgstr "Excalibur Image!"

#. cv/btl/ner_1231_edit.at3 | 46 quadros | modo 1
msgctxt "871:1"
msgid "This is where I reign supreme!"
msgstr "Aqui, eu reino suprema!"

#. cv/btl/gil_1093.at3 | 34 quadros | modo 1
msgctxt "872:0"
msgid "Perhaps I'll toy with you."
msgstr "Talvez eu brinque um pouco contigo."

#. cv/btl/adl_1800.at3 | 46 quadros | modo 1
msgctxt "873:0"
msgid "If you want to settle this with fists,\n          then don't mind me.          "
msgstr "Se quer resolver no soco,\nnão se importe comigo."

#. cv/btl/ksk_1230_edit.at3 | 82 quadros | modo 1
msgctxt "874:1"
msgid "This is a scoop of lust, the\n  Celestial Inverted Moon.  "
msgstr "Uma medida de luxúria,\na Lua Celestial Invertida."

#. cv/btl/ksk_1230_edit.at3 | 150 quadros | modo 1
msgctxt "874:3"
msgid "Hehe… Just one drop is enough to kill you."
msgstr "Hehe… Uma gota basta para matar você."

#. cv/btl/gil_1101a.at3 | 38 quadros | modo 1
msgctxt "875:0"
msgid "Not bad, mongrel!"
msgstr "Nada mal, criatura mestiça!"

#. cv/fld/mll_0100.at3 | 90 quadros | modo 2
msgctxt "876:0"
msgid "Meltlilith. Has a nice ring to it, don't you think?"
msgstr "Meltlilith. É um nome bonito, você não acha?"

#. cv/fld/kia_0104.at3 | 140 quadros | modo 2
msgctxt "877:0"
msgid "The Shingon Tachikawa village in Japan."
msgstr "No vilarejo da escola Shingon Tachikawa, no Japão."

#. cv/fld/kia_0104.at3 | 48 quadros | modo 2
msgctxt "877:1"
msgid "Though now, I don't have a place I call home."
msgstr "Hoje, porém, não tenho um lugar que chame de lar."

#. cv/btl/rin_1700.at3 | 58 quadros | modo 1
msgctxt "878:0"
msgid "Hehe, kneel before me!"
msgstr "Hehe, de joelhos diante de mim!"

#. cv/btl/eli_1230_edit.at3 | 50 quadros | modo 1
msgctxt "879:1"
msgid "My performance will move you!"
msgstr "Meu show vai emocionar você!"

#. cv/btl/mll_1220_edit.at3 | 40 quadros | modo 1
msgctxt "880:1"
msgid "Oh, how scary～"
msgstr "Ah, que medo～"

#. cv/btl/tam_1231_edit.at3 | 40 quadros | modo 1
msgctxt "881:1"
msgid "Concealed air, roar!"
msgstr "Ar oculto, ruja!"

#. se/eb_kar/11 | 24 quadros | modo 1
msgctxt "882:0"
msgid "Kan!"
msgstr "Kan!"

#. cv/btl/emi_1201_edit.at3 | 58 quadros | modo 1
msgctxt "883:0"
msgid "Preparation is key, you know."
msgstr "Preparo é essencial, sabe."

#. cv/btl/tam_1092.at3 | 32 quadros | modo 1
msgctxt "884:0"
msgid "I'll curse you～"
msgstr "Vou amaldiçoar você～"

#. se/eb_ksk/6 | 24 quadros | modo 1
msgctxt "885:0"
msgid "Delete."
msgstr "Excluir."

#. se/eb_gil/12 | 32 quadros | modo 1
msgctxt "886:0"
msgid "I have you now!"
msgstr "Peguei-te!"

#. cv/btl/kar_1751_mix.at3 | 134 quadros | modo 1
msgctxt "887:0"
msgid "They're really putting on the pressure.\n   Jinako, have you made your peace?   "
msgstr "Estão mesmo pressionando.\nJinako, já se conformou com seu destino?"

#. cv/btl/kar_1751_mix.at3 | 148 quadros | modo 1
msgctxt "887:1"
msgid "AHHH!… WE'RE GONNA LOSE… WE'RE GONNA LOSE…\n          KARNA, DO SOMETHING…!!!          "
msgstr "AAAAH!… A GENTE VAI PERDER… VAI PERDER…\nKARNA, FAZ ALGUMA COISA…!!!"

#. cv/btl/kar_1751_mix.at3 | 100 quadros | modo 1
msgctxt "887:2"
msgid "               …I guess not.               \nLet's see how much longer I can struggle for."
msgstr "…pelo visto, não.\nVamos ver até quando consigo resistir."

#. cv/btl/ner_1240_edit.at3 | 50 quadros | modo 1
msgctxt "888:0"
msgid "Grief of the saint!"
msgstr "Pesar do santo!"

#. cv/btl/eli_1750_mix.at3 | 170 quadros | modo 1
msgctxt "889:0"
msgid "Hehe, consumption and income tax are futile\n       before the Queen of the Moon!       "
msgstr "Hehe, nem imposto de renda nem de consumo\nfuncionam contra a Rainha da Lua!"

#. cv/btl/eli_1750_mix.at3 | 185 quadros | modo 1
msgctxt "889:1"
msgid "  Consump… tion? I'm lost.  \nWon't that just… bankrupt us?"
msgstr "Imposto de… consumo? Me perdi.\nIsso não vai… levar a gente à falência?"

#. cv/btl/kot_1540.at3 | 40 quadros | modo 1
msgctxt "890:0"
msgid "Your training's inadequate!"
msgstr "Seu treinamento é insuficiente!"

#. cv/fld/kot_00923.at3 | 40 quadros | modo 3
msgctxt "891:0"
msgid "Well, I guess I'll sell this cheap junk"
msgstr "Bem, acho que vou vender esta tranqueira"

#. cv/fld/kot_00923.at3 | 60 quadros | modo 3
msgctxt "891:1"
msgid "for a quick buck on the internet."
msgstr "na internet pra ganhar uns trocados."

#. cv/btl/gil_1840_mix.at3 | 140 quadros | modo 1
msgctxt "892:0"
msgid "It's not the most satisfying battlefield,\n  but it's time to settle this, Lancer.  "
msgstr "O campo de batalha deixa a desejar,\nmas é hora de resolver isto, Lancer."

#. cv/btl/gil_1840_mix.at3 | 90 quadros | modo 1
msgctxt "892:1"
msgid "Relieve my boredom with that head of yours!"
msgstr "Alivia meu tédio com essa tua cabeça!"

#. cv/btl/gil_1840_mix.at3 | 176 quadros | modo 1
msgctxt "892:2"
msgid "I may not have the arrows of the wind god,\n   but mine still pack quite the punch!   "
msgstr "Não tenho as flechas do deus do vento,\nmas as minhas batem com força!"

#. cv/btl/gil_1840_mix.at3 | 136 quadros | modo 1
msgctxt "892:3"
msgid "I almost forgot, I suppose you are\n      technically an Archer.      "
msgstr "Quase esqueci. Tecnicamente, tu és um Archer."

#. cv/btl/gil_1840_mix.at3 | 122 quadros | modo 1
msgctxt "892:4"
msgid "That inexhaustible treasury of yours shows\n just how incompatible the two of us are. "
msgstr "Teu tesouro inesgotável mostra\ncomo somos incompatíveis."

#. cv/btl/gaw_1110.at3 | 28 quadros | modo 1
msgctxt "893:0"
msgid "Charge!"
msgstr "Ao ataque!"

#. cv/btl/ner_1090.at3 | 28 quadros | modo 1
msgctxt "894:0"
msgid "Let us begin."
msgstr "Comecemos."

#. cv/btl/rin_1800.at3 | 106 quadros | modo 1
msgctxt "895:0"
msgid "One must always fight with elegance\n          and a cool head.          "
msgstr "Deve-se lutar sempre com elegância\ne cabeça fria."

#. cv/fld/psl_0103.at3 | 234 quadros | modo 2
msgctxt "896:0"
msgid "B160/W63/H87. I'm just a little bit big…"
msgstr "B160/C63/Q87. Sou só um pouquinho grande…"

#. cv/btl/tam_1740.at3 | 170 quadros | modo 1
msgctxt "897:0"
msgid "Alrighty darling, I'll clean this up quickly\n        and show you how amazing I…        "
msgstr "Certo, meu bem. Acabo com isso rapidinho\ne mostro como sou incrí…"

#. cv/btl/tam_1740.at3 | 90 quadros | modo 1
msgctxt "897:1"
msgid "D-does something feel, uh, off to you?"
msgstr "V-você também acha que tem algo estranho?"

#. cv/btl/gaw2_1752.at3 | 58 quadros | modo 1
msgctxt "898:0"
msgid "You leave me no choice but to use force…"
msgstr "Não me deixa opção além de usar a força…"

#. cv/fld/eli_0107.at3 | 164 quadros | modo 2
msgctxt "899:0"
msgid "Torture… is a noble's duty, so that doesn't really count."
msgstr "Tortura… é dever da nobreza, então nem conta."

#. cv/fld/eli_0107.at3 | 130 quadros | modo 2
msgctxt "899:1"
msgid "Apart from that… W-what? A m-man's body…?"
msgstr "Fora isso… O-o quê? O corpo de um h-homem…?"

#. cv/fld/eli_0107.at3 | 164 quadros | modo 2
msgctxt "899:2"
msgid "I don't really have any experience, but, uh, fingers are nice!"
msgstr "Não tenho experiência, mas, hum, dedos são legais!"

#. cv/fld/mll_0103.at3 | 166 quadros | modo 2
msgctxt "900:0"
msgid "B75/W55/H80. Any fat is where it needs to be."
msgstr "B75/C55/Q80. Cada grama está no lugar certo."

#. cv/fld/mll_0103.at3 | 90 quadros | modo 2
msgctxt "900:1"
msgid "This is the result of pursuing ultimate beauty."
msgstr "É o resultado de buscar a beleza suprema."

#. se/eb_cuu/2 | 24 quadros | modo 1
msgctxt "901:0"
msgid "Take that!"
msgstr "Toma!"

#. cv/fld/jin_0105.at3 | 76 quadros | modo 2
msgctxt "902:0"
msgid "L-like I'd know!"
msgstr "C-como é que eu vou saber!?"

#. cv/fld/jin_0105.at3 | 146 quadros | modo 2
msgctxt "902:1"
msgid "Though… I used to like when my hair was brushed…"
msgstr "Mas… eu gostava quando escovavam meu cabelo…"

#. cv/btl/gil_1620.at3 | 116 quadros | modo 1
msgctxt "903:0"
msgid "        Such disgrace…        \nIt's almost impressive, really."
msgstr "Que desgraça… Quase impressionante."

#. cv/btl/psl_1750.at3 | 58 quadros | modo 1
msgctxt "904:0"
msgid "I'm getting tired…"
msgstr "Estou ficando cansada…"

#. cv/btl/psl_1750.at3 | 70 quadros | modo 1
msgctxt "904:1"
msgid "My stomach is rumbling too…"
msgstr "Minha barriga também está roncando…"

#. cv/btl/tam_1800.at3 | 62 quadros | modo 1
msgctxt "905:0"
msgid "Please watch me, darling!"
msgstr "Olhe pra mim, meu bem!"

#. cv/btl/gil_1240_edit.at3 | 68 quadros | modo 1
msgctxt "906:0"
msgid "Why is that head of yours still attached?"
msgstr "Por que ainda tens a cabeça no lugar?"

#. cv/btl/gil_1240_edit.at3 | 60 quadros | modo 1
msgctxt "906:2"
msgid "There's only so much insolence I can overlook!"
msgstr "Minha paciência com tua insolência tem limite!"

#. cv/btl/emi_1101.at3 | 63 quadros | modo 1
msgctxt "907:0"
msgid "Thanks. Good thinking, Master."
msgstr "Valeu. Boa ideia."

#. se/eb_ksk/12 | 24 quadros | modo 1
msgctxt "908:0"
msgid "Weak."
msgstr "Que fraqueza."

#. cv/btl/emi_1810_mix.at3 | 185 quadros | modo 1
msgctxt "909:0"
msgid "  Stay focused, Master. She's not thinking  \nclearly, but Rin is still an A-rank Master."
msgstr "Mantenha o foco. Mesmo fora de si,\nRin é uma Mestra de classe A."

#. cv/btl/emi_1810_mix.at3 | 60 quadros | modo 1
msgctxt "909:1"
msgid "She's decently tough."
msgstr "Ela até que é forte."

#. cv/btl/emi_1810_mix.at3 | 80 quadros | modo 1
msgctxt "909:2"
msgid "What do you mean \"decently\"!?"
msgstr "Como assim, “até que”!?"

#. cv/btl/emi_1810_mix.at3 | 140 quadros | modo 1
msgctxt "909:3"
msgid "Aughh, now I'm pissed! Those two are\n sentenced to a life of hard labor! "
msgstr "Argh, agora me irritei!\nCondeno esses dois a trabalhos forçados!"

#. cv/btl/emi_1810_mix.at3 | 170 quadros | modo 1
msgctxt "909:4"
msgid "That's the Queen of the Moon for you,\n  crafting new laws as she pleases.  "
msgstr "Típico da Rainha da Lua,\nque faz as leis que bem entende."

#. cv/btl/emi_1810_mix.at3 | 144 quadros | modo 1
msgctxt "909:5"
msgid "Heh, well then, let's have some fun."
msgstr "Heh, então vamos nos divertir."

#. se/eb_mks/3 | 16 quadros | modo 1
msgctxt "910:0"
msgid "Here!"
msgstr "Aqui!"

#. cv/btl/rob_1110.at3 | 43 quadros | modo 1
msgctxt "911:0"
msgid "Let's keep it going!"
msgstr "Bora continuar!"

#. cv/btl/rin2_1700.at3 | 96 quadros | modo 1
msgctxt "912:0"
msgid "We've set the pace for the fight.\n  It'll be our win at this rate.  "
msgstr "Ditamos o ritmo da luta.\nDesse jeito, vamos vencer."

#. cv/btl/emi_2001.at3 | 50 quadros | modo 1
msgctxt "913:0"
msgid "Try not to be rash and wasteful."
msgstr "Evite agir por impulso e desperdiçar recursos."

#. cv/fld/gil_0605.at3 | 86 quadros | modo 1
msgctxt "914:0"
msgid "Are you already tired? You're a bit pale."
msgstr "Já te cansaste? Pareces sem cor."

#. se/eb_psl/11 | 28 quadros | modo 1
msgctxt "915:0"
msgid "Idiot!!"
msgstr "Idiota!!"

#. cv/btl/tam_1730.at3 | 206 quadros | modo 1
msgctxt "916:0"
msgid "Well then ladies and gentlemen, let the\n  blood-chilling banquet commence…  "
msgstr "Pois bem, senhoras e senhores.\nQue comece o banquete de arrepiar…"

#. cv/btl/gil_1800.at3 | 78 quadros | modo 1
msgctxt "917:0"
msgid "This is nothing to me. Do as you wish."
msgstr "Isso não me diz nada. Faz como quiseres."

#. cv/btl/tam_1631.at3 | 126 quadros | modo 1
msgctxt "918:0"
msgid "How about that, darling? They won't call\n    me the weakest Caster any longer!    "
msgstr "E aí, meu bem? Quero ver me chamarem\nde Caster mais fraca agora!"

#. cv/fld/mks_0202.at3 | 156 quadros | modo 2
msgctxt "919:0"
msgid "The dutiful BB-chan digs out the Labyrinth tirelessly!"
msgstr "A diligente BB-chan escava o Labirinto sem cansar!"

#. cv/fld/mks_0202.at3 | 68 quadros | modo 2
msgctxt "919:1"
msgid "Expanding my influence takes up so much of my day!"
msgstr "Expandir minha influência ocupa boa parte do dia!"

#. se/eb_gil/8 | 36 quadros | modo 1
msgctxt "920:0"
msgid "Take what you deserve!"
msgstr "Recebe o que mereces!"

#. cv/btl/adl_1701.at3 | 62 quadros | modo 1
msgctxt "921:0"
msgid "Is brute force all you have left?\n         You damn idiot.         "
msgstr "Só lhe resta a força bruta?\nQue idiota."

#. cv/btl/el2_1110.at3 | 30 quadros | modo 1
msgctxt "922:0"
msgid "DROP DEAD!"
msgstr "MORRA!"

#. cv/btl/emi_1700.at3 | 25 quadros | modo 1
msgctxt "923:0"
msgid "Keep it up."
msgstr "Continue assim."

#. cv/btl/emi_2060.at3 | 83 quadros | modo 1
msgctxt "924:0"
msgid "I'm off the clock. Could you leave us alone?"
msgstr "Estou de folga. Pode nos deixar em paz?"

#. cv/btl/tam3_1272_edit.at3 | 78 quadros | modo 1
msgctxt "925:1"
msgid "The cycle of rebirth is steeped in ignorance!"
msgstr "O ciclo do renascimento\nestá imerso na ignorância!"

#. cv/btl/emi_1631.at3 | 122 quadros | modo 1
msgctxt "926:0"
msgid "    Some of my power has returned.    \nThings are looking up for us, Master."
msgstr "Recuperei parte da minha força.\nAs coisas estão melhorando."

#. cv/btl/ner_1715.at3 | 52 quadros | modo 1
msgctxt "927:0"
msgid "If only I was stronger…"
msgstr "Se ao menos eu fosse mais forte…"

#. cv/btl/elp_1600.at3 | 78 quadros | modo 1
msgctxt "928:0"
msgid "I dedicate this victory to you 鷙!"
msgstr "Dedico esta vitória a você鷙!"

#. cv/btl/rob_1740.at3 | 180 quadros | modo 1
msgctxt "929:0"
msgid "My mind's all here, but my body just can't\n    keep up. Ugh, this is ridiculous.    "
msgstr "Minha cabeça funciona, mas o corpo\nnão acompanha. Argh, que ridículo."

#. cv/btl/gil_1850_mix.at3 | 206 quadros | modo 1
msgctxt "930:0"
msgid "Mongrel. I can't call it an expert's opinion,\n     but I believe she's just defective.     "
msgstr "Criatura mestiça. Não sou perito,\nmas creio que ela tem um defeito."

#. cv/btl/gil_1850_mix.at3 | 86 quadros | modo 1
msgctxt "930:1"
msgid "Something like a cracked pearl."
msgstr "Como uma pérola rachada."

#. cv/btl/gil_1850_mix.at3 | 170 quadros | modo 1
msgctxt "930:2"
msgid "W-what!? Don't look at me\n  with those cold eyes!  "
msgstr "O-o quê!? Não me olhe com essa frieza!"

#. cv/btl/gil_1850_mix.at3 | 114 quadros | modo 1
msgctxt "930:3"
msgid "  I am eternally young!  \nI won't become worthless!"
msgstr "Sou eternamente jovem!\nNão vou perder meu valor!"

#. se/eb_tam3/13 | 24 quadros | modo 1
msgctxt "931:0"
msgid "How careless."
msgstr "Que descuido."

#. cv/btl/tam_1270_edit.at3 | 22 quadros | modo 1
msgctxt "932:1"
msgid "Here I go!"
msgstr "Aqui vou eu!"

#. cv/btl/tam_1270_edit.at3 | 20 quadros | modo 1
msgctxt "932:3"
msgid "One!"
msgstr "Um!"

#. cv/btl/tam_1270_edit.at3 | 20 quadros | modo 1
msgctxt "932:5"
msgid "Two!"
msgstr "Dois!"

#. cv/btl/tam_1270_edit.at3 | 40 quadros | modo 1
msgctxt "932:7"
msgid "DI―VINE PUNISHMENT!"
msgstr "Pu―ni―ção divina!"

#. cv/btl/tam_1270_edit.at3 | 60 quadros | modo 1
msgctxt "932:9"
msgid "This is my secret move～"
msgstr "Essa é minha técnica secreta～"

#. cv/btl/kar_1710.at3 | 62 quadros | modo 1
msgctxt "933:0"
msgid "Now, how shall I turn the tables?"
msgstr "Agora, como vou virar o jogo?"

#. cv/fld/gil_0621.at3 | 66 quadros | modo 1
msgctxt "934:0"
msgid "AUO dress change!"
msgstr "Troca de roupa do AUO!"

#. cv/fld/kot_00925.at3 | 82 quadros | modo 3
msgctxt "935:0"
msgid "Didn't leave yourself enough money?"
msgstr "Não reservou dinheiro suficiente?"

#. cv/fld/kot_00925.at3 | 80 quadros | modo 3
msgctxt "935:1"
msgid "Resign yourself to a commoner's misery."
msgstr "Resigne-se à miséria de um plebeu."

#. cv/btl/sin_1540.at3 | 120 quadros | modo 1
msgctxt "936:0"
msgid "A weapon fit for a celebrity.\n  That is the Shinji Tank!  "
msgstr "Uma arma digna de uma celebridade.\nEsse é o Tanque do Shinji!"

#. cv/fld/ner_0621.at3 | 48 quadros | modo 1
msgctxt "937:0"
msgid "Please wait patiently for me 鷙"
msgstr "Espera por mim com paciência, por favor鷙"

#. cv/btl/sal_1091.at3 | 36 quadros | modo 1
msgctxt "938:0"
msgid "I'll be sure to cherish my new toy～"
msgstr "Vou cuidar bem do meu brinquedo novo～"

#. cv/btl/tam3_1730.at3 | 114 quadros | modo 1
msgctxt "939:0"
msgid "I've built up plenty of spiritual power.\n     Whenever you're ready, Master.     "
msgstr "Acumulei bastante poder espiritual.\nQuando quiser, meu bem."

#. cv/btl/tam_1511.at3 | 32 quadros | modo 1
msgctxt "940:0"
msgid "T-time out!!"
msgstr "P-pausa!!"

#. cv/btl/sal_1400.at3 | 37 quadros | modo 1
msgctxt "941:0"
msgid "Good night…"
msgstr "Boa noite…"

#. se/eb_emi3/9 | 26 quadros | modo 1
msgctxt "942:0"
msgid "Third-rate."
msgstr "De terceira."

#. cv/btl/ksk_1753.at3 | 114 quadros | modo 1
msgctxt "943:0"
msgid "To stop primordial power… How vexing…"
msgstr "Deter o poder primordial… Que incômodo…"

#. cv/btl/emi_2002.at3 | 30 quadros | modo 1
msgctxt "944:0"
msgid "Orders, Master?"
msgstr "Quais são as ordens?"

#. cv/btl/sin_1800.at3 | 154 quadros | modo 1
msgctxt "945:0"
msgid "SHINJI TAAAAANK, LIFT OOOOOFF!!"
msgstr "TANQUE DO SHINJI, DECOLAAAAR!!"

#. se/eb_emi/10 | 24 quadros | modo 1
msgctxt "946:0"
msgid "This is it!"
msgstr "É agora!"

#. cv/btl/gil_1615.at3 | 110 quadros | modo 1
msgctxt "947:0"
msgid "Even if you're just playing, at\nleast put some effort into it."
msgstr "Ainda que seja brincadeira,\nfaz ao menos algum esforço."

#. se/eb_tam/16 | 29 quadros | modo 1
msgctxt "948:0"
msgid "Cry your heart out!"
msgstr "Chore à vontade!"

#. cv/btl/ner_1740.at3 | 68 quadros | modo 1
msgctxt "949:0"
msgid "Finally, it's my turn on the stage!"
msgstr "Finalmente é a minha vez no palco!"

#. cv/btl/ner_1740.at3 | 90 quadros | modo 1
msgctxt "949:1"
msgid "You can count on me―u…umumumu?"
msgstr "Podes contar comigo― u… umumumu?"

#. se/eb_sal/8 | 28 quadros | modo 1
msgctxt "950:0"
msgid "*crush*～!"
msgstr "＊esmaga＊～!"

#. cv/btl/elp_1260_edit.at3 | 90 quadros | modo 1
msgctxt "951:0"
msgid "S-stop making me bring out the tail!"
msgstr "P-para de me fazer usar a cauda!"

#. sound/bgm/bgm_bb_voice_02.at3 | 106 quadros | modo 1
msgctxt "952:0"
msgid "It doesn't matter. Nothing matters anymore!"
msgstr "Não importa. Nada mais importa!"

#. sound/bgm/bgm_bb_voice_02.at3 | 82 quadros | modo 1
msgctxt "952:2"
msgid "So please, hurry up and give up already!"
msgstr "Por favor, ande logo e desista de uma vez!"

#. se/eb_ner/15 | 32 quadros | modo 1
msgctxt "953:0"
msgid "You may try again."
msgstr "Podes tentar de novo."

#. cv/btl/elp_1621.at3 | 72 quadros | modo 1
msgctxt "954:0"
msgid "I-I'll be badass next time, okay!?"
msgstr "N-na próxima eu vou arrasar, tá!?"

#. se/eb_ksk/14 | 35 quadros | modo 1
msgctxt "955:0"
msgid "Do you understand yet?"
msgstr "Já compreendeu?"

#. cv/btl/sal_1200_edit.at3 | 74 quadros | modo 1
msgctxt "956:0"
msgid "Alice is gone! Is gone!"
msgstr "Alice sumiu! Sumiu!"

#. cv/btl/kar_1230_edit.at3 | 70 quadros | modo 1
msgctxt "957:0"
msgid "Brahmastra Kundala!"
msgstr "Brahmastra Kundala!"

#. cv/btl/emi_1261_edit.at3 | 60 quadros | modo 1
msgctxt "958:1"
msgid "Rho Aias!"
msgstr "Rho Aias!"

#. se/eb_el2/0 | 26 quadros | modo 1
msgctxt "959:0"
msgid "Scram!"
msgstr "Some daqui!"

#. cv/btl/mll_1750.at3 | 58 quadros | modo 1
msgctxt "960:0"
msgid "I think it's about time I end this."
msgstr "Acho que já é hora de acabar com isto."

#. cv/btl/gaw2_1230_edit.at3 | 88 quadros | modo 1
msgctxt "961:0"
msgid "O morning flash, return to me my cash!"
msgstr "Ó clarão da aurora, devolva meu dinheiro!"

#. cv/fld/tam_0600.at3 | 60 quadros | modo 1
msgctxt "962:0"
msgid "Good work out there, Master."
msgstr "Bom trabalho lá fora, Mestre."

#. cv/btl/rin_1530.at3 | 25 quadros | modo 1
msgctxt "963:0"
msgid "You're wide open!"
msgstr "Você baixou toda a guarda!"

#. cv/btl/ner_1700.at3 | 68 quadros | modo 1
msgctxt "964:0"
msgid "Keep it up. Don't waste this chance!"
msgstr "Continua assim. Não desperdiça esta chance!"

#. cv/fld/ran_0200.at3 | 206 quadros | modo 2
msgctxt "965:0"
msgid "Someone with a generous heart, perhaps. Someone who would"
msgstr "Alguém de coração generoso, talvez. Alguém que"

#. cv/fld/ran_0200.at3 | 96 quadros | modo 2
msgctxt "965:1"
msgid "be devoted to me and help me learn what love is."
msgstr "se dedique a mim e me ajude a entender o amor."

#. cv/btl/ner_1095.at3 | 38 quadros | modo 1
msgctxt "966:0"
msgid "We'll win this together!"
msgstr "Vamos vencer lado a lado!"

#. cv/btl/tam_1601.at3 | 90 quadros | modo 1
msgctxt "967:0"
msgid "Master! I'll stick with you forever!"
msgstr "Mestre! Vou ficar com você pra sempre!"

#. cv/btl/gaw2_1400.at3 | 130 quadros | modo 1
msgctxt "968:0"
msgid "  S-such lawlessness…  \nMust not go unpunished…"
msgstr "T-tamanha desordem…\nNão pode ficar impune…"

#. cv/btl/eli_1220_edit.at3 | 56 quadros | modo 1
msgctxt "969:0"
msgid "Idol privilege, activate!"
msgstr "Privilégio de idol, ativar!"

#. cv/btl/gil_1230_edit.at3 | 70 quadros | modo 1
msgctxt "970:0"
msgid "Why is that head of yours still attached?"
msgstr "Por que ainda tens a cabeça no lugar?"

#. se/eb_emi/14 | 24 quadros | modo 1
msgctxt "971:0"
msgid "Too easy."
msgstr "Fácil demais."

#. cv/fld/ner_0605.at3 | 48 quadros | modo 1
msgctxt "972:0"
msgid "What's wrong, Master?"
msgstr "O que houve, Maestro?"

#. cv/btl/emi3_1730.at3 | 52 quadros | modo 1
msgctxt "973:0"
msgid "Let me show you the zenith\n    of swordsmanship.    "
msgstr "Deixe-me mostrar o auge da esgrima."

#. cv/btl/ner_1704.at3 | 82 quadros | modo 1
msgctxt "974:0"
msgid "Mhm. Feel free to depend on me more!"
msgstr "Umu. Podes contar ainda mais comigo!"

#. cv/btl/tam3_1220_edit.at3 | 60 quadros | modo 1
msgctxt "975:1"
msgid "Frigid heavens, conceal all in ice."
msgstr "Céus gélidos, cubram tudo de gelo."

#. cv/btl/ner_1745.at3 | 178 quadros | modo 1
msgctxt "976:0"
msgid "Fighting a pretty girl without reason doesn't\n      sit well with me, but so it goes.      "
msgstr "Não me agrada lutar sem motivo\ncom uma bela moça, mas que seja."

#. cv/btl/ner_1745.at3 | 64 quadros | modo 1
msgctxt "976:1"
msgid "Other than that, I'm game."
msgstr "Fora isso, aceito o desafio."

#. cv/btl/tam_1700.at3 | 44 quadros | modo 1
msgctxt "977:0"
msgid "Let's wrap this up by tearing\n    them apart, shall we?    "
msgstr "Vamos acabar com isso em grande estilo\ne despedaçar todos eles?"

#. cv/btl/emi_1210_edit.at3 | 60 quadros | modo 1
msgctxt "978:0"
msgid "Circuit… ignition!"
msgstr "Circuito… ignição!"

#. cv/btl/ner_1510.at3 | 66 quadros | modo 1
msgctxt "979:0"
msgid "Ugh, is this necessary!?"
msgstr "Argh, isso é mesmo necessário!?"

#. cv/btl/ksk_1510.at3 | 29 quadros | modo 1
msgctxt "980:0"
msgid "This is as far as you go."
msgstr "Você chegou ao fim da linha."

#. se/eb_ksk/3 | 24 quadros | modo 1
msgctxt "981:0"
msgid "Unnecessary."
msgstr "Desnecessário."

#. se/eb_ner/6 | 51 quadros | modo 1
msgctxt "982:0"
msgid "This is delightful!"
msgstr "Que delícia!"

#. cv/btl/rin2_1210_edit.at3 | 36 quadros | modo 1
msgctxt "983:1"
msgid "I can't afford to be stingy here!"
msgstr "Aqui não dá pra economizar!"

#. cv/fld/gil_0602.at3 | 64 quadros | modo 1
msgctxt "984:0"
msgid "Sit where you like. I'll allow it for today."
msgstr "Senta onde quiseres. Por hoje, eu permito."

#. cv/btl/kia_1090.at3 | 28 quadros | modo 1
msgctxt "985:0"
msgid "Let's begin."
msgstr "Vamos começar."

#. cv/btl/ran_1511.at3 | 55 quadros | modo 1
msgctxt "986:0"
msgid "You're making too many mistakes, Lancer!"
msgstr "Você está cometendo erros demais, Lancer!"

#. cv/btl/eli_1511.at3 | 46 quadros | modo 1
msgctxt "987:0"
msgid "I guess you're no D-list idol."
msgstr "Até que você não é uma idol de quinta."

#. cv/btl/tam3_1273_edit.at3 | 40 quadros | modo 1
msgctxt "988:1"
msgid "Be purified and disappear."
msgstr "Purifique-se e desapareça."

#. cv/btl/tam3_1273_edit.at3 | 50 quadros | modo 1
msgctxt "988:3"
msgid "And thus, the curtain closes."
msgstr "E assim cai a cortina."

#. cv/btl/eli_1250_edit.at3 | 80 quadros | modo 1
msgctxt "989:0"
msgid "I'm ready to go! You won't escape!"
msgstr "Já estou pronta! Você não vai fugir!"

#. cv/btl/eli_1250_edit.at3 | 66 quadros | modo 1
msgctxt "989:2"
msgid "H-huh? I'm stuck… Kya!"
msgstr "H-hã? Tô presa… Aah!"

#. cv/btl/cuu_1700.at3 | 66 quadros | modo 1
msgctxt "990:0"
msgid "Are you going to get serious or\n       just stand there?       "
msgstr "Vai levar a sério ou vai ficar aí parado?"

#. se/eb_rob/6 | 24 quadros | modo 1
msgctxt "991:0"
msgid "How nice of you!"
msgstr "Que gentileza sua!"

#. cv/btl/tam3_1270a_edit.at3 | 24 quadros | modo 1
msgctxt "992:1"
msgid "Here I go!"
msgstr "Aqui vou eu!"

#. cv/btl/tam3_1270a_edit.at3 | 24 quadros | modo 1
msgctxt "992:3"
msgid "Snowflake!"
msgstr "Floco de neve!"

#. cv/btl/tam3_1270a_edit.at3 | 24 quadros | modo 1
msgctxt "992:5"
msgid "Chrysanthemum!"
msgstr "Crisântemo!"

#. cv/btl/tam3_1270a_edit.at3 | 24 quadros | modo 1
msgctxt "992:7"
msgid "I'll crush them!"
msgstr "Vou esmagá-los!"

#. cv/btl/tam3_1270a_edit.at3 | 24 quadros | modo 1
msgctxt "992:9"
msgid "Red spider lily!"
msgstr "Lírio-aranha-vermelho!"

#. cv/btl/tam3_1270a_edit.at3 | 70 quadros | modo 1
msgctxt "992:11"
msgid "…wait, why do I have such a skill?"
msgstr "…espera, por que tenho essa habilidade?"

#. cv/btl/cuu_1511.at3 | 52 quadros | modo 1
msgctxt "993:0"
msgid "ARGH! We're in some shit here!"
msgstr "Argh! A gente tá na merda!"

#. cv/btl/el2_1400.at3 | 60 quadros | modo 1
msgctxt "994:0"
msgid "I… lost?"
msgstr "Eu… perdi?"

#. cv/btl/tam_1091.at3 | 26 quadros | modo 1
msgctxt "995:0"
msgid "I won't lose!"
msgstr "Eu não vou perder!"

#. cv/btl/kar_1756_mix.at3 | 130 quadros | modo 1
msgctxt "996:0"
msgid "I tire of this sight. How shall we make\n       this into a superb scene?       "
msgstr "Cansei desta paisagem.\nComo podemos torná-la digna de um espetáculo?"

#. cv/btl/kar_1756_mix.at3 | 66 quadros | modo 1
msgctxt "996:1"
msgid "What, you like the location or somethin'?"
msgstr "Ué, gostou do lugar ou coisa assim?"

#. cv/btl/gil_1710.at3 | 70 quadros | modo 1
msgctxt "997:0"
msgid "Hurry and get back up, you imbecile!"
msgstr "Levanta de uma vez, criatura imbecil!"

#. cv/btl/kar_1752_mix.at3 | 90 quadros | modo 1
msgctxt "998:0"
msgid "This is the critical moment, Master.\n          Shall I use it?          "
msgstr "Este é o momento decisivo, Mestra.\nDevo usá-lo?"

#. cv/btl/kar_1752_mix.at3 | 76 quadros | modo 1
msgctxt "998:1"
msgid "Y-yes! Mow them down!!"
msgstr "S-sim! Acaba com eles!!"

#. cv/btl/gil_1261_edit.at3 | 90 quadros | modo 1
msgctxt "999:1"
msgid "I'll let you see a small\nportion of my treasury."
msgstr "Vou te mostrar uma pequena\nparte do meu tesouro."

#. cv/btl/gaw2_1520.at3 | 43 quadros | modo 1
msgctxt "1000:0"
msgid "Do you really have no remorse!?"
msgstr "Não sente remorso algum!?"

#. cv/btl/elp_1800b.at3 | 86 quadros | modo 1
msgctxt "1001:0"
msgid "It's time for the long-awaited encore～!"
msgstr "Chegou a hora do tão esperado bis～!"

#. cv/btl/rin_1220_edit.at3 | 44 quadros | modo 1
msgctxt "1002:1"
msgid "Queen Beam!"
msgstr "Queen Beam!"

#. cv/btl/psl_1220_edit.at3 | 60 quadros | modo 1
msgctxt "1003:1"
msgid "Get weaker… and weaker…"
msgstr "Enfraqueça… cada vez mais…"

#. cv/btl/emi_1707.at3 | 40 quadros | modo 1
msgctxt "1004:0"
msgid "I'm trusting you to make the best call."
msgstr "Confio que vai tomar a melhor decisão."

#. cv/btl/tam3_1120.at3 | 38 quadros | modo 1
msgctxt "1005:0"
msgid "I can still fight…"
msgstr "Ainda posso lutar…"

#. cv/btl/ner_1850_mix.at3 | 146 quadros | modo 1
msgctxt "1006:0"
msgid "I swear to you, this will be your last number."
msgstr "Juro que este será teu último número."

#. cv/btl/ner_1850_mix.at3 | 130 quadros | modo 1
msgctxt "1006:1"
msgid "I'll hold nothing back and show you\n        my best performance!        "
msgstr "Não vou me conter!\nVou te mostrar meu melhor espetáculo!"

#. cv/btl/ner_1850_mix.at3 | 100 quadros | modo 1
msgctxt "1006:2"
msgid "You took the words right out of my mouth,\n                Elizabeth.                "
msgstr "Tiraste as palavras da minha boca, Elizabeth."

#. cv/btl/ner_1850_mix.at3 | 116 quadros | modo 1
msgctxt "1006:3"
msgid "We'll see whose truly fit to be\n     the star of the show!     "
msgstr "Vamos ver quem merece ser\na estrela do espetáculo!"

#. se/eb_cuu/3 | 40 quadros | modo 1
msgctxt "1007:0"
msgid "All together now!"
msgstr "Todo mundo junto!"

#. cv/fld/kot_0091.at3 | 48 quadros | modo 3
msgctxt "1008:0"
msgid "What kind of bargain can I entice you with?"
msgstr "Que oferta poderá seduzir você hoje?"

#. cv/fld/jin_0102.at3 | 106 quadros | modo 2
msgctxt "1009:0"
msgid "Hmph. 82kg. I'm overweight, so what?"
msgstr "Hunf. 82 kg. Tô acima do peso, e daí?"

#. se/eb_mll/104 | 24 quadros | modo 1
msgctxt "1010:0"
msgid "You're finished."
msgstr "É o seu fim."

#. cv/btl/eli_1240_edit.at3 | 46 quadros | modo 1
msgctxt "1011:1"
msgid "Direct hit!"
msgstr "Na mosca!"

#. cv/btl/eli_1240_edit.at3 | 40 quadros | modo 1
msgctxt "1011:2"
msgid "Thanks for the delicious meal～鷙"
msgstr "Obrigada pelo banquete～鷙"

#. cv/btl/gil_1804.at3 | 70 quadros | modo 1
msgctxt "1012:0"
msgid "It seems they want to try resisting us."
msgstr "Parece que vão tentar resistir."

#. cv/btl/kot_1202_edit.at3 | 40 quadros | modo 1
msgctxt "1013:0"
msgid "Found your blind spot."
msgstr "Achei seu ponto cego."

#. cv/btl/el2_1753.at3 | 126 quadros | modo 1
msgctxt "1014:0"
msgid "What the hell!? How do you not get my music!?"
msgstr "Como assim!? Não entende a minha música!?"

#. cv/btl/kia_1800.at3 | 220 quadros | modo 1
msgctxt "1015:0"
msgid "Stifled child, in one's \"suchness\"\n        lies perfection―        "
msgstr "Criança sufocada. Na talidade\nde cada ser reside a perfeição―"

#. cv/btl/kia_1800.at3 | 58 quadros | modo 1
msgctxt "1015:1"
msgid "Let this brief diversion be my mercy to you."
msgstr "Tome esta breve distração como minha clemência."

#. cv/btl/cuu_1111.at3 | 38 quadros | modo 1
msgctxt "1016:0"
msgid "You're a knave, priest."
msgstr "Seu canalha, padre."

#. cv/fld/emi_0620.at3 | 26 quadros | modo 1
msgctxt "1017:0"
msgid "Hang on a second."
msgstr "Espere um instante."

#. cv/fld/jin_0104.at3 | 88 quadros | modo 2
msgctxt "1018:0"
msgid "Japan. Though my papa was German."
msgstr "Japão. Embora meu pai fosse alemão."

#. cv/btl/el2_1756.at3 | 76 quadros | modo 1
msgctxt "1019:0"
msgid "The amps are live and ready to go～"
msgstr "Os amplificadores já estão ligados～"

#. cv/btl/gil_1940.at3 | 146 quadros | modo 1
msgctxt "1020:0"
msgid "          Let's go, Master!          \nBehold the power that is your servant!"
msgstr "Vamos! Contempla o poder do teu Servo!"

#. cv/fld/emi_0200.at3 | 168 quadros | modo 2
msgctxt "1021:0"
msgid "Not really a part of the body, but like, the balance of it all."
msgstr "Não é bem uma parte do corpo. É o equilíbrio do conjunto."

#. cv/fld/emi_0200.at3 | 80 quadros | modo 2
msgctxt "1021:1"
msgid "I'm particular about body proportions I mean."
msgstr "Quero dizer, reparo nas proporções do corpo."

#. cv/fld/emi_0200.at3 | 100 quadros | modo 2
msgctxt "1021:2"
msgid "So, uh, something like this shape? *vague hand gestures*"
msgstr "Então, hum, mais ou menos assim? ＊gestos vagos＊"

#. cv/btl/tam3_1750_mix.at3 | 136 quadros | modo 1
msgctxt "1022:0"
msgid "What a disappointment. Let's keep the\n      pressure on them, Master.      "
msgstr "Que decepção. Vamos manter a pressão."

#. cv/btl/tam3_1750_mix.at3 | 156 quadros | modo 1
msgctxt "1022:1"
msgid "They have some promise. But if they're\n        weak, then that's that.        "
msgstr "Até têm potencial.\nMas quem é fraco é fraco."

#. cv/fld/rin_0105.at3 | 166 quadros | modo 2
msgctxt "1023:0"
msgid "Physically, nothing in particular. Apart from that…"
msgstr "Fisicamente, nada em especial. Fora isso…"

#. cv/fld/rin_0105.at3 | 134 quadros | modo 2
msgctxt "1023:1"
msgid "I'm not good with… well… being scolded, you know?"
msgstr "Não lido bem com… bom… levar bronca, sabe?"

#. cv/btl/ran_1510.at3 | 44 quadros | modo 1
msgctxt "1024:0"
msgid "Outside of calculated error range."
msgstr "Fora da margem de erro calculada."

#. cv/btl/ner_1860_mix.at3 | 156 quadros | modo 1
msgctxt "1025:0"
msgid "Don't make light of me just because I'm dying.\nThis poison isn't remotely the same as before."
msgstr "Não me subestime só porque estou morrendo.\nEste veneno é diferente do de antes."

#. cv/btl/ner_1860_mix.at3 | 74 quadros | modo 1
msgctxt "1025:1"
msgid "This won't play out like last time!"
msgstr "Desta vez vai ser diferente!"

#. cv/btl/ner_1860_mix.at3 | 158 quadros | modo 1
msgctxt "1025:2"
msgid "   Of course not. I won't hold back against   \nthe fangs of a rebel fighting at death's door."
msgstr "Claro que sim. Não pouparei forças\ncontra as presas de um rebelde moribundo."

#. cv/btl/ner_1860_mix.at3 | 182 quadros | modo 1
msgctxt "1025:3"
msgid "    Even more so against a true marksman.    \nI'll crush you here with full force, Archer."
msgstr "Ainda mais um atirador de verdade.\nVou esmagar-te com toda a força, Archer."

#. cv/btl/ner_1860_mix.at3 | 68 quadros | modo 1
msgctxt "1025:4"
msgid "That's a good look."
msgstr "Que belo visual."

#. cv/btl/ner_1860_mix.at3 | 124 quadros | modo 1
msgctxt "1025:5"
msgid "I hate to admit it, but the sight of you\n  holding a sword is really something.  "
msgstr "Custa admitir, mas é impressionante\nver você empunhar uma espada."

#. cv/btl/tam3_1270_edit.at3 | 24 quadros | modo 1
msgctxt "1026:1"
msgid "Here I go!"
msgstr "Aqui vou eu!"

#. cv/btl/tam3_1270_edit.at3 | 24 quadros | modo 1
msgctxt "1026:3"
msgid "Snowflake!"
msgstr "Floco de neve!"

#. cv/btl/tam3_1270_edit.at3 | 24 quadros | modo 1
msgctxt "1026:5"
msgid "Chrysanthemum!"
msgstr "Crisântemo!"

#. cv/btl/tam3_1270_edit.at3 | 24 quadros | modo 1
msgctxt "1026:7"
msgid "Red spider lily!"
msgstr "Lírio-aranha-vermelho!"

#. cv/btl/tam3_1270_edit.at3 | 70 quadros | modo 1
msgctxt "1026:9"
msgid "…wait, what skill even is this?"
msgstr "…espera, que habilidade é essa?"

#. cv/btl/gil_1100.at3 | 32 quadros | modo 1
msgctxt "1027:0"
msgid "As is expected."
msgstr "Como era de se esperar."

#. cv/fld/psl_0202.at3 | 96 quadros | modo 2
msgctxt "1028:0"
msgid "I'd say things like practicing my cooking…"
msgstr "Diria coisas como praticar culinária…"

#. cv/fld/psl_0202.at3 | 100 quadros | modo 2
msgctxt "1028:1"
msgid "But I get really hungry just by moving around a bit…"
msgstr "Mas só de me mexer um pouquinho já fico morrendo de fome…"

#. cv/btl/kar_1211_edit.at3 | 60 quadros | modo 1
msgctxt "1029:1"
msgid "   Weapons are but a crutch.   \nA true hero kills with a stare!"
msgstr "Armas são só uma muleta.\nUm herói de verdade mata com o olhar!"

#. se/eb_ksk/13 | 30 quadros | modo 1
msgctxt "1030:0"
msgid "Vulgar."
msgstr "Vulgar."

#. cv/btl/emi_1613.at3 | 82 quadros | modo 1
msgctxt "1031:0"
msgid "We took minimal damage. Good work."
msgstr "Sofremos pouco dano. Bom trabalho."

#. cv/btl/kot_1201_edit.at3 | 48 quadros | modo 1
msgctxt "1032:0"
msgid "Just keeping you in check."
msgstr "Só estou mantendo você sob controle."

#. cv/btl/twi_1701.at3 | 96 quadros | modo 1
msgctxt "1033:0"
msgid "Sorry, but I've had practice fighting\n    opponents of your skill level.    "
msgstr "Desculpe, mas já tenho prática\ncontra oponentes do seu nível."

#. cv/btl/ner_1500.at3 | 50 quadros | modo 1
msgctxt "1034:0"
msgid "It's always my time to shine!"
msgstr "Sempre é a minha hora de brilhar!"

#. se/eb_emi/16 | 27 quadros | modo 1
msgctxt "1035:0"
msgid "I'll overtake you!"
msgstr "Vou ultrapassar você!"

#. cv/btl/el2_1120.at3 | 84 quadros | modo 1
msgctxt "1036:0"
msgid "Do you think a dragon would fall that easily!?"
msgstr "Achou que um dragão cairia tão fácil!?"

#. se/eb_cuu/5 | 32 quadros | modo 1
msgctxt "1037:0"
msgid "You're like a freakin' rock!"
msgstr "Você é duro feito pedra!"

#. cv/btl/sal_1751.at3 | 78 quadros | modo 1
msgctxt "1038:0"
msgid "You're playing a little too rough, you know!"
msgstr "Tá brincando com força demais, sabia!"

#. cv/btl/gil_1200_edit.at3 | 52 quadros | modo 1
msgctxt "1039:0"
msgid "My weapons could be a little sharper."
msgstr "Minhas armas podiam ter mais fio."

#. se/eb_ner/11 | 25 quadros | modo 1
msgctxt "1040:0"
msgid "Too slow!"
msgstr "Devagar demais!"

#. cv/btl/emi_1510.at3 | 28 quadros | modo 1
msgctxt "1041:0"
msgid "Can we survive this?"
msgstr "Será que sobrevivemos a isso?"

#. cv/btl/ner_1631.at3 | 116 quadros | modo 1
msgctxt "1042:0"
msgid "You may praise me! My body\n has become more perfect! "
msgstr "Podes me louvar! Meu corpo\nficou ainda mais perfeito!"

#. se/eb_emi/19 | 28 quadros | modo 1
msgctxt "1043:0"
msgid "Foolish!"
msgstr "Que tolice!"

#. cv/btl/ner_1520.at3 | 40 quadros | modo 1
msgctxt "1044:0"
msgid "Argh, spineless coward!"
msgstr "Argh, quanta covardia!"

#. cv/btl/cuu_1753_mix.at3 | 46 quadros | modo 1
msgctxt "1045:0"
msgid "WHAT!?"
msgstr "O quê!?"

#. cv/btl/cuu_1753_mix.at3 | 178 quadros | modo 1
msgctxt "1045:1"
msgid "I said I'd leave it to you, but why does your\n   spear end up missing every single time?   "
msgstr "Eu disse que deixava com você.\nPor que essa lança erra toda vez?"

#. cv/btl/kia_1710.at3 | 176 quadros | modo 1
msgctxt "1046:0"
msgid "  How has it come to this…?  \nWhat is it that's driving you?"
msgstr "Como chegamos a isso…?\nO que lhe dá tanta força?"

#. se/eb_kar/8 | 24 quadros | modo 1
msgctxt "1047:0"
msgid "Good defense!"
msgstr "Boa defesa!"

#. cv/btl/tam3_1700.at3 | 62 quadros | modo 1
msgctxt "1048:0"
msgid "You realize you have no chance\n      of winning, right?      "
msgstr "Sabe que não tem chance de ganhar, né?"

#. cv/btl/ner_1890_mix.at3 | 250 quadros | modo 1
msgctxt "1049:0"
msgid "You say all mankind will love you. Does that\n      include the ones who reject you?      "
msgstr "Dizes que toda a humanidade vai te amar.\nE os que te rejeitam, também?"

#. cv/btl/ner_1890_mix.at3 | 138 quadros | modo 1
msgctxt "1049:1"
msgid "              Of course.              \nScorn is pleasurable in its own right."
msgstr "Claro. O desprezo é um prazer à parte."

#. cv/btl/ner_1890_mix.at3 | 154 quadros | modo 1
msgctxt "1049:2"
msgid "I waste nothing given to me."
msgstr "Não desperdiço nada do que me dão."

#. cv/btl/ner_1890_mix.at3 | 168 quadros | modo 1
msgctxt "1049:3"
msgid "Unlike you, I'm not picky, Saber."
msgstr "Ao contrário de você, não sou exigente, Saber."

#. cv/btl/ner_1890_mix.at3 | 160 quadros | modo 1
msgctxt "1049:4"
msgid "   It's not about being picky,   \nit's about valuing individuality!"
msgstr "Isto é valorizar a individualidade!\nQue tem a ver com ser exigente!?"

#. cv/btl/ner_1890_mix.at3 | 156 quadros | modo 1
msgctxt "1049:5"
msgid "Kiara Sessyoin, Mother Earth's misbegotten,"
msgstr "Sessyoin Kiara, filha desnaturada da Mãe Terra,"

#. cv/btl/ner_1890_mix.at3 | 86 quadros | modo 1
msgctxt "1049:6"
msgid "you and your perverse desires\n    shall be slain here!    "
msgstr "tu e teus desejos perversos\nperecereis aqui!"

#. cv/fld/tam_0107.at3 | 106 quadros | modo 2
msgctxt "1050:0"
msgid "Maybe the soul… like a soul fetish?"
msgstr "Talvez a alma… tipo, fetiche por almas?"

#. cv/fld/tam_0107.at3 | 104 quadros | modo 2
msgctxt "1050:1"
msgid "The spirit of a hot guy just makes my heart leap!"
msgstr "A alma de um homem bonito\nfaz meu coração disparar!"

#. cv/fld/kot_0095.at3 | 74 quadros | modo 3
msgctxt "1051:1"
msgid "Looking for a present, boy?"
msgstr "Procurando um presente, rapaz?"

#. cv/btl/gil_1920_mix_a.at3 | 176 quadros | modo 1
msgctxt "1052:0"
msgid "I'm not sure how to handle this, Caster.\n He's an awfully intense Heroic Spirit. "
msgstr "Não sei lidar com isso, Caster.\nEsse Espírito Heroico é intenso demais."

#. cv/btl/gil_1920_mix_a.at3 | 84 quadros | modo 1
msgctxt "1052:1"
msgid "Don't you think he's too godlike to kill?"
msgstr "Você não acha que ele é divino demais pra matar?"

#. cv/btl/gil_1920_mix_a.at3 | 202 quadros | modo 1
msgctxt "1052:2"
msgid "Not at all. He's a fool who denied the gods\n          and sided with mankind.          "
msgstr "De modo algum. É um tolo que renegou\nos deuses e ficou do lado dos humanos."

#. cv/btl/gil_1920_mix_a.at3 | 116 quadros | modo 1
msgctxt "1052:3"
msgid "There's no need to fear punishment for killing\n              someone like that.              "
msgstr "Não há por que temer um castigo\npor matar alguém assim."

#. cv/btl/gil_1920_mix_a.at3 | 96 quadros | modo 1
msgctxt "1052:4"
msgid "Really? Well then, let's knock him down then."
msgstr "É mesmo? Então vamos derrubá-lo."

#. cv/btl/gil_1920_mix_a.at3 | 92 quadros | modo 1
msgctxt "1052:5"
msgid "One irregularity is more than enough\n          with me around.          "
msgstr "Uma irregularidade já é o bastante\ncomigo por aqui."

#. se/eb_kia/14 | 32 quadros | modo 1
msgctxt "1053:0"
msgid "That won't do."
msgstr "Assim não serve."

#. cv/btl/gil_1300_edit.at3 | 90 quadros | modo 1
msgctxt "1054:0"
msgid "This is getting interesting.\n    Stand down, Master.    "
msgstr "Isso está ficando interessante.\nRecua e deixa comigo."

#. cv/btl/gil_1300_edit.at3 | 64 quadros | modo 1
msgctxt "1054:2"
msgid "I talk of the origin."
msgstr "Falo da origem."

#. cv/btl/gil_1300_edit.at3 | 200 quadros | modo 1
msgctxt "1054:3"
msgid "  Source elements, mixing and solidifying  \ninto the star that weaves of all creation."
msgstr "Os elementos primordiais se misturam e formam\na estrela que tece toda a criação."

#. cv/btl/gil_1300_edit.at3 | 100 quadros | modo 1
msgctxt "1054:5"
msgid "Fwhaahahahaa!!"
msgstr "Fuahahahahaa!!"

#. cv/btl/gil_1300_edit.at3 | 76 quadros | modo 1
msgctxt "1054:7"
msgid "Pay tribute with your life!"
msgstr "Paga o tributo com a tua vida!"

#. cv/btl/gil_1300_edit.at3 | 100 quadros | modo 1
msgctxt "1054:8"
msgid "Enuma Elish!"
msgstr "Enuma Elish!"

#. cv/btl/ner_1112.at3 | 50 quadros | modo 1
msgctxt "1055:0"
msgid "There's absolutely NO hope for you!"
msgstr "Não te resta esperança ALGUMA!"

#. se/eb_gil/19 | 33 quadros | modo 1
msgctxt "1056:0"
msgid "Disappear!"
msgstr "Desapareça!"

#. cv/btl/sal_1210_edit.at3 | 79 quadros | modo 1
msgctxt "1057:1"
msgid "Chase the rabbit down to the\n    underground kingdom!    "
msgstr "Siga o coelho até o reino subterrâneo!"

#. cv/btl/ner_1741_mix.at3 | 90 quadros | modo 1
msgctxt "1058:0"
msgid "I can't resist playing with my food a little～"
msgstr "Não resisto a brincar um pouco com a comida～"

#. cv/btl/ner_1741_mix.at3 | 96 quadros | modo 1
msgctxt "1058:1"
msgid "Make sure to give me a nice scream, okay?"
msgstr "Quero ouvir um grito bem bonito, tá?"

#. cv/btl/ner_1741_mix.at3 | 140 quadros | modo 1
msgctxt "1058:2"
msgid "You've got quite the discerning ears if you're\n      asking to hear my beautiful voice.      "
msgstr "Tens mesmo ouvidos exigentes\npara pedires minha bela voz."

#. cv/btl/ner_1741_mix.at3 | 114 quadros | modo 1
msgctxt "1058:3"
msgid "Unfortunately for you, you'll be the\n        one singing tonight.        "
msgstr "Para teu azar, serás tu quem canta hoje."

#. cv/btl/ner_1741_mix.at3 | 124 quadros | modo 1
msgctxt "1058:4"
msgid "Hehe, pretty cocky for a Servant who\n       lost all their levels.       "
msgstr "Hehe, que audácia pra quem perdeu\ntodos os níveis de Servo."

#. cv/btl/ner_1741_mix.at3 | 144 quadros | modo 1
msgctxt "1058:5"
msgid "You'll just have to show me what an\nexperienced Servant like you can do."
msgstr "Vai ter que mostrar do que alguém\ncom sua experiência é capaz."

#. cv/btl/ner_1230_edit.at3 | 64 quadros | modo 1
msgctxt "1059:1"
msgid "Let the bells of Nuptiae ring!"
msgstr "Que os sinos de Nuptiae ressoem!"

#. cv/btl/emi_1100.at3 | 32 quadros | modo 1
msgctxt "1060:0"
msgid "How thoughtful of you."
msgstr "Que consideração."

#. cv/btl/emi_1805.at3 | 102 quadros | modo 1
msgctxt "1061:0"
msgid "Relax, this is nothing for us."
msgstr "Relaxe. Isso não é nada pra nós."

#. cv/btl/gaw2_1710.at3 | 98 quadros | modo 1
msgctxt "1062:0"
msgid "No wonder Japan has so much debt…!"
msgstr "Não admira que o Japão tenha tanta dívida…!"

#. cv/btl/rob_1301_edit.at3 | 82 quadros | modo 1
msgctxt "1063:1"
msgid "Poison, flow forth from the tainted ground!"
msgstr "Veneno, brote do solo corrompido!"

#. cv/btl/sal_1520.at3 | 88 quadros | modo 1
msgctxt "1064:0"
msgid "No mercy! No mercy! No mercy～鷙"
msgstr "Sem dó! Sem dó! Sem dó～鷙"

#. cv/fld/gil_0107.at3 | 164 quadros | modo 2
msgctxt "1065:0"
msgid "Of course, they should be beautiful. There's no question there."
msgstr "É claro que deve ser bela. Isso é indiscutível."

#. cv/fld/gil_0107.at3 | 96 quadros | modo 2
msgctxt "1065:1"
msgid "What makes my heart flutter is the sound of another's breaking."
msgstr "O que me acelera o coração é ouvir outro coração se partir."

#. cv/fld/gil_0107.at3 | 134 quadros | modo 2
msgctxt "1065:2"
msgid "The most delicious fruit releases an even more heavenly juice."
msgstr "A fruta mais deliciosa dá um suco ainda mais divino."

#. cv/fld/gil_0107.at3 | 44 quadros | modo 2
msgctxt "1065:3"
msgid "It's an enthralling taste."
msgstr "É um sabor que enfeitiça."

#. cv/btl/gil_1602.at3 | 60 quadros | modo 1
msgctxt "1066:0"
msgid "Now THIS is the kind of rehabilitation I need."
msgstr "ISSO é a recuperação de que preciso."

#. se/eb_gaw2/8 | 25 quadros | modo 1
msgctxt "1067:0"
msgid "Payback time!"
msgstr "Hora de pagar!"

#. cv/btl/emi_1704.at3 | 62 quadros | modo 1
msgctxt "1068:0"
msgid "Great! You're getting better at this!"
msgstr "Ótimo! Você está pegando o jeito!"

#. se/eb_ner/14 | 29 quadros | modo 1
msgctxt "1069:0"
msgid "It's time to give up!"
msgstr "Hora de desistir!"

#. cv/btl/gil_1271_edit.at3 | 82 quadros | modo 1
msgctxt "1070:0"
msgid "      Bow your head!      \nYour judgement is at hand!"
msgstr "Curva a cabeça!\nChegou a hora do teu julgamento!"

#. cv/btl/gil_1745.at3 | 110 quadros | modo 1
msgctxt "1071:0"
msgid "It's just a counterfeit servant,\n       a worthless faker.       "
msgstr "É só uma imitação de Servo,\numa falsificação sem valor."

#. cv/btl/gil_1745.at3 | 26 quadros | modo 1
msgctxt "1071:1"
msgid "Dispose of it already!"
msgstr "Dá fim a isso de uma vez!"

#. cv/btl/elp_1520.at3 | 64 quadros | modo 1
msgctxt "1072:0"
msgid "You're in for some punishment\n     after this, piggy!!     "
msgstr "Você vai receber seu castigo,\nporquinho!!"

#. cv/btl/ner_1501.at3 | 48 quadros | modo 1
msgctxt "1073:0"
msgid "Splendid, Praetor!"
msgstr "Esplêndido, Maestro!"

#. cv/btl/elp_1700.at3 | 84 quadros | modo 1
msgctxt "1074:0"
msgid " Everything's going smoothly. \nJust relax and watch the show."
msgstr "Tá tudo indo bem.\nRelaxa e assiste ao show."

#. se/eb_gil/16 | 46 quadros | modo 1
msgctxt "1075:0"
msgid "You're just paper to me."
msgstr "Para mim, és só papel."

#. cv/fld/ner_0602.at3 | 84 quadros | modo 1
msgctxt "1076:0"
msgid "Idiot, the spot next to me is open, you know…"
msgstr "Tolo, o lugar ao meu lado está livre, sabes…"

#. se/eb_kia/11 | 38 quadros | modo 1
msgctxt "1077:0"
msgid "Don't mind if I do～"
msgstr "Com licença, então～"

#. cv/fld/eli_0104.at3 | 108 quadros | modo 2
msgctxt "1078:0"
msgid "A noble house that once faced the fangs of a"
msgstr "Uma família nobre que enfrentou as presas de um"

#. cv/fld/eli_0104.at3 | 143 quadros | modo 2
msgctxt "1078:1"
msgid "fearsome dragon: the House of Báthory in Hungary."
msgstr "dragão temível: a casa Báthory, na Hungria."

#. cv/fld/eli_0104.at3 | 88 quadros | modo 2
msgctxt "1078:2"
msgid "That place was my everything."
msgstr "Aquele lugar era tudo pra mim."

#. cv/btl/tam_1112.at3 | 46 quadros | modo 1
msgctxt "1079:0"
msgid "Ichimokuren, Eye Strike!"
msgstr "Ichimokuren, Golpe do Olho!"

#. cv/btl/ner_1830_mix.at3 | 188 quadros | modo 1
msgctxt "1080:0"
msgid "What a pitiful maiden. Your love won't\n          reach my Praetor.          "
msgstr "Que donzela lamentável.\nTeu amor jamais alcançará meu Maestro."

#. cv/btl/ner_1830_mix.at3 | 80 quadros | modo 1
msgctxt "1080:1"
msgid "I will become the fortress that repels you!"
msgstr "Serei a fortaleza que te repelirá!"

#. cv/btl/ner_1830_mix.at3 | 204 quadros | modo 1
msgctxt "1080:2"
msgid "I don't understand… I don't understand\n    anything you're saying, Saber…!    "
msgstr "Não entendo… Não entendo nada\ndo que você diz, Saber…!"

#. cv/btl/ner_1830_mix.at3 | 112 quadros | modo 1
msgctxt "1080:3"
msgid "What's so wrong about wanting to be loved!?"
msgstr "Qual é o problema de querer amor!?"

#. se/eb_tam3/9 | 26 quadros | modo 1
msgctxt "1081:0"
msgid "I will tear you down."
msgstr "Vou acabar com você."

#. cv/btl/kar_1301_edit.at3 | 60 quadros | modo 1
msgctxt "1082:1"
msgid "Know the mercy of the King of Gods."
msgstr "Conheça a misericórdia do Rei dos Deuses."

#. cv/btl/kar_1301_edit.at3 | 64 quadros | modo 1
msgctxt "1082:3"
msgid "Watch closely, Indra."
msgstr "Observe bem, Indra."

#. cv/btl/kar_1301_edit.at3 | 80 quadros | modo 1
msgctxt "1082:5"
msgid "One hit will lead to extinction."
msgstr "Um só golpe levará à extinção."

#. cv/btl/kar_1301_edit.at3 | 88 quadros | modo 1
msgctxt "1082:7"
msgid "Burn, Vasavi Shakti!"
msgstr "Arda, Vasavi Shakti!"

#. cv/btl/kar_1301_edit.at3 | 88 quadros | modo 1
msgctxt "1082:9"
msgid "Hmph. Farewell."
msgstr "Humph. Adeus."

#. cv/btl/ner_1910_mix_a.at3 | 96 quadros | modo 1
msgctxt "1083:0"
msgid "There's no need to ask why we're fighting."
msgstr "Não há por que perguntar a razão da luta."

#. cv/btl/ner_1910_mix_a.at3 | 150 quadros | modo 1
msgctxt "1083:1"
msgid "What matters is the dance of sparks\n      between blade and spear!      "
msgstr "Importa a dança das faíscas\nentre lâmina e lança!"

#. cv/btl/ner_1910_mix_a.at3 | 248 quadros | modo 1
msgctxt "1083:2"
msgid "    I see we're on the same page, my lady.    \nIt's about *how* we fight, not *why* we fight!"
msgstr "Vejo que pensamos igual, minha dama.\nO que importa é *como* lutamos!"

#. cv/btl/ner_1910_mix_a.at3 | 76 quadros | modo 1
msgctxt "1083:3"
msgid "That's just what it means to be a hero!"
msgstr "É isso que significa ser herói!"

#. cv/btl/ner_1910_mix_a.at3 | 262 quadros | modo 1
msgctxt "1083:4"
msgid "    Well said. Simple-minded warriors get    \nalong quite well. We can't lose now, Lancer!"
msgstr "Bem dito. Guerreiros de ideias simples\nse dão bem. Não podemos perder, Lancer!"

#. cv/btl/ner_1910_mix_a.at3 | 94 quadros | modo 1
msgctxt "1083:5"
msgid "The battle of the idiots begins now!"
msgstr "Começa agora a batalha dos idiotas!"

#. cv/btl/ner_1910_mix_a.at3 | 32 quadros | modo 1
msgctxt "1083:6"
msgid "DON'T CALL US IDIOTS!\nDON'T CALL US IDIOTS!"
msgstr "NADA DE NOS CHAMAR DE IDIOTAS!\nNADA DE NOS CHAMAR DE IDIOTAS!"

#. se/eb_mll/106 | 20 quadros | modo 1
msgctxt "1084:0"
msgid "Not so fast!"
msgstr "Não tão depressa!"

#. se/eb_elp/4 | 26 quadros | modo 1
msgctxt "1085:0"
msgid "Take that!"
msgstr "Toma!"

#. cv/btl/emi3_1800.at3 | 46 quadros | modo 1
msgctxt "1086:0"
msgid "We'll shoot them down soon enough, Rin."
msgstr "Logo os derrubaremos, Rin."

#. cv/btl/gaw2_1090.at3 | 25 quadros | modo 1
msgctxt "1087:0"
msgid "Forward!"
msgstr "Avante!"

#. cv/btl/el2_1301_edit.at3 | 70 quadros | modo 1
msgctxt "1088:1"
msgid "Báthory Erzsébet!"
msgstr "Báthory Erzsébet!"

#. cv/btl/twi_1510.at3 | 24 quadros | modo 1
msgctxt "1089:0"
msgid "Damn it!"
msgstr "Droga!"

#. cv/btl/eli_1301_edit.at3 | 52 quadros | modo 1
msgctxt "1090:1"
msgid "Kilenc Sárkány!"
msgstr "Kilenc Sárkány!"

#. se/eb_tam3/19 | 28 quadros | modo 1
msgctxt "1091:0"
msgid "Please forgive me."
msgstr "Por favor, me perdoe."

#. cv/fld/kot_00921.at3 | 30 quadros | modo 3
msgctxt "1092:0"
msgid "You've got a deal."
msgstr "Negócio fechado."

#. cv/btl/cuu_1231_edit.at3 | 46 quadros | modo 1
msgctxt "1093:1"
msgid "Time to make my last stand."
msgstr "Hora de lutar até o fim."

#. se/eb_gil/22 | 34 quadros | modo 1
msgctxt "1094:0"
msgid "How obvious."
msgstr "Que óbvio."

#. cv/btl/jin_1701.at3 | 126 quadros | modo 1
msgctxt "1095:0"
msgid "Hehe. Were you under the impression\n    that I was actually trying?    "
msgstr "Hehe. Achou mesmo que eu\ntava tentando de verdade?"

#. cv/btl/ner_1251_edit.at3 | 92 quadros | modo 1
msgctxt "1096:0"
msgid "Heavens, once more your blessing!"
msgstr "Céus, mais uma vez vossa bênção!"

#. cv/btl/elp_1251_edit.at3 | 56 quadros | modo 1
msgctxt "1097:0"
msgid "I'm coming to defile you 鷙"
msgstr "Vou aí te profanar鷙"

#. cv/btl/elp_1251_edit.at3 | 36 quadros | modo 1
msgctxt "1097:1"
msgid "Just let it happen!"
msgstr "Deixa acontecer!"

#. cv/btl/elp_1251_edit.at3 | 76 quadros | modo 1
msgctxt "1097:3"
msgid "W-well then, had enough?"
msgstr "E-então, já chega pra você?"

#. cv/btl/ran_1700.at3 | 130 quadros | modo 1
msgctxt "1098:0"
msgid "Dystopia is but one step away.\n  I can do this, I know it!  "
msgstr "Falta um passo para a distopia.\nSei que consigo!"

#. cv/btl/tam_1090.at3 | 30 quadros | modo 1
msgctxt "1099:0"
msgid "Well then～"
msgstr "Pois bem～"

#. cv/btl/emi_1860_mix.at3 | 144 quadros | modo 1
msgctxt "1100:0"
msgid "We've both seen up the other's sleeve.\n     This should be a fair fight.     "
msgstr "Já vimos os truques um do outro.\nVai ser uma luta justa."

#. cv/btl/emi_1860_mix.at3 | 144 quadros | modo 1
msgctxt "1100:1"
msgid "Ha! I feel pretty disadvantaged being stuck\n         in a level with no cover.         "
msgstr "Ha! Estou em desvantagem\nnum mapa sem cobertura."

#. cv/btl/emi_1860_mix.at3 | 190 quadros | modo 1
msgctxt "1100:2"
msgid "  We'll just go ahead and call it a handicap  \nthen. I'm better at setting up traps at least."
msgstr "Vamos chamar isso de handicap.\nPelo menos sei montar armadilhas melhor."

#. cv/btl/emi_1860_mix.at3 | 168 quadros | modo 1
msgctxt "1100:3"
msgid "Cheeky until the end―actually no, even\n        death won't solve that.        "
msgstr "Atrevido até o fim― aliás,\nnem a morte resolve isso."

#. cv/btl/emi_1860_mix.at3 | 122 quadros | modo 1
msgctxt "1100:4"
msgid "You've got a long way before you become a\n       proper hero, forest hunter.       "
msgstr "Ainda falta muito pra virar herói,\ncaçador da floresta."

#. cv/btl/emi_1860_mix.at3 | 146 quadros | modo 1
msgctxt "1100:5"
msgid "Ha! And here you are meeting my cheek\n      with snark. Same as ever.      "
msgstr "Ha! E lá vem você responder\natrevimento com sarcasmo. Como sempre."

#. cv/btl/tam_1705.at3 | 54 quadros | modo 1
msgctxt "1101:0"
msgid "Do you understand the power of our love now!?"
msgstr "Entendeu a força do nosso amor agora!?"

#. cv/btl/emi3_1100.at3 | 33 quadros | modo 1
msgctxt "1102:0"
msgid "How prudent of you, Rin."
msgstr "Que prudente, Rin."

#. cv/btl/gil_2020.at3 | 118 quadros | modo 1
msgctxt "1103:0"
msgid "Don't waste my time. I can only allow\n       so much fooling around.       "
msgstr "Não desperdices meu tempo.\nMinha tolerância tem limites."

#. se/eb_cuu/4 | 42 quadros | modo 1
msgctxt "1104:0"
msgid "An extra serving, on the house!"
msgstr "Mais uma porção, por conta da casa!"

#. cv/fld/ran_0201.at3 | 126 quadros | modo 2
msgctxt "1105:0"
msgid "Are you seriously asking me that? I'll say it until you get it."
msgstr "Está mesmo me perguntando isso? Vou repetir até entender."

#. cv/fld/ran_0201.at3 | 28 quadros | modo 2
msgctxt "1105:1"
msgid "I don't"
msgstr "Eu não"

#. cv/fld/ran_0201.at3 | 22 quadros | modo 2
msgctxt "1105:2"
msgid "wear"
msgstr "uso"

#. cv/fld/ran_0201.at3 | 20 quadros | modo 2
msgctxt "1105:3"
msgid "underwear."
msgstr "roupa íntima."

#. cv/btl/psl_1757.at3 | 147 quadros | modo 1
msgctxt "1106:0"
msgid "How could you…!? We could be together forever,\n        why would you throw that away!?        "
msgstr "Como pôde…!? Podíamos ficar juntos\npara sempre! Por que jogar isso fora!?"

#. cv/fld/mks_0100.at3 | 112 quadros | modo 2
msgctxt "1107:0"
msgid "B.B. What that stands for is a secret."
msgstr "B.B. O significado é segredo."

#. cv/fld/mks_0100.at3 | 92 quadros | modo 2
msgctxt "1107:1"
msgid "You may call me whatever you like, Senpai."
msgstr "Pode me chamar do que quiser, Senpai."

#. cv/btl/tam3_1500.at3 | 37 quadros | modo 1
msgctxt "1108:0"
msgid "It has been my pleasure, Master."
msgstr "Foi um prazer servir a você."

#. cv/btl/gil_1603.at3 | 132 quadros | modo 1
msgctxt "1109:0"
msgid "    NOW I can call you my \"Master.\"    \nIt's only fair after that performance."
msgstr "Agora, sim, mereces me comandar.\nÉ justo, depois desse desempenho."

#. cv/btl/gaw_1090.at3 | 26 quadros | modo 1
msgctxt "1110:0"
msgid "This is it!"
msgstr "É agora!"

#. cv/fld/gil_0604.at3 | 72 quadros | modo 1
msgctxt "1111:0"
msgid "  It's a pain getting back up  \nafter finally getting to relax."
msgstr "É um saco ter de levantar\ndepois de enfim relaxar."

#. cv/btl/gil_1616.at3 | 58 quadros | modo 1
msgctxt "1112:0"
msgid "That enemy was nothing for us."
msgstr "Esse inimigo não era nada pra nós."

#. cv/btl/tam_1711.at3 | 90 quadros | modo 1
msgctxt "1113:0"
msgid "Ouch… I'm sorry for being\n  such a glass cannon～  "
msgstr "Ai… Desculpa, bato forte,\nmas quebro fácil～"

#. cv/btl/gaw2_1200_edit.at3 | 55 quadros | modo 1
msgctxt "1114:1"
msgid "Hurry up and…"
msgstr "Ande logo e…"

#. cv/btl/gaw2_1200_edit.at3 | 30 quadros | modo 1
msgctxt "1114:2"
msgid "PAY ALREADY!"
msgstr "PAGUE DE UMA VEZ!"

#. cv/fld/gil_0105.at3 | 68 quadros | modo 2
msgctxt "1115:0"
msgid "Don't ask me questions you know the answer to!"
msgstr "Não me faças perguntas cuja resposta já sabes!"

#. cv/fld/gil_0105.at3 | 100 quadros | modo 2
msgctxt "1115:1"
msgid "My weak point is clearly that I have no faults!"
msgstr "Meu ponto fraco é claramente não ter defeitos!"

#. cv/btl/ner_1900_mix.at3 | 160 quadros | modo 1
msgctxt "1116:0"
msgid "…hmm, having both outfits be red makes you\n             really stand out.             "
msgstr "…hum, de vermelho dos pés à cabeça,\nvocê chama mesmo a atenção."

#. cv/btl/ner_1900_mix.at3 | 120 quadros | modo 1
msgctxt "1116:1"
msgid "    WAIT!? Could they be    \na couple matching outfits!?"
msgstr "ESPERA!? Será que são\nroupas combinando de casal!?"

#. cv/btl/ner_1900_mix.at3 | 116 quadros | modo 1
msgctxt "1116:2"
msgid "No we're not!! It's just a coincidence,\n            a coincidence!            "
msgstr "Não somos um casal!! É coincidência,\ncoincidência!"

#. cv/btl/ner_1900_mix.at3 | 138 quadros | modo 1
msgctxt "1116:3"
msgid "I can't tell if she's strong or an idiot.\n     She's a hard Saber to follow…     "
msgstr "Não sei se ela é forte ou idiota.\nQue Saber difícil de acompanhar…"

#. cv/btl/ner_1601.at3 | 58 quadros | modo 1
msgctxt "1117:0"
msgid "What splendid commands you gave."
msgstr "Que ordens esplêndidas."

#. cv/btl/mll_1200_edit.at3 | 30 quadros | modo 1
msgctxt "1118:1"
msgid "I'm not through yet."
msgstr "Ainda não terminei."

#. cv/btl/mll_1200_edit.at3 | 26 quadros | modo 1
msgctxt "1118:2"
msgid "Disappear!"
msgstr "Desapareça!"

#. cv/btl/rob_1752.at3 | 133 quadros | modo 1
msgctxt "1119:0"
msgid "The line's cast, now to wait for a bite."
msgstr "Linha lançada. Agora é esperar morder a isca."

#. cv/fld/ner_0631.at3 | 68 quadros | modo 1
msgctxt "1120:0"
msgid "I-it's a bit avant-garde…"
msgstr "É-é meio vanguardista…"

#. cv/btl/emi_1241_edit.at3 | 72 quadros | modo 1
msgctxt "1121:1"
msgid "Triple-linked crane wings… Drive in!"
msgstr "Asas Triplas da Garça… Avancem!"

#. cv/fld/psl_0107.at3 | 190 quadros | modo 2
msgctxt "1122:0"
msgid "I like everything about them, but I really like their hands."
msgstr "Gosto de tudo nessa pessoa, mas principalmente das mãos."

#. cv/fld/psl_0107.at3 | 133 quadros | modo 2
msgctxt "1122:1"
msgid "I'd love to hold their hand or have them pat my head…"
msgstr "Queria segurar sua mão ou receber um carinho na cabeça…"

#. cv/btl/kia_1750.at3 | 172 quadros | modo 1
msgctxt "1123:0"
msgid "Being a god has its downsides, too…\n      None stand as your equal.      "
msgstr "Ser uma divindade também tem suas\ndesvantagens… Ninguém se iguala a você."

#. cv/fld/mks_0104.at3 | 134 quadros | modo 2
msgctxt "1124:0"
msgid "The original is from Japan, but I'm an authentic,"
msgstr "A original é do Japão, mas eu sou"

#. cv/fld/mks_0104.at3 | 114 quadros | modo 2
msgctxt "1124:1"
msgid "100%, always was, always have been resident of the Moon."
msgstr "da Lua de verdade. Cem por cento, desde sempre."

#. cv/btl/ner_1805.at3 | 132 quadros | modo 1
msgctxt "1125:0"
msgid "How dull. I can't be motivated\n   on stage against *that*.   "
msgstr "Que tédio. Como me animar no palco\ncontra uma coisa dessas?"

#. cv/btl/tam_1704.at3 | 106 quadros | modo 1
msgctxt "1126:0"
msgid "I'm free to burn or cut them as\n  I see fit after this, right?  "
msgstr "Depois eu posso queimar ou cortar\nà vontade, né?"

#. cv/fld/psl_0106.at3 | 98 quadros | modo 2
msgctxt "1127:0"
msgid "April 10th. That's what I decided on just now!"
msgstr "10 de abril. Foi o que decidi agora há pouco!"

#. cv/btl/ner_1200_edit.at3 | 40 quadros | modo 1
msgctxt "1128:0"
msgid "Wounds of the saint!"
msgstr "Feridas do santo!"

#. cv/btl/tam_1400.at3 | 55 quadros | modo 1
msgctxt "1129:0"
msgid "Tamamo, down～!"
msgstr "Tamamo, fora de combate～!"

#. cv/btl/adl_1755.at3 | 110 quadros | modo 1
msgctxt "1130:0"
msgid "    What's wrong? If you fall now,    \nthen consider this story's finale writ!"
msgstr "O que houve? Se cair agora,\no desfecho desta história já está escrito!"

#. cv/btl/ner_1705.at3 | 33 quadros | modo 1
msgctxt "1131:0"
msgid "How precious."
msgstr "Que preciosidade."

#. cv/fld/ran_0102.at3 | 126 quadros | modo 2
msgctxt "1132:0"
msgid "45kg. I might be a bit on the slender side,"
msgstr "45 kg. Talvez eu seja um pouco esguia,"

#. cv/fld/ran_0102.at3 | 72 quadros | modo 2
msgctxt "1132:1"
msgid "but it does not cause me any operational hindrance."
msgstr "mas isso não prejudica minhas funções."

#. cv/btl/emi3_1090.at3 | 24 quadros | modo 1
msgctxt "1133:0"
msgid "Understood, Rin."
msgstr "Entendido, Rin."

#. cv/btl/ner_2015.at3 | 130 quadros | modo 1
msgctxt "1134:0"
msgid "Wha―? We're in a bad position.\n    Feel free to run away.    "
msgstr "O quê―? Estamos em desvantagem.\nPodes fugir, se quiseres."

#. cv/btl/el2_1520.at3 | 42 quadros | modo 1
msgctxt "1135:0"
msgid "You little shit-piggy…!"
msgstr "Seu porquinho de merda…!"

#. se/eb_tam/10 | 28 quadros | modo 1
msgctxt "1136:0"
msgid "Please rest now."
msgstr "Descanse agora, por favor."

#. cv/btl/emi_1715.at3 | 102 quadros | modo 1
msgctxt "1137:0"
msgid "It's okay, let's calm down.\n  We can turn this around.  "
msgstr "Tudo bem, calma.\nPodemos virar isso."

#. cv/btl/twi_1530.at3 | 34 quadros | modo 1
msgctxt "1138:0"
msgid "Well done."
msgstr "Muito bem."

#. se/eb_psl/10 | 38 quadros | modo 1
msgctxt "1139:0"
msgid "Please stop!!"
msgstr "Pare, por favor!!"

#. cv/btl/kia_1220_edit.at3 | 64 quadros | modo 1
msgctxt "1140:1"
msgid "Hehehe, caught you鷙"
msgstr "Hehehe, peguei você鷙"

#. cv/btl/mll_1800.at3 | 72 quadros | modo 1
msgctxt "1141:0"
msgid "Well, shall we dance like we're melting?"
msgstr "Bem, vamos dançar até derreter?"

#. cv/btl/leo_1211_edit.at3 | 42 quadros | modo 1
msgctxt "1142:1"
msgid "I'm ending this now."
msgstr "Vou acabar com isto agora."

#. cv/btl/ner_1233_edit.at3 | 66 quadros | modo 1
msgctxt "1143:1"
msgid "My blade crashes like thunder!"
msgstr "Minha lâmina ressoa como trovão!"

#. cv/btl/adl_1201_edit.at3 | 54 quadros | modo 1
msgctxt "1144:1"
msgid "Go on! Brawl it out, you ninnies!"
msgstr "Vai! Saiam na porrada, seus imbecis!"

#. cv/fld/mll_0104.at3 | 54 quadros | modo 2
msgctxt "1145:0"
msgid "The Far Side of the Moon."
msgstr "O Lado Distante da Lua."

#. cv/fld/mll_0104.at3 | 76 quadros | modo 2
msgctxt "1145:1"
msgid "It's a dreary place. Doesn't even have a doll shop."
msgstr "É um lugar sem graça. Nem loja de bonecas tem."

#. cv/btl/rin2_1520.at3 | 60 quadros | modo 1
msgctxt "1146:0"
msgid "No way, they're crushing us!?"
msgstr "Não pode ser, estão acabando com a gente!?"

#. se/eb_mll/110 | 24 quadros | modo 1
msgctxt "1147:0"
msgid "How weak."
msgstr "Que fraqueza."

#. cv/btl/tam_1701.at3 | 40 quadros | modo 1
msgctxt "1148:0"
msgid "What a rather weak opponent."
msgstr "Que oponente fraquinho."

#. cv/btl/psl_1753.at3 | 130 quadros | modo 1
msgctxt "1149:0"
msgid "WHY!? Why are you running away from me!?"
msgstr "POR quê!? Por que está fugindo de mim!?"

#. cv/btl/emi_1610.at3 | 32 quadros | modo 1
msgctxt "1150:0"
msgid "Ehh, that was passable."
msgstr "É, deu pro gasto."

#. cv/btl/el2_1300_edit.at3 | 96 quadros | modo 1
msgctxt "1151:1"
msgid "      It's time for the last number!      \nI'll bestow upon you a most glorious death!"
msgstr "Hora do último número!\nVou te dar uma morte gloriosa!"

#. cv/btl/tam_1802.at3 | 68 quadros | modo 1
msgctxt "1152:0"
msgid "They're savages inside and out."
msgstr "São selvagens por dentro e por fora."

#. cv/btl/gaw_1230_edit.at3 | 98 quadros | modo 1
msgctxt "1153:0"
msgid "Protect the morning light\n and all that it brings! "
msgstr "Proteja a luz da manhã\ne tudo o que ela traz!"

#. cv/btl/rob_1741.at3 | 152 quadros | modo 1
msgctxt "1154:0"
msgid "Argh, you're really driving me into a corner.\n I might black out from all this excitement! "
msgstr "Argh, tá mesmo me encurralando.\nVou desmaiar de tanta emoção!"

#. cv/btl/gil_2002.at3 | 116 quadros | modo 1
msgctxt "1155:0"
msgid "Be efficient in battle. I don't want to hear\n you complain about wasted resources later. "
msgstr "Poupa recursos na batalha.\nNão quero ouvir reclamações depois."

#. cv/btl/ksk_1511.at3 | 30 quadros | modo 1
msgctxt "1156:0"
msgid "You cheeky little…"
msgstr "Quanta ousadia, sua criaturinha…"

#. cv/fld/mks_0101.at3 | 212 quadros | modo 2
msgctxt "1157:0"
msgid "156cm. I want you to see me from my cutest angle, Senpai～"
msgstr "156 cm. Quero que me veja pelo ângulo mais fofo, Senpai～"

#. cv/fld/mks_0101.at3 | 36 quadros | modo 2
msgctxt "1157:1"
msgid "Just kidding."
msgstr "Brincadeira."

#. cv/btl/emi_1630.at3 | 98 quadros | modo 1
msgctxt "1158:0"
msgid "I've gotten one of my skills back.\n  Please review it before battle.  "
msgstr "Recuperei uma habilidade.\nConfira antes da luta."

#. cv/fld/tam_0101.at3 | 150 quadros | modo 2
msgctxt "1159:0"
msgid "Mikon! With my cute fox ears aside, 160cm."
msgstr "Mikon! Sem contar estas orelhas fofas,\ntenho 1,60 m."

#. cv/fld/tam_0101.at3 | 76 quadros | modo 2
msgctxt "1159:1"
msgid "Head pats! Head pats please!!!"
msgstr "Cafuné! Quero cafuné, por favor!!!"

#. cv/btl/ner_1623.at3 | 112 quadros | modo 1
msgctxt "1160:0"
msgid "Hey. You're not just slacking off, are you?"
msgstr "Ei. Não estás fazendo corpo mole, estás?"

#. cv/btl/psl_1091.at3 | 34 quadros | modo 1
msgctxt "1161:0"
msgid "I won't lose…!"
msgstr "Eu não vou perder…!"

#. cv/btl/emi3_1260_edit.at3 | 56 quadros | modo 1
msgctxt "1162:1"
msgid "Rho Aias!"
msgstr "Rho Aias!"

#. cv/btl/tam_1615.at3 | 102 quadros | modo 1
msgctxt "1163:0"
msgid "Hehe… Were you day dreaming at the end there?"
msgstr "Hehe… Estava no mundo da lua no final?"

#. cv/btl/rin2_1710.at3 | 100 quadros | modo 1
msgctxt "1164:0"
msgid "Not bad… But we're just getting started."
msgstr "Nada mal… Mas estamos só começando."

#. cv/btl/emi_1612.at3 | 65 quadros | modo 1
msgctxt "1165:0"
msgid "With that obstacle gone, let's keep moving."
msgstr "Resolvido o obstáculo, vamos em frente."

#. cv/btl/cuu_1752_mix.at3 | 112 quadros | modo 1
msgctxt "1166:0"
msgid " We're nearing the climax. \nLet's wrap this up, Master!"
msgstr "Estamos chegando ao clímax.\nVamos acabar com isso, Mestre!"

#. cv/btl/cuu_1752_mix.at3 | 96 quadros | modo 1
msgctxt "1166:1"
msgid "Yes, this does feel like the end.\n  I'll leave it to you, Lancer.  "
msgstr "Sim, parece mesmo o fim.\nDeixo com você, Lancer."

#. cv/btl/tam_1301_edit.at3 | 60 quadros | modo 1
msgctxt "1167:0"
msgid "I'll show you my secret technique!"
msgstr "Vou mostrar minha técnica secreta!"

#. cv/btl/tam_1301_edit.at3 | 120 quadros | modo 1
msgctxt "1167:1"
msgid "A deadly curse spreads throughout the\n    world from the Killing Stone.    "
msgstr "Da Pedra Assassina nasce a maldição\nmortal que se espalha pelo mundo."

#. cv/btl/tam_1301_edit.at3 | 72 quadros | modo 1
msgctxt "1167:2"
msgid "The Tamamo Weight Stone will purify it."
msgstr "A Pedra de Lastro de Tamamo vai purificá-la."

#. cv/btl/tam_1301_edit.at3 | 24 quadros | modo 1
msgctxt "1167:3"
msgid "Now!"
msgstr "Agora!"

#. cv/btl/tam_1301_edit.at3 | 24 quadros | modo 1
msgctxt "1167:5"
msgid "Haa!"
msgstr "Haa!"

#. cv/btl/tam_1301_edit.at3 | 100 quadros | modo 1
msgctxt "1167:7"
msgid "I've hereby reformed!"
msgstr "Prontinho! Sou outra pessoa!"

#. cv/btl/tam_1301_edit.at3 | 80 quadros | modo 1
msgctxt "1167:8"
msgid "Now see the pure light of Amaterasu!"
msgstr "Contemple a luz pura de Amaterasu!"

#. cv/btl/el2_1710.at3 | 90 quadros | modo 1
msgctxt "1168:0"
msgid "No! I don't want to lose…!"
msgstr "Não! Eu não quero perder…!"

#. cv/btl/el2_1710.at3 | 60 quadros | modo 1
msgctxt "1168:1"
msgid "I don't want to be locked away…!"
msgstr "Não quero ficar presa…!"

#. cv/btl/ner_2021.at3 | 98 quadros | modo 1
msgctxt "1169:0"
msgid "Don't interrupt my walk to the stage!\n      You'll really tick me off!      "
msgstr "Não interrompas minha entrada no palco!\nNão me irrites!"

#. cv/btl/psl_1700.at3 | 142 quadros | modo 1
msgctxt "1170:0"
msgid "You don't need to be scared, you know?\n      I promise to make it quick!      "
msgstr "Não precisa ter medo, viu?\nPrometo que vai ser rápido!"

#. cv/btl/gaw_1510.at3 | 48 quadros | modo 1
msgctxt "1171:0"
msgid "Argh, clever…"
msgstr "Argh, astuto…"

#. cv/btl/psl_1300.at3 | 100 quadros | modo 1
msgctxt "1172:0"
msgid "Ahh, so this is what love looks like…"
msgstr "Ahh, então é assim que o amor é…"

#. se/eb_emi/8 | 28 quadros | modo 1
msgctxt "1173:0"
msgid "This is the end!"
msgstr "É o fim!"

#. se/eb_tam3/7 | 24 quadros | modo 1
msgctxt "1174:0"
msgid "Rude."
msgstr "Que grosseria."

#. cv/btl/emi3_1110.at3 | 26 quadros | modo 1
msgctxt "1175:0"
msgid "Nice, Rin!"
msgstr "Boa, Rin!"

#. cv/fld/ran_0202.at3 | 90 quadros | modo 2
msgctxt "1176:0"
msgid "There's no such thing as free time."
msgstr "Tempo livre não existe."

#. cv/fld/ran_0202.at3 | 130 quadros | modo 2
msgctxt "1176:1"
msgid "I schedule my hobbies for any unused time for maximum efficiency."
msgstr "Agendo meus passatempos nas horas vagas para máxima eficiência."

#. cv/fld/ran_0202.at3 | 26 quadros | modo 2
msgctxt "1176:2"
msgid "…what?"
msgstr "…o quê?"

#. cv/fld/kia_0107.at3 | 198 quadros | modo 2
msgctxt "1177:0"
msgid "I'm not one to be picky; I answer the desires of my partner."
msgstr "Não sou exigente. Atendo aos desejos de quem está comigo."

#. cv/fld/kia_0107.at3 | 142 quadros | modo 2
msgctxt "1177:1"
msgid "I devote myself to taking in the cravings of their body."
msgstr "Dedico-me a acolher os anseios do corpo dessa pessoa."

#. cv/btl/adl_1700.at3 | 99 quadros | modo 1
msgctxt "1178:0"
msgid "God, this is unbearable! You're a\n        DISGRACE, Kiara!        "
msgstr "Que coisa insuportável! Você é\numa DESGRAÇA, Kiara!"

#. cv/fld/ran_0107.at3 | 172 quadros | modo 2
msgctxt "1179:0"
msgid "I have no perverted tastes. I am a proper homunculus."
msgstr "Não tenho gostos pervertidos. Sou uma homúnculo exemplar."

#. cv/fld/ran_0107.at3 | 116 quadros | modo 2
msgctxt "1179:1"
msgid "I don't feel like my sweat functions are erotic."
msgstr "Não considero erótica a minha função de transpirar."

#. cv/fld/ran_0107.at3 | 50 quadros | modo 2
msgctxt "1179:2"
msgid "Nope. That'd be weird."
msgstr "Não. Seria estranho."

#. cv/btl/mll_1300_edit.at3 | 108 quadros | modo 1
msgctxt "1180:0"
msgid "Will the troublemakers please leave the stage?"
msgstr "Quem está atrapalhando pode sair do palco?"

#. cv/btl/mll_1300_edit.at3 | 74 quadros | modo 1
msgctxt "1180:2"
msgid "Now, resign yourself to the frigid depths."
msgstr "Agora, resigne-se às profundezas geladas."

#. cv/btl/mll_1300_edit.at3 | 64 quadros | modo 1
msgctxt "1180:4"
msgid "Saraswati Meltout."
msgstr "Saraswati Meltout."

#. cv/fld/kot_0092.at3 | 100 quadros | modo 3
msgctxt "1181:0"
msgid "Well then. What do you desire today?"
msgstr "Então. O que deseja hoje?"

#. cv/fld/kot_00929.at3 | 46 quadros | modo 3
msgctxt "1182:0"
msgid "Many thanks, my treasured customer."
msgstr "Muito obrigado, estimada clientela."

#. cv/btl/emi3_1230_edit.at3 | 34 quadros | modo 1
msgctxt "1183:1"
msgid "I'll have you rethink your strategy."
msgstr "Vou fazer você repensar sua estratégia."

#. cv/fld/kot_00917.at3 | 26 quadros | modo 3
msgctxt "1184:0"
msgid "Take it."
msgstr "Pegue."

#. cv/btl/gil_1712.at3 | 38 quadros | modo 1
msgctxt "1185:0"
msgid "You're going to kill me at this rate!"
msgstr "Desse jeito vais acabar me matando!"

#. cv/fld/jin_0103.at3 | 176 quadros | modo 2
msgctxt "1186:0"
msgid "B109/W87/H112. Heh… My body's overloaded～"
msgstr "B109/C87/Q112. Heh… Meu corpo tá em sobrecarga～"

#. cv/btl/tam_1220_edit.at3 | 58 quadros | modo 1
msgctxt "1187:1"
msgid "Hehe, now you're all stiff 薗"
msgstr "Hehe, agora você nem se mexe薗"

#. cv/btl/emi3_1752_mix.at3 | 164 quadros | modo 1
msgctxt "1188:0"
msgid "Archer, do that thing! You know, the whole\n    \"I am the bone of my sword\" thing!    "
msgstr "Archer, faz aquilo! Sabe,\naquela do “sou o osso da minha espada”!"

#. cv/btl/emi3_1752_mix.at3 | 108 quadros | modo 1
msgctxt "1188:1"
msgid "You know, I'm suddenly feeling unmotivated…"
msgstr "Sabe, de repente perdi a vontade…"

#. se/eb_ner/8 | 28 quadros | modo 1
msgctxt "1189:0"
msgid "Away with you!"
msgstr "Vai-te daqui!"

#. cv/btl/gil_1500.at3 | 76 quadros | modo 1
msgctxt "1190:0"
msgid "Excellent. Is this not entertaining, mongrel?"
msgstr "Excelente. Não é divertido, criatura mestiça?"

#. cv/fld/kot_00931.at3 | 110 quadros | modo 3
msgctxt "1191:0"
msgid "Thank you. Now explore the Labyrinth with confidence."
msgstr "Muito obrigado. Agora explore\no Labirinto com confiança."

#. se/eb_emi3/15 | 24 quadros | modo 1
msgctxt "1192:0"
msgid "Damn you!"
msgstr "Maldito!"

#. cv/fld/mll_0101.at3 | 178 quadros | modo 2
msgctxt "1193:0"
msgid "190cm. Yes, really. Do you not see these legs?"
msgstr "190 cm. Sério. Está vendo estas pernas?"

#. cv/fld/mll_0101.at3 | 56 quadros | modo 2
msgctxt "1193:1"
msgid "You're welcome to gaze at them all you'd like."
msgstr "Pode contemplá-las o quanto quiser."

#. se/eb_ksk/9 | 48 quadros | modo 1
msgctxt "1194:0"
msgid "How utterly incompetent."
msgstr "Quanta incompetência."

#. cv/fld/emi_0104.at3 | 162 quadros | modo 2
msgctxt "1195:0"
msgid "B97/W81/H96."
msgstr "P97/C81/Q96."

#. cv/fld/emi_0104.at3 | 106 quadros | modo 2
msgctxt "1195:1"
msgid "Just wondering, but why are you asking a guy for his 3 sizes?"
msgstr "Por curiosidade, por que pedir as três medidas de um homem?"

#. cv/btl/eli_1756_mix.at3 | 46 quadros | modo 1
msgctxt "1196:0"
msgid "Now's the optimal timing."
msgstr "Este é o momento ideal."

#. cv/btl/eli_1756_mix.at3 | 100 quadros | modo 1
msgctxt "1196:1"
msgid "Okay! Time for the grand finale!"
msgstr "Certo! Hora do gran finale!"

#. cv/btl/eli_1101.at3 | 38 quadros | modo 1
msgctxt "1197:0"
msgid "Thank you, Rin."
msgstr "Obrigada, Rin."

#. cv/btl/emi_1611.at3 | 46 quadros | modo 1
msgctxt "1198:0"
msgid "Seems like your intuition is\n    slowly getting there.    "
msgstr "Parece que sua intuição está melhorando."

#. cv/btl/kia_1520.at3 | 64 quadros | modo 1
msgctxt "1199:0"
msgid "You're making me shudder to my core鷙"
msgstr "Você me faz tremer por inteiro鷙"

#. cv/btl/gil_1700.at3 | 110 quadros | modo 1
msgctxt "1200:0"
msgid "What an atrocious battle,\nit's putting me to sleep."
msgstr "Que luta atroz, está me dando sono."

#. cv/btl/elp_1801.at3 | 70 quadros | modo 1
msgctxt "1201:0"
msgid "I'll leave the stage directions to you,\n              Master 鷙!              "
msgstr "A direção do show fica com você, Mestre鷙!"

#. cv/btl/sin_1210_edit.at3 | 52 quadros | modo 1
msgctxt "1202:1"
msgid "Have a taste of bad luck!"
msgstr "Experimente um pouco de azar!"

#. cv/btl/jin_1710.at3 | 96 quadros | modo 1
msgctxt "1203:0"
msgid "Uh oh. I'm getting the sense I'm stuck\n          on a bad ending…          "
msgstr "Ih. Tô achando que caí num Bad End…"

#. cv/fld/ner_0600.at3 | 104 quadros | modo 1
msgctxt "1204:0"
msgid "Whew… The fatigue all comes out at once when\n                you get home…                "
msgstr "Ufa… O cansaço bate todo de uma vez\nquando voltamos para casa…"

#. cv/btl/ner_1622.at3 | 112 quadros | modo 1
msgctxt "1205:0"
msgid "U-umu. Just forget about that, okay?"
msgstr "U-umu. Esquece isso, está bem?"

#. se/eb_gil/27 | 28 quadros | modo 1
msgctxt "1206:0"
msgid "Damn you!"
msgstr "Maldito!"

#. se/eb_elp/8 | 24 quadros | modo 1
msgctxt "1207:0"
msgid "What!?"
msgstr "O quê!?"

#. cv/btl/ner_2004.at3 | 24 quadros | modo 1
msgctxt "1208:0"
msgid "I'll scatter you!"
msgstr "Vou te reduzir a pedaços!"

#. cv/btl/mll_1110.at3 | 23 quadros | modo 1
msgctxt "1209:0"
msgid "You won't get away!"
msgstr "Você não vai escapar!"

#. cv/fld/kot_00927.at3 | 42 quadros | modo 3
msgctxt "1210:0"
msgid "Take care."
msgstr "Cuide-se."

#. se/eb_ksk/10 | 24 quadros | modo 1
msgctxt "1211:0"
msgid "There."
msgstr "Pronto."

#. cv/btl/gil_1092.at3 | 38 quadros | modo 1
msgctxt "1212:0"
msgid "Don't fold too quickly now."
msgstr "Não cedas tão depressa agora."

#. cv/btl/elp_1120.at3 | 98 quadros | modo 1
msgctxt "1213:0"
msgid "I can't let myself fall when my\n        Master needs me!        "
msgstr "Não posso cair quando\nmeu Mestre precisa de mim!"

#. cv/btl/kar_1800.at3 | 116 quadros | modo 1
msgctxt "1214:0"
msgid "What bothersome karma. Is this even\n  worth risking one's life over?  "
msgstr "Que carma incômodo.\nVale mesmo a pena arriscar a vida por isso?"

#. cv/btl/sin_1700.at3 | 114 quadros | modo 1
msgctxt "1215:0"
msgid "Another grand invention, as expected\n        from yours truly～        "
msgstr "Mais uma grande invenção,\ncomo era de esperar do gênio aqui～"

#. cv/btl/eli_1210_edit.at3 | 46 quadros | modo 1
msgctxt "1216:0"
msgid "Just try getting through these scales!"
msgstr "Tenta atravessar essas escamas!"

#. cv/btl/gil_1631.at3 | 76 quadros | modo 1
msgctxt "1217:0"
msgid "My current arsenal didn't quite\n      feel up to the task.      "
msgstr "Meu arsenal atual não pareceu\nà altura da tarefa."

#. cv/btl/psl_1100.at3 | 36 quadros | modo 1
msgctxt "1218:0"
msgid "Thank you so much!!"
msgstr "Muito obrigada!!"

#. cv/btl/ran_1200_edit.at3 | 44 quadros | modo 1
msgctxt "1219:0"
msgid "Femininity, up."
msgstr "Feminilidade, aumentar."

#. cv/btl/ner_1711.at3 | 40 quadros | modo 1
msgctxt "1220:0"
msgid "Ugh, this is boring me!"
msgstr "Argh, que tédio!"

#. cv/btl/eli_1110.at3 | 23 quadros | modo 1
msgctxt "1221:0"
msgid "Rock on!"
msgstr "Rock na veia!"

#. cv/btl/ner_1840_mix.at3 | 156 quadros | modo 1
msgctxt "1222:0"
msgid "A lust for glory ends only in\n    one's own destruction.    "
msgstr "A sede de glória só acaba\nna própria destruição."

#. cv/btl/ner_1840_mix.at3 | 150 quadros | modo 1
msgctxt "1222:1"
msgid "Your reign of flowers has come to an end.\n      Go and meet the fourth sunset.      "
msgstr "Teu reinado de flores acabou.\nVai ao encontro do quarto pôr do sol."

#. cv/btl/ner_1840_mix.at3 | 128 quadros | modo 1
msgctxt "1222:2"
msgid "Ha! What nonsense comes from the\n       avatar of the sun!       "
msgstr "Ha! Que tolice, vinda do avatar do Sol!"

#. cv/btl/ner_1840_mix.at3 | 88 quadros | modo 1
msgctxt "1222:3"
msgid "Does the sun not always rise again?"
msgstr "O Sol não volta sempre a nascer?"

#. cv/btl/ner_1840_mix.at3 | 140 quadros | modo 1
msgctxt "1222:4"
msgid "    As long as my Praetor calls me,    \nI'll keep coming back, even from ashes!"
msgstr "Enquanto meu Maestro me chamar,\nvoltarei até das cinzas!"

#. cv/btl/elp_1231_edit.at3 | 48 quadros | modo 1
msgctxt "1223:1"
msgid "You leave yourself wide open!"
msgstr "Você baixou a guarda!"

#. cv/btl/mll_1752.at3 | 60 quadros | modo 1
msgctxt "1224:0"
msgid "It's time for the grand finale."
msgstr "Chegou a hora do gran finale."

#. cv/btl/tam_1261_edit.at3 | 86 quadros | modo 1
msgctxt "1225:1"
msgid "Please suffer for eternity～"
msgstr "Sofra pela eternidade, por favor～"

#. se/eb_emi/18 | 24 quadros | modo 1
msgctxt "1226:0"
msgid "Excuse me."
msgstr "Com licença."

#. cv/btl/el2_1521.at3 | 44 quadros | modo 1
msgctxt "1227:0"
msgid "No way, they might beat me!"
msgstr "Não pode ser, eles podem me vencer!"

#. cv/btl/tam_1241_edit.at3 | 70 quadros | modo 1
msgctxt "1228:1"
msgid "Not holding back is my true power鷙"
msgstr "Meu poder de verdade é sem me conter鷙"

#. cv/fld/eli_0105.at3 | 94 quadros | modo 2
msgctxt "1229:0"
msgid "I won't forgive you if you see my reverse scale!"
msgstr "Não vou perdoar se vir minha escama invertida!"

#. cv/fld/eli_0105.at3 | 134 quadros | modo 2
msgctxt "1229:1"
msgid "I'll meticulously stab you, crush your limbs, wring you out,"
msgstr "Vou te perfurar com cuidado, esmagar braços e pernas,"

#. cv/fld/eli_0105.at3 | 96 quadros | modo 2
msgctxt "1229:2"
msgid "then… make you take responsibility and marry me!"
msgstr "torcer você… Depois vai assumir\na responsabilidade e casar comigo!"

#. cv/btl/eli_1260_edit.at3 | 82 quadros | modo 1
msgctxt "1230:0"
msgid "Fine. It's embarrassing, but I'll show you!"
msgstr "Tá bom. Dá vergonha, mas vou mostrar!"

#. cv/fld/psl_0201.at3 | 156 quadros | modo 2
msgctxt "1231:0"
msgid "Pink is really cute… H-huh? Y-yes, I wear panties…"
msgstr "Rosa é tão fofo… H-hã? S-sim, eu uso calcinha…"

#. cv/btl/ner_1610_a.at3 | 50 quadros | modo 1
msgctxt "1232:0"
msgid "We can work a bit harder next time."
msgstr "Podemos nos esforçar mais da próxima vez."

#. cv/btl/tam_1210_edit.at3 | 52 quadros | modo 1
msgctxt "1233:1"
msgid "Let me bring you to the ritual flames."
msgstr "Vou levar você às chamas do ritual."

#. cv/btl/sal_1110.at3 | 38 quadros | modo 1
msgctxt "1234:0"
msgid "Could you die already?"
msgstr "Dá pra morrer logo?"

#. cv/btl/kar_1752_mix_a.at3 | 90 quadros | modo 1
msgctxt "1235:0"
msgid "This is the critical moment, Master.\n          Shall I use it?          "
msgstr "Este é o momento decisivo, Mestra.\nDevo usá-lo?"

#. cv/btl/kar_1752_mix_a.at3 | 76 quadros | modo 1
msgctxt "1235:1"
msgid "Y-yes! Mow them down!!"
msgstr "S-sim! Acaba com eles!!"

#. cv/fld/ner_0107.at3 | 86 quadros | modo 2
msgctxt "1236:0"
msgid "I'm unable to give just a single one!"
msgstr "Não consigo escolher uma só pessoa!"

#. cv/fld/ner_0107.at3 | 64 quadros | modo 2
msgctxt "1236:1"
msgid "That's like the whole point of a harem!!"
msgstr "É pra isso que serve um harém!!"

#. cv/btl/elp_1610.at3 | 53 quadros | modo 1
msgctxt "1237:0"
msgid "The two of us are going places!"
msgstr "Nós dois vamos longe!"

#. cv/btl/tam_2006.at3 | 58 quadros | modo 1
msgctxt "1238:0"
msgid "This is where we forge an opening."
msgstr "É agora que a gente abre uma brecha."

#. cv/btl/tam3_1753_mix.at3 | 114 quadros | modo 1
msgctxt "1239:0"
msgid "          I'm surprised.          \nHow'd they manage to survive that…"
msgstr "Que surpresa.\nComo conseguiram sobreviver…?"

#. cv/btl/tam3_1753_mix.at3 | 154 quadros | modo 1
msgctxt "1239:1"
msgid "I-I'm sorry. They've greatly\ndisgraced me with that one…"
msgstr "D-desculpe. Foi uma grande humilhação…"

#. cv/btl/ner_1120.at3 | 62 quadros | modo 1
msgctxt "1240:0"
msgid "I can't die and leave you behind…"
msgstr "Não posso morrer e te deixar para trás…"

#. cv/btl/emi_1260_edit.at3 | 26 quadros | modo 1
msgctxt "1241:1"
msgid "Protect us!"
msgstr "Proteja-nos!"

#. cv/fld/kot_00928.at3 | 68 quadros | modo 3
msgctxt "1242:0"
msgid "I wish you'd value my store a bit more…"
msgstr "Queria que desse um pouco\nmais de valor à minha loja…"

#. cv/btl/gil_1630.at3 | 122 quadros | modo 1
msgctxt "1243:0"
msgid "Fine. I'll give you access to\n    more of my treasures.    "
msgstr "Pois bem. Vou liberar mais dos meus tesouros."

#. cv/btl/tam_1900_mix.at3 | 140 quadros | modo 1
msgctxt "1244:0"
msgid "Hehehe… Putting the side quest part aside,\n     this might be a good opportunity.     "
msgstr "Hehehe… Missão secundária à parte,\nesta pode ser uma boa oportunidade."

#. cv/btl/tam_1900_mix.at3 | 64 quadros | modo 1
msgctxt "1244:1"
msgid "Hey you, Archy-boy over there?"
msgstr "Ei, garotinho Archer!"

#. cv/btl/tam_1900_mix.at3 | 130 quadros | modo 1
msgctxt "1244:2"
msgid "Let me discipline you to my heart's content,\n                  okay? 鷙                  "
msgstr "Vou te dar uma boa lição,\naté me dar por satisfeita, viu? 鷙"

#. cv/btl/tam_1900_mix.at3 | 140 quadros | modo 1
msgctxt "1244:3"
msgid "What evil magical energy…\n    Be careful Archer!    "
msgstr "Que energia mágica maligna…\nCuidado, Archer!"

#. cv/btl/tam_1900_mix.at3 | 88 quadros | modo 1
msgctxt "1244:4"
msgid "That servant is rotten to the core!"
msgstr "Essa Serva é podre até o âmago!"

#. cv/btl/psl_1211_edit.at3 | 74 quadros | modo 1
msgctxt "1245:1"
msgid "Die… Die… Die…!"
msgstr "Morra… Morra… Morra…!"

#. cv/btl/tam_1621.at3 | 124 quadros | modo 1
msgctxt "1246:0"
msgid "Master, that wasn't on purpose, right…?\n    Of course not, that'd be silly.    "
msgstr "Mestre, foi sem querer, né…?\nClaro que foi. Que bobagem a minha."

#. cv/btl/kar_1100.at3 | 24 quadros | modo 1
msgctxt "1247:0"
msgid "Savage…!"
msgstr "Que ferocidade…!"

#. cv/fld/kot_00913.at3 | 132 quadros | modo 3
msgctxt "1248:0"
msgid "Ah Gilgamesh, I welcome a man in cuneiform!"
msgstr "Ah, Gilgamesh. Um homem\ndigno da escrita cuneiforme!"

#. se/eb_el2/4 | 40 quadros | modo 1
msgctxt "1249:0"
msgid "Every last one of you!!"
msgstr "Todinhos vocês!!"

#. cv/btl/gil_1614.at3 | 58 quadros | modo 1
msgctxt "1250:0"
msgid "They gave us a hard time, didn't they?"
msgstr "Até que nos deram trabalho, não deram?"

#. cv/btl/tam3_1260_edit.at3 | 122 quadros | modo 1
msgctxt "1251:0"
msgid "Now scatter, flower of heaven's grudge,\n    eternally blooming and tearing.    "
msgstr "Espalhe-se, flor do rancor celeste,\na florescer e dilacerar pela eternidade."

#. cv/btl/tam3_1260_edit.at3 | 50 quadros | modo 1
msgctxt "1251:1"
msgid "Land of Eternal Bane!"
msgstr "Terra da Maldição Eterna!"

#. se/eb_gil/11 | 32 quadros | modo 1
msgctxt "1252:0"
msgid "You damn fool."
msgstr "Seu maldito tolo."

#. cv/btl/el2_1231_edit.at3 | 38 quadros | modo 1
msgctxt "1253:0"
msgid "THINK YOU CAN DODGE THIS!?"
msgstr "ACHA QUE CONSEGUE DESVIAR!?"

#. cv/btl/elp_1932.at3 | 120 quadros | modo 1
msgctxt "1254:0"
msgid "  Orders please, Master.  \nLet me prove myself to you!"
msgstr "As ordens, por favor! Quero provar meu valor!"

#. cv/btl/kot_1530.at3 | 28 quadros | modo 1
msgctxt "1255:0"
msgid "Too bad."
msgstr "Que pena."

#. cv/btl/ksk_1710.at3 | 107 quadros | modo 1
msgctxt "1256:0"
msgid "Unthinkable… The Moon Cell can't\n      possibly be losing…!      "
msgstr "Inconcebível… O Moon Cell\nnão pode estar perdendo…!"

#. cv/btl/gil_1111.at3 | 28 quadros | modo 1
msgctxt "1257:0"
msgid "There you are!"
msgstr "Aí estás!"

#. cv/btl/kar_1520.at3 | 34 quadros | modo 1
msgctxt "1258:0"
msgid "You slipped through my defenses…!"
msgstr "Passou pelas minhas defesas…!"

#. cv/btl/ner_1232_edit.at3 | 54 quadros | modo 1
msgctxt "1259:1"
msgid "Pari Tenu Blauserum!"
msgstr "Pari Tenu Blauserum!"

#. cv/btl/kar_1521.at3 | 32 quadros | modo 1
msgctxt "1260:0"
msgid "Exceptional…!"
msgstr "Excepcional…!"

#. cv/btl/elp_2000.at3 | 30 quadros | modo 1
msgctxt "1261:0"
msgid "I'll spin them right 'round!"
msgstr "Vou botar todos pra rodar!"

#. cv/fld/tam_0601.at3 | 54 quadros | modo 1
msgctxt "1262:0"
msgid "Shall we rest up a bit?"
msgstr "Vamos descansar um pouquinho?"

#. cv/fld/psl_0200.at3 | 94 quadros | modo 2
msgctxt "1263:0"
msgid "I'd like to be treated with lots of care."
msgstr "Queria que me tratasse com todo cuidado."

#. cv/fld/psl_0200.at3 | 86 quadros | modo 2
msgctxt "1263:1"
msgid "Being cherished by someone would make me really happy!"
msgstr "Ser querida por alguém me faria muito feliz!"

#. cv/btl/kar_1101.at3 | 40 quadros | modo 1
msgctxt "1264:0"
msgid "Comic… duo."
msgstr "Uma dupla… cômica."

#. cv/btl/mll_1400.at3 | 116 quadros | modo 1
msgctxt "1265:0"
msgid "This… can't be happening… can it?"
msgstr "Isto… não pode estar acontecendo… pode?"

#. cv/btl/emi_1741.at3 | 70 quadros | modo 1
msgctxt "1266:0"
msgid "You actually on a \"diet\"?"
msgstr "É sério que você tá de “dieta”?"

#. cv/btl/emi_1741.at3 | 90 quadros | modo 1
msgctxt "1266:1"
msgid "You realize that \"gourmet\" doesn't mean\n            \"gorge,\" right?            "
msgstr "Você sabe que “gourmet”\nnão quer dizer “glutona”, né?"

#. cv/btl/kar_1221_edit.at3 | 70 quadros | modo 1
msgctxt "1267:0"
msgid "Grant me your curse!"
msgstr "Conceda-me sua maldição!"

#. cv/btl/kar_1221_edit.at3 | 80 quadros | modo 1
msgctxt "1267:1"
msgid "Brahmastra Kundala!"
msgstr "Brahmastra Kundala!"

#. se/eb_gil/9 | 38 quadros | modo 1
msgctxt "1268:0"
msgid "How foolish of you!"
msgstr "Que tolice a tua!"

#. cv/btl/kot_1800.at3 | 40 quadros | modo 1
msgctxt "1269:0"
msgid "It's time to repent."
msgstr "É hora de se arrepender."

#. cv/btl/rin2_1510.at3 | 42 quadros | modo 1
msgctxt "1270:0"
msgid "Sorry, hang in there, Archer!"
msgstr "Foi mal! Aguenta firme, Archer!"

#. cv/fld/jin_0202.at3 | 180 quadros | modo 2
msgctxt "1271:0"
msgid "Nonstop holiday all year round. All the games and net I can take!"
msgstr "Férias o ano inteiro. Jogo e internet até dizer chega!"

#. cv/fld/kot_00914.at3 | 108 quadros | modo 3
msgctxt "1272:0"
msgid "I'm absolutely blown away, AUO."
msgstr "Estou absolutamente impressionado, AUO."

#. cv/fld/kot_00914.at3 | 82 quadros | modo 3
msgctxt "1272:1"
msgid "I didn't expect you to be so kind to my shop."
msgstr "Não esperava tamanha bondade com minha loja."

#. cv/btl/tam_1741.at3 | 140 quadros | modo 1
msgctxt "1273:0"
msgid "Geh. It's not just her appearance, even her\n            weapon is spikey!!            "
msgstr "Aff. Já não bastava a aparência,\naté a arma dela tem espinhos!!"

#. cv/btl/tam_1741.at3 | 86 quadros | modo 1
msgctxt "1273:1"
msgid "She really is going to be a genuine pain\n    in the ass Servant, isn't she…    "
msgstr "Essa Serva vai ser um pé no saco mesmo…"

#. cv/fld/rin_0102.at3 | 114 quadros | modo 2
msgctxt "1274:0"
msgid "48kg. Nice balance, don't you think?"
msgstr "48 kg. Um bom equilíbrio, não acha?"

#. cv/fld/rin_0102.at3 | 84 quadros | modo 2
msgctxt "1274:1"
msgid "I had to stay in shape while with the Middle East resistance."
msgstr "Tinha que me manter em forma na resistência do Oriente Médio."

#. cv/btl/cuu_1110.at3 | 24 quadros | modo 1
msgctxt "1275:0"
msgid "Don't leave yet!"
msgstr "Não vá embora ainda!"

#. cv/btl/gil_1210_edit.at3 | 62 quadros | modo 1
msgctxt "1276:0"
msgid "My resolve is inexhaustible."
msgstr "Minha determinação é inesgotável."

#. cv/btl/jin_1530.at3 | 38 quadros | modo 1
msgctxt "1277:0"
msgid "Perfect combo!"
msgstr "Combo perfeito!"

#. cv/btl/ner_1093.at3 | 44 quadros | modo 1
msgctxt "1278:0"
msgid "Let's win, and win grand!"
msgstr "Vamos vencer em grande estilo!"

#. cv/btl/emi_1870_mix.at3 | 186 quadros | modo 1
msgctxt "1279:0"
msgid "  Love is something that fades over time.  \nYour wish for eternity can never be granted."
msgstr "O amor se apaga com o tempo.\nSeu desejo de eternidade nunca se realizará."

#. cv/btl/emi_1870_mix.at3 | 100 quadros | modo 1
msgctxt "1279:1"
msgid "I'll end that dream of yours with\n          my own hands.          "
msgstr "Vou acabar com esse sonho\ncom minhas próprias mãos."

#. cv/btl/emi_1870_mix.at3 | 100 quadros | modo 1
msgctxt "1279:2"
msgid "I was going to let you live since you had\n        some redeeming qualities,        "
msgstr "Eu ia poupar sua vida.\nVocê até tinha algumas qualidades."

#. cv/btl/emi_1870_mix.at3 | 86 quadros | modo 1
msgctxt "1279:3"
msgid "but you just had to be cocky, didn't you?"
msgstr "Mas tinha que se achar, não tinha?"

#. cv/btl/emi_1870_mix.at3 | 94 quadros | modo 1
msgctxt "1279:4"
msgid "Fine. I'll have you disappear, Archer!"
msgstr "Pois bem. Vou fazer você sumir, Archer!"

#. cv/btl/kar_1080.at3 | 24 quadros | modo 1
msgctxt "1280:0"
msgid "Not bad."
msgstr "Nada mal."

#. se/eb_ner/19 | 40 quadros | modo 1
msgctxt "1281:0"
msgid "Don't test me!"
msgstr "Não me ponhas à prova!"

#. cv/fld/tam_0605.at3 | 70 quadros | modo 1
msgctxt "1282:0"
msgid "Welcome home, Darling."
msgstr "Que bom que voltou, meu bem."

#. cv/btl/eli_1510.at3 | 42 quadros | modo 1
msgctxt "1283:0"
msgid "Haa, not bad."
msgstr "Ah, nada mal."

#. cv/fld/ner_0104.at3 | 180 quadros | modo 2
msgctxt "1284:0"
msgid "A glorious place embraced by the seas and where all roads lead!"
msgstr "Um lugar glorioso abraçado pelos\nmares, onde todos os caminhos chegam!"

#. cv/fld/ner_0104.at3 | 154 quadros | modo 2
msgctxt "1284:1"
msgid "The City of Flowers where I rule, that is to say,"
msgstr "A Cidade das Flores, onde reino. Ou seja,"

#. cv/fld/ner_0104.at3 | 48 quadros | modo 2
msgctxt "1284:2"
msgid "the capital city of Rome!"
msgstr "Roma, a capital!"

#. cv/fld/emi_0102.at3 | 132 quadros | modo 2
msgctxt "1285:0"
msgid "187cm. I'm a bit on the tall side,"
msgstr "187 cm. Sou um pouco alto,"

#. cv/fld/emi_0102.at3 | 120 quadros | modo 2
msgctxt "1285:1"
msgid "but not compared to some colossal servants out there."
msgstr "mas nada perto de alguns Servos colossais."

#. cv/fld/emi_0102.at3 | 90 quadros | modo 2
msgctxt "1285:2"
msgid "I don't really see myself as that tall, personally."
msgstr "Pessoalmente, não me acho tão alto assim."

#. cv/btl/rob_1200_edit.at3 | 54 quadros | modo 1
msgctxt "1286:1"
msgid "Heads up, explosion incoming!"
msgstr "Cuidado, vai explodir!"

#. cv/btl/ner_2060.at3 | 60 quadros | modo 1
msgctxt "1287:0"
msgid "Read the mood!"
msgstr "Aprende a ler o ambiente!"

#. cv/btl/ner_2060.at3 | 64 quadros | modo 1
msgctxt "1287:1"
msgid "We're in the middle of a date, you idiot."
msgstr "Estamos num encontro, idiota."

#. cv/fld/jin_0106.at3 | 144 quadros | modo 2
msgctxt "1288:0"
msgid "November 3rd. I'm around… 20 years old, yeah."
msgstr "3 de novembro. Tenho uns… 20 anos, sim."

#. se/eb_ksk/4 | 24 quadros | modo 1
msgctxt "1289:0"
msgid "Futile."
msgstr "Inútil."

#. cv/btl/ner_1714.at3 | 48 quadros | modo 1
msgctxt "1290:0"
msgid "As long as I have you…"
msgstr "Contanto que eu tenha a ti…"

#. cv/btl/twi_1520.at3 | 62 quadros | modo 1
msgctxt "1291:0"
msgid "They read our every move."
msgstr "Previram todos os nossos movimentos."

#. cv/btl/emi_1712a.at3 | 64 quadros | modo 1
msgctxt "1292:0"
msgid "You're more out of practice than I thought."
msgstr "Está mais sem prática do que eu pensava."

#. cv/fld/emi_0621.at3 | 53 quadros | modo 1
msgctxt "1293:0"
msgid "Well, I guess it's alright."
msgstr "Bem, até que está bom."

#. cv/btl/ran_1210_edit.at3 | 53 quadros | modo 1
msgctxt "1294:1"
msgid "Training is recommended."
msgstr "Recomendo treinamento."

#. cv/btl/psl_1400.at3 | 92 quadros | modo 1
msgctxt "1295:0"
msgid "A-ahhh… ahhhhhh…"
msgstr "A-ahhh… ahhhhhh…"

#. se/eb_psl/6 | 46 quadros | modo 1
msgctxt "1296:0"
msgid "Oh no, I didn't mean to!"
msgstr "Ah, não! Foi sem querer!"

#. cv/btl/ner_1802.at3 | 83 quadros | modo 1
msgctxt "1297:0"
msgid "Hmph… This one looks small time."
msgstr "Humph… Que adversário insignificante."

#. se/eb_ksk/8 | 24 quadros | modo 1
msgctxt "1298:0"
msgid "Disappear."
msgstr "Desapareça."

#. cv/btl/emi_1731.at3 | 56 quadros | modo 1
msgctxt "1299:0"
msgid "The nuclear reactor core is now active."
msgstr "O núcleo do reator nuclear está ativo."

#. cv/btl/emi_1731.at3 | 80 quadros | modo 1
msgctxt "1299:2"
msgid "Let me show you the true\nessence of wrought iron!"
msgstr "Vou mostrar a verdadeira\nessência do ferro forjado!"

#. cv/btl/tam_1614.at3 | 90 quadros | modo 1
msgctxt "1300:0"
msgid "I'll sympathize with you, since you\n      look worse for the wear.      "
msgstr "Vou ter pena de você.\nOlha só o seu estado."

#. cv/btl/cuu_1220_edit.at3 | 38 quadros | modo 1
msgctxt "1301:0"
msgid "There's the second…!"
msgstr "Aí vai a segunda…!"

#. cv/btl/emi_2000.at3 | 34 quadros | modo 1
msgctxt "1302:0"
msgid "Let's make this quick."
msgstr "Vamos resolver isso rápido."

#. cv/btl/sin_1520.at3 | 68 quadros | modo 1
msgctxt "1303:0"
msgid "HEY! Why are you letting them thrash us!?"
msgstr "EI! Por que tá deixando acabarem com a gente!?"

#. cv/fld/tam_0104.at3 | 110 quadros | modo 2
msgctxt "1304:0"
msgid "That's a question that's difficult to answer…"
msgstr "Essa pergunta é difícil de responder…"

#. cv/fld/tam_0104.at3 | 134 quadros | modo 2
msgctxt "1304:1"
msgid "Umm… hmm… can I just say Japan?"
msgstr "Ahn… hum… posso dizer só Japão?"

#. cv/btl/jin_1540.at3 | 66 quadros | modo 1
msgctxt "1305:0"
msgid "Your life belongs to me!"
msgstr "Sua vida é minha!"

#. cv/btl/sin_1710.at3 | 92 quadros | modo 1
msgctxt "1306:0"
msgid "What the hell was I thinking coming up with\n          something like this…?          "
msgstr "Onde eu tava com a cabeça\nquando inventei isso…?"

#. cv/fld/kia_0201.at3 | 188 quadros | modo 2
msgctxt "1307:0"
msgid "I'd say a pure snow white or a bewitching deep black."
msgstr "Diria branco puro como a neve ou preto sedutor e profundo."

#. cv/fld/kia_0201.at3 | 108 quadros | modo 2
msgctxt "1307:1"
msgid "As a woman, I've got to to have at least those in rotation."
msgstr "Como mulher, preciso ter pelo menos essas duas opções."

#. cv/btl/gil_1870_mix.at3 | 90 quadros | modo 1
msgctxt "1308:0"
msgid "You said I was foolish to seek eternity?"
msgstr "Você disse que foi tolice buscar a eternidade?"

#. cv/btl/gil_1870_mix.at3 | 156 quadros | modo 1
msgctxt "1308:1"
msgid "Choice words coming from the man who let\n   eternal youth slip from his grasp.   "
msgstr "Logo você, que deixou a juventude eterna\nescapar por entre os dedos."

#. cv/btl/gil_1870_mix.at3 | 90 quadros | modo 1
msgctxt "1308:2"
msgid "I'll become eternity itself!"
msgstr "Vou me tornar a própria eternidade!"

#. cv/btl/gil_1870_mix.at3 | 124 quadros | modo 1
msgctxt "1308:3"
msgid "Nonsense. Your quest for eternity is not\n            the foolish part.            "
msgstr "Bobagem. Tua busca pela eternidade\nnão é a parte tola."

#. cv/btl/gil_1870_mix.at3 | 120 quadros | modo 1
msgctxt "1308:4"
msgid "Your drive to obtain it is what's so pitiful."
msgstr "O que dá pena é o motivo que te move."

#. cv/btl/gil_1870_mix.at3 | 128 quadros | modo 1
msgctxt "1308:5"
msgid "Only death will convince you that\n  your conviction is misguided.  "
msgstr "Só a morte vai te convencer\nde que tua convicção é um erro."

#. cv/btl/ner_2061.at3 | 138 quadros | modo 1
msgctxt "1309:0"
msgid "You may gaze upon me. For this is a goddess'\n        dress in the color of spring!        "
msgstr "Podes me contemplar. É o vestido\nde uma deusa nas cores da primavera!"

#. cv/btl/tam_1613.at3 | 42 quadros | modo 1
msgctxt "1310:0"
msgid "Shall we hurry on ahead?"
msgstr "Vamos logo em frente?"

#. cv/btl/elp_1400.at3 | 48 quadros | modo 1
msgctxt "1311:0"
msgid "I'm… sorry…"
msgstr "Me… desculpe…"

#. cv/fld/ner_0601.at3 | 40 quadros | modo 1
msgctxt "1312:0"
msgid "Having problems relaxing?"
msgstr "Com dificuldade de relaxar?"

#. cv/btl/emi_1600.at3 | 88 quadros | modo 1
msgctxt "1313:0"
msgid "Well done. You'll get no complaints from me."
msgstr "Bom trabalho. Da minha parte, sem queixas."

#. se/eb_mks/9 | 30 quadros | modo 1
msgctxt "1314:0"
msgid "How scary～"
msgstr "Que medo～"

#. cv/btl/emi3_1240_edit.at3 | 46 quadros | modo 1
msgctxt "1315:1"
msgid "\"Our strength rips through mountains!\""
msgstr "“Nossa força rasga montanhas!”"

#. cv/btl/tam3_1250_edit.at3 | 53 quadros | modo 1
msgctxt "1316:0"
msgid "Spirit of Yin, rise from the imperial tomb."
msgstr "Espírito de Yin, erga-se do túmulo imperial."

#. cv/btl/tam_1100.at3 | 40 quadros | modo 1
msgctxt "1317:0"
msgid "Oh, I'm so happy!!"
msgstr "Ah, que felicidade!!"

#. cv/btl/mll_1210_edit.at3 | 40 quadros | modo 1
msgctxt "1318:1"
msgid "When I melt you, it'll be with love."
msgstr "Vou derreter você com amor."

#. cv/btl/gaw2_1751.at3 | 120 quadros | modo 1
msgctxt "1319:0"
msgid "You have so much power… Why won't you use\n        it to do the right thing!?        "
msgstr "Tem tamanho poder… Por que não o usa\npara fazer o que é certo!?"

#. cv/btl/sal_1750.at3 | 47 quadros | modo 1
msgctxt "1320:0"
msgid "I'll pull you to pieces!"
msgstr "Vou arrancar seus pedaços!"

#. cv/btl/ran_1530.at3 | 40 quadros | modo 1
msgctxt "1321:0"
msgid "This was all within my calculations."
msgstr "Tudo dentro do que calculei."

#. cv/btl/emi3_1092.at3 | 26 quadros | modo 1
msgctxt "1322:0"
msgid "You two look sloppy!"
msgstr "Vocês dois estão dando brecha!"

#. cv/btl/eli_1710.at3 | 80 quadros | modo 1
msgctxt "1323:0"
msgid "Uh oh… I'm not like, in a pinch, am I?"
msgstr "Ai… Eu não tô encrencada, tô?"

#. cv/btl/ner_2000.at3 | 88 quadros | modo 1
msgctxt "1324:0"
msgid "Yes. Fight like it's natural for us to win."
msgstr "Sim. Luta como quem sabe que vai vencer."

#. cv/btl/gil_1741_mix.at3 | 90 quadros | modo 1
msgctxt "1325:0"
msgid "I can't resist playing with my food a little～"
msgstr "Não resisto a brincar um pouco com a comida～"

#. cv/btl/gil_1741_mix.at3 | 96 quadros | modo 1
msgctxt "1325:1"
msgid "Make sure to give me a nice scream, okay?"
msgstr "Quero ouvir um grito bem bonito, tá?"

#. cv/btl/gil_1741_mix.at3 | 124 quadros | modo 1
msgctxt "1325:2"
msgid "The only thing you'll get from me is\na smile as I watch the jesters dance."
msgstr "De mim só terás um sorriso\nenquanto observo a dança dos bufões."

#. cv/btl/gil_1741_mix.at3 | 84 quadros | modo 1
msgctxt "1325:3"
msgid "You'll be the one screaming by the end of this."
msgstr "No fim, vai ser você quem grita."

#. cv/btl/gil_1741_mix.at3 | 124 quadros | modo 1
msgctxt "1325:4"
msgid "Hehe, pretty cocky for a Servant who\n       lost all their levels.       "
msgstr "Hehe, que audácia pra quem perdeu\ntodos os níveis de Servo."

#. cv/btl/gil_1741_mix.at3 | 144 quadros | modo 1
msgctxt "1325:5"
msgid "You'll just have to show me what an\nexperienced Servant like you can do."
msgstr "Vai ter que mostrar do que alguém\ncom sua experiência é capaz."

#. se/eb_psl/7 | 32 quadros | modo 1
msgctxt "1326:0"
msgid "Let me hit you!!"
msgstr "Deixe-me bater em você!!"

#. cv/btl/leo_1530.at3 | 48 quadros | modo 1
msgctxt "1327:0"
msgid "We're hitting her with everything we've got…"
msgstr "Estamos atacando com tudo o que temos…"

#. cv/fld/kot_00912.at3 | 68 quadros | modo 3
msgctxt "1328:0"
msgid "It's time to show off your \"Golden Rule!\""
msgstr "Hora de exibir a sua “Regra de Ouro”!"

#. cv/fld/kot_00912.at3 | 64 quadros | modo 3
msgctxt "1328:1"
msgid "Get that receipt stretching!"
msgstr "Faça esse recibo ficar bem comprido!"

#. cv/btl/adl_1521.at3 | 36 quadros | modo 1
msgctxt "1329:0"
msgid "Is this the best you can do, Kiara?"
msgstr "É só isso que consegue, Kiara?"

#. cv/btl/rob_1100.at3 | 47 quadros | modo 1
msgctxt "1330:0"
msgid "Thanks for the pick up!"
msgstr "Valeu pela força!"

#. cv/btl/psl_1201_edit.at3 | 58 quadros | modo 1
msgctxt "1331:1"
msgid "I-I can't hold it any longer!"
msgstr "N-não consigo segurar mais!"

#. se/eb_psl/8 | 28 quadros | modo 1
msgctxt "1332:0"
msgid "I'll catch you."
msgstr "Vou pegar você."

#. cv/fld/rin_0202.at3 | 102 quadros | modo 2
msgctxt "1333:0"
msgid "Physical and mental relaxation."
msgstr "Relaxar o corpo e a mente."

#. cv/fld/rin_0202.at3 | 104 quadros | modo 2
msgctxt "1333:1"
msgid "If you don't let yourself rest, you'll fall at a critical moment."
msgstr "Sem descanso, você cai bem na hora mais importante."

#. cv/btl/gil_1120.at3 | 48 quadros | modo 1
msgctxt "1334:0"
msgid "You've earned yourself an end in gore…!"
msgstr "Fizeste por merecer um fim sangrento…!"

#. cv/btl/rin_1540.at3 | 30 quadros | modo 1
msgctxt "1335:0"
msgid "Perfect!"
msgstr "Perfeito!"

#. cv/btl/cuu_1520.at3 | 46 quadros | modo 1
msgctxt "1336:0"
msgid "The fuck are you doing, you shitty priest!?"
msgstr "Que porra você tá fazendo, padre de merda!?"

#. cv/btl/tam_2001.at3 | 27 quadros | modo 1
msgctxt "1337:0"
msgid "Let's go!"
msgstr "Vamos lá!"

#. cv/fld/tam_0604.at3 | 47 quadros | modo 1
msgctxt "1338:0"
msgid "We can finally take a breather～"
msgstr "Enfim dá pra respirar um pouco～"

#. cv/btl/elp_1240_edit.at3 | 50 quadros | modo 1
msgctxt "1339:1"
msgid "Direct hit!"
msgstr "Na mosca!"

#. cv/btl/elp_1240_edit.at3 | 42 quadros | modo 1
msgctxt "1339:2"
msgid "Thanks for the delicious meal～鷙"
msgstr "Obrigada pelo banquete～鷙"

#. cv/btl/ksk_1521.at3 | 58 quadros | modo 1
msgctxt "1340:0"
msgid "I won't accept this outcome…!"
msgstr "Não aceito esse resultado…!"

#. cv/fld/emi_0630.at3 | 48 quadros | modo 1
msgctxt "1341:0"
msgid "This feels very fashionable for me."
msgstr "Com isso, até pareço andar na moda."

#. cv/fld/jin_0101.at3 | 128 quadros | modo 2
msgctxt "1342:0"
msgid "153cm. My papa was tall at least…"
msgstr "153 cm. Pelo menos meu pai era alto…"

#. se/eb_sal/7 | 23 quadros | modo 1
msgctxt "1343:0"
msgid "Take that!"
msgstr "Toma!"

#. cv/btl/gil_1613a.at3 | 78 quadros | modo 1
msgctxt "1344:0"
msgid "I told you not to send me close quarters."
msgstr "Eu disse para não me mandar lutar de perto."

#. cv/btl/el2_1200_edit.at3 | 68 quadros | modo 1
msgctxt "1345:0"
msgid "I still have so much killing to do～"
msgstr "Ainda tenho tanta gente pra matar～"

#. cv/btl/ner_1300_edit.at3 | 60 quadros | modo 1
msgctxt "1346:1"
msgid "I offer this flower for your grave."
msgstr "Ofereço esta flor para o teu túmulo."

#. cv/btl/ner_1300_edit.at3 | 98 quadros | modo 1
msgctxt "1346:3"
msgid "The petals dance, and what I cleave are stars!"
msgstr "As pétalas dançam, e eu rasgo as estrelas!"

#. cv/btl/ner_1300_edit.at3 | 50 quadros | modo 1
msgctxt "1346:5"
msgid "THIS is supreme beauty…"
msgstr "ISSO é beleza suprema…"

#. cv/btl/ner_1300_edit.at3 | 58 quadros | modo 1
msgctxt "1346:7"
msgid "Give praise!"
msgstr "Louvem-me!"

#. cv/btl/ner_1300_edit.at3 | 48 quadros | modo 1
msgctxt "1346:8"
msgid "Domus Aurea!"
msgstr "Domus Aurea!"

#. se/eb_mks/7 | 32 quadros | modo 1
msgctxt "1347:0"
msgid "Ready, set…"
msgstr "Preparar, apontar…"

#. cv/fld/mks_0106.at3 | 166 quadros | modo 2
msgctxt "1348:0"
msgid "My birthday is set as March 2nd. I can't wait to see what kind of"
msgstr "Meu aniversário foi definido como 2 de março. Mal posso esperar"

#. cv/fld/mks_0106.at3 | 84 quadros | modo 2
msgctxt "1348:1"
msgid "present my silly Senpai with weird tastes will get me～"
msgstr "pelo presente que vai me dar com esse gosto estranho, Senpai～"

#. cv/btl/ner_1613.at3 | 76 quadros | modo 1
msgctxt "1349:0"
msgid "Don't just space out, or we'll fall behind."
msgstr "Nada de distração, ou ficaremos para trás."

#. cv/btl/emi3_1500.at3 | 28 quadros | modo 1
msgctxt "1350:0"
msgid "Accept your fate!"
msgstr "Aceite seu destino!"

#. cv/btl/emi_1712.at3 | 56 quadros | modo 1
msgctxt "1351:0"
msgid "You've really lost your touch, man!"
msgstr "Você perdeu a prática de vez, hein!"

#. cv/btl/mll_1710.at3 | 46 quadros | modo 1
msgctxt "1352:0"
msgid "…I wonder if one of my leg tendons tore…"
msgstr "…será que rompi um tendão da perna…?"

#. cv/btl/emi_1744.at3 | 84 quadros | modo 1
msgctxt "1353:0"
msgid "     No need to hold back.     \nLet's go full throttle, Master!"
msgstr "Nada de se conter.\nVamos com tudo!"

#. se/eb_gil/17 | 39 quadros | modo 1
msgctxt "1354:0"
msgid "I'll rip your eyes out!"
msgstr "Vou arrancar teus olhos!"

#. cv/btl/tam_2021.at3 | 72 quadros | modo 1
msgctxt "1355:0"
msgid "Know your place…"
msgstr "Saiba o seu lugar…"

#. cv/btl/tam_2021.at3 | 88 quadros | modo 1
msgctxt "1355:1"
msgid "C'mere so I can snippy-snap you in half 鷙"
msgstr "Vem cá que vou te picar ao meio 鷙"

#. cv/btl/el2_1501.at3 | 64 quadros | modo 1
msgctxt "1356:0"
msgid "YOU'RE AN EYESORE, AN EYESORE!"
msgstr "QUE FEIURA! QUE FEIURA!"

#. cv/btl/jin_1211_edit.at3 | 66 quadros | modo 1
msgctxt "1357:1"
msgid "\"lol chill tho\""
msgstr "“kkk relaxa aí”"

#. cv/btl/jin_1211_edit.at3 | 36 quadros | modo 1
msgctxt "1357:2"
msgid "I love it when people get mad!"
msgstr "Adoro quando a galera fica revoltada!"

#. cv/fld/gil_0102.at3 | 148 quadros | modo 2
msgctxt "1358:0"
msgid "If you absolutely must know, around 68kg."
msgstr "Se tanto precisas saber, uns 68 kg."

#. cv/fld/gil_0102.at3 | 110 quadros | modo 2
msgctxt "1358:1"
msgid "Just so we're clear, I have no fat on my body."
msgstr "Que fique claro. Não há gordura no meu corpo."

#. cv/fld/gil_0102.at3 | 118 quadros | modo 2
msgctxt "1358:2"
msgid "I've never had an ounce of fat my entire life."
msgstr "Jamais tive um grama de gordura na vida."

#. cv/fld/gil_0102.at3 | 64 quadros | modo 2
msgctxt "1358:3"
msgid "That good enough for you, mongrel?"
msgstr "Isso te basta, criatura mestiça?"

#. cv/btl/jin_1510.at3 | 60 quadros | modo 1
msgctxt "1359:0"
msgid "Awaw! What are you doing now!?"
msgstr "Aaaah! O que é que você tá fazendo agora!?"

#. se/eb_elp/6 | 33 quadros | modo 1
msgctxt "1360:0"
msgid "You're banned from the venue!"
msgstr "Sua entrada no show está banida!"

#. cv/btl/tam_1250_edit.at3 | 44 quadros | modo 1
msgctxt "1361:0"
msgid "I might be a bit angry now…"
msgstr "Acho que estou começando a ficar brava…"

#. cv/btl/mll_1956.at3 | 80 quadros | modo 1
msgctxt "1362:0"
msgid "Let me show you the difference between\n              you and I.              "
msgstr "Deixe-me mostrar a diferença\nentre mim e você."

#. cv/btl/mll_1956.at3 | 130 quadros | modo 1
msgctxt "1362:1"
msgid "Do you really think a backup dancer could\n    stand up to a prima donna like me?    "
msgstr "Acha mesmo que alguém do corpo de baile\npode enfrentar uma prima-dona como eu?"

#. cv/btl/tam_2002.at3 | 46 quadros | modo 1
msgctxt "1363:0"
msgid "Darling, hang in there!"
msgstr "Meu bem, aguente firme!"

#. cv/btl/kar_1954_mix.at3 | 172 quadros | modo 1
msgctxt "1364:0"
msgid "Let's get started, Jinako. Wait, no sorry,\n  I messed up. You're Jimeko now, right?  "
msgstr "Vamos começar, Jinako. Ou melhor, perdão.\nAgora você é Jimeko, certo?"

#. cv/btl/kar_1954_mix.at3 | 140 quadros | modo 1
msgctxt "1364:1"
msgid "  We went back to Jinako already!  \nYou're not even listening, are you!?"
msgstr "Já voltamos pra Jinako!\nVocê nem tá ouvindo, né!?"
