msgctxt "item_param_04:29:2"
msgid "your opponent's every possible movement."
msgstr "todos os movimentos possíveis do oponente."

#. cmn/item_param_04.bin | registro 30 | nome
msgctxt "item_param_04:30:0"
msgid "Thoughtful Mystic Code"
msgstr "Artefato Místico de Afeição"

#. cmn/item_param_04.bin | registro 30 | descrição 1
msgctxt "item_param_04:30:1"
msgid "Mystic Code formed from the strong feelings of a Servant."
msgstr "Artefato Místico feito da intensidade do afeto de um Servo."

#. cmn/item_param_04.bin | registro 30 | descrição 2
msgctxt "item_param_04:30:2"
msgid "What kind of feelings and for whom is privy only to them."
msgstr "Só o Servo sabe qual é o sentimento e por quem o nutre."

