msgctxt "item_param_04:29:0"
msgid "Demon of Atlas"
msgstr "Demônio de Atlas"

#. cmn/item_param_04.bin | registro 29 | descrição 1
msgctxt "item_param_04:29:1"
msgid "Creates a brief impenetrable wall by predicting"
msgstr "Cria por instantes uma barreira impenetrável ao prever"

