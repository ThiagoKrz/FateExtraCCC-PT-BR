msgctxt "item_param_04:26:2"
msgid "taking the place of the user."
msgstr "tomando o lugar de quem o usa."

#. cmn/item_param_04.bin | registro 27 | nome
msgctxt "item_param_04:27:0"
msgid "Silver Anklet"
msgstr "Tornozeleira de Prata"

#. cmn/item_param_04.bin | registro 27 | descrição 1
msgctxt "item_param_04:27:1"
msgid "An anklet modified with thaumaturgy that helps a"
msgstr "Uma tornozeleira modificada por magia, que ajuda"

