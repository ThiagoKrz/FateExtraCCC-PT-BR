msgstr "Uma bola de cristal do tamanho de uma bola de softbol"

#. cmn/item_param_04.bin | registro 3 | descrição 2
msgctxt "item_param_04:3:2"
msgid "radiates an ominous light."
msgstr "que irradia uma luz sinistra."

#. cmn/item_param_04.bin | registro 4 | nome
msgctxt "item_param_04:4:0"
msgid "Shockwave/1st Strike"
msgstr "Onda de Choque/Golpe 1"

#. cmn/item_param_04.bin | registro 4 | descrição 1
msgctxt "item_param_04:4:1"
msgid "Allows the use of Field Skill: Mana Burst C."
msgstr "Permite usar a habilidade de campo Explosão de Mana C."

#. cmn/item_param_04.bin | registro 4 | descrição 2
msgctxt "item_param_04:4:2"
msgid "Stuns for 1 turn@eliminates weaker enemies."
msgstr "Atordoa por 1 turno@elimina inimigos mais fracos."

#. cmn/item_param_04.bin | registro 5 | nome
msgctxt "item_param_04:5:0"
msgid "Exorcist Blade"
msgstr "Lâmina Exorcista"

#. cmn/item_param_04.bin | registro 5 | descrição 1
msgctxt "item_param_04:5:1"
msgid "A small dagger said to have the power to"
msgstr "Uma adaga pequena que, dizem, tem o poder de"

#. cmn/item_param_04.bin | registro 5 | descrição 2
msgctxt "item_param_04:5:2"
msgid "exorcise malevolent spirits."
msgstr "exorcizar espíritos malignos."

#. cmn/item_param_04.bin | registro 6 | nome
msgctxt "item_param_04:6:0"
msgid "Phoenix Scarf"
msgstr "Echarpe de Fênix"

#. cmn/item_param_04.bin | registro 6 | descrição 1
msgctxt "item_param_04:6:1"
msgid "A stylish silk scarf adorned with the feathers"
msgstr "Uma echarpe de seda elegante, enfeitada com penas"

#. cmn/item_param_04.bin | registro 6 | descrição 2
msgctxt "item_param_04:6:2"
msgid "of the mythical phoenix."
msgstr "da fênix mitológica."

#. cmn/item_param_04.bin | registro 7 | nome
msgctxt "item_param_04:7:0"
msgid "Aromatic Wood"
msgstr "Madeira Aromática"

#. cmn/item_param_04.bin | registro 7 | descrição 1
msgctxt "item_param_04:7:1"
msgid "Fragrant woods whose scents are proven to heal"
msgstr "Madeira cujo aroma comprovadamente cura"

#. cmn/item_param_04.bin | registro 7 | descrição 2
msgctxt "item_param_04:7:2"
msgid "even incurable diseases."
msgstr "até doenças incuráveis."

#. cmn/item_param_04.bin | registro 8 | nome
msgctxt "item_param_04:8:0"
msgid "Saint's Monocle"
msgstr "Monóculo do Santo"

#. cmn/item_param_04.bin | registro 8 | descrição 1
msgctxt "item_param_04:8:1"
msgid "A hacking tool used to learn the abilities of"
msgstr "Uma ferramenta de hacking que revela habilidades de"

#. cmn/item_param_04.bin | registro 8 | descrição 2
msgctxt "item_param_04:8:2"
msgid "enemies encountered in the Sakura Labyrinth."
msgstr "inimigos encontrados no Labirinto de Sakura."

#. cmn/item_param_04.bin | registro 9 | nome
msgctxt "item_param_04:9:0"
msgid "Fortune Key"
msgstr "Chave da Fortuna"

#. cmn/item_param_04.bin | registro 9 | descrição 1
msgctxt "item_param_04:9:1"
msgid "A charm that skews the odds in favor of the one"
msgstr "Um amuleto que faz a sorte pender"

#. cmn/item_param_04.bin | registro 9 | descrição 2
msgctxt "item_param_04:9:2"
msgid "in possession of it."
msgstr "para o lado de quem o carrega."

#. cmn/item_param_04.bin | registro 10 | nome
msgctxt "item_param_04:10:0"
msgid "Imp's Belt"
msgstr "Cinto do Diabrete"

#. cmn/item_param_04.bin | registro 10 | descrição 1
msgctxt "item_param_04:10:1"
msgid "An excessively outrageous belt studded with"
msgstr "Um cinto extravagante, coberto de"

