msgctxt "item_param_04:27:2"
msgid "Master enhance their Servant's magic abilities."
msgstr "o Mestre a reforçar a magia de seu Servo."

#. cmn/item_param_04.bin | registro 28 | nome
msgctxt "item_param_04:28:0"
msgid "Base Red Mystic Code"
msgstr "Artefato Místico Base Vermelho"

#. cmn/item_param_04.bin | registro 28 | descrição 1
msgctxt "item_param_04:28:1"
msgid "Conceptual weapon made from the shroud of a certain saint."
msgstr "Arma Conceitual feita da mortalha de um santo."

#. cmn/item_param_04.bin | registro 28 | descrição 2
msgctxt "item_param_04:28:2"
msgid "Shields the wearer not from enemies, but from the World."
msgstr "Protege quem a usa do próprio Mundo."

