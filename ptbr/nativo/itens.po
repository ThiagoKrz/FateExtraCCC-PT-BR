msgctxt "item_param_04:11:1"
msgid "An earring of mysterious power that transfers a"
msgstr "Um brinco com o poder misterioso de transferir"

#. cmn/item_param_04.bin | registro 11 | descrição 2
msgctxt "item_param_04:11:2"
msgid "Master's magic to their Servant."
msgstr "a magia de um Mestre ao seu Servo."

#. cmn/item_param_04.bin | registro 12 | nome
msgctxt "item_param_04:12:0"
msgid "Old Rusty Sword"
msgstr "Espada Velha Enferrujada"

#. cmn/item_param_04.bin | registro 12 | descrição 1
msgctxt "item_param_04:12:1"
msgid "An old sword, covered in years of rust."
msgstr "Uma espada velha, enferrujada há anos."

#. cmn/item_param_04.bin | registro 13 | nome
msgctxt "item_param_04:13:0"
msgid "Mermaid Robe"
msgstr "Manto de Sereia"

#. cmn/item_param_04.bin | registro 13 | descrição 1
msgctxt "item_param_04:13:1"
msgid "A robe of archaic cut adorned with scales"
msgstr "Um manto de corte antigo, decorado com escamas"

#. cmn/item_param_04.bin | registro 13 | descrição 2
msgctxt "item_param_04:13:2"
msgid "taken from a mermaid."
msgstr "tiradas de uma sereia."

#. cmn/item_param_04.bin | registro 14 | nome
msgctxt "item_param_04:14:0"
msgid "Seraphic Music Box"
msgstr "Caixa de Música Seráfica"

#. cmn/item_param_04.bin | registro 14 | descrição 1
msgctxt "item_param_04:14:1"
msgid "A music box that plays a healing tone."
msgstr "Uma caixa de música que toca uma melodia curativa."

#. cmn/item_param_04.bin | registro 15 | nome
msgctxt "item_param_04:15:0"
msgid "Staff of Fortitude"
msgstr "Cajado da Fortaleza"

#. cmn/item_param_04.bin | registro 15 | descrição 1
msgctxt "item_param_04:15:1"
msgid "A staff that infuses a Servant with fortitude and prana."
msgstr "Um cajado que infunde vigor e prana no Servo."

#. cmn/item_param_04.bin | registro 16 | nome
msgctxt "item_param_04:16:0"
msgid "Protection Charm"
msgstr "Amuleto de Proteção"

#. cmn/item_param_04.bin | registro 16 | descrição 1
msgctxt "item_param_04:16:1"
msgid "A charm that creates a barrier that protects the"
msgstr "Um amuleto que cria uma barreira e protege"

#. cmn/item_param_04.bin | registro 16 | descrição 2
msgctxt "item_param_04:16:2"
msgid "wielder from physical attacks."
msgstr "quem o usa de ataques físicos."

#. cmn/item_param_04.bin | registro 17 | nome
msgctxt "item_param_04:17:0"
msgid "Enhancement Spike"
msgstr "Espigão de Aprimoramento"

#. cmn/item_param_04.bin | registro 17 | descrição 1
msgctxt "item_param_04:17:1"
msgid "A unique lightweight spike engraved with the"
msgstr "Um espigão leve e singular, gravado com"

#. cmn/item_param_04.bin | registro 17 | descrição 2
msgctxt "item_param_04:17:2"
msgid "image of a gamboling cat."
msgstr "a imagem de um gato brincalhão."

#. cmn/item_param_04.bin | registro 18 | nome
msgctxt "item_param_04:18:0"
msgid "Shockwave/2nd Strike"
msgstr "Onda de Choque/Golpe 2"

#. cmn/item_param_04.bin | registro 18 | descrição 1
msgctxt "item_param_04:18:1"
msgid "Allows the use of Field Skill: Mana Burst B."
msgstr "Permite usar a habilidade de campo Explosão de Mana B."

#. cmn/item_param_04.bin | registro 18 | descrição 2
msgctxt "item_param_04:18:2"
msgid "Stuns for 2 turns@eliminates weaker enemies."
msgstr "Atordoa por 2 turnos@elimina inimigos mais fracos."

#. cmn/item_param_04.bin | registro 19 | nome
msgctxt "item_param_04:19:0"
msgid "Dragon Cloak"
msgstr "Manto de Dragão"

#. cmn/item_param_04.bin | registro 19 | descrição 1
msgctxt "item_param_04:19:1"
msgid "An item of remarkable craftsmanship said to be"
msgstr "Uma peça de feitura impecável, que dizem ser"

#. cmn/item_param_04.bin | registro 19 | descrição 2
msgctxt "item_param_04:19:2"
msgid "made from the hide of an ancient dragon."
msgstr "feita do couro de um dragão ancestral."

#. cmn/item_param_04.bin | registro 20 | nome
msgctxt "item_param_04:20:0"
msgid "Maleficent Garments"
msgstr "Vestes Maléficas"

#. cmn/item_param_04.bin | registro 20 | descrição 1
msgctxt "item_param_04:20:1"
msgid "Set of clothes that radiate pure evil and"
msgstr "Vestes que irradiam pura maldade e"

#. cmn/item_param_04.bin | registro 20 | descrição 2
msgctxt "item_param_04:20:2"
msgid "malice embroidered with countless lizards."
msgstr "malícia, bordadas com incontáveis lagartos."

#. cmn/item_param_04.bin | registro 21 | nome
msgctxt "item_param_04:21:0"
msgid "Staff of Rebuke"
msgstr "Cajado da Repreensão"

#. cmn/item_param_04.bin | registro 21 | descrição 1
msgctxt "item_param_04:21:1"
msgid "An item of great power that, when struck with it,"
msgstr "Um objeto de grande poder. Quem for atingido por ele"

#. cmn/item_param_04.bin | registro 21 | descrição 2
msgctxt "item_param_04:21:2"
msgid "will cause one to lose willpower and magic."
msgstr "perderá a força de vontade e a magia."

#. cmn/item_param_04.bin | registro 22 | nome
msgctxt "item_param_04:22:0"
msgid "Sword of Repentance"
msgstr "Espada do Arrependimento"

#. cmn/item_param_04.bin | registro 22 | descrição 1
msgctxt "item_param_04:22:1"
msgid "A legendary sword said to have slain a demon."
msgstr "Uma espada lendária que teria matado um demônio."

#. cmn/item_param_04.bin | registro 23 | nome
msgctxt "item_param_04:23:0"
msgid "Shockwave/3rd Strike"
msgstr "Onda de Choque/Golpe 3"

#. cmn/item_param_04.bin | registro 23 | descrição 1
msgctxt "item_param_04:23:1"
msgid "Allows the use of Field Skill: Mana Burst A."
msgstr "Permite usar a habilidade de campo Explosão de Mana A."

#. cmn/item_param_04.bin | registro 23 | descrição 2
msgctxt "item_param_04:23:2"
msgid "No cost@stuns for 1 turn@eliminates weaker enemies."
msgstr "Sem custo@atordoa por 1 turno@elimina inimigos fracos."

#. cmn/item_param_04.bin | registro 24 | nome
msgctxt "item_param_04:24:0"
msgid "Angelic Trumpet"
msgstr "Trombeta Angelical"

#. cmn/item_param_04.bin | registro 24 | descrição 1
msgctxt "item_param_04:24:1"
msgid "A relic thought to have belonged to an angel."
msgstr "Uma relíquia que teria pertencido a um anjo."

#. cmn/item_param_04.bin | registro 25 | nome
msgctxt "item_param_04:25:0"
msgid "Celestial Blade"
msgstr "Lâmina Celestial"

#. cmn/item_param_04.bin | registro 25 | descrição 1
msgctxt "item_param_04:25:1"
msgid "An ancient sword of incredible power;"
msgstr "Uma espada ancestral de poder incrível,"

#. cmn/item_param_04.bin | registro 25 | descrição 2
msgctxt "item_param_04:25:2"
msgid "said to have belonged to a god who slew monsters."
msgstr "que teria pertencido a um deus matador de monstros."

#. cmn/item_param_04.bin | registro 26 | nome
msgctxt "item_param_04:26:0"
msgid "Scapegoat Charm"
msgstr "Amuleto do Bode Expiatório"

#. cmn/item_param_04.bin | registro 26 | descrição 1
msgctxt "item_param_04:26:1"
msgid "A charm that can help to divert disaster by"
msgstr "Um amuleto que pode desviar um infortúnio"

