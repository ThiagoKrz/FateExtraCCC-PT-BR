  "interface/poem/cpt_06.txb": {
   "3": {
    "en": "CHAPTER",
    "pt": "CAPÍTULO",
    "fonte": "quadrada"
   },
   "9": {
    "partes": [
     {
      "en": "Pleasure: Critical",
      "pt": "Prazer: Crítico",
      "fonte": "quadrada_fina",
      "area": [
       0,
       232,
       23,
       40
      ],
      "alinhar": "esq"
     }
    ]
   },
   "13": {
    "en": "Her eyes drowned in love spoke.",
    "pt": "Seus olhos afogados em amor falaram.",
    "fonte": "garamond",
    "percentil": 90,
    "contorno": false,
    "brilho": true
   },
   "14": {
    "en": "“For you, I will give my everything.”",
    "pt": "“Por você, darei tudo de mim.”",
    "fonte": "garamond",
    "percentil": 90,
    "contorno": false,
    "brilho": true
   },
   "15": {
    "en": "“You mean your body.” he laughed.",
    "pt": "“Quer dizer o seu corpo”, riu ele.",
    "fonte": "garamond",
    "percentil": 90,
    "contorno": false,
    "brilho": true
   },
   "16": {
    "en": "“Just like an animal, aren’t you?” she said.",
    "pt": "“Igual a um animal, não é?”, disse ela.",
    "fonte": "garamond",
    "percentil": 90,
    "contorno": false,
    "brilho": true
   },
   "17": {
    "en": "“Your heart is mine.” he laughed.",
    "pt": "“O seu coração é meu”, riu ele.",
    "fonte": "garamond",
    "percentil": 90,
    "contorno": false,
    "brilho": true
   },
   "18": {
    "en": "“Yes, that’s right.” she said.",
    "pt": "“Sim, isso mesmo”, disse ela.",
    "fonte": "garamond",
    "percentil": 90,
    "contorno": false,
    "brilho": true
   },
   "19": {
    "en": "“Please, help me.” he said.",
    "pt": "“Por favor, me ajude”, disse ele.",
    "fonte": "garamond",
    "percentil": 90,
    "contorno": false,
    "brilho": true
   },
   "20": {
    "en": "“Just like an animal isn’t enough.” she laughed.",
    "pt": "“Igual a um animal não basta”, riu ela.",
    "fonte": "garamond",
    "percentil": 90,
    "contorno": false,
    "brilho": true
   },
   "21": {
    "en": "“But you said you loved me.” he said.",
    "pt": "“Mas você disse que me amava”, disse ele.",
    "fonte": "garamond",
    "percentil": 90,
    "contorno": false,
    "brilho": true
   },
   "22": {
    "en": "“Yes, that’s right.” she laughed.",
    "pt": "“Sim, isso mesmo”, riu ela.",
    "fonte": "garamond",
    "percentil": 90,
    "contorno": false,
    "brilho": true
   },
   "23": {
    "en": "Beyond the veil, man and woman became one.",
    "pt": "Além do véu, homem e mulher se tornaram um só.",
    "fonte": "garamond",
    "percentil": 90,
    "contorno": false,
    "brilho": true
   },
   "24": {
    "en": "Like skin meeting with skin. Like ice melting in heat.",
    "pt": "Como pele tocando pele. Como gelo derretendo no calor.",
    "fonte": "garamond",
    "percentil": 90,
    "contorno": false,
    "brilho": true
   },
   "25": {
    "en": "The woman who embodies infatuation laughs.",
    "pt": "Ri a mulher que encarna a paixão.",
    "fonte": "garamond",
    "percentil": 90,
    "contorno": false,
    "brilho": true
   },
   "26": {
    "partes": [
     {
      "en": "True love can only be obtained",
      "pt": "O amor verdadeiro só se conquista",
      "fonte": "garamond",
      "percentil": 90,
      "contorno": false,
      "brilho": true,
      "area": [
       0,
       433,
       0,
       23
      ],
      "alinhar": "centro"
     },
     {
      "en": "when you rule over everything.",
      "pt": "quando se domina tudo.",
      "fonte": "garamond",
      "percentil": 90,
      "contorno": false,
      "brilho": true,
      "area": [
       0,
       433,
       23,
       50
      ],
      "alinhar": "centro"
     }
    ]
   },
   "27": {
    "en": "This is the story of a girl.",
    "pt": "Esta é a história de uma garota.",
    "fonte": "garamond",
    "percentil": 90,
    "contorno": false,
    "brilho": true
   },
   "28": {
