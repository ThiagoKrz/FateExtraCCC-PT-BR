msgid "――――――."
msgstr ""

#. backlog,motion,text
msgctxt "576640"
msgid "Eh―――Oh you, that's not it at all.\nI'm the evil #C236196003BB#CDEF, just like I've always been!"
msgstr ""

#. backlog,motion,text
msgctxt "576860"
msgid "……!"
msgstr ""

#. backlog,motion,text
msgctxt "576984"
msgid "―――What the!?"
msgstr ""

#. backlog,motion,text
msgctxt "578496"
msgid "Excuse me. In front of you, is there an\n#C000246204Item Folder#CDEF?"
msgstr ""

#. backlog,motion,text
msgctxt "578920"
msgid "…what is this?"
msgstr ""

#. backlog,motion,text
msgctxt "579408"
msgid "Is that so…?"
msgstr ""

#. backlog,motion,text
msgctxt "579424"
msgid "Computers and chess, no, AI and chess\nappear to have a deep connection."
msgstr ""

#. backlog,motion,text
msgctxt "579640"
msgid "Good work, #C236196003#FAMILY#CDEF.\nThat's all for today's search.\n#C236196003Sakura#CDEF, please teleport #[him][her]# back."
msgstr ""

#. backlog,motion,text
msgctxt "579772"
msgid "Yes. Mission clear!\nI'll be teleporting you back to the old school,\nso please have a good rest, okay?"
msgstr ""

#. backlog,motion,text
