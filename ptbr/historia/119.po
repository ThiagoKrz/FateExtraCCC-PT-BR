msgid "Prompted by #C236196003Rin#CDEF, I shake off the strange,\ntroubling feeling I have."
msgstr "#[Alertado][Alertada]# pela #C236196003Rin#CDEF, espanto a sensação\nestranha e perturbadora que sinto."

