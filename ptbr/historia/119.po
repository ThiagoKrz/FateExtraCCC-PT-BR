#. backlog,motion,text
msgctxt "530256"
msgid "……………uh, Senpai?\nWhy am I here?"
msgstr ""

#. choice
msgctxt "530548"
msgid "I called you here."
msgstr ""

#. choice
msgctxt "530568"
msgid "…you don't remember?"
msgstr ""

#. choice
msgctxt "530592"
