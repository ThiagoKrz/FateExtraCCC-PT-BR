#. popupStd_line1
msgctxt "47728"
msgid "Obtained"
msgstr "Obtido"

#. backlog,motion,text
msgctxt "631488"
msgid "\nVisitors    detected."
msgstr ""

#. backlog,motion,text
msgctxt "632072"
msgid "Needless to say, your prayers shall\nnever reach me."
msgstr ""

#. backlog,motion,text
msgctxt "632128"
msgid "I repeat:\nVisitors, confirmed.\nAt present, no guests are―――"
msgstr ""

#. backlog,motion,text
msgctxt "632740"
msgid "…not at all.\nThis thing isn't still, Master."
msgstr ""

#. backlog,motion,text
msgctxt "632972"
msgid "No, #RUBS  Master#RUBEDarling#REND.\nThis is by no means such a place."
msgstr ""

#. backlog,motion,text
msgctxt "633792"
msgid "Negativity.\nCurses, cutting, and craters."
msgstr ""

#. backlog,motion,text
msgctxt "633920"
msgid "That's all that exists in this space."
msgstr ""

#. backlog,motion,text
msgctxt "633968"
msgid "Positivity.\nHope. Links. Building up."
msgstr ""

#. backlog,motion,text
msgctxt "634368"
msgid "Senpai.\nYou're a pathogen that's appeared in\nthis perfect universe."
msgstr ""

#. backlog,motion,text
msgctxt "635368"
msgid "―――I know."
msgstr ""

#. backlog,motion,text
msgctxt "636012"
msgid "―――?"
msgstr ""

#. backlog,motion,text
msgctxt "636024"
msgid "#C240240240――, ――――, ――――――!?#CDEF"
msgstr ""

#. backlog,motion,text
msgctxt "636072"
msgid "#C200200200―――!!!!!#CDEF"
msgstr ""

#. backlog,motion,text
msgctxt "636108"
msgid "#C160160160!!!, !!!!!, !―――#CDEF"
msgstr ""

#. backlog,motion,text
msgctxt "636572"
msgid "Don't you see? You're the only ones\ncannibalizing your own kind for gain."
msgstr ""

#. backlog,motion,text
msgctxt "636648"
msgid "You all chose self-destruction."
msgstr ""

#. backlog,motion,text
msgctxt "636684"
msgid "You all chose self-destruction."
msgstr ""

#. backlog,motion,text
msgctxt "636720"
msgid "You all chose self-destruction."
msgstr ""

#. backlog,motion,text
msgctxt "636756"
msgid "\n\n\n\n\n\n\n#C160160160…the truth couldn't be any clearer.#CDEF"
msgstr ""

#. backlog,motion,text
msgctxt "636872"
msgid "#C160160160…an inexcusable credit roll plays.#CDEF"
msgstr ""

#. backlog,motion,text
msgctxt "637348"
msgid "#C160160160…………………………………………………\n…………………………………………………\n…………………………………………………\n………………it's no good. I have no counter to her argument.#CDEF"
msgstr ""

#. backlog,motion,text
msgctxt "637828"
msgid "――――――."
msgstr ""

#. backlog,motion,text
msgctxt "638032"
msgid "N-no… I'm not being fair.\nI'm practically the embodiment of fairness,\nso why am I hiding the truth?"
msgstr ""

#. backlog,motion,text
msgctxt "638332"
msgid "H-have they no shame?\nI-I didn't see it coming, either!\nSo, why did they approve? Well, see―"
msgstr ""

#. backlog,motion,text
msgctxt "638428"
msgid "The #C000246204Moon Cell#CDEF, that I became, altered\nthe votes―――Ugh, damn you…\nDon't be fooled, Senpai―――!"
msgstr ""

#. backlog,motion,text
msgctxt "638544"
msgid "#C160160160―――, ―――.#CDEF"
msgstr ""

#. backlog,motion,text
msgctxt "638580"
msgid "#C200200200I hear    a    voice.#CDEF"
msgstr ""

#. backlog,motion,text
msgctxt "638620"
msgid "#C240240240I hear a voice.#CDEF"
msgstr ""

#. backlog,motion,text
msgctxt "638652"
msgid "I hear a voice."
msgstr ""

#. backlog,motion,text
msgctxt "638832"
msgid "None of that is any big deal."
msgstr ""

#. backlog,motion,text
msgctxt "638960"
msgid "I've always, always been miserably struggling\nto live out of a pathetic fear of death."
msgstr ""

#. backlog,motion,text
msgctxt "639336"
msgid "\n…she yells out."
msgstr ""

#. backlog,motion,text
msgctxt "639368"
msgid "\"They were never like this before.\""
msgstr ""

#. backlog,motion,text
msgctxt "639704"
msgid "Why―――do you all go so far to suffer!?"
msgstr ""

#. backlog,motion,text
msgctxt "639764"
msgid "―――It's obvious."
msgstr ""

#. backlog,motion,text
msgctxt "639788"
msgid "It's because we don't understand."
msgstr ""

#. backlog,motion,text
msgctxt "640368"
msgid "If a measly#RUBSconclusion#RUBE thing#REND like this is enough to\nmake me quit, then I can't claim I even\nbelong to that IMMATURE PLANET――――!!!!!!"
msgstr ""

#. backlog,motion,text
msgctxt "640892"
msgid "And―――\nMy hero shall propose to this day!"
msgstr ""

#. backlog,motion,text
msgctxt "640984"
msgid "Behold, #C236196003BB#CDEF!\nThe light of love my Praetor and I bear!"
msgstr ""

#. backlog,motion,text
msgctxt "643908"
msgid "…for I made a vow―to protect."
msgstr ""

#. backlog,motion,text
msgctxt "644064"
msgid "I shall eliminate you here\nand settle humanity's fate."
msgstr ""

#. backlog,motion,text
msgctxt "645364"
msgid "I stare straight back at said malice."
msgstr ""

#. backlog,motion,text
msgctxt "645404"
msgid "…okay. Now THIS I can fight.\nAgainst this malice, I can face it head-on."
msgstr ""

#. backlog,motion,text
msgctxt "646884"
msgid "The #C000246204Moon Cell#CDEF won't stop…!?\nAnd now it's progressing faster WITHOUT #C236196003BB#CDEF!?"
msgstr ""

#. backlog,motion,text
msgctxt "647232"
msgid "What the hell is going on?"
msgstr ""

#. backlog,motion,text
msgctxt "647416"
msgid "It's almost as if―――"
msgstr ""

#. backlog,motion,text
msgctxt "647528"
msgid "*kgh*, ah…! No, I won't let it…!\nI won't let the #C000246204Moon Cell#CDEF rampage…!"
msgstr ""

#. backlog,motion,text
msgctxt "647972"
msgid "Who will, protect―――\nThat wonderful… person…?"
msgstr ""

#. backlog,motion,text
msgctxt "648028"
msgid "…#C236196003BB#CDEF is still fighting back."
msgstr ""

#. backlog,motion,text
msgctxt "648192"
msgid "Regardless, neither happens."
msgstr ""

#. backlog,motion,text
msgctxt "648648"
msgid "Ohh, as long as #C236196003Sakura#CDEF is available,\nthe #C000246204Moon Cell#CDEF can use her as a backup!"
msgstr ""

#. backlog,motion,text
msgctxt "649280"
msgid "Then―――What did we take down #C236196003BB#CDEF for…!?"
msgstr ""

#. backlog,motion,text
msgctxt "649340"
msgid "No, no!\nYour efforts weren't wasted!"
msgstr ""

#. backlog,motion,text
msgctxt "649392"
msgid "#C236196003Sakura#CDEF…!?"
msgstr ""

#. backlog,motion,text
msgctxt "649420"
msgid "With #C236196003BB#CDEF defeated, now I can directly\ninhibit the corrupting programs!"
msgstr ""

#. backlog,motion,text
msgctxt "649520"
msgid "Up until this point, I couldn't stop #C236196003BB#CDEF.\n#C236196003BB#CDEF couldn't stop me."
msgstr ""

#. backlog,motion,text
msgctxt "649724"
msgid "But you, #C236196003Rin#CDEF, and #C236196003Rani#CDEF brought\nme all the way here."
msgstr ""

#. backlog,motion,text
msgctxt "649896"
msgid "I can negate all the rules the #C000246204Moon Cell#CDEF\nimposed on us――I can make this all go away!"
msgstr ""

#. backlog,motion,text
msgctxt "651140"
msgid "…come on."
msgstr ""

#. backlog,motion,text
msgctxt "652724"
msgid "But―――But!"
msgstr ""

#. backlog,motion,text
msgctxt "652748"
msgid "…good. I swore that I would protect you.\nLooks like I kept my word on that, at least."
msgstr ""

#. backlog,motion,text
msgctxt "653184"
msgid "#C236196003Sakura#CDEF#C080080080……!#CDEF"
msgstr ""

#. backlog,motion,text
msgctxt "653728"
msgid "It's clearly my fault…"
msgstr ""

#. backlog,motion,text
msgctxt "653756"
msgid "I was so close… Wait, if I could get\none more chance, I know I can corner #C236196003BB#CDEF―――"
msgstr ""

#. backlog,motion,text
msgctxt "654048"
msgid "First―――"
msgstr ""

#. backlog,motion,text
msgctxt "654132"
msgid "Huh――"
msgstr ""

#. backlog,motion,text
msgctxt "654176"
msgid "Ah, huh―――?"
msgstr ""

#. backlog,motion,text
msgctxt "654284"
msgid "Something is, something is, something is, something is\nsomething is, something is, something is, something is\nsomething is, something is, something is――?"
msgstr ""

#. backlog,motion,text
msgctxt "654820"
msgid "―――I don't, understand."
msgstr ""

#. backlog,motion,text
msgctxt "654848"
msgid "What, did #C236196003BB#CDEF, just say…?"
msgstr ""

#. backlog,motion,text
msgctxt "655184"
msgid "You will be that entity's #RUBS soul#RUBEOS#REND,\nforever continuing to supply the plants and\nanimals left on Earth with nutrients."
msgstr ""

#. backlog,motion,text
msgctxt "655656"
msgid "One mere hour later."
msgstr ""

#. backlog,motion,text
msgctxt "655704"
msgid "And after that―"
msgstr ""

#. backlog,motion,text
msgctxt "656276"
msgid "Visitors    detected."
msgstr ""

#. backlog,motion,text
msgctxt "656516"
msgid "You will then be responsible for the cost\nof disassembly."
msgstr ""

#. backlog,motion,text
msgctxt "656684"
msgid "Utilizing 99.9 percent of your being\nas resources for the #C000246204Moon Cell#CDEF\nwill settle your balance."
msgstr ""

#. backlog,motion,text
msgctxt "656800"
msgid "I repeat:\nVisitors, confirmed.\nAt present, no guests are―――"
msgstr ""

#. backlog,motion,text
msgctxt "657592"
msgid "We're not able to monitor you in the Core,\nso we tried boosting the voice channel…"
msgstr ""

#. backlog,motion,text
msgctxt "657888"
msgid "We made it this far as a team.\nMe, finish this alone with #C236196003#SVT#CDEF? No thanks."
msgstr ""

#. backlog,motion,text
msgctxt "658412"
msgid "#C236196003BB#CDEF may be lowbrow, but she's always been\nshort on malice. Something foul got mixed in."
msgstr ""

#. backlog,motion,text
msgctxt "658636"
msgid "…yes, that alone doesn't mean it's evil\nand inhumane… but something is mixed in that\nshouldn't be."
msgstr ""

#. backlog,motion,text
msgctxt "659988"
msgid "…hmph… Well, no matter.\nMaster, please stand back. This woman appears\nto prefer taking the #C000246204Moon Cell#CDEF's side."
msgstr ""

#. backlog,motion,text
msgctxt "660604"
msgid "…I knew it."
msgstr ""

#. backlog,motion,text
msgctxt "661060"
msgid "F-follow the script here, Senpai!\nYou l-love me…!?"
msgstr ""

#. backlog,motion,text
msgctxt "661320"
msgid "Gah, grr…!\nN-no, it's still okay.\nTwo wives is within acceptable range!"
msgstr ""

#. backlog,motion,text
msgctxt "661732"
msgid "Don't forget, I've risen to become\nQueen of the Moon!\nSenpai―pshh―I totally, erm, like―――"
msgstr ""

#. backlog,motion,text
msgctxt "661836"
msgid "\"Like\"?"
msgstr ""

#. backlog,motion,text
msgctxt "662012"
msgid "Since #C236196003#FAMILY #GIVEN#CDEF likes #C236196003BB#CDEF\nand #C236196003BB#CDEF likes #C236196003#FAMILY #GIVEN#CDEF back,\nwe can now talk this through."
msgstr ""

#. backlog,motion,text
msgctxt "662280"
msgid "Ah, okay!\nI apologize, Senpa―――Ah!?"
msgstr ""

#. backlog,motion,text
msgctxt "662460"
msgid "#C236196003BB#CDEF starts noticeably trembling."
msgstr ""

#. backlog,motion,text
msgctxt "663012"
msgid "Don't forget, I've risen to become\nQueen of the Moon!\nSenpai―pshh―I totally, erm, like―――"
msgstr ""

#. backlog,motion,text
msgctxt "663116"
msgid "\"Like\"?"
msgstr ""

#. backlog,motion,text
msgctxt "663292"
msgid "Since #C236196003#FAMILY #GIVEN#CDEF likes #C236196003BB#CDEF\nand #C236196003BB#CDEF likes #C236196003#FAMILY #GIVEN#CDEF back,\nwe can now talk this through."
msgstr ""

#. backlog,motion,text
msgctxt "663892"
msgid "You'll forever be my playthings.\nWith that, I'll tolerate you all."
msgstr ""

#. backlog,motion,text
msgctxt "663960"
msgid "You heard her.\nWell, Praetor?\nI can tell her if it so pleases you."
msgstr ""

#. choice
msgctxt "664608"
msgid "Have my Servant stand down."
msgstr ""

#. choice
msgctxt "664636"
msgid "Keep talking to BB."
msgstr ""

#. choice
msgctxt "664656"
msgid "Shut up! I love you, stupid!"
msgstr ""

#. choice
msgctxt "664692"
msgid "Start listening to your Senpai!"
msgstr ""

#. backlog,motion,text
msgctxt "664732"
msgid "I have #C236196003#SVT#CDEF stand down."
msgstr ""

#. backlog,motion,text
msgctxt "664972"
msgid "…please leave.\nI won't, last, much―――"
msgstr ""

#. backlog,motion,text
msgctxt "665120"
msgid "I'm asking you kindly:\ngo back to the school building.\nI had built it all for you―――"
msgstr ""

#. backlog,motion,text
msgctxt "665208"
msgid "―――\"Really.\""
msgstr ""

#. backlog,motion,text
msgctxt "665288"
msgid "#C236196003BB#CDEF has been moving towards one goal this entire time."
msgstr ""

#. backlog,motion,text
msgctxt "665592"
msgid "Hey―――Senpai?\nS-stop! Don't come any closer!"
msgstr ""

#. backlog,motion,text
msgctxt "665644"
msgid "Any further, and I'll end up\nautomatically attacking…!"
msgstr ""

#. backlog,motion,text
msgctxt "665720"
msgid "Who knows why,\nbut #C236196003BB#CDEF did all this to protect #C236196003#FAMILY #GIVEN#CDEF."
msgstr ""

#. backlog,motion,text
msgctxt "666228"
msgid "All by herself.\nAs her body eroded away."
msgstr ""

#. backlog,motion,text
msgctxt "666284"
msgid "After all that, I can't just abandon her."
msgstr ""

#. choice
msgctxt "666420"
msgid "Shut up! I love you, stupid!"
msgstr ""

#. choice
msgctxt "666456"
msgid "Start listening to your Senpai!"
msgstr ""

#. backlog,motion,text
msgctxt "666496"
msgid "It's not possible!\nHaven't you been paying attention!?"
msgstr ""

#. backlog,motion,text
msgctxt "667016"
msgid "――――――."
msgstr ""

#. backlog,motion,text
msgctxt "667032"
msgid "#C236196003BB#CDEF's outward hostility vanishes."
msgstr ""

#. backlog,motion,text
msgctxt "667220"
msgid "And, if possible―――\nI want to know why she did all this."
msgstr ""

#. backlog,motion,text
msgctxt "667292"
msgid "………lies.\nYou lie. All lies.\nThere's no logic behind it."
msgstr ""

#. backlog,motion,text
msgctxt "667356"
msgid "Look, I messed up the #C000246204Moon Cell#CDEF!\nI tried to kill you, Senpai!\nI'm a menace―plain and simple!"
msgstr ""

#. backlog,motion,text
msgctxt "667480"
msgid "Besides, I know that the #C236196003Sakura#CDEF you\ntrust is the OTHER one!"
msgstr ""

#. backlog,motion,text
msgctxt "667564"
msgid "How can you say that you love someone like me!?"
msgstr ""

#. backlog,motion,text
msgctxt "667740"
msgid "#C236196003Sakura#CDEF…!?\nHow, when…!?"
msgstr ""

#. backlog,motion,text
msgctxt "667788"
msgid "It's thanks to you, Senpai.\nYour words just now dramatically weakened\nher grip."
msgstr ""

#. backlog,motion,text
msgctxt "668316"
msgid "All of that drove you to do all this.\n…that's why you're the real one."
msgstr ""

#. backlog,motion,text
msgctxt "668588"
msgid "Only, me―――?"
msgstr ""

#. backlog,motion,text
msgctxt "668696"
msgid "#C236196003BB#CDEF looks up.\nWith tear-laden eyes, she stares straight at me."
msgstr ""

#. backlog,motion,text
msgctxt "668832"
msgid "You do know―――\nAccepting me won't make \"#C236196003BB#CDEF\" go away.\nA pure #C236196003Sakura#CDEF won't take her place."
msgstr ""

#. backlog,motion,text
msgctxt "669040"
msgid "Wait.\nSomething in that list seems off."
msgstr ""

#. backlog,motion,text
msgctxt "669088"
msgid "Mhm, mhm.\n…hm?"
msgstr ""

#. backlog,motion,text
msgctxt "669164"
msgid "Hold it.\nOne of those descriptions is dubious."
msgstr ""

#. backlog,motion,text
msgctxt "669212"
msgid "That's who I am.\nI'm pesky, if I say so myself!\nAre you fine with that!?"
msgstr ""

#. backlog,motion,text
msgctxt "669508"
msgid "…figures.\n…I was so stupid."
msgstr ""

#. backlog,motion,text
msgctxt "669552"
msgid "All I ever do is feed my own ego.\nThat's it."
msgstr ""

#. backlog,motion,text
msgctxt "669800"
msgid "The world itself disappears."
msgstr ""

#. backlog,motion,text
msgctxt "670120"
msgid "――――――."
msgstr ""

#. backlog,motion,text
msgctxt "670136"
msgid "#C236196003BB#CDEF's outward hostility vanishes."
msgstr ""

#. backlog,motion,text
msgctxt "670324"
msgid "And, if possible―――\nI want to know why she did all this."
msgstr ""

#. backlog,motion,text
msgctxt "670396"
msgid "………lies.\nYou lie. All lies.\nThere's no logic behind it."
msgstr ""

#. backlog,motion,text
msgctxt "670460"
msgid "You're going to forgive me?\nThat can't possibly be true―――"
msgstr ""

#. backlog,motion,text
msgctxt "670528"
msgid "Look, I messed up the #C000246204Moon Cell#CDEF!\nI tried to kill you, Senpai!\nI'm a menace―plain and simple!"
msgstr ""

#. backlog,motion,text
msgctxt "670652"
msgid "Besides, I know that the #C236196003Sakura#CDEF\nyou think of as a friend is the OTHER one!"
msgstr ""

#. backlog,motion,text
msgctxt "670916"
msgid "#C236196003Sakura#CDEF…!?\nHow, when…!?"
msgstr ""

#. backlog,motion,text
msgctxt "670964"
msgid "It's thanks to you, Senpai.\nYour words just now dramatically weakened\nher grip."
msgstr ""

#. backlog,motion,text
msgctxt "671492"
msgid "All of that drove you to do all this.\n…that's why you're the real one."
msgstr ""

#. backlog,motion,text
msgctxt "671876"
msgid "How Senpai―――feels?"
msgstr ""

#. backlog,motion,text
msgctxt "671904"
msgid "#C236196003BB#CDEF looks up.\nWith tear-laden eyes, she stares straight at me."
msgstr ""

#. backlog,motion,text
msgctxt "672328"
msgid "I'm honestly a menace.\nYou would be friends with me despite that,\nSenpai?"
msgstr ""

#. backlog,motion,text
msgctxt "672416"
msgid "Will you yell at me for being a menace…?"
msgstr ""

#. backlog,motion,text
msgctxt "672808"
msgid "The world itself disappears."
msgstr ""

#. backlog,motion,text
msgctxt "672944"
msgid "I would do the same if I were in her place."
msgstr ""

#. backlog,motion,text
msgctxt "673180"
msgid "―――Ahh―――"
msgstr ""

#. backlog,motion,text
msgctxt "673336"
msgid "You made the right choice in order to save\nSenpai. However, you made one mistake."
msgstr ""

#. backlog,motion,text
msgctxt "673672"
msgid "#[His][Her]# dream lies elsewhere.\nNot in this false world; where it truly belongs."
msgstr ""

#. backlog,motion,text
msgctxt "673844"
msgid "…so please don't restrain #[his][her]# feelings,\nfor you've gained a real heart."
msgstr ""

#. backlog,motion,text
msgctxt "673928"
msgid "――――――."
msgstr ""

#. backlog,motion,text
msgctxt "674172"
msgid "Finally―――Thank you, #C236196003BB#CDEF…!"
msgstr ""

#. backlog,motion,text
msgctxt "674648"
msgid "#C236196003BB#CDEF looks away abashedly.\nThe little gesture is just so cute."
msgstr ""

#. backlog,motion,text
msgctxt "675172"
msgid "No way… A system other than ours has taken\nover the Core!\n#C236196003BB#CDEF, access the Core again!"
msgstr ""

#. backlog,motion,text
msgctxt "675396"
msgid "A, hh―――It's, pull, ing me―――\nHe, lp―――\nHelp me, Senpai―――!"
msgstr ""

#. backlog,motion,text
msgctxt "675480"
msgid "Heehee. You made for a fine and tasty meal, #C236196003BB#CDEF.\nAnd it's no surprise―――"
msgstr ""

#. backlog,motion,text
msgctxt "675576"
msgid "Administrative system changes,\n#C000246204Moon Cell#CDEF control transfer―accepted."
msgstr ""

#. backlog,motion,text
msgctxt "676148"
msgid "――――――."
msgstr ""

#. backlog,motion,text
msgctxt "676196"
msgid "But why is she here?\nWasn't she stabbed and deleted by #C236196003Meltlilith#CDEF!?"
msgstr ""

#. backlog,motion,text
msgctxt "676600"
msgid "#C236196003Andersen#CDEF revived, too―――!?"
msgstr ""

#. backlog,motion,text
msgctxt "676656"
msgid "Wait, \"survived\"?\nSo they weren't killed by #C236196003Meltlilith#CDEF…?"
msgstr ""

#. backlog,motion,text
msgctxt "676996"
msgid "The woman #C236196003Meltlilith#CDEF had killed was her\nown kin in the guise of #C236196003Kiara#CDEF."
msgstr ""

#. backlog,motion,text
msgctxt "677104"
msgid "…!\nThat's why #C236196003Lip#CDEF had disappeared from\nthe Labyrinth―――"
msgstr ""

#. backlog,motion,text
msgctxt "677300"
msgid "Heehee. You have a point."
msgstr ""

#. backlog,motion,text
msgctxt "677452"
msgid "However, can't I just control someone who does?"
msgstr ""

#. backlog,motion,text
msgctxt "677588"
msgid "…eh?"
msgstr ""

#. backlog,motion,text
msgctxt "677600"
msgid "Heeheehee… That look on your face is too much.\nI suppose you finally realized who incited\nthis entire predicament."
msgstr ""

#. backlog,motion,text
msgctxt "677876"
msgid "You two don't even get the option to \"overwork\"\nyourselves. You two have no such free will."
msgstr ""

#. backlog,motion,text
msgctxt "677968"
msgid "Ah―――Ahh―――"
msgstr ""

#. backlog,motion,text
msgctxt "678216"
msgid "Do you understand now?"
msgstr ""

#. backlog,motion,text
msgctxt "678580"
msgid "That, can't―――\nI mean, #C236196003BB#CDEF took over the #C000246204Moon Cell#CDEF\nso she could save Senpai―――"
msgstr ""

#. backlog,motion,text
msgctxt "679180"
msgid "Yes. I found making #C236196003BB#CDEF go haywire\nto be more enjoyable than my Master battles."
msgstr ""

#. backlog,motion,text
msgctxt "679276"
msgid "#C236196003Kiara#CDEF's gentle smile is angelic."
msgstr ""

#. backlog,motion,text
msgctxt "679508"
msgid "#C236196003#SVT#CDEF……!"
msgstr ""

#. backlog,motion,text
msgctxt "680476"
msgid "I up and used my Black Thread of the Five\nSkandhas. You can't move for now, but hey, to be\ntied up is a delight for some. Please enjoy."
msgstr ""

#. backlog,motion,text
msgctxt "681940"
msgid "Oh―――You've had the wrong impression\nthis whole time."
msgstr ""

#. backlog,motion,text
msgctxt "682184"
msgid "It's a karma called \"#ROFS0004#RUBS  Tanha #RUBEcraving#REND.\"\nThe love between a man and a woman\nbegets guilt."
msgstr ""

#. backlog,motion,text
msgctxt "682388"
msgid "Do you understand?\nIntrinsic love manifests only from mothers."
msgstr ""

#. backlog,motion,text
msgctxt "682752"
msgid "………\nThat's wrong.\nThat has to be wrong."
msgstr ""

#. backlog,motion,text
msgctxt "682976"
msgid "Ah―――"
msgstr ""

#. backlog,motion,text
msgctxt "683156"
msgid "As a proper AI,\nyou will never understand human love."
msgstr ""

#. backlog,motion,text
msgctxt "683272"
msgid "…I… I still…\nTo me, Senpai is―――"
msgstr ""

#. backlog,motion,text
msgctxt "683528"
msgid "I want to leap and lash at #C236196003Kiara#CDEF,\nbut I'm paralyzed up to my very tongue."
msgstr ""

#. backlog,motion,text
msgctxt "683636"
msgid "What am I doing?"
msgstr ""

#. backlog,motion,text
msgctxt "683664"
msgid "#C236196003Kiara#CDEF ended up absorbing #C236196003Sakura#CDEF, too."
msgstr ""

#. backlog,motion,text
msgctxt "684084"
msgid "Let me show you my true form―――\nThe primordial form of a woman's true nature."
msgstr ""

#. backlog,motion,text
msgctxt "684260"
msgid "Understood."
msgstr ""

#. backlog,motion,text
msgctxt "684696"
msgid "How will this tale end?\nDon't blink, for you won't want to miss it!"
msgstr ""

#. backlog,motion,text
msgctxt "684904"
msgid "Ah―――Ahh, AAAAAHHHHH!"
msgstr ""

#. backlog,motion,text
msgctxt "685164"
msgid "Ah, ahh―――AHHH!\nIt hurts, it hurts! Help! Ahh, yes!\nThis pain, this bliss is my testimony…!"
msgstr ""

#. backlog,motion,text
msgctxt "685284"
msgid "#C236196003Kiara#CDEF… or, what once was #C236196003Kiara#CDEF is transforming.\nWithin the light, something forbidden is materializing."
msgstr ""

#. backlog,motion,text
msgctxt "686200"
msgid "Is this really what you want?\nJust whose side are you on!?"
msgstr ""

#. backlog,motion,text
msgctxt "686796"
msgid "Isn't that what a Servant is, #C236196003#SVT#CDEF?"
msgstr ""

#. backlog,motion,text
msgctxt "686856"
msgid "Isn't that what a Servant is, #C236196003#SVT#CDEF?"
msgstr ""

#. backlog,motion,text
msgctxt "686916"
msgid "Isn't that what a Servant is, #C236196003#SVT#CDEF?"
msgstr ""

#. backlog,motion,text
msgctxt "686976"
msgid "Isn't that what a Servant is, #C236196003#SVT#CDEF?"
msgstr ""

#. backlog,motion,text
msgctxt "687036"
msgid "―――."
msgstr ""

#. backlog,motion,text
msgctxt "687048"
msgid "―――."
msgstr ""

#. backlog,motion,text
msgctxt "687060"
msgid "―――."
msgstr ""

#. backlog,motion,text
msgctxt "687072"
msgid "―――."
msgstr ""

#. backlog,motion,text
msgctxt "687360"
msgid "………………"
msgstr ""

#. backlog,motion,text
msgctxt "687756"
msgid "\"Fly, like swans.\nThis isn't the pond you two belong in.\""
msgstr ""

#. backlog,motion,text
msgctxt "688020"
msgid "#C236196003Kiara#CDEF#C080080080, #C236196003Andersen#CDEF#C080080080…!\n#C236196003#SVT#CDEF#C080080080…!#CDEF"
msgstr ""

#. backlog,motion,text
msgctxt "690884"
msgid "#C236196003Andersen#CDEF."
msgstr ""

#. backlog,motion,text
msgctxt "691896"
msgid "Filthier than a gutter in hell.\nPeople have to hold their nose when they\nwalk by you."
msgstr ""

#. backlog,motion,text
msgctxt "691992"
msgid "But so what?\nThat's what women are.\nThat's what men are, too."
msgstr ""

#. backlog,motion,text
msgctxt "692216"
msgid "…but why?\nI thought you hated women."
msgstr ""

#. backlog,motion,text
msgctxt "693368"
msgid "The very way she lived could only be the\nmiracle known as \"love.\""
msgstr ""

#. backlog,motion,text
msgctxt "693876"
msgid "I'll never know what happened.\nWas it her fault?\nWas it his fault?"
msgstr ""

#. backlog,motion,text
msgctxt "694512"
msgid "#C236196003Andersen#CDEF lifts #C236196003Kiara#CDEF's hand and kisses it on the back."
msgstr ""

#. backlog,motion,text
msgctxt "694724"
msgid "――――――."
msgstr ""

#. backlog,motion,text
msgctxt "696012"
msgid "As if following his Master, the Servant disappears, too."
msgstr ""

#. backlog,motion,text
msgctxt "696072"
msgid "…#C236196003Kiara Sessyoin#CDEF and #C236196003Andersen#CDEF.\nThe final page closes the culprits' story."
msgstr ""

