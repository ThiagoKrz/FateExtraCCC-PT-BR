#. backlog,motion,text
msgctxt "32588"
msgid "#C236196003#SVT#CDEF is right.\nLet's head back to #C000246204My Room#CDEF and get some rest."
msgstr "#C236196003#SVT#CDEF tem razão.\nVamos voltar ao #C000246204Meu Quarto#CDEF e descansar."

#. backlog,motion,text
msgctxt "34004"
msgid "Darling! My Room! My Room!\nLet's put our exploration aside for now\nand go to our room!"
msgstr "#[Querido][Querida]#! Meu Quarto! Meu Quarto!\nVamos deixar a exploração de lado por ora\ne ir para o nosso quarto!"

#. backlog,motion,text
msgctxt "34216"
msgid "#C236196003#SVT#CDEF is right.\nLet's take it easy and head to #C000246204My Room#CDEF."
msgstr "#C236196003#SVT#CDEF tem razão.\nVamos com calma e seguir para #C000246204Meu Quarto#CDEF."

#. unk_op1659
msgctxt "34588"
msgid "　Obtained\n#C000246204#TITM0001#CDEF."
msgstr "　Obtido:\n#C000246204#TITM0001#CDEF."

