msgstr ""

#. backlog,motion,text
msgctxt "41796"
msgid "We obtained the #C000246204SG#CDEF.\nLet's go back to #C000246204My Room#CDEF and rest."
msgstr ""

#. backlog,motion,text
msgctxt "42088"
msgid "Apocalypse Now!\nCome back soooooooon!"
msgstr ""

#. backlog,motion,text
msgctxt "42556"
msgid "Surely you aren't thinking of WALKING back?\nDo you intend to make me march for no purpose?\nLook for that #C000246204checkpoint#CDEF!"
msgstr ""

#. backlog,motion,text
msgctxt "43468"
msgid "#C236196003#SVT#CDEF is right.\nLet's head back to #C000246204My Room#CDEF and get some rest."
msgstr ""

#. unk_op1659
msgctxt "47696"
msgid "　Obtained\n#C000246204#TITM0001#CDEF."
msgstr "　Obtido:\n#C000246204#TITM0001#CDEF."

#. popupStd_line1
msgctxt "47740"
msgid "Obtained"
msgstr "Obtido"

#. backlog,motion,text
msgctxt "542264"
msgid "―――No biggie.\nSeems I've got one last job on my plate."
msgstr ""

#. unk_op1653
msgctxt "542980"
msgid "Save current progress?"
msgstr ""

#. popupStd_line1
msgctxt "543052"
msgid "It is recommended that"
msgstr ""

#. backlog,motion,text
msgctxt "543724"
msgid "One    moment.\nI    will    prepare    a\n1,080   0,000    shortcu―――"
msgstr ""

#. backlog,motion,text
msgctxt "543988"
msgid "We're doomed, WE ARE DOOOOMED!\n#C236196003Sakura#CDEF, hurry!\nPlease cheat in a bypass for us!"
msgstr ""

#. backlog,motion,text
msgctxt "544424"
msgid "―――There it is. That's the border between\nthis life and the next. Beyond it is the\nreality you reside in."
msgstr ""

#. backlog,motion,text
msgctxt "544544"
msgid "We made it…!\nOnce we get inside―――Once we―――"
msgstr ""

#. backlog,motion,text
msgctxt "544600"
msgid "―――Wait.\nThis is a barrier.\nHow do we get in!?"
msgstr ""

#. backlog,motion,text
msgctxt "545148"
msgid "But――"
msgstr ""

#. backlog,motion,text
msgctxt "545216"
msgid "*kgh*―――HRRAAAAH!"
msgstr ""

#. backlog,motion,text
msgctxt "545556"
msgid "The reinitializing wave looms so close,\nyet #C236196003Gilgamesh#CDEF works without rushing."
msgstr ""

#. backlog,motion,text
msgctxt "545732"
msgid "Which means―――"
msgstr ""

#. backlog,motion,text
msgctxt "545844"
msgid "―――#C236196003BB#CDEF!"
msgstr ""

#. backlog,motion,text
msgctxt "545956"
msgid "Gah…!\nNope, this won't be easy, after all."
msgstr ""

#. backlog,motion,text
msgctxt "546000"
msgid "As long―――as my body is intact,\nI'm sure I can at least distract it―――"
msgstr ""

#. backlog,motion,text
msgctxt "546328"
msgid "Was there ever any doubt?\nWhy do you think I dragged my\ndying body over here?"
msgstr ""

#. backlog,motion,text
msgctxt "546532"
msgid "#C236196003BB#CDEF is falling apart.\nThe handful of Spiritrons left of her body\nare disappearing."
msgstr ""

#. backlog,motion,text
msgctxt "546768"
msgid "It's fine, really. I was \"nothing\" to begin\nwith. I can take any damage easy peasy."
msgstr ""

#. backlog,motion,text
msgctxt "546872"
msgid "You can't hurt or damage \"nothing.\"\nDubious self-modifications? No problem.\nI didn't suffer at all, nope."
msgstr ""

#. backlog,motion,text
msgctxt "547020"
msgid "That's a lie.\nI know just how grueling the path she's taken has been."
msgstr ""

#. backlog,motion,text
msgctxt "547196"
msgid "…that's what makes this infuriatingly frustrating."
msgstr ""

#. backlog,motion,text
msgctxt "547316"
msgid "I never asked you to bear all this pain for me…!"
msgstr ""

#. backlog,motion,text
msgctxt "547552"
msgid "Rather than some chosen virtuoso out of our\nleague,"
msgstr ""

#. backlog,motion,text
msgctxt "547624"
msgid "we're glad that a dime-a-dozen person like\nyou did your best to put a smile on our faces."
msgstr ""

#. backlog,motion,text
msgctxt "547716"
msgid "That's all I ever needed to dream well."
msgstr ""

#. backlog,motion,text
msgctxt "547768"
msgid "She says that that was enough for her."
msgstr ""

#. backlog,motion,text
msgctxt "549412"
msgid "All while facing away from us.\nBracing her limbs, she does her utmost to stand\nher ground and not look back."
msgstr ""

#. backlog,motion,text
msgctxt "549600"
msgid "So that I don't leave her unrequited,\nI call out―――"
msgstr ""

#. choice
msgctxt "549660"
msgid "BB――!"
msgstr ""

#. choice
msgctxt "549676"
msgid "Sakura――!"
msgstr ""

#. backlog,motion,text
msgctxt "549744"
msgid "#C080080080The last I saw of #C236196003BB#CDEF#C080080080, she wore a seemingly\ntroubled and disappointed smile.#CDEF"
msgstr ""

#. backlog,motion,text
msgctxt "549868"
msgid "I call out her name."
msgstr ""

#. backlog,motion,text
msgctxt "549892"
msgid "\"#C000246204Sakura#CDEF.\""
msgstr ""

