msgid "　Obtained\n#C000246204#TITM0001#CDEF."
msgstr "　Obtido:\n#C000246204#TITM0001#CDEF."

#. popupStd_line1
msgctxt "34508"
msgid "Obtained"
msgstr "Obtido"

#. backlog,motion,text
msgctxt "499004"
msgid "\n\n\n                        I slowly awaken."
msgstr "\n\n                   Desperto aos poucos."

#. backlog,motion,text
msgctxt "499592"
msgid "―――Wait."
msgstr "―――Espera."

#. backlog,motion,text
msgctxt "499676"
msgid "Oh, you―――\nHey, sleepyhead."
msgstr "Ah, você―――\nEi, #[dorminhoco][dorminhoca]#."

#. backlog,motion,text
msgctxt "500344"
msgid "H-huh? Senpai…? Don't tell me―did I mess\nup your resuscitation!? Do you recognize me!?"
msgstr "H-hã? Senpai…? Não me diga―eu errei\nna sua ressuscitação?! Você me reconhece?!"

#. backlog,motion,text
msgctxt "500484"
msgid "#C236196003Sakura#CDEF is here as the #C236196003Sakura#CDEF I know."
msgstr "#C236196003Sakura#CDEF está aqui como a #C236196003Sakura#CDEF que conheço."

#. backlog,motion,text
msgctxt "500908"
msgid "I take a deep breath and squint."
msgstr "Respiro fundo e semicerro os olhos."

#. backlog,motion,text
msgctxt "502568"
msgid "Wherever you go, let's go together, please.\nYour dreams are my dreams."
msgstr "Aonde quer que vá, vamos #[juntos][juntas]#, sim?\nOs seus sonhos são os meus sonhos."

#. backlog,motion,text
msgctxt "502904"
msgid "Umm… ahem."
msgstr "Hum… cof, cof."

#. backlog,motion,text
msgctxt "502976"
msgid "#C080080080I'm happy you're here with me.\n               I―――　　　　　　　　　　　\n               I've fallen in love with everything about you.#CDEF"
msgstr "#C080080080Fico feliz que você esteja aqui comigo.\n               Eu―――\n        Eu me apaixonei por tudo em você.#CDEF"

#. backlog,motion,text
msgctxt "503264"
msgid "…jeez.\nIt seems I slept longer than I realized."
msgstr "…nossa.\nParece que dormi mais do que imaginava."

#. backlog,motion,text
msgctxt "503616"
msgid "Let it go beyond that distant, silver Moon―――"
msgstr "Que vá além daquela distante Lua de prata―――"

