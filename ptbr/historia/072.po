#. backlog,motion,text
msgctxt "499004"
msgid "\n\n\n                        I slowly awaken."
msgstr ""

#. backlog,motion,text
msgctxt "499592"
msgid "―――Wait."
msgstr ""

#. backlog,motion,text
msgctxt "499676"
msgid "Oh, you―――\nHey, sleepyhead."
msgstr ""

#. backlog,motion,text
msgctxt "500344"
msgid "H-huh? Senpai…? Don't tell me―did I mess\nup your resuscitation!? Do you recognize me!?"
msgstr ""

#. backlog,motion,text
msgctxt "500484"
msgid "#C236196003Sakura#CDEF is here as the #C236196003Sakura#CDEF I know."
msgstr ""

#. backlog,motion,text
msgctxt "500908"
msgid "I take a deep breath and squint."
msgstr ""

#. backlog,motion,text
msgctxt "502568"
msgid "Wherever you go, let's go together, please.\nYour dreams are my dreams."
msgstr ""

#. backlog,motion,text
msgctxt "502904"
msgid "Umm… ahem."
msgstr ""

#. backlog,motion,text
msgctxt "502976"
msgid "#C080080080I'm happy you're here with me.\n               I―――　　　　　　　　　　　\n               I've fallen in love with everything about you.#CDEF"
msgstr ""

#. backlog,motion,text
msgctxt "503264"
msgid "…jeez.\nIt seems I slept longer than I realized."
msgstr ""

#. backlog,motion,text
msgctxt "503616"
msgid "Let it go beyond that distant, silver Moon―――"
msgstr ""

