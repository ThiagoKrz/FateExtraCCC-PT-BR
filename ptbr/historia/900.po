#. backlog,motion,text
msgctxt "40640"
msgid "#C236196003BB#CDEF is right there.\nLet's #C000246204press on#CDEF."
msgstr "#C236196003BB#CDEF está logo ali.\nVamos #C000246204seguir em frente#CDEF."

#. backlog,motion,text
msgctxt "41660"
msgid "We obtained the #C000246204SG#CDEF.\nLet's go back to #C000246204My Room#CDEF and rest."
msgstr "Obtivemos o #C000246204SG#CDEF.\nVamos voltar ao #C000246204Meu Quarto#CDEF e descansar."

#. backlog,motion,text
msgctxt "41952"
msgid "Apocalypse Now!\nCome back soooooooon!"
msgstr "Apocalipse Agora!\nVolte looooogo!"

#. backlog,motion,text
msgctxt "42420"
msgid "Surely you aren't thinking of WALKING back?\nDo you intend to make me march for no purpose?\nLook for that #C000246204checkpoint#CDEF!"
msgstr "Não vai querer voltar A PÉ, não é?\nQuer me fazer marchar à toa?\nProcure aquele #C000246204checkpoint#CDEF!"

#. backlog,motion,text
msgctxt "43236"
msgid "#C236196003#SVT#CDEF is right.\nLet's head back to #C000246204My Room#CDEF and get some rest."
msgstr "#C236196003#SVT#CDEF tem razão.\nVamos voltar ao #C000246204Meu Quarto#CDEF e descansar."

#. unk_op1659
msgctxt "47272"
msgid "　Obtained\n#C000246204#TITM0001#CDEF."
msgstr "　Obtido:\n#C000246204#TITM0001#CDEF."

#. popupStd_line1
msgctxt "47320"
msgid "#TVAL02 Sm#CDEF."
msgstr ""

#. popupStd_line2
msgctxt "47340"
msgid "has been obtained."
msgstr "foi obtido."

#. backlog,motion,text
msgctxt "484028"
msgid "#C076151255Lancer#CDEF disappeared inside.\n…either way, it's time to explore."
msgstr "A #C076151255Lancer#CDEF sumiu lá dentro.\n…de qualquer forma, é hora de explorar."

#. backlog,motion,text
msgctxt "484496"
msgid "Do you still plan on disrupting my recital?\nYou lowly #C076151255#[pig][squirrel]##CDEF!"
msgstr "Ainda quer atrapalhar o meu recital,\n#C076151255#[porco][esquilo]##CDEF reles!"

#. backlog,motion,text
msgctxt "484588"
msgid "How ridiculous that I must entertain the\nlikes of you…\nFan #1, get them!"
msgstr "Que ridículo ter que aturar\ngente como você…\nFã número 1, acabe com #[ele][ela]#!"

#. backlog,motion,text
msgctxt "484672"
msgid "…n-no way, my fan!"
msgstr "…n-não pode ser, meu fã!"

#. backlog,motion,text
msgctxt "484864"
msgid "Wh-what nerve from a #C076151255#[pig][squirrel]##CDEF!\nNo way in hell!!"
msgstr "Q-que audácia de um #C076151255#[porco][esquilo]##CDEF!\nDe jeito nenhum!!"

#. backlog,motion,text
msgctxt "485132"
msgid "#C076151255Lancer#CDEF wobbled her way back to the door."
msgstr "A #C076151255Lancer#CDEF voltou cambaleando até a porta."

#. backlog,motion,text
msgctxt "485196"
msgid "We obtained #C076151255Lancer#CDEF's #C255093131Secret Garden#CDEF, #C255093131Lonely Person#CDEF!"
msgstr "Obtivemos o #C255093131Secret Garden#CDEF da #C076151255Lancer#CDEF,\n#C255093131Pessoa Solitária#CDEF!"

#. backlog,motion,text
msgctxt "485688"
msgid "Normally there'd be 3 floors with 3 secrets…\nBut this is just a prototype."
msgstr "Normalmente seriam 3 andares com 3 segredos…\nMas isto é apenas um protótipo."

