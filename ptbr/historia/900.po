#. backlog,motion,text
msgctxt "484028"
msgid "#C076151255Lancer#CDEF disappeared inside.\n…either way, it's time to explore."
msgstr ""

#. backlog,motion,text
msgctxt "484496"
msgid "Do you still plan on disrupting my recital?\nYou lowly #C076151255#[pig][squirrel]##CDEF!"
msgstr ""

#. backlog,motion,text
msgctxt "484588"
msgid "How ridiculous that I must entertain the\nlikes of you…\nFan #1, get them!"
msgstr ""

#. backlog,motion,text
msgctxt "484672"
msgid "…n-no way, my fan!"
msgstr ""

#. backlog,motion,text
msgctxt "484864"
msgid "Wh-what nerve from a #C076151255#[pig][squirrel]##CDEF!\nNo way in hell!!"
msgstr ""

#. backlog,motion,text
msgctxt "485132"
