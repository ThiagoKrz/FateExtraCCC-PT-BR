"Content-Type: text/plain; charset=UTF-8\n"
"Language: pt_BR\n"

msgctxt "0"
msgid "No Error."
msgstr "Sem erros."

msgctxt "1"
msgid "The installed game data has been damaged.\nThe installed game data cannot be read.\nLoading the UMD™ game data.\n\nThe install game data function has been turned OFF."
msgstr "Os dados instalados estão danificados.\nNão é possível lê-los.\nCarregando os dados do UMD™.\n\nA instalação de dados foi desativada."

msgctxt "2"
msgid "The installed game data has failed to load.\nThe installed game data cannot be read.\nLoading the UMD™ game data.\n\nThe install game data function has been turned OFF."
msgstr "Falha ao carregar os dados instalados.\nNão é possível lê-los.\nCarregando os dados do UMD™.\n\nA instalação de dados foi desativada."

msgctxt "3"
msgid "No memory stick has been detected.\nThe installed game data cannot be read.\nLoading the UMD™ game data.\n\nThe install game data function has been turned OFF."
msgstr "Nenhum Memory Stick foi detectado.\nNão é possível ler os dados instalados.\nCarregando os dados do UMD™.\n\nA instalação de dados foi desativada."

msgctxt "4"
msgid "Install has been aborted due to activation of Sleep Mode.\nCreation of install data has failed."
msgstr "A instalação foi interrompida pelo modo de espera.\nFalha ao criar os dados de instalação."
